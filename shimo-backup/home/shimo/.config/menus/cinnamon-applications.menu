<?xml version="1.0" ?>
<!DOCTYPE Menu
  PUBLIC '-//freedesktop//DTD Menu 1.0//EN'
  'http://standards.freedesktop.org/menu-spec/menu-1.0.dtd'>
<Menu>
	<Name>Applications</Name>
	<MergeFile type="parent">/etc/xdg/menus/cinnamon-applications.menu</MergeFile>
	<Menu>
		<Name>Administration</Name>
		<Exclude>
			<Filename>org.gnome.baobab.desktop</Filename>
		</Exclude>
		<AppDir>/home/shimo/.local/share/applications</AppDir>
		<Exclude>
			<Filename>lightdm-settings.desktop</Filename>
		</Exclude>
		<Exclude>
			<Filename>fingwit.desktop</Filename>
		</Exclude>
		<Exclude>
			<Filename>ubiquity.desktop</Filename>
		</Exclude>
		<Exclude>
			<Filename>mintsources.desktop</Filename>
		</Exclude>
		<Exclude>
			<Filename>mintupdate.desktop</Filename>
		</Exclude>
		<Exclude>
			<Filename>mintbackup.desktop</Filename>
		</Exclude>
		<Exclude>
			<Filename>mintdrivers.desktop</Filename>
		</Exclude>
		<Exclude>
			<Filename>mintinstall.desktop</Filename>
		</Exclude>
		<Exclude>
			<Filename>mintsysadm.desktop</Filename>
		</Exclude>
		<Exclude>
			<Filename>cinnamon-settings-users.desktop</Filename>
		</Exclude>
		<Exclude>
			<Filename>system-config-printer.desktop</Filename>
		</Exclude>
		<Include>
			<Filename>org.gnome.Terminal.desktop</Filename>
		</Include>
		<Exclude>
			<Filename>timeshift-gtk.desktop</Filename>
		</Exclude>
	</Menu>
	<Menu>
		<Name>Preferences</Name>
		<AppDir>/home/shimo/.local/share/applications</AppDir>
		<Include>
			<Filename>cinnamon-settings-startup.desktop</Filename>
		</Include>
	</Menu>
	<Menu>
		<Name>Internet</Name>
		<Exclude>
			<Filename>x11vnc.desktop</Filename>
		</Exclude>
		<AppDir>/home/shimo/.local/share/applications</AppDir>
		<Exclude>
			<Filename>webapp-OnlineChat4519.desktop</Filename>
		</Exclude>
		<Exclude>
			<Filename>transmission-gtk.desktop</Filename>
		</Exclude>
	</Menu>
</Menu>
