scription":"Визначення схеми для вказаного URL. Схему потрібно надати лише для уникнення доступів до URL схеми."}}}},"json.validate.enable":{"type":"boolean","scope":"window","default":true,"description":"Увімкнути/вимкнути валідацію JSON."},"json.format.enable":{"type":"boolean","scope":"window","default":true,"description":"Увімкнути/вимкнути форматувач JSON за замовчуванням"},"json.format.keepLines":{"type":"boolean","scope":"window","default":false,"description":"Зберігайте всі існуючі нові рядки під час форматування."},"json.trace.server":{"type":"string","scope":"window","enum":["off","messages","verbose"],"default":"off","description":"Відстежує комунікацію між VS Code та сервером мови JSON."},"json.colorDecorators.enable":{"type":"boolean","scope":"window","default":true,"description":"Увімкнути або вимкнути кольорові декоратори","deprecationMessage":"Налаштування `json.colorDecorators.enable` було застарілим на користь `editor.colorDecorators`."},"json.maxItemsComputed":{"type":"number","default":5000,"description":"Максимальна кількість обчислених символів контуру та зон складання (обмежена з причин продуктивності)."},"json.schemaDownload.enable":{"type":"boolean","default":true,"description":"Коли увімкнено, JSON-схеми можна отримати з http та https-локацій.","tags":["usesOnlineServices"]},"json.schemaDownload.trustedDomains":{"type":"object","default":{"https://schemastore.azurewebsites.net/":true,"https://raw.githubusercontent.com/microsoft/vscode/":true,"https://raw.githubusercontent.com/devcontainers/spec/":true,"https://www.schemastore.org/":true,"https://json.schemastore.org/":true,"https://json-schema.org/":true,"https://developer.microsoft.com/json-schemas/":true},"additionalProperties":{"type":"boolean"},"markdownDescription":"List of trusted domains for downloading JSON schemas over http(s). Use `*` to trust all domains. `*` can also be used as a wildcard in domain names.","tags":["usesOnlineServices"]}}},"configurationDefaults":{"[json]":{"edit