",".ejs",".rhtml"],"aliases":["HTML","htm","html","xhtml"],"mimetypes":["text/html","text/x-jshtm","text/template","text/ng-template","application/xhtml+xml"],"configuration":"./language-configuration.json"}],"grammars":[{"scopeName":"text.html.basic","path":"./syntaxes/html.tmLanguage.json","embeddedLanguages":{"text.html":"html","source.css":"css","source.js":"javascript","source.python":"python","source.smarty":"smarty"},"tokenTypes":{"meta.tag string.quoted":"other"}},{"language":"html","scopeName":"text.html.derivative","path":"./syntaxes/html-derivative.tmLanguage.json","embeddedLanguages":{"text.html":"html","source.css":"css","source.js":"javascript","source.python":"python","source.smarty":"smarty"},"tokenTypes":{"meta.tag string.quoted":"other"}}],"snippets":[{"language":"html","path":"./snippets/html.code-snippets"}]},"repository":{"type":"git","url":"https://github.com/microsoft/vscode.git"}},"location":{"$mid":1,"path":"/usr/share/code/resources/app/extensions/html","scheme":"file"},"isBuiltin":true,"targetPlatform":"undefined","isValid":true,"validations":[],"preRelease":false,"forceAutoUpdate":false},{"type":0,"identifier":{"id":"vscode.html-language-features"},"manifest":{"name":"html-language-features","displayName":"Особливості мови HTML","description":"Надає розширену підтримку мов для файлів HTML та Handlebar","version":"10.0.0","publisher":"vscode","license":"MIT","aiKey":"0c6ae279ed8443289764825290e4f9e2-1a736e7c-1324-4338-be46-fc2a58ae4d14-7255","engines":{"vscode":"^1.77.0"},"icon":"icons/html.png","activationEvents":["onLanguage:html","onLanguage:handlebars"],"enabledApiProposals":["extensionsAny"],"main":"./client/dist/node/htmlClientMain","browser":"./client/dist/browser/htmlClientMain","capabilities":{"virtualWorkspaces":true,"untrustedWorkspaces":{"supported":true}},"categories":["Programming Languages"],"contributes":{"configuration":{"id":"html","order":20,"type":"object","title":"HTML","properties":{"html.completion.attributeDefaultValue":{"type":"string","scope":"resource","enum":["doublequotes","singlequotes","empty"],"enumDescriptions":["Значення атрибута встановлено на \"\".\"","Значення атрибута встановлено на ''.","Значення атрибута не встановлено."],"default":"doublequotes","markdownDescription":"Контролює значення за замовчуванням для атрибутів, коли завершення приймається."},"html.customData":{"type":"array","markdownDescription":"Список відносних шляхів до файлів JSON, що відповідають [кастомному формату даних](https://github.com/microsoft/vscode-html-languageservice/blob/master/docs/customData.md).\n\nVS Code завантажує кастомні дані під час запуску, щоб покращити підтримку HTML для кастомних HTML-тегів, атрибутів та значень атрибутів, які ви вказуєте у файлах JSON.\n\nШляхи до файлів є відносними до робочого простору, і враховуються лише налаштування папки робочого простору.","default":[],"items":{"type":"string"},"scope":"resource"},"html.format.enable":{"type":"boolean","scope":"window","default":true,"description":"Увімкнути/вимкнути стандартний HTML форматор."},"html.format.wrapLineLength":{"type":"integer","scope":"resource","default":120,"description":"Максимальна кількість символів на рядок (0 = вимкнути)."},"html.format.unformatted":{"type":["string","null"],"scope":"resource","default":"wbr","markdownDescription":"Список тегів, розділених комами, які не повинні бути переформатовані. `null` за замовчуванням означає всі теги, вказані на https://www.w3.org/TR/html5/dom.html#phrasing-content."},"html.format.contentUnformatted":{"type":["string","null"],"scope":"resource","default":"pre,code,textarea","markdownDescription":"Список тегів, розділених комами, де вміст не повинен бути переформатований. `null` за замовчуванням відповідає тегу `pre`."},"html.format.indentInnerHtml":{"type":"boolean","scope":"resource","default":false,"markdownDescription":"Відступіть секції `<head>` та `<body>`."},"html.format.preserveNewLines":{"type":"boolean","scope":"resource","default":true,"description":"Контролює, чи слід зберігати існуючі розриви рядків перед елементами. Працює лише перед елементами, а не всередині тегів або для тексту."},"html.format.maxPreserveNewLines":{"type":["number","null"],"scope":"resource","default":null,"markdownDescription":"Максимальна кількість переносів рядків, які потрібно зберегти в одному фрагменті. Використовуйте `null` для необмеженого."},"html.format.indentHandlebars":{"type":"boolean","scope":"resource","default":false,"markdownDescription":"Форматувати та відступити `{{#foo}}` та `{{/foo}}`."},"html.format.extraLiners":{"type":["string","null"],"scope":"resource","default":"head, body, /html","markdownDescription":"Список тегів, розділених комами, перед якими має бути додатковий переніс рядка. `null` за замовчуванням дорівнює `\"head, body, /html\"`."},"html.format.wrapAttributes":{"type":"string","scope":"resource","default":"auto","enum":["auto","force","force-aligned","force-expand-multiline","aligned-multiple","preserve","preserve-aligned"],"enumDescriptions":["Обгортати атрибути лише коли перевищена довжина рядка.","Обгорніть кожен атрибут, крім першого.","Обгорніть кожен атрибут, крім першого, і зберігайте вирівнювання.","Обгорніть кожен атрибут.","Обгортати, коли перевищена довжина рядка, вирівнювати атрибути вертикально.","Зберегти обгортку атрибутів.","Зберегти обгортку атрибутів, але вирівняти."],"description":"Обгортати атрибути."},"html.format.wrapAttributesIndentSize":{"type":["number","null"],"scope":"resource","default":null,"markdownDescription":"Відступити обгорнуті атрибути після N символів. Використовуйте `null`, щоб використовувати розмір відступу за замовчуванням. Ігнорується, якщо `#html.format.wrapAttributes#` встановлено на `aligned`."},"html.format.templating":{"type":"boolean","scope":"resource","default":false,"description":"Вшануй теги мов шаблонів django, erb, handlebars та php."},"html.format.unformattedContentDelimiter":{"type":"string","scope":"resource","default":"","markdownDescription":"Тримайте текстовий контент разом між цим рядком."},"html.suggest.html5":{"type":"boolean","scope":"resource","default":true,"description":"Контролює, чи вбудована підтримка HTML мови пропонує теги, властивості та значення HTML5."},"html.suggest.hideEndTagSuggestions":{"type":"boolean","scope":"resource","default":false,"description":"Controls whether the built-in HTML language support suggests closing tags. When disabled, end tag completions like `</div>` will not be shown."},"html.validate.scripts":{"type":"boolean","scope":"resource","default":true,"description":"Контролює, чи вбудована підтримка HTML мови перевіряє вбудовані скрипти."},"html.validate.styles":{"type":"boolean","scope":"resource","default":true,"description":"Контролює, чи вбудована підтримка HTML мови перевіряє вбудовані стилі."},"html.autoCreateQuotes":{"type":"boolean","scope":"resource","default":true,"markdownDescription":"Увімкнути/вимкнути автоматичне створення лапок для призначення HTML-атрибутів. Тип лапок можна налаштувати за допомогою `#html.completion.attributeDefaultValue#`."},"html.autoClosingTags":{"type":"boolean","scope":"resource","default":true,"description":"Увімкнути/вимкнути автоматичне закриття HTML-тегів."},"html.hover.documentation":{"type":"boolean","scope":"resource","default":true,"description":"Показати документацію тегів та атрибутів при наведенні."},"html.hover.references":{"type":"boolean","scope":"resource","default":true,"description":"Показати посилання на MDN при наведенні."},"html.mirrorCursorOnMatchingTag":{"type":"boolean","scope":"resource","default":false,"description":"Увімкнути/вимкнути відображення курсора на відповідному HTML-тегу.","deprecationMessage":"Застаріло на користь `editor.linkedEditing`"},"html.trace.server":{"type":"string","scope":"window","enum":["off","messages","verbose"],"default":"off","description":"Відстежує комунікацію між VS Code та сервером мови HTML."}}},"configurationDefaults":{"[html]":{"editor.suggest.insertMode":"replace