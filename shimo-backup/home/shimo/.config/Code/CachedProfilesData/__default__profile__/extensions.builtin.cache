":"vscode.css"},"manifest":{"name":"css","displayName":"Основи мови CSS","description":"Надає підсвічування синтаксису та відповідність дужок для файлів CSS, LESS та SCSS.","version":"10.0.0","publisher":"vscode","license":"MIT","engines":{"vscode":"0.10.x"},"scripts":{"update-grammar":"node ../node_modules/vscode-grammar-updater/bin microsoft/vscode-css grammars/css.cson ./syntaxes/css.tmLanguage.json"},"categories":["Programming Languages"],"contributes":{"languages":[{"id":"css","aliases":["CSS","css"],"extensions":[".css"],"mimetypes":["text/css"],"configuration":"./language-configuration.json"}],"grammars":[{"language":"css","scopeName":"source.css","path":"./syntaxes/css.tmLanguage.json","tokenTypes":{"meta.function.url string.quoted":"other"}}]},"repository":{"type":"git","url":"https://github.com/microsoft/vscode.git"}},"location":{"$mid":1,"path":"/usr/share/code/resources/app/extensions/css","scheme":"file"},"isBuiltin":true,"targetPlatform":"undefined","isValid":true,"validations":[],"preRelease":false,"forceAutoUpdate":false},{"type":0,"identifier":{"id":"vscode.css-language-features"},"manifest":{"name":"css-language-features","displayName":"Особливості мови CSS","description":"Надає розширену підтримку мов для файлів CSS, LESS та SCSS.","version":"10.0.0","publisher":"vscode","license":"MIT","engines":{"vscode":"^1.77.0"},"icon":"icons/css.png","activationEvents":["onLanguage:css","onLanguage:less","onLanguage:scss","onCommand:_css.applyCodeAction"],"main":"./client/dist/node/cssClientMain","browser":"./client/dist/browser/cssClientMain","capabilities":{"virtualWorkspaces":true,"untrustedWorkspaces":{"supported":true}},"categories":["Programming Languages"],"contributes":{"configuration":[{"order":22,"id":"css","title":"CSS","properties":{"css.customData":{"type":"array","markdownDescription":"Список відносних шляхів до файлів, що вказують на JSON-файли, відповідно до [кастомного формату даних](https://github.com/microsoft/vscode-css-languageservice/blob/master/docs/customData.md).\n\nVS Code завантажує кастомні дані під час запуску, щоб покращити підтримку CSS для кастомних властивостей (змінних), правил at-rules, псевдокласів і псевдоелементів, які ви вказуєте у JSON-файлах.\n\nШляхи до файлів є відносними до робочого простору, і лише налаштування папки робочого простору враховуються.","default":[],"items":{"type":"string"},"scope":"resource"},"css.completion.triggerPropertyValueCompletion":{"type":"boolean","scope":"resource","default":true,"description":"За замовчуванням, VS Code активує завершення значення властивості після вибору CSS-властивості. Використовуйте цю настройку, щоб вимкнути цю поведінку."},"css.completion.completePropertyWithSemicolon":{"type":"boolean","scope":"resource","default":true,"description":"Вставте крапку з комою в кінці рядка при завершенні властивостей CSS."},"css.validate":{"type":"boolean","scope":"resource","default":true,"description":"Увімкнення або вимкнення всіх валідацій."},"css.hover.documentation":{"type":"boolean","scope":"resource","default":true,"description":"Показати документацію властивостей і значень у CSS при наведенні."},"css.hover.references":{"type":"boolean","scope":"resource","default":true,"description":"Показати посилання на MDN у CSS ховерах."},"css.lint.compatibleVendorPrefixes":{"type":"string","scope":"resource","enum":["ignore","warning","error"],"default":"ignore","description":"Коли ви використовуєте префікс, специфічний для постачальника, переконайтеся, що також включили всі інші властивості, специфічні для постачальника."},"css.lint.vendorPrefix":{"type":"string","scope":"resource","enum":["ignore","warning","error"],"default":"warning","description":"Коли ви використовуєте специфічний префікс постачальника, також включайте стандартну властивість."},"css.lint.duplicateProperties":{"type":"string","scope":"resource","enum":["ignore","warning","error"],"default":"ignore","description":"Не використовуйте дублікати визначень стилю."},"css.lint.emptyRules":{"type":"string","scope":"resource","enum":["ignore","warning","error"],"default":"warning","description":"Не використовуйте порожні набори правил."},"css.lint.importStatement":{"type":"string","scope":"resource","enum":["ignore","warning","error"],"default":"ignore","description":"Імпортні оператори не завантажуються паралельно."},"css.lint.boxModel":{"type":"string","scope":"resource","enum":["ignore","warning","error"],"default":"ignore","markdownDescription":"Не використовуйте `width` або `height`, коли використовуєте `padding` або `border`."},"css.lint.universalSelector":{"type":"string","scope":"resource","enum":["ignore","warning","error"],"default":"ignore","markdownDescription":"Універсальний селектор (`*`) відомий своєю повільністю."},"css.lint.zeroUnits":{"type":"string","scope":"resource","enum":["ignore","warning","error"],"default":"ignore","description":"Одиниця для нуля не потрібна."},"css.lint.fontFaceProperties":{"type":"string","scope":"resource","enum":["ignore","warning","error"],"default":"warning","markdownDescription":"Правило `@font-face` повинно визначати властивості `src` та `font-family`."},"css.lint.hexColorLength":{"type":"string","scope":"resource","enum":["ignore","warning","error"],"default":"error","description":"Шістнадцяткові кольори повинні складатися з 3, 4, 6 або 8 шістнадцяткових чисел."},"css.lint.argumentsInColorFunction":{"type":"string","scope":"resource","enum":["ignore","warning","error"],"default":"error","description":"Неправильна кількість параметрів."},"css.lint.unknownProperties":{"type":"string","scope":"resource","enum":["ignore","warning","error"],"default":"warning","description":"Невідома властивість."},"css.lint.validProperties":{"type":"array","uniqueItems":true,"items":{"type":"string"},"scope":"resource","default":[],"markdownDescription":"Список властивостей, які не були перевірені згідно з правилом `unknownProperties`."},"css.lint.ieHack":{"type":"string","scope":"resource","enum":["ignore","warning"