ed"},{"command":"extension.js-debug.network.clear","group":"navigation","when":"view == jsDebugNetworkTree"}],"view/item/context":[{"command":"extension.js-debug.addXHRBreakpoints","when":"view == jsBrowserBreakpoints && viewItem == xhrBreakpoint"},{"command":"extension.js-debug.editXHRBreakpoints","when":"view == jsBrowserBreakpoints && viewItem == xhrBreakpoint","group":"inline"},{"command":"extension.js-debug.editXHRBreakpoints","when":"view == jsBrowserBreakpoints && viewItem == xhrBreakpoint"},{"command":"extension.js-debug.removeXHRBreakpoint","when":"view == jsBrowserBreakpoints && viewItem == xhrBreakpoint","group":"inline"},{"command":"extension.js-debug.removeXHRBreakpoint","when":"view == jsBrowserBreakpoints && viewItem == xhrBreakpoint"},{"command":"extension.js-debug.addXHRBreakpoints","when":"view == jsBrowserBreakpoints && viewItem == xhrCategory","group":"inline"},{"command":"extension.js-debug.callers.goToCaller","group":"inline","when":"view == jsExcludedCallers"},{"command":"extension.js-debug.callers.gotToTarget","group":"inline","when":"view == jsExcludedCallers"},{"command":"extension.js-debug.callers.remove","group":"inline","when":"view == jsExcludedCallers"},{"command":"extension.js-debug.network.viewRequest","group":"inline@1","when":"view == jsDebugNetworkTree"},{"command":"extension.js-debug.network.openBody","group":"body@1","when":"view == jsDebugNetworkTree"},{"command":"extension.js-debug.network.openBodyInHex","group":"body@2","when":"view == jsDebugNetworkTree"},{"command":"extension.js-debug.network.copyUri","group":"other@1","when":"view == jsDebugNetworkTree"},{"command":"extension.js-debug.network.replayXHR","group":"other@2","when":"view == jsDebugNetworkTree"}],"editor/title":[{"command":"extension.js-debug.prettyPrint","group":"navigation","when":"jsDebugCanPrettyPrint"}]},"breakpoints":[{"language":"javascript"},{"language":"typescript"},{"language":"typescriptreact"},{"language":"javascriptreact"},{"language":"fsharp"},{"language":"html"},{"language":"wat"},{"language":"c"},{"language":"cpp"},{"language":"rust"},{"language":"zig"}],"debuggers":[{"aiKey":"0c6ae279ed8443289764825290e4f9e2-1a736e7c-1324-4338-be46-fc2a58ae4d14-7255","configurationAttributes":{"attach":{"properties":{"address":{"default":"localhost","description":"TCP/IP адреса процесу, який потрібно налагодити. За замовчуванням 'localhost'.","type":"string"},"attachExistingChildren":{"default":false,"description":"Чи намагатися приєднатися до вже створених дочірніх процесів.","type":"boolean"},"autoAttachChildProcesses":{"default":true,"description":"Автоматично підключати налагоджувач до нових дочірніх процесів.","type":"boolean"},"cascadeTerminateToConfigurations":{"default":[],"description":"Список сеансів налагодження, які, коли цей сеанс налагодження буде завершено, також будуть зупинені.","items":{"type":"string","uniqueItems":true},"type":"array"},"continueOnAttach":{"default":true,"markdownDescription":"Якщо це правда, ми автоматично відновимо програми, які були запущені та чекають на `--inspect-brk`","type":"boolean"},"customDescriptionGenerator":{"description":"Налаштуйте текстовий опис, який відображає відладчик для об'єктів (локальних змінних тощо...). Приклади:\n      1. this.toString() // викликає toString для виведення всіх об'єктів\n      2. this.customDescription ? this.customDescription() : defaultValue // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть defaultValue\n      3. function (def) { return this.customDescription ? this.customDescription() : def } // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть defaultValue\n      ","type":"string"},"customPropertiesGenerator":{"deprecated":true,"description":"Налаштуйте властивості, які відображаються для об'єкта в налагоджувачі (локальні змінні тощо...). Приклади:\n    1. { ...this, extraProperty: '12345' } // Додати extraProperty 12345 до всіх об'єктів\n    2. this.customProperties ? this.customProperties() : this // Використовуйте метод customProperties, якщо він доступний, якщо ні - використовуйте властивості в this (за замовчуванням)\n    3. function () { return this.customProperties ? this.customProperties() : this } // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть властивості за замовчуванням\n\n    Застаріло: Це тимчасова реалізація цієї функції, поки ми не матимемо часу реалізувати її в спосіб, описаний тут: https://github.com/microsoft/vscode/issues/102181","type":"string"},"cwd":{"default":"${workspaceFolder}","description":"Абсолютний шлях до робочого каталогу програми, що налагоджується. Якщо ви встановили localRoot, тоді cwd відповідатиме цьому значенню, інакше він повернеться до вашого workspaceFolder.","tags":["setup"],"type":"string"},"enableContentValidation":{"default":true,"description":"Перемикає, чи перевіряємо ми, що вміст файлів на диску відповідає завантаженим у час виконання. Це корисно в різних сценаріях і є обов'язковим у деяких, але може викликати проблеми, якщо у вас є серверна трансформація скриптів, наприклад.","type":"boolean"},"enableDWARF":{"default":true,"markdownDescription":"Перемикає, чи буде відладчик намагатися зчитувати символи налагодження DWARF з WebAssembly, що може вимагати багато ресурсів. Для роботи потрібен розширення `ms-vscode.wasm-dwarf-debugging`.","type":"boolean"},"env":{"additionalProperties":{"type":["string","null"]},"default":{},"markdownDescription":"Змінні середовища, передані програмі. Значення `null` видаляє змінну з середовища.","tags":["setup"],"type":"object"},"envFile":{"default":"${workspaceFolder}/.env","description":"Абсолютний шлях до файлу, що містить визначення змінних середовища.","type":"string"},"localRoot":{"default":null,"description":"Шлях до локального каталогу, що містить програму.","type":["string","null"]},"nodeVersionHint":{"default":12,"description":"Дозволяє вам явно вказати версію Node, яка працює, що може бути використано для вимкнення або ввімкнення певних поведінок у випадках, коли автоматичне визначення версії не працює.","minimum":8,"type":"number"},"outFiles":{"default":["${workspaceFolder}/**/*.(m|c|)js","!**/node_modules/**"],"description":"Якщо карти джерел увімкнені, ці шаблони glob вказують на згенеровані файли JavaScript. Якщо шаблон починається з `!`, файли виключаються. Якщо не вказано, згенерований код очікується в тому ж каталозі, що й його джерело.","items":{"type":"string"},"tags":["setup"],"type":["array"]},"outputCapture":{"default":"console","enum":["console","std"],"markdownDescription":"Звідки захоплювати вихідні повідомлення: за замовчуванням API налагодження, якщо встановлено `console`, або потоки stdout/stderr, якщо встановлено `std`."},"pauseForSourceMap":{"default":false,"markdownDescription":"Чи чекати на завантаження карт джерел для кожного вхідного скрипта. Це має накладні витрати на продуктивність і може бути безпечно вимкнено при виконанні з диска, якщо `rootPath` не вимкнено.","type":"boolean"},"port":{"default":9229,"description":"Порт налагодження для підключення. За замовчуванням 9229.","oneOf":[{"type":"integer"},{"pattern":"^\\${.*}$","type":"string"}],"tags":["setup"]},"processId":{"default":"${command:PickProcess}","description":"ID процесу, до якого потрібно приєднатися.","type":"string"},"remoteHostHeader":{"description":"Явний заголовок Host, який слід використовувати при підключенні до вебсокета інспектора. Якщо не вказано, заголовок host буде встановлено на 'localhost'. Це корисно, коли інспектор працює за проксі, який приймає лише певний заголовок Host.","type":"string"},"remoteRoot":{"default":null,"description":"Абсолютний шлях до віддаленого каталогу, що містить програму.","type":["string","null"]},"resolveSourceMapLocations":{"default":["${workspaceFolder}/**","!**/node_modules/**"],"description":"Список патернів minimatch для місць (папок та URL), в яких карти джерел можуть бути використані для вирішення локальних файлів. Це можна використовувати, щоб уникнути неправильного розриву в зовнішньому коді з картами джерел. Патерни можуть бути префіксовані знаком \"!\", щоб виключити їх. Може бути встановлено на порожній масив або null, щоб уникнути обмежень.","items":{"type":"string"},"type":["array","null"]},"restart":{"default":true,"description":"Спробуйте перепідключитися до програми, якщо ми втратимо з'єднання. Якщо встановлено `true`, ми будемо намагатися раз на секунду, вічно. Ви можете налаштувати інтервал і максимальну кількість спроб, вказавши `delay` та `maxAttempts` в об'єкті замість цього.","oneOf":[{"type":"boolean"},{"properties":{"delay":{"default":1000,"minimum":0,"type":"number"},"maxAttempts":{"default":10,"minimum":0,"type":"number"}},"type":"object"}]},"runtimeSourcemapPausePatterns":{"default":[],"items":{"type":"string"},"markdownDescription":"Список шаблонів, за якими можна вручну вставити точки зупинки вхідної точки. Це може бути корисно, щоб надати відладчику можливість встановити точки зупинки при використанні sourcemaps, які не існують або не можуть бути виявлені до запуску, наприклад, [з фреймворком Serverless](https://github.com/microsoft/vscode-js-debug/issues/492).","type":"array"},"showAsyncStacks":{"default":true,"description":"Показати асинхронні виклики, які призвели до поточного стеку викликів.","oneOf":[{"type":"boolean"},{"properties":{"onAttach":{"default":32,"type":"number"}},"required":["onAttach"],"type":"object"},{"properties":{"onceBreakpointResolved":{"default":32,"type":"number"}},"required":["onceBreakpointResolved"],"type":"object"}]},"skipFiles":{"default":["${/**"],"description":"Масив імен файлів або папок, або шаблонів шляхів, які слід пропустити під час налагодження. Дозволені зіркові шаблони та заперечення, наприклад, `[\"**/node_modules/**\", \"!**/node_modules/my-module/**\"]`","type":"array"},"smartStep":{"default":true,"description":"Автоматично проходьте через згенерований код, який не може бути відображений назад до оригінального джерела.","type":"boolean"},"sourceMapPathOverrides":{"default":{"meteor://💻app/*":"${workspaceFolder}/*","webpack:///./~/*":"${workspaceFolder}/node_modules/*","webpack://?:*/*":"${workspaceFolder}/*"},"description":"Набір відображень для переписування місць розташування вихідних файлів з того, що вказує sourcemap, на їхні місця на диску.","type":"object"},"sourceMapRenames":{"default":true,"description":"Чи використовувати відображення \"names\" у sourcemaps. Це вимагає запиту на отримання вихідного контенту, що може бути повільним з певними налагоджувачами.","type":"boolean"},"sourceMaps":{"default":true,"description":"Використовуйте карти джерел JavaScript (якщо вони існують).","type":"boolean"},"timeout":{"default":10000,"description":"Спробуйте знову протягом цього числа мілісекунд для підключення до Node.js. За замовчуванням 10000 мс.","type":"number"},"timeouts":{"additionalProperties":false,"default":{},"description":"Тайм-аути для кількох операцій налагодження.","markdownDescription":"Таймаути для кількох операцій налагоджувача.","properties":{"hoverEvaluation":{"default":500,"description":"Час до оцінки значення для символів, на які наведено курсор, скасовується. Якщо встановлено 0, оцінка при наведенні ніколи не закінчується.","type":"number"},"sourceMapCumulativePause":{"default":1000,"description":"Додатковий час у мілісекундах, дозволений за сесію для очікування обробки source-map, після того як мінімальний час (sourceMapMinPause) буде вичерпано","type":"number"},"sourceMapMinPause":{"default":1000,"description":"Мінімальний час у мілісекундах, витрачений на очікування обробки кожної source-map під час парсингу скрипта","type":"number"}},"type":"object"},"trace":{"default":true,"description":"Налаштовує, який діагностичний вивід буде створено.","oneOf":[{"description":"Trace може бути встановлено на 'true', щоб записувати діагностичні журнали на диск.","type":"boolean"},{"additionalProperties":false,"properties":{"logFile":{"description":"Налаштовує, де на диску записуються журнали.","type":["string","null"]},"stdio":{"description":"Чи повертати дані трасування з запущеного додатку або браузера.","type":"boolean"}},"type":"object"}]},"websocketAddress":{"description":"Точна адреса вебсокета для підключення. Якщо не вказано, вона буде виявлена з адреси та порту.","type":"string"}}},"launch":{"properties":{"args":{"default":[],"description":"Аргументи командного рядка, передані програмі.\n\nМожуть бути масивом рядків або єдиним рядком. Коли програма запускається в терміналі, встановлення цієї властивості в єдиний рядок призведе до того, що аргументи не будуть екрановані для оболонки.","items":{"type":"string"},"tags":["setup"],"type":["array","string"]},"attachSimplePort":{"default":9229,"description":"Якщо встановлено, приєднується до процесу через вказаний порт. Це зазвичай більше не є необхідним для програм Node.js і втрачає можливість налагодження дочірніх процесів, але може бути корисним у більш екзотичних сценаріях, таких як запуск з Deno та Docker. Якщо встановлено на 0, буде вибрано випадковий порт, і --inspect-brk буде автоматично додано до аргументів запуску.","oneOf":[{"type":"integer"},{"pattern":"^\\${.*}$","type":"string"}]},"autoAttachChildProcesses":{"default":true,"description":"Автоматично підключати налагоджувач до нових дочірніх процесів.","type":"boolean"},"cascadeTerminateToConfigurations":{"default":[],"description":"Список сеансів налагодження, які, коли цей сеанс налагодження буде завершено, також будуть зупинені.","items":{"type":"string","uniqueItems":true},"type":"array"},"console":{"default":"internalConsole","description":"Де запустити ціль налагодження.","enum":["internalConsole","integratedTerminal","externalTerminal"],"enumDescriptions":["Консоль налагодження VS Code (яка не підтримує читання введення з програми)","інтегрований термінал VS Code","Зовнішній термінал, який можна налаштувати через налаштування користувача"],"type":"string"},"customDescriptionGenerator":{"description":"Налаштуйте текстовий опис, який відображає відладчик для об'єктів (локальних змінних тощо...). Приклади:\n      1. this.toString() // викликає toString для виведення всіх об'єктів\n      2. this.customDescription ? this.customDescription() : defaultValue // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть defaultValue\n      3. function (def) { return this.customDescription ? this.customDescription() : def } // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть defaultValue\n      ","type":"string"},"customPropertiesGenerator":{"deprecated":true,"description":"Налаштуйте властивості, які відображаються для об'єкта в налагоджувачі (локальні змінні тощо...). Приклади:\n    1. { ...this, extraProperty: '12345' } // Додати extraProperty 12345 до всіх об'єктів\n    2. this.customProperties ? this.customProperties() : this // Використовуйте метод customProperties, якщо він доступний, якщо ні - використовуйте властивості в this (за замовчуванням)\n    3. function () { return this.customProperties ? this.customProperties() : this } // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть властивості за замовчуванням\n\n    Застаріло: Це тимчасова реалізація цієї функції, поки ми не матимемо часу реалізувати її в спосіб, описаний тут: https://github.com/microsoft/vscode/issues/102181","type":"string"},"cwd":{"default":"${workspaceFolder}","description":"Абсолютний шлях до робочого каталогу програми, що налагоджується. Якщо ви встановили localRoot, тоді cwd відповідатиме цьому значенню, інакше він повернеться до вашого workspaceFolder.","tags":["setup"],"type":"string"},"enableContentValidation":{"default":true,"description":"Перемикає, чи перевіряємо ми, що вміст файлів на диску відповідає завантаженим у час виконання. Це корисно в різних сценаріях і є обов'язковим у деяких, але може викликати проблеми, якщо у вас є серверна трансформація скриптів, наприклад.","type":"boolean"},"enableDWARF":{"default":true,"markdownDescription":"Перемикає, чи буде відладчик намагатися зчитувати символи налагодження DWARF з WebAssembly, що може вимагати багато ресурсів. Для роботи потрібен розширення `ms-vscode.wasm-dwarf-debugging`.","type":"boolean"},"env":{"additionalProperties":{"type":["string","null"]},"default":{},"markdownDescription":"Змінні середовища, передані програмі. Значення `null` видаляє змінну з середовища.","tags":["setup"],"type":"object"},"envFile":{"default":"${workspaceFolder}/.env","description":"Абсолютний шлях до файлу, що містить визначення змінних середовища.","type":"string"},"experimentalNetworking":{"default":"auto","description":"Увімкніть експериментальну перевірку в Node.js. Коли встановлено `auto`, це увімкнено для версій Node.js, які це підтримують. Його можна встановити на `on` або `off`, щоб увімкнути або вимкнути його явно.","enum":["auto","on","off"],"type":"string"},"killBehavior":{"default":"forceful","enum":["forceful","polite","none"],"markdownDescription":"Налаштовує, як процеси налагодження зупиняються при завершенні сеансу. Може бути:\n\n- примусовим (за замовчуванням): примусово знищує дерево процесів. Надсилає SIGKILL на posix або `taskkill.exe /F` на Windows.\n- ввічливим: м’яко знищує дерево процесів. Можливо, що некоректно працюючі процеси продовжать виконуватись після завершення таким чином. Надсилає SIGTERM на posix або `taskkill.exe` без прапора `/F` (примус) на Windows.\n- жодного: жодного завершення не відбудеться.","type":"string"},"localRoot":{"default":null,"description":"Шлях до локального каталогу, що містить програму.","type":["string","null"]},"nodeVersionHint":{"default":12,"description":"Дозволяє вам явно вказати версію Node, яка працює, що може бути використано для вимкнення або ввімкнення певних поведінок у випадках, коли автоматичне визначення версії не працює.","minimum":8,"type":"number"},"outFiles":{"default":["${workspaceFolder}/**/*.(m|c|)js","!**/node_modules/**"],"description":"Якщо карти джерел увімкнені, ці шаблони glob вказують на згенеровані файли JavaScript. Якщо шаблон починається з `!`, файли виключаються. Якщо не вказано, згенерований код очікується в тому ж каталозі, що й його джерело.","items":{"type":"string"},"tags":["setup"],"type":["array"]},"outputCapture":{"default":"console","enum":["console","std"],"markdownDescription":"Звідки захоплювати вихідні повідомлення: за замовчуванням API налагодження, якщо встановлено `console`, або потоки stdout/stderr, якщо встановлено `std`."},"pauseForSourceMap":{"default":false,"markdownDescription":"Чи чекати на завантаження карт джерел для кожного вхідного скрипта. Це має накладні витрати на продуктивність і може бути безпечно вимкнено при виконанні з диска, якщо `rootPath` не вимкнено.","type":"boolean"},"profileStartup":{"default":true,"description":"Якщо це правда, почне профілювання, як тільки процес запуститься","type":"boolean"},"program":{"default":"","description":"Абсолютний шлях до програми. Згенероване значення визначається шляхом аналізу package.json та відкритих файлів. Відредагуйте цей атрибут.","tags":["setup"],"type":"string"},"remoteRoot":{"default":null,"description":"Абсолютний шлях до віддаленого каталогу, що містить програму.","type":["string","null"]},"resolveSourceMapLocations":{"default":["${workspaceFolder}/**","!**/node_modules/**"],"description":"Список патернів minimatch для місць (папок та URL), в яких карти джерел можуть бути використані для вирішення локальних файлів. Це можна використовувати, щоб уникнути неправильного розриву в зовнішньому коді з картами джерел. Патерни можуть бути префіксовані знаком \"!\", щоб виключити їх. Може бути встановлено на порожній масив або null, щоб уникнути обмежень.","items":{"type":"string"},"type":["array","null"]},"restart":{"default":true,"description":"Спробуйте перепідключитися до програми, якщо ми втратимо з'єднання. Якщо встановлено `true`, ми будемо намагатися раз на секунду, вічно. Ви можете налаштувати інтервал і максимальну кількість спроб, вказавши `delay` та `maxAttempts` в об'єкті замість цього.","oneOf":[{"type":"boolean"},{"properties":{"delay":{"default":1000,"minimum":0,"type":"number"},"maxAttempts":{"default":10,"minimum":0,"type":"number"}},"type":"object"}]},"runtimeArgs":{"default":[],"description":"Необов'язкові аргументи, передані виконуваному файлу часу виконання.","items":{"type":"string"},"tags":["setup"],"type":"array"},"runtimeExecutable":{"default":"node","markdownDescription":"Час виконання для використання. Або абсолютний шлях, або ім'я часу виконання, доступного в PATH. Якщо пропущено, вважається, що використовується `node`.","type":["string","null"]},"runtimeSourcemapPausePatterns":{"default":[],"items":{"type":"string"},"markdownDescription":"Список шаблонів, за якими можна вручну вставити точки зупинки вхідної точки. Це може бути корисно, щоб надати відладчику можливість встановити точки зупинки при використанні sourcemaps, які не існують або не можуть бути виявлені до запуску, наприклад, [з фреймворком Serverless](https://github.com/microsoft/vscode-js-debug/issues/492).","type":"array"},"runtimeVersion":{"default":"default","markdownDescription":"Версія середовища виконання `node`, яку слід використовувати. Потрібен `nvm`.","type":"string"},"showAsyncStacks":{"default":true,"description":"Показати асинхронні виклики, які призвели до поточного стеку викликів.","oneOf":[{"type":"boolean"},{"properties":{"onAttach":{"default":32,"type":"number"}},"required":["onAttach"],"type":"object"},{"properties":{"onceBreakpointResolved":{"default":32,"type":"number"}},"required":["onceBreakpointResolved"],"type":"object"}]},"skipFiles":{"default":["${/**"],"description":"Масив імен файлів або папок, або шаблонів шляхів, які слід пропустити під час налагодження. Дозволені зіркові шаблони та заперечення, наприклад, `[\"**/node_modules/**\", \"!**/node_modules/my-module/**\"]`","type":"array"},"smartStep":{"default":true,"description":"Автоматично проходьте через згенерований код, який не може бути відображений назад до оригінального джерела.","type":"boolean"},"sourceMapPathOverrides":{"default":{"meteor://💻app/*":"${workspaceFolder}/*","webpack:///./~/*":"${workspaceFolder}/node_modules/*","webpack://?:*/*":"${workspaceFolder}/*"},"description":"Набір відображень для переписування місць розташування вихідних файлів з того, що вказує sourcemap, на їхні місця на диску.","type":"object"},"sourceMapRenames":{"default":true,"description":"Чи використовувати відображення \"names\" у sourcemaps. Це вимагає запиту на отримання вихідного контенту, що може бути повільним з певними налагоджувачами.","type":"boolean"},"sourceMaps":{"default":true,"description":"Використовуйте карти джерел JavaScript (якщо вони існують).","type":"boolean"},"stopOnEntry":{"default":true,"description":"Автоматично зупинити програму після запуску.","type":["boolean","string"]},"timeout":{"default":10000,"description":"Спробуйте знову протягом цього числа мілісекунд для підключення до Node.js. За замовчуванням 10000 мс.","type":"number"},"timeouts":{"additionalProperties":false,"default":{},"description":"Тайм-аути для кількох операцій налагодження.","markdownDescription":"Таймаути для кількох операцій налагоджувача.","properties":{"hoverEvaluation":{"default":500,"description":"Час до оцінки значення для символів, на які наведено курсор, скасовується. Якщо встановлено 0, оцінка при наведенні ніколи не закінчується.","type":"number"},"sourceMapCumulativePause":{"default":1000,"description":"Додатковий час у мілісекундах, дозволений за сесію для очікування обробки source-map, після того як мінімальний час (sourceMapMinPause) буде вичерпано","type":"number"},"sourceMapMinPause":{"default":1000,"description":"Мінімальний час у мілісекундах, витрачений на очікування обробки кожної source-map під час парсингу скрипта","type":"number"}},"type":"object"},"trace":{"default":true,"description":"Налаштовує, який діагностичний вивід буде створено.","oneOf":[{"description":"Trace може бути встановлено на 'true', щоб записувати діагностичні журнали на диск.","type":"boolean"},{"additionalProperties":false,"properties":{"logFile":{"description":"Налаштовує, де на диску записуються журнали.","type":["string","null"]},"stdio":{"description":"Чи повертати дані трасування з запущеного додатку або браузера.","type":"boolean"}},"type":"object"}]}}}},"configurationSnippets":[],"deprecated":"Please use type node instead","label":"Node.js","languages":["javascript","typescript","javascriptreact","typescriptreact"],"strings":{"unverifiedBreakpoints":"Деякі з ваших точок зупинки не можуть бути встановлені. Якщо у вас виникає проблема, ви можете [усунути неполадки у вашій конфігурації запуску](command:extension.js-debug.createDiagnostics)."},"type":"pwa-node","variables":{"PickProcess":"extension.js-debug.pickNodeProcess"}},{"aiKey":"0c6ae279ed8443289764825290e4f9e2-1a736e7c-1324-4338-be46-fc2a58ae4d14-7255","configurationAttributes":{"attach":{"properties":{"address":{"default":"localhost","description":"TCP/IP адреса процесу, який потрібно налагодити. За замовчуванням 'localhost'.","type":"string"},"attachExistingChildren":{"default":false,"description":"Чи намагатися приєднатися до вже створених дочірніх процесів.","type":"boolean"},"autoAttachChildProcesses":{"default":true,"description":"Автоматично підключати налагоджувач до нових дочірніх процесів.","type":"boolean"},"cascadeTerminateToConfigurations":{"default":[],"description":"Список сеансів налагодження, які, коли цей сеанс налагодження буде завершено, також будуть зупинені.","items":{"type":"string","uniqueItems":true},"type":"array"},"continueOnAttach":{"default":true,"markdownDescription":"Якщо це правда, ми автоматично відновимо програми, які були запущені та чекають на `--inspect-brk`","type":"boolean"},"customDescriptionGenerator":{"description":"Налаштуйте текстовий опис, який відображає відладчик для об'єктів (локальних змінних тощо...). Приклади:\n      1. this.toString() // викликає toString для виведення всіх об'єктів\n      2. this.customDescription ? this.customDescription() : defaultValue // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть defaultValue\n      3. function (def) { return this.customDescription ? this.customDescription() : def } // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть defaultValue\n      ","type":"string"},"customPropertiesGenerator":{"deprecated":true,"description":"Налаштуйте властивості, які відображаються для об'єкта в налагоджувачі (локальні змінні тощо...). Приклади:\n    1. { ...this, extraProperty: '12345' } // Додати extraProperty 12345 до всіх об'єктів\n    2. this.customProperties ? this.customProperties() : this // Використовуйте метод customProperties, якщо він доступний, якщо ні - використовуйте властивості в this (за замовчуванням)\n    3. function () { return this.customProperties ? this.customProperties() : this } // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть властивості за замовчуванням\n\n    Застаріло: Це тимчасова реалізація цієї функції, поки ми не матимемо часу реалізувати її в спосіб, описаний тут: https://github.com/microsoft/vscode/issues/102181","type":"string"},"cwd":{"default":"${workspaceFolder}","description":"Абсолютний шлях до робочого каталогу програми, що налагоджується. Якщо ви встановили localRoot, тоді cwd відповідатиме цьому значенню, інакше він повернеться до вашого workspaceFolder.","tags":["setup"],"type":"string"},"enableContentValidation":{"default":true,"description":"Перемикає, чи перевіряємо ми, що вміст файлів на диску відповідає завантаженим у час виконання. Це корисно в різних сценаріях і є обов'язковим у деяких, але може викликати проблеми, якщо у вас є серверна трансформація скриптів, наприклад.","type":"boolean"},"enableDWARF":{"default":true,"markdownDescription":"Перемикає, чи буде відладчик намагатися зчитувати символи налагодження DWARF з WebAssembly, що може вимагати багато ресурсів. Для роботи потрібен розширення `ms-vscode.wasm-dwarf-debugging`.","type":"boolean"},"env":{"additionalProperties":{"type":["string","null"]},"default":{},"markdownDescription":"Змінні середовища, передані програмі. Значення `null` видаляє змінну з середовища.","tags":["setup"],"type":"object"},"envFile":{"default":"${workspaceFolder}/.env","description":"Абсолютний шлях до файлу, що містить визначення змінних середовища.","type":"string"},"localRoot":{"default":null,"description":"Шлях до локального каталогу, що містить програму.","type":["string","null"]},"nodeVersionHint":{"default":12,"description":"Дозволяє вам явно вказати версію Node, яка працює, що може бути використано для вимкнення або ввімкнення певних поведінок у випадках, коли автоматичне визначення версії не працює.","minimum":8,"type":"number"},"outFiles":{"default":["${workspaceFolder}/**/*.(m|c|)js","!**/node_modules/**"],"description":"Якщо карти джерел увімкнені, ці шаблони glob вказують на згенеровані файли JavaScript. Якщо шаблон починається з `!`, файли виключаються. Якщо не вказано, згенерований код очікується в тому ж каталозі, що й його джерело.","items":{"type":"string"},"tags":["setup"],"type":["array"]},"outputCapture":{"default":"console","enum":["console","std"],"markdownDescription":"Звідки захоплювати вихідні повідомлення: за замовчуванням API налагодження, якщо встановлено `console`, або потоки stdout/stderr, якщо встановлено `std`."},"pauseForSourceMap":{"default":false,"markdownDescription":"Чи чекати на завантаження карт джерел для кожного вхідного скрипта. Це має накладні витрати на продуктивність і може бути безпечно вимкнено при виконанні з диска, якщо `rootPath` не вимкнено.","type":"boolean"},"port":{"default":9229,"description":"Порт налагодження для підключення. За замовчуванням 9229.","oneOf":[{"type":"integer"},{"pattern":"^\\${.*}$","type":"string"}],"tags":["setup"]},"processId":{"default":"${command:PickProcess}","description":"ID процесу, до якого потрібно приєднатися.","type":"string"},"remoteHostHeader":{"description":"Явний заголовок Host, який слід використовувати при підключенні до вебсокета інспектора. Якщо не вказано, заголовок host буде встановлено на 'localhost'. Це корисно, коли інспектор працює за проксі, який приймає лише певний заголовок Host.","type":"string"},"remoteRoot":{"default":null,"description":"Абсолютний шлях до віддаленого каталогу, що містить програму.","type":["string","null"]},"resolveSourceMapLocations":{"default":["${workspaceFolder}/**","!**/node_modules/**"],"description":"Список патернів minimatch для місць (папок та URL), в яких карти джерел можуть бути використані для вирішення локальних файлів. Це можна використовувати, щоб уникнути неправильного розриву в зовнішньому коді з картами джерел. Патерни можуть бути префіксовані знаком \"!\", щоб виключити їх. Може бути встановлено на порожній масив або null, щоб уникнути обмежень.","items":{"type":"string"},"type":["array","null"]},"restart":{"default":true,"description":"Спробуйте перепідключитися до програми, якщо ми втратимо з'єднання. Якщо встановлено `true`, ми будемо намагатися раз на секунду, вічно. Ви можете налаштувати інтервал і максимальну кількість спроб, вказавши `delay` та `maxAttempts` в об'єкті замість цього.","oneOf":[{"type":"boolean"},{"properties":{"delay":{"default":1000,"minimum":0,"type":"number"},"maxAttempts":{"default":10,"minimum":0,"type":"number"}},"type":"object"}]},"runtimeSourcemapPausePatterns":{"default":[],"items":{"type":"string"},"markdownDescription":"Список шаблонів, за якими можна вручну вставити точки зупинки вхідної точки. Це може бути корисно, щоб надати відладчику можливість встановити точки зупинки при використанні sourcemaps, які не існують або не можуть бути виявлені до запуску, наприклад, [з фреймворком Serverless](https://github.com/microsoft/vscode-js-debug/issues/492).","type":"array"},"showAsyncStacks":{"default":true,"description":"Показати асинхронні виклики, які призвели до поточного стеку викликів.","oneOf":[{"type":"boolean"},{"properties":{"onAttach":{"default":32,"type":"number"}},"required":["onAttach"],"type":"object"},{"properties":{"onceBreakpointResolved":{"default":32,"type":"number"}},"required":["onceBreakpointResolved"],"type":"object"}]},"skipFiles":{"default":["${/**"],"description":"Масив імен файлів або папок, або шаблонів шляхів, які слід пропустити під час налагодження. Дозволені зіркові шаблони та заперечення, наприклад, `[\"**/node_modules/**\", \"!**/node_modules/my-module/**\"]`","type":"array"},"smartStep":{"default":true,"description":"Автоматично проходьте через згенерований код, який не може бути відображений назад до оригінального джерела.","type":"boolean"},"sourceMapPathOverrides":{"default":{"meteor://💻app/*":"${workspaceFolder}/*","webpack:///./~/*":"${workspaceFolder}/node_modules/*","webpack://?:*/*":"${workspaceFolder}/*"},"description":"Набір відображень для переписування місць розташування вихідних файлів з того, що вказує sourcemap, на їхні місця на диску.","type":"object"},"sourceMapRenames":{"default":true,"description":"Чи використовувати відображення \"names\" у sourcemaps. Це вимагає запиту на отримання вихідного контенту, що може бути повільним з певними налагоджувачами.","type":"boolean"},"sourceMaps":{"default":true,"description":"Використовуйте карти джерел JavaScript (якщо вони існують).","type":"boolean"},"timeout":{"default":10000,"description":"Спробуйте знову протягом цього числа мілісекунд для підключення до Node.js. За замовчуванням 10000 мс.","type":"number"},"timeouts":{"additionalProperties":false,"default":{},"description":"Тайм-аути для кількох операцій налагодження.","markdownDescription":"Таймаути для кількох операцій налагоджувача.","properties":{"hoverEvaluation":{"default":500,"description":"Час до оцінки значення для символів, на які наведено курсор, скасовується. Якщо встановлено 0, оцінка при наведенні ніколи не закінчується.","type":"number"},"sourceMapCumulativePause":{"default":1000,"description":"Додатковий час у мілісекундах, дозволений за сесію для очікування обробки source-map, після того як мінімальний час (sourceMapMinPause) буде вичерпано","type":"number"},"sourceMapMinPause":{"default":1000,"description":"Мінімальний час у мілісекундах, витрачений на очікування обробки кожної source-map під час парсингу скрипта","type":"number"}},"type":"object"},"trace":{"default":true,"description":"Налаштовує, який діагностичний вивід буде створено.","oneOf":[{"description":"Trace може бути встановлено на 'true', щоб записувати діагностичні журнали на диск.","type":"boolean"},{"additionalProperties":false,"properties":{"logFile":{"description":"Налаштовує, де на диску записуються журнали.","type":["string","null"]},"stdio":{"description":"Чи повертати дані трасування з запущеного додатку або браузера.","type":"boolean"}},"type":"object"}]},"websocketAddress":{"description":"Точна адреса вебсокета для підключення. Якщо не вказано, вона буде виявлена з адреси та порту.","type":"string"}}},"launch":{"properties":{"args":{"default":[],"description":"Аргументи командного рядка, передані програмі.\n\nМожуть бути масивом рядків або єдиним рядком. Коли програма запускається в терміналі, встановлення цієї властивості в єдиний рядок призведе до того, що аргументи не будуть екрановані для оболонки.","items":{"type":"string"},"tags":["setup"],"type":["array","string"]},"attachSimplePort":{"default":9229,"description":"Якщо встановлено, приєднується до процесу через вказаний порт. Це зазвичай більше не є необхідним для програм Node.js і втрачає можливість налагодження дочірніх процесів, але може бути корисним у більш екзотичних сценаріях, таких як запуск з Deno та Docker. Якщо встановлено на 0, буде вибрано випадковий порт, і --inspect-brk буде автоматично додано до аргументів запуску.","oneOf":[{"type":"integer"},{"pattern":"^\\${.*}$","type":"string"}]},"autoAttachChildProcesses":{"default":true,"description":"Автоматично підключати налагоджувач до нових дочірніх процесів.","type":"boolean"},"cascadeTerminateToConfigurations":{"default":[],"description":"Список сеансів налагодження, які, коли цей сеанс налагодження буде завершено, також будуть зупинені.","items":{"type":"string","uniqueItems":true},"type":"array"},"console":{"default":"internalConsole","description":"Де запустити ціль налагодження.","enum":["internalConsole","integratedTerminal","externalTerminal"],"enumDescriptions":["Консоль налагодження VS Code (яка не підтримує читання введення з програми)","інтегрований термінал VS Code","Зовнішній термінал, який можна налаштувати через налаштування користувача"],"type":"string"},"customDescriptionGenerator":{"description":"Налаштуйте текстовий опис, який відображає відладчик для об'єктів (локальних змінних тощо...). Приклади:\n      1. this.toString() // викликає toString для виведення всіх об'єктів\n      2. this.customDescription ? this.customDescription() : defaultValue // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть defaultValue\n      3. function (def) { return this.customDescription ? this.customDescription() : def } // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть defaultValue\n      ","type":"string"},"customPropertiesGenerator":{"deprecated":true,"description":"Налаштуйте властивості, які відображаються для об'єкта в налагоджувачі (локальні змінні тощо...). Приклади:\n    1. { ...this, extraProperty: '12345' } // Додати extraProperty 12345 до всіх об'єктів\n    2. this.customProperties ? this.customProperties() : this // Використовуйте метод customProperties, якщо він доступний, якщо ні - використовуйте властивості в this (за замовчуванням)\n    3. function () { return this.customProperties ? this.customProperties() : this } // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть властивості за замовчуванням\n\n    Застаріло: Це тимчасова реалізація цієї функції, поки ми не матимемо часу реалізувати її в спосіб, описаний тут: https://github.com/microsoft/vscode/issues/102181","type":"string"},"cwd":{"default":"${workspaceFolder}","description":"Абсолютний шлях до робочого каталогу програми, що налагоджується. Якщо ви встановили localRoot, тоді cwd відповідатиме цьому значенню, інакше він повернеться до вашого workspaceFolder.","tags":["setup"],"type":"string"},"enableContentValidation":{"default":true,"description":"Перемикає, чи перевіряємо ми, що вміст файлів на диску відповідає завантаженим у час виконання. Це корисно в різних сценаріях і є обов'язковим у деяких, але може викликати проблеми, якщо у вас є серверна трансформація скриптів, наприклад.","type":"boolean"},"enableDWARF":{"default":true,"markdownDescription":"Перемикає, чи буде відладчик намагатися зчитувати символи налагодження DWARF з WebAssembly, що може вимагати багато ресурсів. Для роботи потрібен розширення `ms-vscode.wasm-dwarf-debugging`.","type":"boolean"},"env":{"additionalProperties":{"type":["string","null"]},"default":{},"markdownDescription":"Змінні середовища, передані програмі. Значення `null` видаляє змінну з середовища.","tags":["setup"],"type":"object"},"envFile":{"default":"${workspaceFolder}/.env","description":"Абсолютний шлях до файлу, що містить визначення змінних середовища.","type":"string"},"experimentalNetworking":{"default":"auto","description":"Увімкніть експериментальну перевірку в Node.js. Коли встановлено `auto`, це увімкнено для версій Node.js, які це підтримують. Його можна встановити на `on` або `off`, щоб увімкнути або вимкнути його явно.","enum":["auto","on","off"],"type":"string"},"killBehavior":{"default":"forceful","enum":["forceful","polite","none"],"markdownDescription":"Налаштовує, як процеси налагодження зупиняються при завершенні сеансу. Може бути:\n\n- примусовим (за замовчуванням): примусово знищує дерево процесів. Надсилає SIGKILL на posix або `taskkill.exe /F` на Windows.\n- ввічливим: м’яко знищує дерево процесів. Можливо, що некоректно працюючі процеси продовжать виконуватись після завершення таким чином. Надсилає SIGTERM на posix або `taskkill.exe` без прапора `/F` (примус) на Windows.\n- жодного: жодного завершення не відбудеться.","type":"string"},"localRoot":{"default":null,"description":"Шлях до локального каталогу, що містить програму.","type":["string","null"]},"nodeVersionHint":{"default":12,"description":"Дозволяє вам явно вказати версію Node, яка працює, що може бути використано для вимкнення або ввімкнення певних поведінок у випадках, коли автоматичне визначення версії не працює.","minimum":8,"type":"number"},"outFiles":{"default":["${workspaceFolder}/**/*.(m|c|)js","!**/node_modules/**"],"description":"Якщо карти джерел увімкнені, ці шаблони glob вказують на згенеровані файли JavaScript. Якщо шаблон починається з `!`, файли виключаються. Якщо не вказано, згенерований код очікується в тому ж каталозі, що й його джерело.","items":{"type":"string"},"tags":["setup"],"type":["array"]},"outputCapture":{"default":"console","enum":["console","std"],"markdownDescription":"Звідки захоплювати вихідні повідомлення: за замовчуванням API налагодження, якщо встановлено `console`, або потоки stdout/stderr, якщо встановлено `std`."},"pauseForSourceMap":{"default":false,"markdownDescription":"Чи чекати на завантаження карт джерел для кожного вхідного скрипта. Це має накладні витрати на продуктивність і може бути безпечно вимкнено при виконанні з диска, якщо `rootPath` не вимкнено.","type":"boolean"},"profileStartup":{"default":true,"description":"Якщо це правда, почне профілювання, як тільки процес запуститься","type":"boolean"},"program":{"default":"","description":"Абсолютний шлях до програми. Згенероване значення визначається шляхом аналізу package.json та відкритих файлів. Відредагуйте цей атрибут.","tags":["setup"],"type":"string"},"remoteRoot":{"default":null,"description":"Абсолютний шлях до віддаленого каталогу, що містить програму.","type":["string","null"]},"resolveSourceMapLocations":{"default":["${workspaceFolder}/**","!**/node_modules/**"],"description":"Список патернів minimatch для місць (папок та URL), в яких карти джерел можуть бути використані для вирішення локальних файлів. Це можна використовувати, щоб уникнути неправильного розриву в зовнішньому коді з картами джерел. Патерни можуть бути префіксовані знаком \"!\", щоб виключити їх. Може бути встановлено на порожній масив або null, щоб уникнути обмежень.","items":{"type":"string"},"type":["array","null"]},"restart":{"default":true,"description":"Спробуйте перепідключитися до програми, якщо ми втратимо з'єднання. Якщо встановлено `true`, ми будемо намагатися раз на секунду, вічно. Ви можете налаштувати інтервал і максимальну кількість спроб, вказавши `delay` та `maxAttempts` в об'єкті замість цього.","oneOf":[{"type":"boolean"},{"properties":{"delay":{"default":1000,"minimum":0,"type":"number"},"maxAttempts":{"default":10,"minimum":0,"type":"number"}},"type":"object"}]},"runtimeArgs":{"default":[],"description":"Необов'язкові аргументи, передані виконуваному файлу часу виконання.","items":{"type":"string"},"tags":["setup"],"type":"array"},"runtimeExecutable":{"default":"node","markdownDescription":"Час виконання для використання. Або абсолютний шлях, або ім'я часу виконання, доступного в PATH. Якщо пропущено, вважається, що використовується `node`.","type":["string","null"]},"runtimeSourcemapPausePatterns":{"default":[],"items":{"type":"string"},"markdownDescription":"Список шаблонів, за якими можна вручну вставити точки зупинки вхідної точки. Це може бути корисно, щоб надати відладчику можливість встановити точки зупинки при використанні sourcemaps, які не існують або не можуть бути виявлені до запуску, наприклад, [з фреймворком Serverless](https://github.com/microsoft/vscode-js-debug/issues/492).","type":"array"},"runtimeVersion":{"default":"default","markdownDescription":"Версія середовища виконання `node`, яку слід використовувати. Потрібен `nvm`.","type":"string"},"showAsyncStacks":{"default":true,"description":"Показати асинхронні виклики, які призвели до поточного стеку викликів.","oneOf":[{"type":"boolean"},{"properties":{"onAttach":{"default":32,"type":"number"}},"required":["onAttach"],"type":"object"},{"properties":{"onceBreakpointResolved":{"default":32,"type":"number"}},"required":["onceBreakpointResolved"],"type":"object"}]},"skipFiles":{"default":["${/**"],"description":"Масив імен файлів або папок, або шаблонів шляхів, які слід пропустити під час налагодження. Дозволені зіркові шаблони та заперечення, наприклад, `[\"**/node_modules/**\", \"!**/node_modules/my-module/**\"]`","type":"array"},"smartStep":{"default":true,"description":"Автоматично проходьте через згенерований код, який не може бути відображений назад до оригінального джерела.","type":"boolean"},"sourceMapPathOverrides":{"default":{"meteor://💻app/*":"${workspaceFolder}/*","webpack:///./~/*":"${workspaceFolder}/node_modules/*","webpack://?:*/*":"${workspaceFolder}/*"},"description":"Набір відображень для переписування місць розташування вихідних файлів з того, що вказує sourcemap, на їхні місця на диску.","type":"object"},"sourceMapRenames":{"default":true,"description":"Чи використовувати відображення \"names\" у sourcemaps. Це вимагає запиту на отримання вихідного контенту, що може бути повільним з певними налагоджувачами.","type":"boolean"},"sourceMaps":{"default":true,"description":"Використовуйте карти джерел JavaScript (якщо вони існують).","type":"boolean"},"stopOnEntry":{"default":true,"description":"Автоматично зупинити програму після запуску.","type":["boolean","string"]},"timeout":{"default":10000,"description":"Спробуйте знову протягом цього числа мілісекунд для підключення до Node.js. За замовчуванням 10000 мс.","type":"number"},"timeouts":{"additionalProperties":false,"default":{},"description":"Тайм-аути для кількох операцій налагодження.","markdownDescription":"Таймаути для кількох операцій налагоджувача.","properties":{"hoverEvaluation":{"default":500,"description":"Час до оцінки значення для символів, на які наведено курсор, скасовується. Якщо встановлено 0, оцінка при наведенні ніколи не закінчується.","type":"number"},"sourceMapCumulativePause":{"default":1000,"description":"Додатковий час у мілісекундах, дозволений за сесію для очікування обробки source-map, після того як мінімальний час (sourceMapMinPause) буде вичерпано","type":"number"},"sourceMapMinPause":{"default":1000,"description":"Мінімальний час у мілісекундах, витрачений на очікування обробки кожної source-map під час парсингу скрипта","type":"number"}},"type":"object"},"trace":{"default":true,"description":"Налаштовує, який діагностичний вивід буде створено.","oneOf":[{"description":"Trace може бути встановлено на 'true', щоб записувати діагностичні журнали на диск.","type":"boolean"},{"additionalProperties":false,"properties":{"logFile":{"description":"Налаштовує, де на диску записуються журнали.","type":["string","null"]},"stdio":{"description":"Чи повертати дані трасування з запущеного додатку або браузера.","type":"boolean"}},"type":"object"}]}}}},"configurationSnippets":[{"body":{"name":"${1:Attach}","port":9229,"request":"attach","skipFiles":["<node_internals>/**"],"type":"node"},"description":"Приєднатися до запущеної програми вузла","label":"Node.js: Прикріпити"},{"body":{"address":"${2:TCP/IP address of process to be debugged}","localRoot":"^\"\\${workspaceFolder}\"","name":"${1:Attach to Remote}","port":9229,"remoteRoot":"${3:Absolute path to the remote directory containing the program}","request":"attach","skipFiles":["<node_internals>/**"],"type":"node"},"description":"Приєднайтеся до порту налагодження віддаленої програми вузла","label":"Node.js: Підключитися до віддаленої програми"},{"body":{"name":"${1:Attach by Process ID}","processId":"^\"\\${command:PickProcess}\"","request":"attach","skipFiles":["<node_internals>/**"],"type":"node"},"description":"Відкрийте вибір процесу, щоб вибрати процес вузла для підключення","label":"Node.js: Приєднатися до процесу"},{"body":{"name":"${2:Launch Program}","program":"^\"\\${workspaceFolder}/${1:app.js}\"","request":"launch","skipFiles":["<node_internals>/**"],"type":"node"},"description":"Запустіть програму вузла в режимі налагодження","label":"Node.js: Запустити програму"},{"body":{"name":"${1:Launch via NPM}","request":"launch","runtimeArgs":["run-script","debug"],"runtimeExecutable":"npm","skipFiles":["<node_internals>/**"],"type":"node"},"label":"Node.js: Запуск через npm","markdownDescription":"Запустіть програму вузла через скрипт `debug` npm"},{"body":{"console":"integratedTerminal","internalConsoleOptions":"neverOpen","name":"nodemon","program":"^\"\\${workspaceFolder}/${1:app.js}\"","request":"launch","restart":true,"runtimeExecutable":"nodemon","skipFiles":["<node_internals>/**"],"type":"node"},"description":"Використовуйте nodemon для перезапуску сеансу налагодження при змінах у вихідному коді","label":"Node.js: Налаштування Nodemon"},{"body":{"args":["-u","tdd","--timeout","999999","--colors","^\"\\${workspaceFolder}/${1:test}\""],"internalConsoleOptions":"openOnSessionStart","name":"Mocha Tests","program":"^\"mocha\"","request":"launch","skipFiles":["<node_internals>/**"],"type":"node"},"description":"Відлагодження тестів mocha","label":"Node.js: Тести Mocha"},{"body":{"args":["${1:generator}"],"console":"integratedTerminal","internalConsoleOptions":"neverOpen","name":"Yeoman ${1:generator}","program":"^\"\\${workspaceFolder}/node_modules/yo/lib/cli.js\"","request":"launch","skipFiles":["<node_internals>/**"],"type":"node"},"label":"Node.js: генератор Yeoman","markdownDescription":"Відлагодьте генератор yeoman (встановіть, запустивши `npm link` у папці проекту)"},{"body":{"args":["${1:task}"],"name":"Gulp ${1:task}","program":"^\"\\${workspaceFolder}/node_modules/gulp/bin/gulp.js\"","request":"launch","skipFiles":["<node_internals>/**"],"type":"node"},"description":"Налагодження задачі gulp (переконайтеся, що у вашому проєкті встановлено локальний gulp)","label":"Node.js: Завдання Gulp"},{"body":{"name":"Electron Main","program":"^\"\\${workspaceFolder}/main.js\"","request":"launch","runtimeExecutable":"^\"electron\"","skipFiles":["<node_internals>/**"],"type":"node"},"description":"Відлагоджуйте основний процес Electron","label":"Node.js: Головний процес Electron"}],"label":"Node.js","strings":{"unverifiedBreakpoints":"Деякі з ваших точок зупинки не можуть бути встановлені. Якщо у вас виникає проблема, ви можете [усунути неполадки у вашій конфігурації запуску](command:extension.js-debug.createDiagnostics)."},"type":"node","variables":{"PickProcess":"extension.js-debug.pickNodeProcess"}},{"aiKey":"0c6ae279ed8443289764825290e4f9e2-1a736e7c-1324-4338-be46-fc2a58ae4d14-7255","configurationAttributes":{"launch":{"properties":{"autoAttachChildProcesses":{"default":true,"description":"Автоматично підключати налагоджувач до нових дочірніх процесів.","type":"boolean"},"cascadeTerminateToConfigurations":{"default":[],"description":"Список сеансів налагодження, які, коли цей сеанс налагодження буде завершено, також будуть зупинені.","items":{"type":"string","uniqueItems":true},"type":"array"},"command":{"default":"npm start","description":"Команда для виконання в запущеному терміналі. Якщо не вказано, термінал відкриється без запуску програми.","tags":["setup"],"type":["string","null"]},"customDescriptionGenerator":{"description":"Налаштуйте текстовий опис, який відображає відладчик для об'єктів (локальних змінних тощо...). Приклади:\n      1. this.toString() // викликає toString для виведення всіх об'єктів\n      2. this.customDescription ? this.customDescription() : defaultValue // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть defaultValue\n      3. function (def) { return this.customDescription ? this.customDescription() : def } // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть defaultValue\n      ","type":"string"},"customPropertiesGenerator":{"deprecated":true,"description":"Налаштуйте властивості, які відображаються для об'єкта в налагоджувачі (локальні змінні тощо...). Приклади:\n    1. { ...this, extraProperty: '12345' } // Додати extraProperty 12345 до всіх об'єктів\n    2. this.customProperties ? this.customProperties() : this // Використовуйте метод customProperties, якщо він доступний, якщо ні - використовуйте властивості в this (за замовчуванням)\n    3. function () { return this.customProperties ? this.customProperties() : this } // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть властивості за замовчуванням\n\n    Застаріло: Це тимчасова реалізація цієї функції, поки ми не матимемо часу реалізувати її в спосіб, описаний тут: https://github.com/microsoft/vscode/issues/102181","type":"string"},"cwd":{"default":"${workspaceFolder}","description":"Абсолютний шлях до робочого каталогу програми, що налагоджується. Якщо ви встановили localRoot, тоді cwd відповідатиме цьому значенню, інакше він повернеться до вашого workspaceFolder.","tags":["setup"],"type":"string"},"enableContentValidation":{"default":true,"description":"Перемикає, чи перевіряємо ми, що вміст файлів на диску відповідає завантаженим у час виконання. Це корисно в різних сценаріях і є обов'язковим у деяких, але може викликати проблеми, якщо у вас є серверна трансформація скриптів, наприклад.","type":"boolean"},"enableDWARF":{"default":true,"markdownDescription":"Перемикає, чи буде відладчик намагатися зчитувати символи налагодження DWARF з WebAssembly, що може вимагати багато ресурсів. Для роботи потрібен розширення `ms-vscode.wasm-dwarf-debugging`.","type":"boolean"},"env":{"additionalProperties":{"type":["string","null"]},"default":{},"markdownDescription":"Змінні середовища, передані програмі. Значення `null` видаляє змінну з середовища.","tags":["setup"],"type":"object"},"envFile":{"default":"${workspaceFolder}/.env","description":"Абсолютний шлях до файлу, що містить визначення змінних середовища.","type":"string"},"localRoot":{"default":null,"description":"Шлях до локального каталогу, що містить програму.","type":["string","null"]},"nodeVersionHint":{"default":12,"description":"Дозволяє вам явно вказати версію Node, яка працює, що може бути використано для вимкнення або ввімкнення певних поведінок у випадках, коли автоматичне визначення версії не працює.","minimum":8,"type":"number"},"outFiles":{"default":["${workspaceFolder}/**/*.(m|c|)js","!**/node_modules/**"],"description":"Якщо карти джерел увімкнені, ці шаблони glob вказують на згенеровані файли JavaScript. Якщо шаблон починається з `!`, файли виключаються. Якщо не вказано, згенерований код очікується в тому ж каталозі, що й його джерело.","items":{"type":"string"},"tags":["setup"],"type":["array"]},"outputCapture":{"default":"console","enum":["console","std"],"markdownDescription":"Звідки захоплювати вихідні повідомлення: за замовчуванням API налагодження, якщо встановлено `console`, або потоки stdout/stderr, якщо встановлено `std`."},"pauseForSourceMap":{"default":false,"markdownDescription":"Чи чекати на завантаження карт джерел для кожного вхідного скрипта. Це має накладні витрати на продуктивність і може бути безпечно вимкнено при виконанні з диска, якщо `rootPath` не вимкнено.","type":"boolean"},"remoteRoot":{"default":null,"description":"Абсолютний шлях до віддаленого каталогу, що містить програму.","type":["string","null"]},"resolveSourceMapLocations":{"default":["${workspaceFolder}/**","!**/node_modules/**"],"description":"Список патернів minimatch для місць (папок та URL), в яких карти джерел можуть бути використані для вирішення локальних файлів. Це можна використовувати, щоб уникнути неправильного розриву в зовнішньому коді з картами джерел. Патерни можуть бути префіксовані знаком \"!\", щоб виключити їх. Може бути встановлено на порожній масив або null, щоб уникнути обмежень.","items":{"type":"string"},"type":["array","null"]},"runtimeSourcemapPausePatterns":{"default":[],"items":{"type":"string"},"markdownDescription":"Список шаблонів, за якими можна вручну вставити точки зупинки вхідної точки. Це може бути корисно, щоб надати відладчику можливість встановити точки зупинки при використанні sourcemaps, які не існують або не можуть бути виявлені до запуску, наприклад, [з фреймворком Serverless](https://github.com/microsoft/vscode-js-debug/issues/492).","type":"array"},"showAsyncStacks":{"default":true,"description":"Показати асинхронні виклики, які призвели до поточного стеку викликів.","oneOf":[{"type":"boolean"},{"properties":{"onAttach":{"default":32,"type":"number"}},"required":["onAttach"],"type":"object"},{"properties":{"onceBreakpointResolved":{"default":32,"type":"number"}},"required":["onceBreakpointResolved"],"type":"object"}]},"skipFiles":{"default":["${/**"],"description":"Масив імен файлів або папок, або шаблонів шляхів, які слід пропустити під час налагодження. Дозволені зіркові шаблони та заперечення, наприклад, `[\"**/node_modules/**\", \"!**/node_modules/my-module/**\"]`","type":"array"},"smartStep":{"default":true,"description":"Автоматично проходьте через згенерований код, який не може бути відображений назад до оригінального джерела.","type":"boolean"},"sourceMapPathOverrides":{"default":{"meteor://💻app/*":"${workspaceFolder}/*","webpack:///./~/*":"${workspaceFolder}/node_modules/*","webpack://?:*/*":"${workspaceFolder}/*"},"description":"Набір відображень для переписування місць розташування вихідних файлів з того, що вказує sourcemap, на їхні місця на диску.","type":"object"},"sourceMapRenames":{"default":true,"description":"Чи використовувати відображення \"names\" у sourcemaps. Це вимагає запиту на отримання вихідного контенту, що може бути повільним з певними налагоджувачами.","type":"boolean"},"sourceMaps":{"default":true,"description":"Використовуйте карти джерел JavaScript (якщо вони існують).","type":"boolean"},"timeout":{"default":10000,"description":"Спробуйте знову протягом цього числа мілісекунд для підключення до Node.js. За замовчуванням 10000 мс.","type":"number"},"timeouts":{"additionalProperties":false,"default":{},"description":"Тайм-аути для кількох операцій налагодження.","markdownDescription":"Таймаути для кількох операцій налагоджувача.","properties":{"hoverEvaluation":{"default":500,"description":"Час до оцінки значення для символів, на які наведено курсор, скасовується. Якщо встановлено 0, оцінка при наведенні ніколи не закінчується.","type":"number"},"sourceMapCumulativePause":{"default":1000,"description":"Додатковий час у мілісекундах, дозволений за сесію для очікування обробки source-map, після того як мінімальний час (sourceMapMinPause) буде вичерпано","type":"number"},"sourceMapMinPause":{"default":1000,"description":"Мінімальний час у мілісекундах, витрачений на очікування обробки кожної source-map під час парсингу скрипта","type":"number"}},"type":"object"},"trace":{"default":true,"description":"Налаштовує, який діагностичний вивід буде створено.","oneOf":[{"description":"Trace може бути встановлено на 'true', щоб записувати діагностичні журнали на диск.","type":"boolean"},{"additionalProperties":false,"properties":{"logFile":{"description":"Налаштовує, де на диску записуються журнали.","type":["string","null"]},"stdio":{"description":"Чи повертати дані трасування з запущеного додатку або браузера.","type":"boolean"}},"type":"object"}]}}}},"configurationSnippets":[{"body":{"command":"npm start","name":"Run npm start","request":"launch","type":"node-terminal"},"description":"Запустіть \"npm start\" у терміналі налагодження","label":"Запустіть \"npm start\" у терміналі налагодження"}],"label":"Термінал налагодження JavaScript","languages":[],"strings":{"unverifiedBreakpoints":"Деякі з ваших точок зупинки не можуть бути встановлені. Якщо у вас виникає проблема, ви можете [усунути неполадки у вашій конфігурації запуску](command:extension.js-debug.createDiagnostics)."},"type":"node-terminal"},{"aiKey":"0c6ae279ed8443289764825290e4f9e2-1a736e7c-1324-4338-be46-fc2a58ae4d14-7255","configurationAttributes":{"launch":{"properties":{"args":{"default":["--extensionDevelopmentPath=${workspaceFolder}"],"description":"Аргументи командного рядка, передані програмі.\n\nМожуть бути масивом рядків або єдиним рядком. Коли програма запускається в терміналі, встановлення цієї властивості в єдиний рядок призведе до того, що аргументи не будуть екрановані для оболонки.","items":{"type":"string"},"tags":["setup"],"type":"array"},"autoAttachChildProcesses":{"default":true,"description":"Автоматично підключати налагоджувач до нових дочірніх процесів.","type":"boolean"},"cascadeTerminateToConfigurations":{"default":[],"description":"Список сеансів налагодження, які, коли цей сеанс налагодження буде завершено, також будуть зупинені.","items":{"type":"string","uniqueItems":true},"type":"array"},"customDescriptionGenerator":{"description":"Налаштуйте текстовий опис, який відображає відладчик для об'єктів (локальних змінних тощо...). Приклади:\n      1. this.toString() // викликає toString для виведення всіх об'єктів\n      2. this.customDescription ? this.customDescription() : defaultValue // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть defaultValue\n      3. function (def) { return this.customDescription ? this.customDescription() : def } // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть defaultValue\n      ","type":"string"},"customPropertiesGenerator":{"deprecated":true,"description":"Налаштуйте властивості, які відображаються для об'єкта в налагоджувачі (локальні змінні тощо...). Приклади:\n    1. { ...this, extraProperty: '12345' } // Додати extraProperty 12345 до всіх об'єктів\n    2. this.customProperties ? this.customProperties() : this // Використовуйте метод customProperties, якщо він доступний, якщо ні - використовуйте властивості в this (за замовчуванням)\n    3. function () { return this.customProperties ? this.customProperties() : this } // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть властивості за замовчуванням\n\n    Застаріло: Це тимчасова реалізація цієї функції, поки ми не матимемо часу реалізувати її в спосіб, описаний тут: https://github.com/microsoft/vscode/issues/102181","type":"string"},"cwd":{"default":"${workspaceFolder}","description":"Абсолютний шлях до робочого каталогу програми, що налагоджується. Якщо ви встановили localRoot, тоді cwd відповідатиме цьому значенню, інакше він повернеться до вашого workspaceFolder.","tags":["setup"],"type":"string"},"debugWebWorkerHost":{"default":true,"markdownDescription":"Налаштовує, чи слід намагатися підключитися до хоста розширення веб-робітника.","type":["boolean"]},"debugWebviews":{"default":true,"markdownDescription":"Налаштовує, чи слід намагатися підключитися до веб-переглядів у запущеному екземплярі VS Code. Це буде працювати лише в настільному VS Code.","type":["boolean"]},"enableContentValidation":{"default":true,"description":"Перемикає, чи перевіряємо ми, що вміст файлів на диску відповідає завантаженим у час виконання. Це корисно в різних сценаріях і є обов'язковим у деяких, але може викликати проблеми, якщо у вас є серверна трансформація скриптів, наприклад.","type":"boolean"},"enableDWARF":{"default":true,"markdownDescription":"Перемикає, чи буде відладчик намагатися зчитувати символи налагодження DWARF з WebAssembly, що може вимагати багато ресурсів. Для роботи потрібен розширення `ms-vscode.wasm-dwarf-debugging`.","type":"boolean"},"env":{"additionalProperties":{"type":["string","null"]},"default":{},"markdownDescription":"Змінні середовища, передані програмі. Значення `null` видаляє змінну з середовища.","tags":["setup"],"type":"object"},"envFile":{"default":"${workspaceFolder}/.env","description":"Абсолютний шлях до файлу, що містить визначення змінних середовища.","type":"string"},"localRoot":{"default":null,"description":"Шлях до локального каталогу, що містить програму.","type":["string","null"]},"nodeVersionHint":{"default":12,"description":"Дозволяє вам явно вказати версію Node, яка працює, що може бути використано для вимкнення або ввімкнення певних поведінок у випадках, коли автоматичне визначення версії не працює.","minimum":8,"type":"number"},"outFiles":{"default":["${workspaceFolder}/**/*.(m|c|)js","!**/node_modules/**"],"description":"Якщо карти джерел увімкнені, ці шаблони glob вказують на згенеровані файли JavaScript. Якщо шаблон починається з `!`, файли виключаються. Якщо не вказано, згенерований код очікується в тому ж каталозі, що й його джерело.","items":{"type":"string"},"tags":["setup"],"type":["array"]},"outputCapture":{"default":"console","enum":["console","std"],"markdownDescription":"Звідки захоплювати вихідні повідомлення: за замовчуванням API налагодження, якщо встановлено `console`, або потоки stdout/stderr, якщо встановлено `std`."},"pauseForSourceMap":{"default":false,"markdownDescription":"Чи чекати на завантаження карт джерел для кожного вхідного скрипта. Це має накладні витрати на продуктивність і може бути безпечно вимкнено при виконанні з диска, якщо `rootPath` не вимкнено.","type":"boolean"},"remoteRoot":{"default":null,"description":"Абсолютний шлях до віддаленого каталогу, що містить програму.","type":["string","null"]},"rendererDebugOptions":{"default":{"webRoot":"${workspaceFolder}"},"markdownDescription":"Опції запуску Chrome, що використовуються при підключенні до процесу рендерингу, з `debugWebviews` або `debugWebWorkerHost`.","properties":{"address":{"default":"localhost","description":"IP-адреса або ім'я хоста, на якому слухає налагоджений браузер.","type":"string"},"browserAttachLocation":{"default":null,"description":"Примушує браузер підключатися в одному місці. У віддаленому робочому просторі (через ssh або WSL, наприклад) це можна використовувати для підключення до браузера на віддаленій машині, а не локально.","oneOf":[{"type":"null"},{"enum":["ui","workspace"],"type":"string"}]},"cascadeTerminateToConfigurations":{"default":[],"description":"Список сеансів налагодження, які, коли цей сеанс налагодження буде завершено, також будуть зупинені.","items":{"type":"string","uniqueItems":true},"type":"array"},"customDescriptionGenerator":{"description":"Налаштуйте текстовий опис, який відображає відладчик для об'єктів (локальних змінних тощо...). Приклади:\n      1. this.toString() // викликає toString для виведення всіх об'єктів\n      2. this.customDescription ? this.customDescription() : defaultValue // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть defaultValue\n      3. function (def) { return this.customDescription ? this.customDescription() : def } // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть defaultValue\n      ","type":"string"},"customPropertiesGenerator":{"deprecated":true,"description":"Налаштуйте властивості, які відображаються для об'єкта в налагоджувачі (локальні змінні тощо...). Приклади:\n    1. { ...this, extraProperty: '12345' } // Додати extraProperty 12345 до всіх об'єктів\n    2. this.customProperties ? this.customProperties() : this // Використовуйте метод customProperties, якщо він доступний, якщо ні - використовуйте властивості в this (за замовчуванням)\n    3. function () { return this.customProperties ? this.customProperties() : this } // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть властивості за замовчуванням\n\n    Застаріло: Це тимчасова реалізація цієї функції, поки ми не матимемо часу реалізувати її в спосіб, описаний тут: https://github.com/microsoft/vscode/issues/102181","type":"string"},"disableNetworkCache":{"default":true,"description":"Контролює, чи пропускати мережевий кеш для кожного запиту","type":"boolean"},"enableContentValidation":{"default":true,"description":"Перемикає, чи перевіряємо ми, що вміст файлів на диску відповідає завантаженим у час виконання. Це корисно в різних сценаріях і є обов'язковим у деяких, але може викликати проблеми, якщо у вас є серверна трансформація скриптів, наприклад.","type":"boolean"},"enableDWARF":{"default":true,"markdownDescription":"Перемикає, чи буде відладчик намагатися зчитувати символи налагодження DWARF з WebAssembly, що може вимагати багато ресурсів. Для роботи потрібен розширення `ms-vscode.wasm-dwarf-debugging`.","type":"boolean"},"inspectUri":{"default":null,"description":"Формат, який потрібно використовувати для переписування inspectUri: Це шаблонний рядок, який інтерполює ключі в `{curlyBraces}`. Доступні ключі:\n - `url.*` - це розпарсена адреса запущеного застосунку. Наприклад, `{url.port}`, `{url.hostname}`\n - `port` - це порт налагодження, на якому слухає Chrome.\n - `browserInspectUri` - це URI інспектора на запущеному браузері.\n - `browserInspectUriPath` - це частина шляху URI інспектора на запущеному браузері (наприклад: \"/devtools/browser/e9ec0098-306e-472a-8133-5e42488929c2\").\n - `wsProtocol` - це вказаний протокол вебсокетів. Це встановлюється на `wss`, якщо оригінальна URL-адреса є `https`, або `ws` в іншому випадку.","type":["string","null"]},"outFiles":{"default":["${workspaceFolder}/**/*.(m|c|)js","!**/node_modules/**"],"description":"Якщо карти джерел увімкнені, ці шаблони glob вказують на згенеровані файли JavaScript. Якщо шаблон починається з `!`, файли виключаються. Якщо не вказано, згенерований код очікується в тому ж каталозі, що й його джерело.","items":{"type":"string"},"tags":["setup"],"type":["array"]},"outputCapture":{"default":"console","enum":["console","std"],"markdownDescription":"Звідки захоплювати вихідні повідомлення: за замовчуванням API налагодження, якщо встановлено `console`, або потоки stdout/stderr, якщо встановлено `std`."},"pathMapping":{"default":{},"description":"Відображення URL/шляхів на локальні папки, щоб вирішити скрипти в браузері на скрипти на диску","type":"object"},"pauseForSourceMap":{"default":false,"markdownDescription":"Чи чекати на завантаження карт джерел для кожного вхідного скрипта. Це має накладні витрати на продуктивність і може бути безпечно вимкнено при виконанні з диска, якщо `rootPath` не вимкнено.","type":"boolean"},"perScriptSourcemaps":{"default":"auto","description":"Чи завантажуються скрипти окремо з унікальними sourcemaps, що містять базову назву вихідного файлу. Це можна налаштувати для оптимізації обробки sourcemap при роботі з великою кількістю малих скриптів. Якщо встановлено \"auto\", ми виявимо відомі випадки, коли це доречно.","enum":["yes","no","auto"],"type":"string"},"port":{"default":9229,"description":"Порт, який використовувати для віддаленого налагодження браузера, вказується як `--remote-debugging-port` під час запуску браузера.","oneOf":[{"type":"integer"},{"pattern":"^\\${.*}$","type":"string"}],"tags":["setup"]},"resolveSourceMapLocations":{"default":null,"description":"Список патернів minimatch для місць (папок та URL), в яких карти джерел можуть бути використані для вирішення локальних файлів. Це можна використовувати, щоб уникнути неправильного розриву в зовнішньому коді з картами джерел. Патерни можуть бути префіксовані знаком \"!\", щоб виключити їх. Може бути встановлено на порожній масив або null, щоб уникнути обмежень.","items":{"type":"string"},"type":["array","null"]},"restart":{"default":false,"markdownDescription":"Чи підключитися знову, якщо з'єднання браузера закрито","type":"boolean"},"server":{"oneOf":[{"additionalProperties":false,"default":{"program":"node my-server.js"},"description":"Налаштовує веб-сервер для запуску. Використовує таку ж конфігурацію, як і завдання запуску 'node'.","properties":{"args":{"default":[],"description":"Аргументи командного рядка, передані програмі.\n\nМожуть бути масивом рядків або єдиним рядком. Коли програма запускається в терміналі, встановлення цієї властивості в єдиний рядок призведе до того, що аргументи не будуть екрановані для оболонки.","items":{"type":"string"},"tags":["setup"],"type":["array","string"]},"attachSimplePort":{"default":9229,"description":"Якщо встановлено, приєднується до процесу через вказаний порт. Це зазвичай більше не є необхідним для програм Node.js і втрачає можливість налагодження дочірніх процесів, але може бути корисним у більш екзотичних сценаріях, таких як запуск з Deno та Docker. Якщо встановлено на 0, буде вибрано випадковий порт, і --inspect-brk буде автоматично додано до аргументів запуску.","oneOf":[{"type":"integer"},{"pattern":"^\\${.*}$","type":"string"}]},"autoAttachChildProcesses":{"default":true,"description":"Автоматично підключати налагоджувач до нових дочірніх процесів.","type":"boolean"},"cascadeTerminateToConfigurations":{"default":[],"description":"Список сеансів налагодження, які, коли цей сеанс налагодження буде завершено, також будуть зупинені.","items":{"type":"string","uniqueItems":true},"type":"array"},"console":{"default":"internalConsole","description":"Де запустити ціль налагодження.","enum":["internalConsole","integratedTerminal","externalTerminal"],"enumDescriptions":["Консоль налагодження VS Code (яка не підтримує читання введення з програми)","інтегрований термінал VS Code","Зовнішній термінал, який можна налаштувати через налаштування користувача"],"type":"string"},"customDescriptionGenerator":{"description":"Налаштуйте текстовий опис, який відображає відладчик для об'єктів (локальних змінних тощо...). Приклади:\n      1. this.toString() // викликає toString для виведення всіх об'єктів\n      2. this.customDescription ? this.customDescription() : defaultValue // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть defaultValue\n      3. function (def) { return this.customDescription ? this.customDescription() : def } // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть defaultValue\n      ","type":"string"},"customPropertiesGenerator":{"deprecated":true,"description":"Налаштуйте властивості, які відображаються для об'єкта в налагоджувачі (локальні змінні тощо...). Приклади:\n    1. { ...this, extraProperty: '12345' } // Додати extraProperty 12345 до всіх об'єктів\n    2. this.customProperties ? this.customProperties() : this // Використовуйте метод customProperties, якщо він доступний, якщо ні - використовуйте властивості в this (за замовчуванням)\n    3. function () { return this.customProperties ? this.customProperties() : this } // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть властивості за замовчуванням\n\n    Застаріло: Це тимчасова реалізація цієї функції, поки ми не матимемо часу реалізувати її в спосіб, описаний тут: https://github.com/microsoft/vscode/issues/102181","type":"string"},"cwd":{"default":"${workspaceFolder}","description":"Абсолютний шлях до робочого каталогу програми, що налагоджується. Якщо ви встановили localRoot, тоді cwd відповідатиме цьому значенню, інакше він повернеться до вашого workspaceFolder.","tags":["setup"],"type":"string"},"enableContentValidation":{"default":true,"description":"Перемикає, чи перевіряємо ми, що вміст файлів на диску відповідає завантаженим у час виконання. Це корисно в різних сценаріях і є обов'язковим у деяких, але може викликати проблеми, якщо у вас є серверна трансформація скриптів, наприклад.","type":"boolean"},"enableDWARF":{"default":true,"markdownDescription":"Перемикає, чи буде відладчик намагатися зчитувати символи налагодження DWARF з WebAssembly, що може вимагати багато ресурсів. Для роботи потрібен розширення `ms-vscode.wasm-dwarf-debugging`.","type":"boolean"},"env":{"additionalProperties":{"type":["string","null"]},"default":{},"markdownDescription":"Змінні середовища, передані програмі. Значення `null` видаляє змінну з середовища.","tags":["setup"],"type":"object"},"envFile":{"default":"${workspaceFolder}/.env","description":"Абсолютний шлях до файлу, що містить визначення змінних середовища.","type":"string"},"experimentalNetworking":{"default":"auto","description":"Увімкніть експериментальну перевірку в Node.js. Коли встановлено `auto`, це увімкнено для версій Node.js, які це підтримують. Його можна встановити на `on` або `off`, щоб увімкнути або вимкнути його явно.","enum":["auto","on","off"],"type":"string"},"killBehavior":{"default":"forceful","enum":["forceful","polite","none"],"markdownDescription":"Налаштовує, як процеси налагодження зупиняються при завершенні сеансу. Може бути:\n\n- примусовим (за замовчуванням): примусово знищує дерево процесів. Надсилає SIGKILL на posix або `taskkill.exe /F` на Windows.\n- ввічливим: м’яко знищує дерево процесів. Можливо, що некоректно працюючі процеси продовжать виконуватись після завершення таким чином. Надсилає SIGTERM на posix або `taskkill.exe` без прапора `/F` (примус) на Windows.\n- жодного: жодного завершення не відбудеться.","type":"string"},"localRoot":{"default":null,"description":"Шлях до локального каталогу, що містить програму.","type":["string","null"]},"nodeVersionHint":{"default":12,"description":"Дозволяє вам явно вказати версію Node, яка працює, що може бути використано для вимкнення або ввімкнення певних поведінок у випадках, коли автоматичне визначення версії не працює.","minimum":8,"type":"number"},"outFiles":{"default":["${workspaceFolder}/**/*.(m|c|)js","!**/node_modules/**"],"description":"Якщо карти джерел увімкнені, ці шаблони glob вказують на згенеровані файли JavaScript. Якщо шаблон починається з `!`, файли виключаються. Якщо не вказано, згенерований код очікується в тому ж каталозі, що й його джерело.","items":{"type":"string"},"tags":["setup"],"type":["array"]},"outputCapture":{"default":"console","enum":["console","std"],"markdownDescription":"Звідки захоплювати вихідні повідомлення: за замовчуванням API налагодження, якщо встановлено `console`, або потоки stdout/stderr, якщо встановлено `std`."},"pauseForSourceMap":{"default":false,"markdownDescription":"Чи чекати на завантаження карт джерел для кожного вхідного скрипта. Це має накладні витрати на продуктивність і може бути безпечно вимкнено при виконанні з диска, якщо `rootPath` не вимкнено.","type":"boolean"},"profileStartup":{"default":true,"description":"Якщо це правда, почне профілювання, як тільки процес запуститься","type":"boolean"},"program":{"default":"","description":"Абсолютний шлях до програми. Згенероване значення визначається шляхом аналізу package.json та відкритих файлів. Відредагуйте цей атрибут.","tags":["setup"],"type":"string"},"remoteRoot":{"default":null,"description":"Абсолютний шлях до віддаленого каталогу, що містить програму.","type":["string","null"]},"resolveSourceMapLocations":{"default":["${workspaceFolder}/**","!**/node_modules/**"],"description":"Список патернів minimatch для місць (папок та URL), в яких карти джерел можуть бути використані для вирішення локальних файлів. Це можна використовувати, щоб уникнути неправильного розриву в зовнішньому коді з картами джерел. Патерни можуть бути префіксовані знаком \"!\", щоб виключити їх. Може бути встановлено на порожній масив або null, щоб уникнути обмежень.","items":{"type":"string"},"type":["array","null"]},"restart":{"default":true,"description":"Спробуйте перепідключитися до програми, якщо ми втратимо з'єднання. Якщо встановлено `true`, ми будемо намагатися раз на секунду, вічно. Ви можете налаштувати інтервал і максимальну кількість спроб, вказавши `delay` та `maxAttempts` в об'єкті замість цього.","oneOf":[{"type":"boolean"},{"properties":{"delay":{"default":1000,"minimum":0,"type":"number"},"maxAttempts":{"default":10,"minimum":0,"type":"number"}},"type":"object"}]},"runtimeArgs":{"default":[],"description":"Необов'язкові аргументи, передані виконуваному файлу часу виконання.","items":{"type":"string"},"tags":["setup"],"type":"array"},"runtimeExecutable":{"default":"node","markdownDescription":"Час виконання для використання. Або абсолютний шлях, або ім'я часу виконання, доступного в PATH. Якщо пропущено, вважається, що використовується `node`.","type":["string","null"]},"runtimeSourcemapPausePatterns":{"default":[],"items":{"type":"string"},"markdownDescription":"Список шаблонів, за якими можна вручну вставити точки зупинки вхідної точки. Це може бути корисно, щоб надати відладчику можливість встановити точки зупинки при використанні sourcemaps, які не існують або не можуть бути виявлені до запуску, наприклад, [з фреймворком Serverless](https://github.com/microsoft/vscode-js-debug/issues/492).","type":"array"},"runtimeVersion":{"default":"default","markdownDescription":"Версія середовища виконання `node`, яку слід використовувати. Потрібен `nvm`.","type":"string"},"showAsyncStacks":{"default":true,"description":"Показати асинхронні виклики, які призвели до поточного стеку викликів.","oneOf":[{"type":"boolean"},{"properties":{"onAttach":{"default":32,"type":"number"}},"required":["onAttach"],"type":"object"},{"properties":{"onceBreakpointResolved":{"default":32,"type":"number"}},"required":["onceBreakpointResolved"],"type":"object"}]},"skipFiles":{"default":["${/**"],"description":"Масив імен файлів або папок, або шаблонів шляхів, які слід пропустити під час налагодження. Дозволені зіркові шаблони та заперечення, наприклад, `[\"**/node_modules/**\", \"!**/node_modules/my-module/**\"]`","type":"array"},"smartStep":{"default":true,"description":"Автоматично проходьте через згенерований код, який не може бути відображений назад до оригінального джерела.","type":"boolean"},"sourceMapPathOverrides":{"default":{"meteor://💻app/*":"${workspaceFolder}/*","webpack:///./~/*":"${workspaceFolder}/node_modules/*","webpack://?:*/*":"${workspaceFolder}/*"},"description":"Набір відображень для переписування місць розташування вихідних файлів з того, що вказує sourcemap, на їхні місця на диску.","type":"object"},"sourceMapRenames":{"default":true,"description":"Чи використовувати відображення \"names\" у sourcemaps. Це вимагає запиту на отримання вихідного контенту, що може бути повільним з певними налагоджувачами.","type":"boolean"},"sourceMaps":{"default":true,"description":"Використовуйте карти джерел JavaScript (якщо вони існують).","type":"boolean"},"stopOnEntry":{"default":true,"description":"Автоматично зупинити програму після запуску.","type":["boolean","string"]},"timeout":{"default":10000,"description":"Спробуйте знову протягом цього числа мілісекунд для підключення до Node.js. За замовчуванням 10000 мс.","type":"number"},"timeouts":{"additionalProperties":false,"default":{},"description":"Тайм-аути для кількох операцій налагодження.","markdownDescription":"Таймаути для кількох операцій налагоджувача.","properties":{"hoverEvaluation":{"default":500,"description":"Час до оцінки значення для символів, на які наведено курсор, скасовується. Якщо встановлено 0, оцінка при наведенні ніколи не закінчується.","type":"number"},"sourceMapCumulativePause":{"default":1000,"description":"Додатковий час у мілісекундах, дозволений за сесію для очікування обробки source-map, після того як мінімальний час (sourceMapMinPause) буде вичерпано","type":"number"},"sourceMapMinPause":{"default":1000,"description":"Мінімальний час у мілісекундах, витрачений на очікування обробки кожної source-map під час парсингу скрипта","type":"number"}},"type":"object"},"trace":{"default":true,"description":"Налаштовує, який діагностичний вивід буде створено.","oneOf":[{"description":"Trace може бути встановлено на 'true', щоб записувати діагностичні журнали на диск.","type":"boolean"},{"additionalProperties":false,"properties":{"logFile":{"description":"Налаштовує, де на диску записуються журнали.","type":["string","null"]},"stdio":{"description":"Чи повертати дані трасування з запущеного додатку або браузера.","type":"boolean"}},"type":"object"}]}},"type":"object"},{"additionalProperties":false,"default":{"program":"npm start"},"description":"Термінал налагодження JavaScript","properties":{"autoAttachChildProcesses":{"default":true,"description":"Автоматично підключати налагоджувач до нових дочірніх процесів.","type":"boolean"},"cascadeTerminateToConfigurations":{"default":[],"description":"Список сеансів налагодження, які, коли цей сеанс налагодження буде завершено, також будуть зупинені.","items":{"type":"string","uniqueItems":true},"type":"array"},"command":{"default":"npm start","description":"Команда для виконання в запущеному терміналі. Якщо не вказано, термінал відкриється без запуску програми.","tags":["setup"],"type":["string","null"]},"customDescriptionGenerator":{"description":"Налаштуйте текстовий опис, який відображає відладчик для об'єктів (локальних змінних тощо...). Приклади:\n      1. this.toString() // викликає toString для виведення всіх об'єктів\n      2. this.customDescription ? this.customDescription() : defaultValue // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть defaultValue\n      3. function (def) { return this.customDescription ? this.customDescription() : def } // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть defaultValue\n      ","type":"string"},"customPropertiesGenerator":{"deprecated":true,"description":"Налаштуйте властивості, які відображаються для об'єкта в налагоджувачі (локальні змінні тощо...). Приклади:\n    1. { ...this, extraProperty: '12345' } // Додати extraProperty 12345 до всіх об'єктів\n    2. this.customProperties ? this.customProperties() : this // Використовуйте метод customProperties, якщо він доступний, якщо ні - використовуйте властивості в this (за замовчуванням)\n    3. function () { return this.customProperties ? this.customProperties() : this } // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть властивості за замовчуванням\n\n    Застаріло: Це тимчасова реалізація цієї функції, поки ми не матимемо часу реалізувати її в спосіб, описаний тут: https://github.com/microsoft/vscode/issues/102181","type":"string"},"cwd":{"default":"${workspaceFolder}","description":"Абсолютний шлях до робочого каталогу програми, що налагоджується. Якщо ви встановили localRoot, тоді cwd відповідатиме цьому значенню, інакше він повернеться до вашого workspaceFolder.","docDefault":"localRoot || ${workspaceFolder}","tags":["setup"],"type":"string"},"enableContentValidation":{"default":true,"description":"Перемикає, чи перевіряємо ми, що вміст файлів на диску відповідає завантаженим у час виконання. Це корисно в різних сценаріях і є обов'язковим у деяких, але може викликати проблеми, якщо у вас є серверна трансформація скриптів, наприклад.","type":"boolean"},"enableDWARF":{"default":true,"markdownDescription":"Перемикає, чи буде відладчик намагатися зчитувати символи налагодження DWARF з WebAssembly, що може вимагати багато ресурсів. Для роботи потрібен розширення `ms-vscode.wasm-dwarf-debugging`.","type":"boolean"},"env":{"additionalProperties":{"type":["string","null"]},"default":{},"markdownDescription":"Змінні середовища, передані програмі. Значення `null` видаляє змінну з середовища.","tags":["setup"],"type":"object"},"envFile":{"default":"${workspaceFolder}/.env","description":"Абсолютний шлях до файлу, що містить визначення змінних середовища.","type":"string"},"localRoot":{"default":null,"description":"Шлях до локального каталогу, що містить програму.","type":["string","null"]},"nodeVersionHint":{"default":12,"description":"Дозволяє вам явно вказати версію Node, яка працює, що може бути використано для вимкнення або ввімкнення певних поведінок у випадках, коли автоматичне визначення версії не працює.","minimum":8,"type":"number"},"outFiles":{"default":["${workspaceFolder}/**/*.(m|c|)js","!**/node_modules/**"],"description":"Якщо карти джерел увімкнені, ці шаблони glob вказують на згенеровані файли JavaScript. Якщо шаблон починається з `!`, файли виключаються. Якщо не вказано, згенерований код очікується в тому ж каталозі, що й його джерело.","items":{"type":"string"},"tags":["setup"],"type":["array"]},"outputCapture":{"default":"console","enum":["console","std"],"markdownDescription":"Звідки захоплювати вихідні повідомлення: за замовчуванням API налагодження, якщо встановлено `console`, або потоки stdout/stderr, якщо встановлено `std`."},"pauseForSourceMap":{"default":false,"markdownDescription":"Чи чекати на завантаження карт джерел для кожного вхідного скрипта. Це має накладні витрати на продуктивність і може бути безпечно вимкнено при виконанні з диска, якщо `rootPath` не вимкнено.","type":"boolean"},"remoteRoot":{"default":null,"description":"Абсолютний шлях до віддаленого каталогу, що містить програму.","type":["string","null"]},"resolveSourceMapLocations":{"default":["${workspaceFolder}/**","!**/node_modules/**"],"description":"Список патернів minimatch для місць (папок та URL), в яких карти джерел можуть бути використані для вирішення локальних файлів. Це можна використовувати, щоб уникнути неправильного розриву в зовнішньому коді з картами джерел. Патерни можуть бути префіксовані знаком \"!\", щоб виключити їх. Може бути встановлено на порожній масив або null, щоб уникнути обмежень.","items":{"type":"string"},"type":["array","null"]},"runtimeSourcemapPausePatterns":{"default":[],"items":{"type":"string"},"markdownDescription":"Список шаблонів, за якими можна вручну вставити точки зупинки вхідної точки. Це може бути корисно, щоб надати відладчику можливість встановити точки зупинки при використанні sourcemaps, які не існують або не можуть бути виявлені до запуску, наприклад, [з фреймворком Serverless](https://github.com/microsoft/vscode-js-debug/issues/492).","type":"array"},"showAsyncStacks":{"default":true,"description":"Показати асинхронні виклики, які призвели до поточного стеку викликів.","oneOf":[{"type":"boolean"},{"properties":{"onAttach":{"default":32,"type":"number"}},"required":["onAttach"],"type":"object"},{"properties":{"onceBreakpointResolved":{"default":32,"type":"number"}},"required":["onceBreakpointResolved"],"type":"object"}]},"skipFiles":{"default":["${/**"],"description":"Масив імен файлів або папок, або шаблонів шляхів, які слід пропустити під час налагодження. Дозволені зіркові шаблони та заперечення, наприклад, `[\"**/node_modules/**\", \"!**/node_modules/my-module/**\"]`","type":"array"},"smartStep":{"default":true,"description":"Автоматично проходьте через згенерований код, який не може бути відображений назад до оригінального джерела.","type":"boolean"},"sourceMapPathOverrides":{"default":{"meteor://💻app/*":"${workspaceFolder}/*","webpack:///./~/*":"${workspaceFolder}/node_modules/*","webpack://?:*/*":"${workspaceFolder}/*"},"description":"Набір відображень для переписування місць розташування вихідних файлів з того, що вказує sourcemap, на їхні місця на диску.","type":"object"},"sourceMapRenames":{"default":true,"description":"Чи використовувати відображення \"names\" у sourcemaps. Це вимагає запиту на отримання вихідного контенту, що може бути повільним з певними налагоджувачами.","type":"boolean"},"sourceMaps":{"default":true,"description":"Використовуйте карти джерел JavaScript (якщо вони існують).","type":"boolean"},"timeout":{"default":10000,"description":"Спробуйте знову протягом цього числа мілісекунд для підключення до Node.js. За замовчуванням 10000 мс.","type":"number"},"timeouts":{"additionalProperties":false,"default":{},"description":"Тайм-аути для кількох операцій налагодження.","markdownDescription":"Таймаути для кількох операцій налагоджувача.","properties":{"hoverEvaluation":{"default":500,"description":"Час до оцінки значення для символів, на які наведено курсор, скасовується. Якщо встановлено 0, оцінка при наведенні ніколи не закінчується.","type":"number"},"sourceMapCumulativePause":{"default":1000,"description":"Додатковий час у мілісекундах, дозволений за сесію для очікування обробки source-map, після того як мінімальний час (sourceMapMinPause) буде вичерпано","type":"number"},"sourceMapMinPause":{"default":1000,"description":"Мінімальний час у мілісекундах, витрачений на очікування обробки кожної source-map під час парсингу скрипта","type":"number"}},"type":"object"},"trace":{"default":true,"description":"Налаштовує, який діагностичний вивід буде створено.","oneOf":[{"description":"Trace може бути встановлено на 'true', щоб записувати діагностичні журнали на диск.","type":"boolean"},{"additionalProperties":false,"properties":{"logFile":{"description":"Налаштовує, де на диску записуються журнали.","type":["string","null"]},"stdio":{"description":"Чи повертати дані трасування з запущеного додатку або браузера.","type":"boolean"}},"type":"object"}]}},"type":"object"}]},"showAsyncStacks":{"default":true,"description":"Показати асинхронні виклики, які призвели до поточного стеку викликів.","oneOf":[{"type":"boolean"},{"properties":{"onAttach":{"default":32,"type":"number"}},"required":["onAttach"],"type":"object"},{"properties":{"onceBreakpointResolved":{"default":32,"type":"number"}},"required":["onceBreakpointResolved"],"type":"object"}]},"skipFiles":{"default":["${/**"],"description":"Масив імен файлів або папок, або шаблонів шляхів, які слід пропустити під час налагодження. Дозволені зіркові шаблони та заперечення, наприклад, `[\"**/node_modules/**\", \"!**/node_modules/my-module/**\"]`","type":"array"},"smartStep":{"default":true,"description":"Автоматично проходьте через згенерований код, який не може бути відображений назад до оригінального джерела.","type":"boolean"},"sourceMapPathOverrides":{"default":{"meteor://💻app/*":"${workspaceFolder}/*","webpack:///./~/*":"${workspaceFolder}/node_modules/*","webpack://?:*/*":"${workspaceFolder}/*"},"description":"Набір відображень для переписування місць розташування вихідних файлів з того, що вказує sourcemap, на їхні місця на диску.","type":"object"},"sourceMapRenames":{"default":true,"description":"Чи використовувати відображення \"names\" у sourcemaps. Це вимагає запиту на отримання вихідного контенту, що може бути повільним з певними налагоджувачами.","type":"boolean"},"sourceMaps":{"default":true,"description":"Використовуйте карти джерел JavaScript (якщо вони існують).","type":"boolean"},"targetSelection":{"default":"automatic","enum":["pick","automatic"],"markdownDescription":"Чи прикріпити до всіх цілей, які відповідають фільтру URL (\"автоматично\"), чи запитати вибрати одну (\"вибрати\").","type":"string"},"timeout":{"default":10000,"description":"Спробуйте знову протягом цього числа мілісекунд для підключення до Node.js. За замовчуванням 10000 мс.","type":"number"},"timeouts":{"additionalProperties":false,"default":{},"description":"Тайм-аути для кількох операцій налагодження.","markdownDescription":"Таймаути для кількох операцій налагоджувача.","properties":{"hoverEvaluation":{"default":500,"description":"Час до оцінки значення для символів, на які наведено курсор, скасовується. Якщо встановлено 0, оцінка при наведенні ніколи не закінчується.","type":"number"},"sourceMapCumulativePause":{"default":1000,"description":"Додатковий час у мілісекундах, дозволений за сесію для очікування обробки source-map, після того як мінімальний час (sourceMapMinPause) буде вичерпано","type":"number"},"sourceMapMinPause":{"default":1000,"description":"Мінімальний час у мілісекундах, витрачений на очікування обробки кожної source-map під час парсингу скрипта","type":"number"}},"type":"object"},"trace":{"default":true,"description":"Налаштовує, який діагностичний вивід буде створено.","oneOf":[{"description":"Trace може бути встановлено на 'true', щоб записувати діагностичні журнали на диск.","type":"boolean"},{"additionalProperties":false,"properties":{"logFile":{"description":"Налаштовує, де на диску записуються журнали.","type":["string","null"]},"stdio":{"description":"Чи повертати дані трасування з запущеного додатку або браузера.","type":"boolean"}},"type":"object"}]},"url":{"default":"http://localhost:8080","description":"Шукатиме вкладку з цим точним URL і приєднається до неї, якщо буде знайдена","tags":["setup"],"type":"string"},"urlFilter":{"default":"","description":"Шукатиме сторінку з цим URL і прикріпить до неї, якщо знайде. Можуть бути * підстановочні знаки.","type":"string"},"vueComponentPaths":{"default":["${workspaceFolder}/**/*.vue"],"description":"Список шаблонів глобусів файлів для знаходження `*.vue` компонентів. За замовчуванням, здійснює пошук по всьому робочому простору. Це потрібно вказати через додаткові запити, які потребують мапи джерел Vue в Vue CLI 4. Ви можете вимкнути це спеціальне оброблення, встановивши це в порожній масив.","type":"array"},"webRoot":{"default":"${workspaceFolder}","description":"Це вказує абсолютний шлях до кореня веб-сервера в робочому просторі. Використовується для вирішення шляхів, таких як `/app.js`, до файлів на диску. Скорочення для pathMapping для \"/\"","tags":["setup"],"type":"string"}},"type":"object"},"resolveSourceMapLocations":{"default":["${workspaceFolder}/**","!**/node_modules/**"],"description":"Список патернів minimatch для місць (папок та URL), в яких карти джерел можуть бути використані для вирішення локальних файлів. Це можна використовувати, щоб уникнути неправильного розриву в зовнішньому коді з картами джерел. Патерни можуть бути префіксовані знаком \"!\", щоб виключити їх. Може бути встановлено на порожній масив або null, щоб уникнути обмежень.","items":{"type":"string"},"type":["array","null"]},"runtimeExecutable":{"default":"node","markdownDescription":"Абсолютний шлях до VS Code.","type":["string","null"]},"runtimeSourcemapPausePatterns":{"default":[],"items":{"type":"string"},"markdownDescription":"Список шаблонів, за якими можна вручну вставити точки зупинки вхідної точки. Це може бути корисно, щоб надати відладчику можливість встановити точки зупинки при використанні sourcemaps, які не існують або не можуть бути виявлені до запуску, наприклад, [з фреймворком Serverless](https://github.com/microsoft/vscode-js-debug/issues/492).","type":"array"},"showAsyncStacks":{"default":true,"description":"Показати асинхронні виклики, які призвели до поточного стеку викликів.","oneOf":[{"type":"boolean"},{"properties":{"onAttach":{"default":32,"type":"number"}},"required":["onAttach"],"type":"object"},{"properties":{"onceBreakpointResolved":{"default":32,"type":"number"}},"required":["onceBreakpointResolved"],"type":"object"}]},"skipFiles":{"default":["${/**"],"description":"Масив імен файлів або папок, або шаблонів шляхів, які слід пропустити під час налагодження. Дозволені зіркові шаблони та заперечення, наприклад, `[\"**/node_modules/**\", \"!**/node_modules/my-module/**\"]`","type":"array"},"smartStep":{"default":true,"description":"Автоматично проходьте через згенерований код, який не може бути відображений назад до оригінального джерела.","type":"boolean"},"sourceMapPathOverrides":{"default":{"meteor://💻app/*":"${workspaceFolder}/*","webpack:///./~/*":"${workspaceFolder}/node_modules/*","webpack://?:*/*":"${workspaceFolder}/*"},"description":"Набір відображень для переписування місць розташування вихідних файлів з того, що вказує sourcemap, на їхні місця на диску.","type":"object"},"sourceMapRenames":{"default":true,"description":"Чи використовувати відображення \"names\" у sourcemaps. Це вимагає запиту на отримання вихідного контенту, що може бути повільним з певними налагоджувачами.","type":"boolean"},"sourceMaps":{"default":true,"description":"Використовуйте карти джерел JavaScript (якщо вони існують).","type":"boolean"},"testConfiguration":{"default":"${workspaceFolder}/.vscode-test.js","markdownDescription":"Шлях до файлу конфігурації тесту для [test CLI](https://code.visualstudio.com/api/working-with-extensions/testing-extension#quick-setup-the-test-cli).","type":"string"},"testConfigurationLabel":{"default":"","markdownDescription":"Одна конфігурація для запуску з файлу. Якщо не вказано, вас можуть попросити вибрати.","type":"string"},"timeout":{"default":10000,"description":"Спробуйте знову протягом цього числа мілісекунд для підключення до Node.js. За замовчуванням 10000 мс.","type":"number"},"timeouts":{"additionalProperties":false,"default":{},"description":"Тайм-аути для кількох операцій налагодження.","markdownDescription":"Таймаути для кількох операцій налагоджувача.","properties":{"hoverEvaluation":{"default":500,"description":"Час до оцінки значення для символів, на які наведено курсор, скасовується. Якщо встановлено 0, оцінка при наведенні ніколи не закінчується.","type":"number"},"sourceMapCumulativePause":{"default":1000,"description":"Додатковий час у мілісекундах, дозволений за сесію для очікування обробки source-map, після того як мінімальний час (sourceMapMinPause) буде вичерпано","type":"number"},"sourceMapMinPause":{"default":1000,"description":"Мінімальний час у мілісекундах, витрачений на очікування обробки кожної source-map під час парсингу скрипта","type":"number"}},"type":"object"},"trace":{"default":true,"description":"Налаштовує, який діагностичний вивід буде створено.","oneOf":[{"description":"Trace може бути встановлено на 'true', щоб записувати діагностичні журнали на диск.","type":"boolean"},{"additionalProperties":false,"properties":{"logFile":{"description":"Налаштовує, де на диску записуються журнали.","type":["string","null"]},"stdio":{"description":"Чи повертати дані трасування з запущеного додатку або браузера.","type":"boolean"}},"type":"object"}]}},"required":[]}},"configurationSnippets":[],"deprecated":"Please use type extensionHost instead","label":"Розробка розширень для VS Code","languages":["javascript","typescript","javascriptreact","typescriptreact"],"strings":{"unverifiedBreakpoints":"Деякі з ваших точок зупинки не можуть бути встановлені. Якщо у вас виникає проблема, ви можете [усунути неполадки у вашій конфігурації запуску](command:extension.js-debug.createDiagnostics)."},"type":"pwa-extensionHost"},{"aiKey":"0c6ae279ed8443289764825290e4f9e2-1a736e7c-1324-4338-be46-fc2a58ae4d14-7255","configurationAttributes":{"launch":{"properties":{"args":{"default":["--extensionDevelopmentPath=${workspaceFolder}"],"description":"Аргументи командного рядка, передані програмі.\n\nМожуть бути масивом рядків або єдиним рядком. Коли програма запускається в терміналі, встановлення цієї властивості в єдиний рядок призведе до того, що аргументи не будуть екрановані для оболонки.","items":{"type":"string"},"tags":["setup"],"type":"array"},"autoAttachChildProcesses":{"default":true,"description":"Автоматично підключати налагоджувач до нових дочірніх процесів.","type":"boolean"},"cascadeTerminateToConfigurations":{"default":[],"description":"Список сеансів налагодження, які, коли цей сеанс налагодження буде завершено, також будуть зупинені.","items":{"type":"string","uniqueItems":true},"type":"array"},"customDescriptionGenerator":{"description":"Налаштуйте текстовий опис, який відображає відладчик для об'єктів (локальних змінних тощо...). Приклади:\n      1. this.toString() // викликає toString для виведення всіх об'єктів\n      2. this.customDescription ? this.customDescription() : defaultValue // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть defaultValue\n      3. function (def) { return this.customDescription ? this.customDescription() : def } // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть defaultValue\n      ","type":"string"},"customPropertiesGenerator":{"deprecated":true,"description":"Налаштуйте властивості, які відображаються для об'єкта в налагоджувачі (локальні змінні тощо...). Приклади:\n    1. { ...this, extraProperty: '12345' } // Додати extraProperty 12345 до всіх об'єктів\n    2. this.customProperties ? this.customProperties() : this // Використовуйте метод customProperties, якщо він доступний, якщо ні - використовуйте властивості в this (за замовчуванням)\n    3. function () { return this.customProperties ? this.customProperties() : this } // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть властивості за замовчуванням\n\n    Застаріло: Це тимчасова реалізація цієї функції, поки ми не матимемо часу реалізувати її в спосіб, описаний тут: https://github.com/microsoft/vscode/issues/102181","type":"string"},"cwd":{"default":"${workspaceFolder}","description":"Абсолютний шлях до робочого каталогу програми, що налагоджується. Якщо ви встановили localRoot, тоді cwd відповідатиме цьому значенню, інакше він повернеться до вашого workspaceFolder.","tags":["setup"],"type":"string"},"debugWebWorkerHost":{"default":true,"markdownDescription":"Налаштовує, чи слід намагатися підключитися до хоста розширення веб-робітника.","type":["boolean"]},"debugWebviews":{"default":true,"markdownDescription":"Налаштовує, чи слід намагатися підключитися до веб-переглядів у запущеному екземплярі VS Code. Це буде працювати лише в настільному VS Code.","type":["boolean"]},"enableContentValidation":{"default":true,"description":"Перемикає, чи перевіряємо ми, що вміст файлів на диску відповідає завантаженим у час виконання. Це корисно в різних сценаріях і є обов'язковим у деяких, але може викликати проблеми, якщо у вас є серверна трансформація скриптів, наприклад.","type":"boolean"},"enableDWARF":{"default":true,"markdownDescription":"Перемикає, чи буде відладчик намагатися зчитувати символи налагодження DWARF з WebAssembly, що може вимагати багато ресурсів. Для роботи потрібен розширення `ms-vscode.wasm-dwarf-debugging`.","type":"boolean"},"env":{"additionalProperties":{"type":["string","null"]},"default":{},"markdownDescription":"Змінні середовища, передані програмі. Значення `null` видаляє змінну з середовища.","tags":["setup"],"type":"object"},"envFile":{"default":"${workspaceFolder}/.env","description":"Абсолютний шлях до файлу, що містить визначення змінних середовища.","type":"string"},"localRoot":{"default":null,"description":"Шлях до локального каталогу, що містить програму.","type":["string","null"]},"nodeVersionHint":{"default":12,"description":"Дозволяє вам явно вказати версію Node, яка працює, що може бути використано для вимкнення або ввімкнення певних поведінок у випадках, коли автоматичне визначення версії не працює.","minimum":8,"type":"number"},"outFiles":{"default":["${workspaceFolder}/**/*.(m|c|)js","!**/node_modules/**"],"description":"Якщо карти джерел увімкнені, ці шаблони glob вказують на згенеровані файли JavaScript. Якщо шаблон починається з `!`, файли виключаються. Якщо не вказано, згенерований код очікується в тому ж каталозі, що й його джерело.","items":{"type":"string"},"tags":["setup"],"type":["array"]},"outputCapture":{"default":"console","enum":["console","std"],"markdownDescription":"Звідки захоплювати вихідні повідомлення: за замовчуванням API налагодження, якщо встановлено `console`, або потоки stdout/stderr, якщо встановлено `std`."},"pauseForSourceMap":{"default":false,"markdownDescription":"Чи чекати на завантаження карт джерел для кожного вхідного скрипта. Це має накладні витрати на продуктивність і може бути безпечно вимкнено при виконанні з диска, якщо `rootPath` не вимкнено.","type":"boolean"},"remoteRoot":{"default":null,"description":"Абсолютний шлях до віддаленого каталогу, що містить програму.","type":["string","null"]},"rendererDebugOptions":{"default":{"webRoot":"${workspaceFolder}"},"markdownDescription":"Опції запуску Chrome, що використовуються при підключенні до процесу рендерингу, з `debugWebviews` або `debugWebWorkerHost`.","properties":{"address":{"default":"localhost","description":"IP-адреса або ім'я хоста, на якому слухає налагоджений браузер.","type":"string"},"browserAttachLocation":{"default":null,"description":"Примушує браузер підключатися в одному місці. У віддаленому робочому просторі (через ssh або WSL, наприклад) це можна використовувати для підключення до браузера на віддаленій машині, а не локально.","oneOf":[{"type":"null"},{"enum":["ui","workspace"],"type":"string"}]},"cascadeTerminateToConfigurations":{"default":[],"description":"Список сеансів налагодження, які, коли цей сеанс налагодження буде завершено, також будуть зупинені.","items":{"type":"string","uniqueItems":true},"type":"array"},"customDescriptionGenerator":{"description":"Налаштуйте текстовий опис, який відображає відладчик для об'єктів (локальних змінних тощо...). Приклади:\n      1. this.toString() // викликає toString для виведення всіх об'єктів\n      2. this.customDescription ? this.customDescription() : defaultValue // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть defaultValue\n      3. function (def) { return this.customDescription ? this.customDescription() : def } // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть defaultValue\n      ","type":"string"},"customPropertiesGenerator":{"deprecated":true,"description":"Налаштуйте властивості, які відображаються для об'єкта в налагоджувачі (локальні змінні тощо...). Приклади:\n    1. { ...this, extraProperty: '12345' } // Додати extraProperty 12345 до всіх об'єктів\n    2. this.customProperties ? this.customProperties() : this // Використовуйте метод customProperties, якщо він доступний, якщо ні - використовуйте властивості в this (за замовчуванням)\n    3. function () { return this.customProperties ? this.customProperties() : this } // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть властивості за замовчуванням\n\n    Застаріло: Це тимчасова реалізація цієї функції, поки ми не матимемо часу реалізувати її в спосіб, описаний тут: https://github.com/microsoft/vscode/issues/102181","type":"string"},"disableNetworkCache":{"default":true,"description":"Контролює, чи пропускати мережевий кеш для кожного запиту","type":"boolean"},"enableContentValidation":{"default":true,"description":"Перемикає, чи перевіряємо ми, що вміст файлів на диску відповідає завантаженим у час виконання. Це корисно в різних сценаріях і є обов'язковим у деяких, але може викликати проблеми, якщо у вас є серверна трансформація скриптів, наприклад.","type":"boolean"},"enableDWARF":{"default":true,"markdownDescription":"Перемикає, чи буде відладчик намагатися зчитувати символи налагодження DWARF з WebAssembly, що може вимагати багато ресурсів. Для роботи потрібен розширення `ms-vscode.wasm-dwarf-debugging`.","type":"boolean"},"inspectUri":{"default":null,"description":"Формат, який потрібно використовувати для переписування inspectUri: Це шаблонний рядок, який інтерполює ключі в `{curlyBraces}`. Доступні ключі:\n - `url.*` - це розпарсена адреса запущеного застосунку. Наприклад, `{url.port}`, `{url.hostname}`\n - `port` - це порт налагодження, на якому слухає Chrome.\n - `browserInspectUri` - це URI інспектора на запущеному браузері.\n - `browserInspectUriPath` - це частина шляху URI інспектора на запущеному браузері (наприклад: \"/devtools/browser/e9ec0098-306e-472a-8133-5e42488929c2\").\n - `wsProtocol` - це вказаний протокол вебсокетів. Це встановлюється на `wss`, якщо оригінальна URL-адреса є `https`, або `ws` в іншому випадку.","type":["string","null"]},"outFiles":{"default":["${workspaceFolder}/**/*.(m|c|)js","!**/node_modules/**"],"description":"Якщо карти джерел увімкнені, ці шаблони glob вказують на згенеровані файли JavaScript. Якщо шаблон починається з `!`, файли виключаються. Якщо не вказано, згенерований код очікується в тому ж каталозі, що й його джерело.","items":{"type":"string"},"tags":["setup"],"type":["array"]},"outputCapture":{"default":"console","enum":["console","std"],"markdownDescription":"Звідки захоплювати вихідні повідомлення: за замовчуванням API налагодження, якщо встановлено `console`, або потоки stdout/stderr, якщо встановлено `std`."},"pathMapping":{"default":{},"description":"Відображення URL/шляхів на локальні папки, щоб вирішити скрипти в браузері на скрипти на диску","type":"object"},"pauseForSourceMap":{"default":false,"markdownDescription":"Чи чекати на завантаження карт джерел для кожного вхідного скрипта. Це має накладні витрати на продуктивність і може бути безпечно вимкнено при виконанні з диска, якщо `rootPath` не вимкнено.","type":"boolean"},"perScriptSourcemaps":{"default":"auto","description":"Чи завантажуються скрипти окремо з унікальними sourcemaps, що містять базову назву вихідного файлу. Це можна налаштувати для оптимізації обробки sourcemap при роботі з великою кількістю малих скриптів. Якщо встановлено \"auto\", ми виявимо відомі випадки, коли це доречно.","enum":["yes","no","auto"],"type":"string"},"port":{"default":9229,"description":"Порт, який використовувати для віддаленого налагодження браузера, вказується як `--remote-debugging-port` під час запуску браузера.","oneOf":[{"type":"integer"},{"pattern":"^\\${.*}$","type":"string"}],"tags":["setup"]},"resolveSourceMapLocations":{"default":null,"description":"Список патернів minimatch для місць (папок та URL), в яких карти джерел можуть бути використані для вирішення локальних файлів. Це можна використовувати, щоб уникнути неправильного розриву в зовнішньому коді з картами джерел. Патерни можуть бути префіксовані знаком \"!\", щоб виключити їх. Може бути встановлено на порожній масив або null, щоб уникнути обмежень.","items":{"type":"string"},"type":["array","null"]},"restart":{"default":false,"markdownDescription":"Чи підключитися знову, якщо з'єднання браузера закрито","type":"boolean"},"server":{"oneOf":[{"additionalProperties":false,"default":{"program":"node my-server.js"},"description":"Налаштовує веб-сервер для запуску. Використовує таку ж конфігурацію, як і завдання запуску 'node'.","properties":{"args":{"default":[],"description":"Аргументи командного рядка, передані програмі.\n\nМожуть бути масивом рядків або єдиним рядком. Коли програма запускається в терміналі, встановлення цієї властивості в єдиний рядок призведе до того, що аргументи не будуть екрановані для оболонки.","items":{"type":"string"},"tags":["setup"],"type":["array","string"]},"attachSimplePort":{"default":9229,"description":"Якщо встановлено, приєднується до процесу через вказаний порт. Це зазвичай більше не є необхідним для програм Node.js і втрачає можливість налагодження дочірніх процесів, але може бути корисним у більш екзотичних сценаріях, таких як запуск з Deno та Docker. Якщо встановлено на 0, буде вибрано випадковий порт, і --inspect-brk буде автоматично додано до аргументів запуску.","oneOf":[{"type":"integer"},{"pattern":"^\\${.*}$","type":"string"}]},"autoAttachChildProcesses":{"default":true,"description":"Автоматично підключати налагоджувач до нових дочірніх процесів.","type":"boolean"},"cascadeTerminateToConfigurations":{"default":[],"description":"Список сеансів налагодження, які, коли цей сеанс налагодження буде завершено, також будуть зупинені.","items":{"type":"string","uniqueItems":true},"type":"array"},"console":{"default":"internalConsole","description":"Де запустити ціль налагодження.","enum":["internalConsole","integratedTerminal","externalTerminal"],"enumDescriptions":["Консоль налагодження VS Code (яка не підтримує читання введення з програми)","інтегрований термінал VS Code","Зовнішній термінал, який можна налаштувати через налаштування користувача"],"type":"string"},"customDescriptionGenerator":{"description":"Налаштуйте текстовий опис, який відображає відладчик для об'єктів (локальних змінних тощо...). Приклади:\n      1. this.toString() // викликає toString для виведення всіх об'єктів\n      2. this.customDescription ? this.customDescription() : defaultValue // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть defaultValue\n      3. function (def) { return this.customDescription ? this.customDescription() : def } // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть defaultValue\n      ","type":"string"},"customPropertiesGenerator":{"deprecated":true,"description":"Налаштуйте властивості, які відображаються для об'єкта в налагоджувачі (локальні змінні тощо...). Приклади:\n    1. { ...this, extraProperty: '12345' } // Додати extraProperty 12345 до всіх об'єктів\n    2. this.customProperties ? this.customProperties() : this // Використовуйте метод customProperties, якщо він доступний, якщо ні - використовуйте властивості в this (за замовчуванням)\n    3. function () { return this.customProperties ? this.customProperties() : this } // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть властивості за замовчуванням\n\n    Застаріло: Це тимчасова реалізація цієї функції, поки ми не матимемо часу реалізувати її в спосіб, описаний тут: https://github.com/microsoft/vscode/issues/102181","type":"string"},"cwd":{"default":"${workspaceFolder}","description":"Абсолютний шлях до робочого каталогу програми, що налагоджується. Якщо ви встановили localRoot, тоді cwd відповідатиме цьому значенню, інакше він повернеться до вашого workspaceFolder.","tags":["setup"],"type":"string"},"enableContentValidation":{"default":true,"description":"Перемикає, чи перевіряємо ми, що вміст файлів на диску відповідає завантаженим у час виконання. Це корисно в різних сценаріях і є обов'язковим у деяких, але може викликати проблеми, якщо у вас є серверна трансформація скриптів, наприклад.","type":"boolean"},"enableDWARF":{"default":true,"markdownDescription":"Перемикає, чи буде відладчик намагатися зчитувати символи налагодження DWARF з WebAssembly, що може вимагати багато ресурсів. Для роботи потрібен розширення `ms-vscode.wasm-dwarf-debugging`.","type":"boolean"},"env":{"additionalProperties":{"type":["string","null"]},"default":{},"markdownDescription":"Змінні середовища, передані програмі. Значення `null` видаляє змінну з середовища.","tags":["setup"],"type":"object"},"envFile":{"default":"${workspaceFolder}/.env","description":"Абсолютний шлях до файлу, що містить визначення змінних середовища.","type":"string"},"experimentalNetworking":{"default":"auto","description":"Увімкніть експериментальну перевірку в Node.js. Коли встановлено `auto`, це увімкнено для версій Node.js, які це підтримують. Його можна встановити на `on` або `off`, щоб увімкнути або вимкнути його явно.","enum":["auto","on","off"],"type":"string"},"killBehavior":{"default":"forceful","enum":["forceful","polite","none"],"markdownDescription":"Налаштовує, як процеси налагодження зупиняються при завершенні сеансу. Може бути:\n\n- примусовим (за замовчуванням): примусово знищує дерево процесів. Надсилає SIGKILL на posix або `taskkill.exe /F` на Windows.\n- ввічливим: м’яко знищує дерево процесів. Можливо, що некоректно працюючі процеси продовжать виконуватись після завершення таким чином. Надсилає SIGTERM на posix або `taskkill.exe` без прапора `/F` (примус) на Windows.\n- жодного: жодного завершення не відбудеться.","type":"string"},"localRoot":{"default":null,"description":"Шлях до локального каталогу, що містить програму.","type":["string","null"]},"nodeVersionHint":{"default":12,"description":"Дозволяє вам явно вказати версію Node, яка працює, що може бути використано для вимкнення або ввімкнення певних поведінок у випадках, коли автоматичне визначення версії не працює.","minimum":8,"type":"number"},"outFiles":{"default":["${workspaceFolder}/**/*.(m|c|)js","!**/node_modules/**"],"description":"Якщо карти джерел увімкнені, ці шаблони glob вказують на згенеровані файли JavaScript. Якщо шаблон починається з `!`, файли виключаються. Якщо не вказано, згенерований код очікується в тому ж каталозі, що й його джерело.","items":{"type":"string"},"tags":["setup"],"type":["array"]},"outputCapture":{"default":"console","enum":["console","std"],"markdownDescription":"Звідки захоплювати вихідні повідомлення: за замовчуванням API налагодження, якщо встановлено `console`, або потоки stdout/stderr, якщо встановлено `std`."},"pauseForSourceMap":{"default":false,"markdownDescription":"Чи чекати на завантаження карт джерел для кожного вхідного скрипта. Це має накладні витрати на продуктивність і може бути безпечно вимкнено при виконанні з диска, якщо `rootPath` не вимкнено.","type":"boolean"},"profileStartup":{"default":true,"description":"Якщо це правда, почне профілювання, як тільки процес запуститься","type":"boolean"},"program":{"default":"","description":"Абсолютний шлях до програми. Згенероване значення визначається шляхом аналізу package.json та відкритих файлів. Відредагуйте цей атрибут.","tags":["setup"],"type":"string"},"remoteRoot":{"default":null,"description":"Абсолютний шлях до віддаленого каталогу, що містить програму.","type":["string","null"]},"resolveSourceMapLocations":{"default":["${workspaceFolder}/**","!**/node_modules/**"],"description":"Список патернів minimatch для місць (папок та URL), в яких карти джерел можуть бути використані для вирішення локальних файлів. Це можна використовувати, щоб уникнути неправильного розриву в зовнішньому коді з картами джерел. Патерни можуть бути префіксовані знаком \"!\", щоб виключити їх. Може бути встановлено на порожній масив або null, щоб уникнути обмежень.","items":{"type":"string"},"type":["array","null"]},"restart":{"default":true,"description":"Спробуйте перепідключитися до програми, якщо ми втратимо з'єднання. Якщо встановлено `true`, ми будемо намагатися раз на секунду, вічно. Ви можете налаштувати інтервал і максимальну кількість спроб, вказавши `delay` та `maxAttempts` в об'єкті замість цього.","oneOf":[{"type":"boolean"},{"properties":{"delay":{"default":1000,"minimum":0,"type":"number"},"maxAttempts":{"default":10,"minimum":0,"type":"number"}},"type":"object"}]},"runtimeArgs":{"default":[],"description":"Необов'язкові аргументи, передані виконуваному файлу часу виконання.","items":{"type":"string"},"tags":["setup"],"type":"array"},"runtimeExecutable":{"default":"node","markdownDescription":"Час виконання для використання. Або абсолютний шлях, або ім'я часу виконання, доступного в PATH. Якщо пропущено, вважається, що використовується `node`.","type":["string","null"]},"runtimeSourcemapPausePatterns":{"default":[],"items":{"type":"string"},"markdownDescription":"Список шаблонів, за якими можна вручну вставити точки зупинки вхідної точки. Це може бути корисно, щоб надати відладчику можливість встановити точки зупинки при використанні sourcemaps, які не існують або не можуть бути виявлені до запуску, наприклад, [з фреймворком Serverless](https://github.com/microsoft/vscode-js-debug/issues/492).","type":"array"},"runtimeVersion":{"default":"default","markdownDescription":"Версія середовища виконання `node`, яку слід використовувати. Потрібен `nvm`.","type":"string"},"showAsyncStacks":{"default":true,"description":"Показати асинхронні виклики, які призвели до поточного стеку викликів.","oneOf":[{"type":"boolean"},{"properties":{"onAttach":{"default":32,"type":"number"}},"required":["onAttach"],"type":"object"},{"properties":{"onceBreakpointResolved":{"default":32,"type":"number"}},"required":["onceBreakpointResolved"],"type":"object"}]},"skipFiles":{"default":["${/**"],"description":"Масив імен файлів або папок, або шаблонів шляхів, які слід пропустити під час налагодження. Дозволені зіркові шаблони та заперечення, наприклад, `[\"**/node_modules/**\", \"!**/node_modules/my-module/**\"]`","type":"array"},"smartStep":{"default":true,"description":"Автоматично проходьте через згенерований код, який не може бути відображений назад до оригінального джерела.","type":"boolean"},"sourceMapPathOverrides":{"default":{"meteor://💻app/*":"${workspaceFolder}/*","webpack:///./~/*":"${workspaceFolder}/node_modules/*","webpack://?:*/*":"${workspaceFolder}/*"},"description":"Набір відображень для переписування місць розташування вихідних файлів з того, що вказує sourcemap, на їхні місця на диску.","type":"object"},"sourceMapRenames":{"default":true,"description":"Чи використовувати відображення \"names\" у sourcemaps. Це вимагає запиту на отримання вихідного контенту, що може бути повільним з певними налагоджувачами.","type":"boolean"},"sourceMaps":{"default":true,"description":"Використовуйте карти джерел JavaScript (якщо вони існують).","type":"boolean"},"stopOnEntry":{"default":true,"description":"Автоматично зупинити програму після запуску.","type":["boolean","string"]},"timeout":{"default":10000,"description":"Спробуйте знову протягом цього числа мілісекунд для підключення до Node.js. За замовчуванням 10000 мс.","type":"number"},"timeouts":{"additionalProperties":false,"default":{},"description":"Тайм-аути для кількох операцій налагодження.","markdownDescription":"Таймаути для кількох операцій налагоджувача.","properties":{"hoverEvaluation":{"default":500,"description":"Час до оцінки значення для символів, на які наведено курсор, скасовується. Якщо встановлено 0, оцінка при наведенні ніколи не закінчується.","type":"number"},"sourceMapCumulativePause":{"default":1000,"description":"Додатковий час у мілісекундах, дозволений за сесію для очікування обробки source-map, після того як мінімальний час (sourceMapMinPause) буде вичерпано","type":"number"},"sourceMapMinPause":{"default":1000,"description":"Мінімальний час у мілісекундах, витрачений на очікування обробки кожної source-map під час парсингу скрипта","type":"number"}},"type":"object"},"trace":{"default":true,"description":"Налаштовує, який діагностичний вивід буде створено.","oneOf":[{"description":"Trace може бути встановлено на 'true', щоб записувати діагностичні журнали на диск.","type":"boolean"},{"additionalProperties":false,"properties":{"logFile":{"description":"Налаштовує, де на диску записуються журнали.","type":["string","null"]},"stdio":{"description":"Чи повертати дані трасування з запущеного додатку або браузера.","type":"boolean"}},"type":"object"}]}},"type":"object"},{"additionalProperties":false,"default":{"program":"npm start"},"description":"Термінал налагодження JavaScript","properties":{"autoAttachChildProcesses":{"default":true,"description":"Автоматично підключати налагоджувач до нових дочірніх процесів.","type":"boolean"},"cascadeTerminateToConfigurations":{"default":[],"description":"Список сеансів налагодження, які, коли цей сеанс налагодження буде завершено, також будуть зупинені.","items":{"type":"string","uniqueItems":true},"type":"array"},"command":{"default":"npm start","description":"Команда для виконання в запущеному терміналі. Якщо не вказано, термінал відкриється без запуску програми.","tags":["setup"],"type":["string","null"]},"customDescriptionGenerator":{"description":"Налаштуйте текстовий опис, який відображає відладчик для об'єктів (локальних змінних тощо...). Приклади:\n      1. this.toString() // викликає toString для виведення всіх об'єктів\n      2. this.customDescription ? this.customDescription() : defaultValue // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть defaultValue\n      3. function (def) { return this.customDescription ? this.customDescription() : def } // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть defaultValue\n      ","type":"string"},"customPropertiesGenerator":{"deprecated":true,"description":"Налаштуйте властивості, які відображаються для об'єкта в налагоджувачі (локальні змінні тощо...). Приклади:\n    1. { ...this, extraProperty: '12345' } // Додати extraProperty 12345 до всіх об'єктів\n    2. this.customProperties ? this.customProperties() : this // Використовуйте метод customProperties, якщо він доступний, якщо ні - використовуйте властивості в this (за замовчуванням)\n    3. function () { return this.customProperties ? this.customProperties() : this } // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть властивості за замовчуванням\n\n    Застаріло: Це тимчасова реалізація цієї функції, поки ми не матимемо часу реалізувати її в спосіб, описаний тут: https://github.com/microsoft/vscode/issues/102181","type":"string"},"cwd":{"default":"${workspaceFolder}","description":"Абсолютний шлях до робочого каталогу програми, що налагоджується. Якщо ви встановили localRoot, тоді cwd відповідатиме цьому значенню, інакше він повернеться до вашого workspaceFolder.","docDefault":"localRoot || ${workspaceFolder}","tags":["setup"],"type":"string"},"enableContentValidation":{"default":true,"description":"Перемикає, чи перевіряємо ми, що вміст файлів на диску відповідає завантаженим у час виконання. Це корисно в різних сценаріях і є обов'язковим у деяких, але може викликати проблеми, якщо у вас є серверна трансформація скриптів, наприклад.","type":"boolean"},"enableDWARF":{"default":true,"markdownDescription":"Перемикає, чи буде відладчик намагатися зчитувати символи налагодження DWARF з WebAssembly, що може вимагати багато ресурсів. Для роботи потрібен розширення `ms-vscode.wasm-dwarf-debugging`.","type":"boolean"},"env":{"additionalProperties":{"type":["string","null"]},"default":{},"markdownDescription":"Змінні середовища, передані програмі. Значення `null` видаляє змінну з середовища.","tags":["setup"],"type":"object"},"envFile":{"default":"${workspaceFolder}/.env","description":"Абсолютний шлях до файлу, що містить визначення змінних середовища.","type":"string"},"localRoot":{"default":null,"description":"Шлях до локального каталогу, що містить програму.","type":["string","null"]},"nodeVersionHint":{"default":12,"description":"Дозволяє вам явно вказати версію Node, яка працює, що може бути використано для вимкнення або ввімкнення певних поведінок у випадках, коли автоматичне визначення версії не працює.","minimum":8,"type":"number"},"outFiles":{"default":["${workspaceFolder}/**/*.(m|c|)js","!**/node_modules/**"],"description":"Якщо карти джерел увімкнені, ці шаблони glob вказують на згенеровані файли JavaScript. Якщо шаблон починається з `!`, файли виключаються. Якщо не вказано, згенерований код очікується в тому ж каталозі, що й його джерело.","items":{"type":"string"},"tags":["setup"],"type":["array"]},"outputCapture":{"default":"console","enum":["console","std"],"markdownDescription":"Звідки захоплювати вихідні повідомлення: за замовчуванням API налагодження, якщо встановлено `console`, або потоки stdout/stderr, якщо встановлено `std`."},"pauseForSourceMap":{"default":false,"markdownDescription":"Чи чекати на завантаження карт джерел для кожного вхідного скрипта. Це має накладні витрати на продуктивність і може бути безпечно вимкнено при виконанні з диска, якщо `rootPath` не вимкнено.","type":"boolean"},"remoteRoot":{"default":null,"description":"Абсолютний шлях до віддаленого каталогу, що містить програму.","type":["string","null"]},"resolveSourceMapLocations":{"default":["${workspaceFolder}/**","!**/node_modules/**"],"description":"Список патернів minimatch для місць (папок та URL), в яких карти джерел можуть бути використані для вирішення локальних файлів. Це можна використовувати, щоб уникнути неправильного розриву в зовнішньому коді з картами джерел. Патерни можуть бути префіксовані знаком \"!\", щоб виключити їх. Може бути встановлено на порожній масив або null, щоб уникнути обмежень.","items":{"type":"string"},"type":["array","null"]},"runtimeSourcemapPausePatterns":{"default":[],"items":{"type":"string"},"markdownDescription":"Список шаблонів, за якими можна вручну вставити точки зупинки вхідної точки. Це може бути корисно, щоб надати відладчику можливість встановити точки зупинки при використанні sourcemaps, які не існують або не можуть бути виявлені до запуску, наприклад, [з фреймворком Serverless](https://github.com/microsoft/vscode-js-debug/issues/492).","type":"array"},"showAsyncStacks":{"default":true,"description":"Показати асинхронні виклики, які призвели до поточного стеку викликів.","oneOf":[{"type":"boolean"},{"properties":{"onAttach":{"default":32,"type":"number"}},"required":["onAttach"],"type":"object"},{"properties":{"onceBreakpointResolved":{"default":32,"type":"number"}},"required":["onceBreakpointResolved"],"type":"object"}]},"skipFiles":{"default":["${/**"],"description":"Масив імен файлів або папок, або шаблонів шляхів, які слід пропустити під час налагодження. Дозволені зіркові шаблони та заперечення, наприклад, `[\"**/node_modules/**\", \"!**/node_modules/my-module/**\"]`","type":"array"},"smartStep":{"default":true,"description":"Автоматично проходьте через згенерований код, який не може бути відображений назад до оригінального джерела.","type":"boolean"},"sourceMapPathOverrides":{"default":{"meteor://💻app/*":"${workspaceFolder}/*","webpack:///./~/*":"${workspaceFolder}/node_modules/*","webpack://?:*/*":"${workspaceFolder}/*"},"description":"Набір відображень для переписування місць розташування вихідних файлів з того, що вказує sourcemap, на їхні місця на диску.","type":"object"},"sourceMapRenames":{"default":true,"description":"Чи використовувати відображення \"names\" у sourcemaps. Це вимагає запиту на отримання вихідного контенту, що може бути повільним з певними налагоджувачами.","type":"boolean"},"sourceMaps":{"default":true,"description":"Використовуйте карти джерел JavaScript (якщо вони існують).","type":"boolean"},"timeout":{"default":10000,"description":"Спробуйте знову протягом цього числа мілісекунд для підключення до Node.js. За замовчуванням 10000 мс.","type":"number"},"timeouts":{"additionalProperties":false,"default":{},"description":"Тайм-аути для кількох операцій налагодження.","markdownDescription":"Таймаути для кількох операцій налагоджувача.","properties":{"hoverEvaluation":{"default":500,"description":"Час до оцінки значення для символів, на які наведено курсор, скасовується. Якщо встановлено 0, оцінка при наведенні ніколи не закінчується.","type":"number"},"sourceMapCumulativePause":{"default":1000,"description":"Додатковий час у мілісекундах, дозволений за сесію для очікування обробки source-map, після того як мінімальний час (sourceMapMinPause) буде вичерпано","type":"number"},"sourceMapMinPause":{"default":1000,"description":"Мінімальний час у мілісекундах, витрачений на очікування обробки кожної source-map під час парсингу скрипта","type":"number"}},"type":"object"},"trace":{"default":true,"description":"Налаштовує, який діагностичний вивід буде створено.","oneOf":[{"description":"Trace може бути встановлено на 'true', щоб записувати діагностичні журнали на диск.","type":"boolean"},{"additionalProperties":false,"properties":{"logFile":{"description":"Налаштовує, де на диску записуються журнали.","type":["string","null"]},"stdio":{"description":"Чи повертати дані трасування з запущеного додатку або браузера.","type":"boolean"}},"type":"object"}]}},"type":"object"}]},"showAsyncStacks":{"default":true,"description":"Показати асинхронні виклики, які призвели до поточного стеку викликів.","oneOf":[{"type":"boolean"},{"properties":{"onAttach":{"default":32,"type":"number"}},"required":["onAttach"],"type":"object"},{"properties":{"onceBreakpointResolved":{"default":32,"type":"number"}},"required":["onceBreakpointResolved"],"type":"object"}]},"skipFiles":{"default":["${/**"],"description":"Масив імен файлів або папок, або шаблонів шляхів, які слід пропустити під час налагодження. Дозволені зіркові шаблони та заперечення, наприклад, `[\"**/node_modules/**\", \"!**/node_modules/my-module/**\"]`","type":"array"},"smartStep":{"default":true,"description":"Автоматично проходьте через згенерований код, який не може бути відображений назад до оригінального джерела.","type":"boolean"},"sourceMapPathOverrides":{"default":{"meteor://💻app/*":"${workspaceFolder}/*","webpack:///./~/*":"${workspaceFolder}/node_modules/*","webpack://?:*/*":"${workspaceFolder}/*"},"description":"Набір відображень для переписування місць розташування вихідних файлів з того, що вказує sourcemap, на їхні місця на диску.","type":"object"},"sourceMapRenames":{"default":true,"description":"Чи використовувати відображення \"names\" у sourcemaps. Це вимагає запиту на отримання вихідного контенту, що може бути повільним з певними налагоджувачами.","type":"boolean"},"sourceMaps":{"default":true,"description":"Використовуйте карти джерел JavaScript (якщо вони існують).","type":"boolean"},"targetSelection":{"default":"automatic","enum":["pick","automatic"],"markdownDescription":"Чи прикріпити до всіх цілей, які відповідають фільтру URL (\"автоматично\"), чи запитати вибрати одну (\"вибрати\").","type":"string"},"timeout":{"default":10000,"description":"Спробуйте знову протягом цього числа мілісекунд для підключення до Node.js. За замовчуванням 10000 мс.","type":"number"},"timeouts":{"additionalProperties":false,"default":{},"description":"Тайм-аути для кількох операцій налагодження.","markdownDescription":"Таймаути для кількох операцій налагоджувача.","properties":{"hoverEvaluation":{"default":500,"description":"Час до оцінки значення для символів, на які наведено курсор, скасовується. Якщо встановлено 0, оцінка при наведенні ніколи не закінчується.","type":"number"},"sourceMapCumulativePause":{"default":1000,"description":"Додатковий час у мілісекундах, дозволений за сесію для очікування обробки source-map, після того як мінімальний час (sourceMapMinPause) буде вичерпано","type":"number"},"sourceMapMinPause":{"default":1000,"description":"Мінімальний час у мілісекундах, витрачений на очікування обробки кожної source-map під час парсингу скрипта","type":"number"}},"type":"object"},"trace":{"default":true,"description":"Налаштовує, який діагностичний вивід буде створено.","oneOf":[{"description":"Trace може бути встановлено на 'true', щоб записувати діагностичні журнали на диск.","type":"boolean"},{"additionalProperties":false,"properties":{"logFile":{"description":"Налаштовує, де на диску записуються журнали.","type":["string","null"]},"stdio":{"description":"Чи повертати дані трасування з запущеного додатку або браузера.","type":"boolean"}},"type":"object"}]},"url":{"default":"http://localhost:8080","description":"Шукатиме вкладку з цим точним URL і приєднається до неї, якщо буде знайдена","tags":["setup"],"type":"string"},"urlFilter":{"default":"","description":"Шукатиме сторінку з цим URL і прикріпить до неї, якщо знайде. Можуть бути * підстановочні знаки.","type":"string"},"vueComponentPaths":{"default":["${workspaceFolder}/**/*.vue"],"description":"Список шаблонів глобусів файлів для знаходження `*.vue` компонентів. За замовчуванням, здійснює пошук по всьому робочому простору. Це потрібно вказати через додаткові запити, які потребують мапи джерел Vue в Vue CLI 4. Ви можете вимкнути це спеціальне оброблення, встановивши це в порожній масив.","type":"array"},"webRoot":{"default":"${workspaceFolder}","description":"Це вказує абсолютний шлях до кореня веб-сервера в робочому просторі. Використовується для вирішення шляхів, таких як `/app.js`, до файлів на диску. Скорочення для pathMapping для \"/\"","tags":["setup"],"type":"string"}},"type":"object"},"resolveSourceMapLocations":{"default":["${workspaceFolder}/**","!**/node_modules/**"],"description":"Список патернів minimatch для місць (папок та URL), в яких карти джерел можуть бути використані для вирішення локальних файлів. Це можна використовувати, щоб уникнути неправильного розриву в зовнішньому коді з картами джерел. Патерни можуть бути префіксовані знаком \"!\", щоб виключити їх. Може бути встановлено на порожній масив або null, щоб уникнути обмежень.","items":{"type":"string"},"type":["array","null"]},"runtimeExecutable":{"default":"node","markdownDescription":"Абсолютний шлях до VS Code.","type":["string","null"]},"runtimeSourcemapPausePatterns":{"default":[],"items":{"type":"string"},"markdownDescription":"Список шаблонів, за якими можна вручну вставити точки зупинки вхідної точки. Це може бути корисно, щоб надати відладчику можливість встановити точки зупинки при використанні sourcemaps, які не існують або не можуть бути виявлені до запуску, наприклад, [з фреймворком Serverless](https://github.com/microsoft/vscode-js-debug/issues/492).","type":"array"},"showAsyncStacks":{"default":true,"description":"Показати асинхронні виклики, які призвели до поточного стеку викликів.","oneOf":[{"type":"boolean"},{"properties":{"onAttach":{"default":32,"type":"number"}},"required":["onAttach"],"type":"object"},{"properties":{"onceBreakpointResolved":{"default":32,"type":"number"}},"required":["onceBreakpointResolved"],"type":"object"}]},"skipFiles":{"default":["${/**"],"description":"Масив імен файлів або папок, або шаблонів шляхів, які слід пропустити під час налагодження. Дозволені зіркові шаблони та заперечення, наприклад, `[\"**/node_modules/**\", \"!**/node_modules/my-module/**\"]`","type":"array"},"smartStep":{"default":true,"description":"Автоматично проходьте через згенерований код, який не може бути відображений назад до оригінального джерела.","type":"boolean"},"sourceMapPathOverrides":{"default":{"meteor://💻app/*":"${workspaceFolder}/*","webpack:///./~/*":"${workspaceFolder}/node_modules/*","webpack://?:*/*":"${workspaceFolder}/*"},"description":"Набір відображень для переписування місць розташування вихідних файлів з того, що вказує sourcemap, на їхні місця на диску.","type":"object"},"sourceMapRenames":{"default":true,"description":"Чи використовувати відображення \"names\" у sourcemaps. Це вимагає запиту на отримання вихідного контенту, що може бути повільним з певними налагоджувачами.","type":"boolean"},"sourceMaps":{"default":true,"description":"Використовуйте карти джерел JavaScript (якщо вони існують).","type":"boolean"},"testConfiguration":{"default":"${workspaceFolder}/.vscode-test.js","markdownDescription":"Шлях до файлу конфігурації тесту для [test CLI](https://code.visualstudio.com/api/working-with-extensions/testing-extension#quick-setup-the-test-cli).","type":"string"},"testConfigurationLabel":{"default":"","markdownDescription":"Одна конфігурація для запуску з файлу. Якщо не вказано, вас можуть попросити вибрати.","type":"string"},"timeout":{"default":10000,"description":"Спробуйте знову протягом цього числа мілісекунд для підключення до Node.js. За замовчуванням 10000 мс.","type":"number"},"timeouts":{"additionalProperties":false,"default":{},"description":"Тайм-аути для кількох операцій налагодження.","markdownDescription":"Таймаути для кількох операцій налагоджувача.","properties":{"hoverEvaluation":{"default":500,"description":"Час до оцінки значення для символів, на які наведено курсор, скасовується. Якщо встановлено 0, оцінка при наведенні ніколи не закінчується.","type":"number"},"sourceMapCumulativePause":{"default":1000,"description":"Додатковий час у мілісекундах, дозволений за сесію для очікування обробки source-map, після того як мінімальний час (sourceMapMinPause) буде вичерпано","type":"number"},"sourceMapMinPause":{"default":1000,"description":"Мінімальний час у мілісекундах, витрачений на очікування обробки кожної source-map під час парсингу скрипта","type":"number"}},"type":"object"},"trace":{"default":true,"description":"Налаштовує, який діагностичний вивід буде створено.","oneOf":[{"description":"Trace може бути встановлено на 'true', щоб записувати діагностичні журнали на диск.","type":"boolean"},{"additionalProperties":false,"properties":{"logFile":{"description":"Налаштовує, де на диску записуються журнали.","type":["string","null"]},"stdio":{"description":"Чи повертати дані трасування з запущеного додатку або браузера.","type":"boolean"}},"type":"object"}]}},"required":[]}},"configurationSnippets":[{"body":{"args":["^\"--extensionDevelopmentPath=\\${workspaceFolder}\""],"name":"Запустити розширення","outFiles":["^\"\\${workspaceFolder}/out/**/*.js\""],"preLaunchTask":"npm","request":"launch","type":"extensionHost"},"description":"Запустіть розширення VS Code в режимі налагодження","label":"Розробка розширень для VS Code"}],"label":"Розробка розширень для VS Code","strings":{"unverifiedBreakpoints":"Деякі з ваших точок зупинки не можуть бути встановлені. Якщо у вас виникає проблема, ви можете [усунути неполадки у вашій конфігурації запуску](command:extension.js-debug.createDiagnostics)."},"type":"extensionHost"},{"aiKey":"0c6ae279ed8443289764825290e4f9e2-1a736e7c-1324-4338-be46-fc2a58ae4d14-7255","configurationAttributes":{"attach":{"properties":{"address":{"default":"localhost","description":"IP-адреса або ім'я хоста, на якому слухає налагоджений браузер.","type":"string"},"browserAttachLocation":{"default":null,"description":"Примушує браузер підключатися в одному місці. У віддаленому робочому просторі (через ssh або WSL, наприклад) це можна використовувати для підключення до браузера на віддаленій машині, а не локально.","oneOf":[{"type":"null"},{"enum":["ui","workspace"],"type":"string"}]},"cascadeTerminateToConfigurations":{"default":[],"description":"Список сеансів налагодження, які, коли цей сеанс налагодження буде завершено, також будуть зупинені.","items":{"type":"string","uniqueItems":true},"type":"array"},"customDescriptionGenerator":{"description":"Налаштуйте текстовий опис, який відображає відладчик для об'єктів (локальних змінних тощо...). Приклади:\n      1. this.toString() // викликає toString для виведення всіх об'єктів\n      2. this.customDescription ? this.customDescription() : defaultValue // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть defaultValue\n      3. function (def) { return this.customDescription ? this.customDescription() : def } // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть defaultValue\n      ","type":"string"},"customPropertiesGenerator":{"deprecated":true,"description":"Налаштуйте властивості, які відображаються для об'єкта в налагоджувачі (локальні змінні тощо...). Приклади:\n    1. { ...this, extraProperty: '12345' } // Додати extraProperty 12345 до всіх об'єктів\n    2. this.customProperties ? this.customProperties() : this // Використовуйте метод customProperties, якщо він доступний, якщо ні - використовуйте властивості в this (за замовчуванням)\n    3. function () { return this.customProperties ? this.customProperties() : this } // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть властивості за замовчуванням\n\n    Застаріло: Це тимчасова реалізація цієї функції, поки ми не матимемо часу реалізувати її в спосіб, описаний тут: https://github.com/microsoft/vscode/issues/102181","type":"string"},"disableNetworkCache":{"default":true,"description":"Контролює, чи пропускати мережевий кеш для кожного запиту","type":"boolean"},"enableContentValidation":{"default":true,"description":"Перемикає, чи перевіряємо ми, що вміст файлів на диску відповідає завантаженим у час виконання. Це корисно в різних сценаріях і є обов'язковим у деяких, але може викликати проблеми, якщо у вас є серверна трансформація скриптів, наприклад.","type":"boolean"},"enableDWARF":{"default":true,"markdownDescription":"Перемикає, чи буде відладчик намагатися зчитувати символи налагодження DWARF з WebAssembly, що може вимагати багато ресурсів. Для роботи потрібен розширення `ms-vscode.wasm-dwarf-debugging`.","type":"boolean"},"inspectUri":{"default":null,"description":"Формат, який потрібно використовувати для переписування inspectUri: Це шаблонний рядок, який інтерполює ключі в `{curlyBraces}`. Доступні ключі:\n - `url.*` - це розпарсена адреса запущеного застосунку. Наприклад, `{url.port}`, `{url.hostname}`\n - `port` - це порт налагодження, на якому слухає Chrome.\n - `browserInspectUri` - це URI інспектора на запущеному браузері.\n - `browserInspectUriPath` - це частина шляху URI інспектора на запущеному браузері (наприклад: \"/devtools/browser/e9ec0098-306e-472a-8133-5e42488929c2\").\n - `wsProtocol` - це вказаний протокол вебсокетів. Це встановлюється на `wss`, якщо оригінальна URL-адреса є `https`, або `ws` в іншому випадку.","type":["string","null"]},"outFiles":{"default":["${workspaceFolder}/**/*.(m|c|)js","!**/node_modules/**"],"description":"Якщо карти джерел увімкнені, ці шаблони glob вказують на згенеровані файли JavaScript. Якщо шаблон починається з `!`, файли виключаються. Якщо не вказано, згенерований код очікується в тому ж каталозі, що й його джерело.","items":{"type":"string"},"tags":["setup"],"type":["array"]},"outputCapture":{"default":"console","enum":["console","std"],"markdownDescription":"Звідки захоплювати вихідні повідомлення: за замовчуванням API налагодження, якщо встановлено `console`, або потоки stdout/stderr, якщо встановлено `std`."},"pathMapping":{"default":{},"description":"Відображення URL/шляхів на локальні папки, щоб вирішити скрипти в браузері на скрипти на диску","type":"object"},"pauseForSourceMap":{"default":false,"markdownDescription":"Чи чекати на завантаження карт джерел для кожного вхідного скрипта. Це має накладні витрати на продуктивність і може бути безпечно вимкнено при виконанні з диска, якщо `rootPath` не вимкнено.","type":"boolean"},"perScriptSourcemaps":{"default":"auto","description":"Чи завантажуються скрипти окремо з унікальними sourcemaps, що містять базову назву вихідного файлу. Це можна налаштувати для оптимізації обробки sourcemap при роботі з великою кількістю малих скриптів. Якщо встановлено \"auto\", ми виявимо відомі випадки, коли це доречно.","enum":["yes","no","auto"],"type":"string"},"port":{"default":9229,"description":"Порт, який використовувати для віддаленого налагодження браузера, вказується як `--remote-debugging-port` під час запуску браузера.","oneOf":[{"type":"integer"},{"pattern":"^\\${.*}$","type":"string"}],"tags":["setup"]},"resolveSourceMapLocations":{"default":null,"description":"Список патернів minimatch для місць (папок та URL), в яких карти джерел можуть бути використані для вирішення локальних файлів. Це можна використовувати, щоб уникнути неправильного розриву в зовнішньому коді з картами джерел. Патерни можуть бути префіксовані знаком \"!\", щоб виключити їх. Може бути встановлено на порожній масив або null, щоб уникнути обмежень.","items":{"type":"string"},"type":["array","null"]},"restart":{"default":false,"markdownDescription":"Чи підключитися знову, якщо з'єднання браузера закрито","type":"boolean"},"server":{"oneOf":[{"additionalProperties":false,"default":{"program":"node my-server.js"},"description":"Налаштовує веб-сервер для запуску. Використовує таку ж конфігурацію, як і завдання запуску 'node'.","properties":{"args":{"default":[],"description":"Аргументи командного рядка, передані програмі.\n\nМожуть бути масивом рядків або єдиним рядком. Коли програма запускається в терміналі, встановлення цієї властивості в єдиний рядок призведе до того, що аргументи не будуть екрановані для оболонки.","items":{"type":"string"},"tags":["setup"],"type":["array","string"]},"attachSimplePort":{"default":9229,"description":"Якщо встановлено, приєднується до процесу через вказаний порт. Це зазвичай більше не є необхідним для програм Node.js і втрачає можливість налагодження дочірніх процесів, але може бути корисним у більш екзотичних сценаріях, таких як запуск з Deno та Docker. Якщо встановлено на 0, буде вибрано випадковий порт, і --inspect-brk буде автоматично додано до аргументів запуску.","oneOf":[{"type":"integer"},{"pattern":"^\\${.*}$","type":"string"}]},"autoAttachChildProcesses":{"default":true,"description":"Автоматично підключати налагоджувач до нових дочірніх процесів.","type":"boolean"},"cascadeTerminateToConfigurations":{"default":[],"description":"Список сеансів налагодження, які, коли цей сеанс налагодження буде завершено, також будуть зупинені.","items":{"type":"string","uniqueItems":true},"type":"array"},"console":{"default":"internalConsole","description":"Де запустити ціль налагодження.","enum":["internalConsole","integratedTerminal","externalTerminal"],"enumDescriptions":["Консоль налагодження VS Code (яка не підтримує читання введення з програми)","інтегрований термінал VS Code","Зовнішній термінал, який можна налаштувати через налаштування користувача"],"type":"string"},"customDescriptionGenerator":{"description":"Налаштуйте текстовий опис, який відображає відладчик для об'єктів (локальних змінних тощо...). Приклади:\n      1. this.toString() // викликає toString для виведення всіх об'єктів\n      2. this.customDescription ? this.customDescription() : defaultValue // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть defaultValue\n      3. function (def) { return this.customDescription ? this.customDescription() : def } // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть defaultValue\n      ","type":"string"},"customPropertiesGenerator":{"deprecated":true,"description":"Налаштуйте властивості, які відображаються для об'єкта в налагоджувачі (локальні змінні тощо...). Приклади:\n    1. { ...this, extraProperty: '12345' } // Додати extraProperty 12345 до всіх об'єктів\n    2. this.customProperties ? this.customProperties() : this // Використовуйте метод customProperties, якщо він доступний, якщо ні - використовуйте властивості в this (за замовчуванням)\n    3. function () { return this.customProperties ? this.customProperties() : this } // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть властивості за замовчуванням\n\n    Застаріло: Це тимчасова реалізація цієї функції, поки ми не матимемо часу реалізувати її в спосіб, описаний тут: https://github.com/microsoft/vscode/issues/102181","type":"string"},"cwd":{"default":"${workspaceFolder}","description":"Абсолютний шлях до робочого каталогу програми, що налагоджується. Якщо ви встановили localRoot, тоді cwd відповідатиме цьому значенню, інакше він повернеться до вашого workspaceFolder.","tags":["setup"],"type":"string"},"enableContentValidation":{"default":true,"description":"Перемикає, чи перевіряємо ми, що вміст файлів на диску відповідає завантаженим у час виконання. Це корисно в різних сценаріях і є обов'язковим у деяких, але може викликати проблеми, якщо у вас є серверна трансформація скриптів, наприклад.","type":"boolean"},"enableDWARF":{"default":true,"markdownDescription":"Перемикає, чи буде відладчик намагатися зчитувати символи налагодження DWARF з WebAssembly, що може вимагати багато ресурсів. Для роботи потрібен розширення `ms-vscode.wasm-dwarf-debugging`.","type":"boolean"},"env":{"additionalProperties":{"type":["string","null"]},"default":{},"markdownDescription":"Змінні середовища, передані програмі. Значення `null` видаляє змінну з середовища.","tags":["setup"],"type":"object"},"envFile":{"default":"${workspaceFolder}/.env","description":"Абсолютний шлях до файлу, що містить визначення змінних середовища.","type":"string"},"experimentalNetworking":{"default":"auto","description":"Увімкніть експериментальну перевірку в Node.js. Коли встановлено `auto`, це увімкнено для версій Node.js, які це підтримують. Його можна встановити на `on` або `off`, щоб увімкнути або вимкнути його явно.","enum":["auto","on","off"],"type":"string"},"killBehavior":{"default":"forceful","enum":["forceful","polite","none"],"markdownDescription":"Налаштовує, як процеси налагодження зупиняються при завершенні сеансу. Може бути:\n\n- примусовим (за замовчуванням): примусово знищує дерево процесів. Надсилає SIGKILL на posix або `taskkill.exe /F` на Windows.\n- ввічливим: м’яко знищує дерево процесів. Можливо, що некоректно працюючі процеси продовжать виконуватись після завершення таким чином. Надсилає SIGTERM на posix або `taskkill.exe` без прапора `/F` (примус) на Windows.\n- жодного: жодного завершення не відбудеться.","type":"string"},"localRoot":{"default":null,"description":"Шлях до локального каталогу, що містить програму.","type":["string","null"]},"nodeVersionHint":{"default":12,"description":"Дозволяє вам явно вказати версію Node, яка працює, що може бути використано для вимкнення або ввімкнення певних поведінок у випадках, коли автоматичне визначення версії не працює.","minimum":8,"type":"number"},"outFiles":{"default":["${workspaceFolder}/**/*.(m|c|)js","!**/node_modules/**"],"description":"Якщо карти джерел увімкнені, ці шаблони glob вказують на згенеровані файли JavaScript. Якщо шаблон починається з `!`, файли виключаються. Якщо не вказано, згенерований код очікується в тому ж каталозі, що й його джерело.","items":{"type":"string"},"tags":["setup"],"type":["array"]},"outputCapture":{"default":"console","enum":["console","std"],"markdownDescription":"Звідки захоплювати вихідні повідомлення: за замовчуванням API налагодження, якщо встановлено `console`, або потоки stdout/stderr, якщо встановлено `std`."},"pauseForSourceMap":{"default":false,"markdownDescription":"Чи чекати на завантаження карт джерел для кожного вхідного скрипта. Це має накладні витрати на продуктивність і може бути безпечно вимкнено при виконанні з диска, якщо `rootPath` не вимкнено.","type":"boolean"},"profileStartup":{"default":true,"description":"Якщо це правда, почне профілювання, як тільки процес запуститься","type":"boolean"},"program":{"default":"","description":"Абсолютний шлях до програми. Згенероване значення визначається шляхом аналізу package.json та відкритих файлів. Відредагуйте цей атрибут.","tags":["setup"],"type":"string"},"remoteRoot":{"default":null,"description":"Абсолютний шлях до віддаленого каталогу, що містить програму.","type":["string","null"]},"resolveSourceMapLocations":{"default":["${workspaceFolder}/**","!**/node_modules/**"],"description":"Список патернів minimatch для місць (папок та URL), в яких карти джерел можуть бути використані для вирішення локальних файлів. Це можна використовувати, щоб уникнути неправильного розриву в зовнішньому коді з картами джерел. Патерни можуть бути префіксовані знаком \"!\", щоб виключити їх. Може бути встановлено на порожній масив або null, щоб уникнути обмежень.","items":{"type":"string"},"type":["array","null"]},"restart":{"default":true,"description":"Спробуйте перепідключитися до програми, якщо ми втратимо з'єднання. Якщо встановлено `true`, ми будемо намагатися раз на секунду, вічно. Ви можете налаштувати інтервал і максимальну кількість спроб, вказавши `delay` та `maxAttempts` в об'єкті замість цього.","oneOf":[{"type":"boolean"},{"properties":{"delay":{"default":1000,"minimum":0,"type":"number"},"maxAttempts":{"default":10,"minimum":0,"type":"number"}},"type":"object"}]},"runtimeArgs":{"default":[],"description":"Необов'язкові аргументи, передані виконуваному файлу часу виконання.","items":{"type":"string"},"tags":["setup"],"type":"array"},"runtimeExecutable":{"default":"node","markdownDescription":"Час виконання для використання. Або абсолютний шлях, або ім'я часу виконання, доступного в PATH. Якщо пропущено, вважається, що використовується `node`.","type":["string","null"]},"runtimeSourcemapPausePatterns":{"default":[],"items":{"type":"string"},"markdownDescription":"Список шаблонів, за якими можна вручну вставити точки зупинки вхідної точки. Це може бути корисно, щоб надати відладчику можливість встановити точки зупинки при використанні sourcemaps, які не існують або не можуть бути виявлені до запуску, наприклад, [з фреймворком Serverless](https://github.com/microsoft/vscode-js-debug/issues/492).","type":"array"},"runtimeVersion":{"default":"default","markdownDescription":"Версія середовища виконання `node`, яку слід використовувати. Потрібен `nvm`.","type":"string"},"showAsyncStacks":{"default":true,"description":"Показати асинхронні виклики, які призвели до поточного стеку викликів.","oneOf":[{"type":"boolean"},{"properties":{"onAttach":{"default":32,"type":"number"}},"required":["onAttach"],"type":"object"},{"properties":{"onceBreakpointResolved":{"default":32,"type":"number"}},"required":["onceBreakpointResolved"],"type":"object"}]},"skipFiles":{"default":["${/**"],"description":"Масив імен файлів або папок, або шаблонів шляхів, які слід пропустити під час налагодження. Дозволені зіркові шаблони та заперечення, наприклад, `[\"**/node_modules/**\", \"!**/node_modules/my-module/**\"]`","type":"array"},"smartStep":{"default":true,"description":"Автоматично проходьте через згенерований код, який не може бути відображений назад до оригінального джерела.","type":"boolean"},"sourceMapPathOverrides":{"default":{"meteor://💻app/*":"${workspaceFolder}/*","webpack:///./~/*":"${workspaceFolder}/node_modules/*","webpack://?:*/*":"${workspaceFolder}/*"},"description":"Набір відображень для переписування місць розташування вихідних файлів з того, що вказує sourcemap, на їхні місця на диску.","type":"object"},"sourceMapRenames":{"default":true,"description":"Чи використовувати відображення \"names\" у sourcemaps. Це вимагає запиту на отримання вихідного контенту, що може бути повільним з певними налагоджувачами.","type":"boolean"},"sourceMaps":{"default":true,"description":"Використовуйте карти джерел JavaScript (якщо вони існують).","type":"boolean"},"stopOnEntry":{"default":true,"description":"Автоматично зупинити програму після запуску.","type":["boolean","string"]},"timeout":{"default":10000,"description":"Спробуйте знову протягом цього числа мілісекунд для підключення до Node.js. За замовчуванням 10000 мс.","type":"number"},"timeouts":{"additionalProperties":false,"default":{},"description":"Тайм-аути для кількох операцій налагодження.","markdownDescription":"Таймаути для кількох операцій налагоджувача.","properties":{"hoverEvaluation":{"default":500,"description":"Час до оцінки значення для символів, на які наведено курсор, скасовується. Якщо встановлено 0, оцінка при наведенні ніколи не закінчується.","type":"number"},"sourceMapCumulativePause":{"default":1000,"description":"Додатковий час у мілісекундах, дозволений за сесію для очікування обробки source-map, після того як мінімальний час (sourceMapMinPause) буде вичерпано","type":"number"},"sourceMapMinPause":{"default":1000,"description":"Мінімальний час у мілісекундах, витрачений на очікування обробки кожної source-map під час парсингу скрипта","type":"number"}},"type":"object"},"trace":{"default":true,"description":"Налаштовує, який діагностичний вивід буде створено.","oneOf":[{"description":"Trace може бути встановлено на 'true', щоб записувати діагностичні журнали на диск.","type":"boolean"},{"additionalProperties":false,"properties":{"logFile":{"description":"Налаштовує, де на диску записуються журнали.","type":["string","null"]},"stdio":{"description":"Чи повертати дані трасування з запущеного додатку або браузера.","type":"boolean"}},"type":"object"}]}},"type":"object"},{"additionalProperties":false,"default":{"program":"npm start"},"description":"Термінал налагодження JavaScript","properties":{"autoAttachChildProcesses":{"default":true,"description":"Автоматично підключати налагоджувач до нових дочірніх процесів.","type":"boolean"},"cascadeTerminateToConfigurations":{"default":[],"description":"Список сеансів налагодження, які, коли цей сеанс налагодження буде завершено, також будуть зупинені.","items":{"type":"string","uniqueItems":true},"type":"array"},"command":{"default":"npm start","description":"Команда для виконання в запущеному терміналі. Якщо не вказано, термінал відкриється без запуску програми.","tags":["setup"],"type":["string","null"]},"customDescriptionGenerator":{"description":"Налаштуйте текстовий опис, який відображає відладчик для об'єктів (локальних змінних тощо...). Приклади:\n      1. this.toString() // викликає toString для виведення всіх об'єктів\n      2. this.customDescription ? this.customDescription() : defaultValue // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть defaultValue\n      3. function (def) { return this.customDescription ? this.customDescription() : def } // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть defaultValue\n      ","type":"string"},"customPropertiesGenerator":{"deprecated":true,"description":"Налаштуйте властивості, які відображаються для об'єкта в налагоджувачі (локальні змінні тощо...). Приклади:\n    1. { ...this, extraProperty: '12345' } // Додати extraProperty 12345 до всіх об'єктів\n    2. this.customProperties ? this.customProperties() : this // Використовуйте метод customProperties, якщо він доступний, якщо ні - використовуйте властивості в this (за замовчуванням)\n    3. function () { return this.customProperties ? this.customProperties() : this } // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть властивості за замовчуванням\n\n    Застаріло: Це тимчасова реалізація цієї функції, поки ми не матимемо часу реалізувати її в спосіб, описаний тут: https://github.com/microsoft/vscode/issues/102181","type":"string"},"cwd":{"default":"${workspaceFolder}","description":"Абсолютний шлях до робочого каталогу програми, що налагоджується. Якщо ви встановили localRoot, тоді cwd відповідатиме цьому значенню, інакше він повернеться до вашого workspaceFolder.","docDefault":"localRoot || ${workspaceFolder}","tags":["setup"],"type":"string"},"enableContentValidation":{"default":true,"description":"Перемикає, чи перевіряємо ми, що вміст файлів на диску відповідає завантаженим у час виконання. Це корисно в різних сценаріях і є обов'язковим у деяких, але може викликати проблеми, якщо у вас є серверна трансформація скриптів, наприклад.","type":"boolean"},"enableDWARF":{"default":true,"markdownDescription":"Перемикає, чи буде відладчик намагатися зчитувати символи налагодження DWARF з WebAssembly, що може вимагати багато ресурсів. Для роботи потрібен розширення `ms-vscode.wasm-dwarf-debugging`.","type":"boolean"},"env":{"additionalProperties":{"type":["string","null"]},"default":{},"markdownDescription":"Змінні середовища, передані програмі. Значення `null` видаляє змінну з середовища.","tags":["setup"],"type":"object"},"envFile":{"default":"${workspaceFolder}/.env","description":"Абсолютний шлях до файлу, що містить визначення змінних середовища.","type":"string"},"localRoot":{"default":null,"description":"Шлях до локального каталогу, що містить програму.","type":["string","null"]},"nodeVersionHint":{"default":12,"description":"Дозволяє вам явно вказати версію Node, яка працює, що може бути використано для вимкнення або ввімкнення певних поведінок у випадках, коли автоматичне визначення версії не працює.","minimum":8,"type":"number"},"outFiles":{"default":["${workspaceFolder}/**/*.(m|c|)js","!**/node_modules/**"],"description":"Якщо карти джерел увімкнені, ці шаблони glob вказують на згенеровані файли JavaScript. Якщо шаблон починається з `!`, файли виключаються. Якщо не вказано, згенерований код очікується в тому ж каталозі, що й його джерело.","items":{"type":"string"},"tags":["setup"],"type":["array"]},"outputCapture":{"default":"console","enum":["console","std"],"markdownDescription":"Звідки захоплювати вихідні повідомлення: за замовчуванням API налагодження, якщо встановлено `console`, або потоки stdout/stderr, якщо встановлено `std`."},"pauseForSourceMap":{"default":false,"markdownDescription":"Чи чекати на завантаження карт джерел для кожного вхідного скрипта. Це має накладні витрати на продуктивність і може бути безпечно вимкнено при виконанні з диска, якщо `rootPath` не вимкнено.","type":"boolean"},"remoteRoot":{"default":null,"description":"Абсолютний шлях до віддаленого каталогу, що містить програму.","type":["string","null"]},"resolveSourceMapLocations":{"default":["${workspaceFolder}/**","!**/node_modules/**"],"description":"Список патернів minimatch для місць (папок та URL), в яких карти джерел можуть бути використані для вирішення локальних файлів. Це можна використовувати, щоб уникнути неправильного розриву в зовнішньому коді з картами джерел. Патерни можуть бути префіксовані знаком \"!\", щоб виключити їх. Може бути встановлено на порожній масив або null, щоб уникнути обмежень.","items":{"type":"string"},"type":["array","null"]},"runtimeSourcemapPausePatterns":{"default":[],"items":{"type":"string"},"markdownDescription":"Список шаблонів, за якими можна вручну вставити точки зупинки вхідної точки. Це може бути корисно, щоб надати відладчику можливість встановити точки зупинки при використанні sourcemaps, які не існують або не можуть бути виявлені до запуску, наприклад, [з фреймворком Serverless](https://github.com/microsoft/vscode-js-debug/issues/492).","type":"array"},"showAsyncStacks":{"default":true,"description":"Показати асинхронні виклики, які призвели до поточного стеку викликів.","oneOf":[{"type":"boolean"},{"properties":{"onAttach":{"default":32,"type":"number"}},"required":["onAttach"],"type":"object"},{"properties":{"onceBreakpointResolved":{"default":32,"type":"number"}},"required":["onceBreakpointResolved"],"type":"object"}]},"skipFiles":{"default":["${/**"],"description":"Масив імен файлів або папок, або шаблонів шляхів, які слід пропустити під час налагодження. Дозволені зіркові шаблони та заперечення, наприклад, `[\"**/node_modules/**\", \"!**/node_modules/my-module/**\"]`","type":"array"},"smartStep":{"default":true,"description":"Автоматично проходьте через згенерований код, який не може бути відображений назад до оригінального джерела.","type":"boolean"},"sourceMapPathOverrides":{"default":{"meteor://💻app/*":"${workspaceFolder}/*","webpack:///./~/*":"${workspaceFolder}/node_modules/*","webpack://?:*/*":"${workspaceFolder}/*"},"description":"Набір відображень для переписування місць розташування вихідних файлів з того, що вказує sourcemap, на їхні місця на диску.","type":"object"},"sourceMapRenames":{"default":true,"description":"Чи використовувати відображення \"names\" у sourcemaps. Це вимагає запиту на отримання вихідного контенту, що може бути повільним з певними налагоджувачами.","type":"boolean"},"sourceMaps":{"default":true,"description":"Використовуйте карти джерел JavaScript (якщо вони існують).","type":"boolean"},"timeout":{"default":10000,"description":"Спробуйте знову протягом цього числа мілісекунд для підключення до Node.js. За замовчуванням 10000 мс.","type":"number"},"timeouts":{"additionalProperties":false,"default":{},"description":"Тайм-аути для кількох операцій налагодження.","markdownDescription":"Таймаути для кількох операцій налагоджувача.","properties":{"hoverEvaluation":{"default":500,"description":"Час до оцінки значення для символів, на які наведено курсор, скасовується. Якщо встановлено 0, оцінка при наведенні ніколи не закінчується.","type":"number"},"sourceMapCumulativePause":{"default":1000,"description":"Додатковий час у мілісекундах, дозволений за сесію для очікування обробки source-map, після того як мінімальний час (sourceMapMinPause) буде вичерпано","type":"number"},"sourceMapMinPause":{"default":1000,"description":"Мінімальний час у мілісекундах, витрачений на очікування обробки кожної source-map під час парсингу скрипта","type":"number"}},"type":"object"},"trace":{"default":true,"description":"Налаштовує, який діагностичний вивід буде створено.","oneOf":[{"description":"Trace може бути встановлено на 'true', щоб записувати діагностичні журнали на диск.","type":"boolean"},{"additionalProperties":false,"properties":{"logFile":{"description":"Налаштовує, де на диску записуються журнали.","type":["string","null"]},"stdio":{"description":"Чи повертати дані трасування з запущеного додатку або браузера.","type":"boolean"}},"type":"object"}]}},"type":"object"}]},"showAsyncStacks":{"default":true,"description":"Показати асинхронні виклики, які призвели до поточного стеку викликів.","oneOf":[{"type":"boolean"},{"properties":{"onAttach":{"default":32,"type":"number"}},"required":["onAttach"],"type":"object"},{"properties":{"onceBreakpointResolved":{"default":32,"type":"number"}},"required":["onceBreakpointResolved"],"type":"object"}]},"skipFiles":{"default":["${/**"],"description":"Масив імен файлів або папок, або шаблонів шляхів, які слід пропустити під час налагодження. Дозволені зіркові шаблони та заперечення, наприклад, `[\"**/node_modules/**\", \"!**/node_modules/my-module/**\"]`","type":"array"},"smartStep":{"default":true,"description":"Автоматично проходьте через згенерований код, який не може бути відображений назад до оригінального джерела.","type":"boolean"},"sourceMapPathOverrides":{"default":{"meteor://💻app/*":"${workspaceFolder}/*","webpack:///./~/*":"${workspaceFolder}/node_modules/*","webpack://?:*/*":"${workspaceFolder}/*"},"description":"Набір відображень для переписування місць розташування вихідних файлів з того, що вказує sourcemap, на їхні місця на диску.","type":"object"},"sourceMapRenames":{"default":true,"description":"Чи використовувати відображення \"names\" у sourcemaps. Це вимагає запиту на отримання вихідного контенту, що може бути повільним з певними налагоджувачами.","type":"boolean"},"sourceMaps":{"default":true,"description":"Використовуйте карти джерел JavaScript (якщо вони існують).","type":"boolean"},"targetSelection":{"default":"automatic","enum":["pick","automatic"],"markdownDescription":"Чи прикріпити до всіх цілей, які відповідають фільтру URL (\"автоматично\"), чи запитати вибрати одну (\"вибрати\").","type":"string"},"timeout":{"default":10000,"description":"Спробуйте знову протягом цього числа мілісекунд для підключення до Node.js. За замовчуванням 10000 мс.","type":"number"},"timeouts":{"additionalProperties":false,"default":{},"description":"Тайм-аути для кількох операцій налагодження.","markdownDescription":"Таймаути для кількох операцій налагоджувача.","properties":{"hoverEvaluation":{"default":500,"description":"Час до оцінки значення для символів, на які наведено курсор, скасовується. Якщо встановлено 0, оцінка при наведенні ніколи не закінчується.","type":"number"},"sourceMapCumulativePause":{"default":1000,"description":"Додатковий час у мілісекундах, дозволений за сесію для очікування обробки source-map, після того як мінімальний час (sourceMapMinPause) буде вичерпано","type":"number"},"sourceMapMinPause":{"default":1000,"description":"Мінімальний час у мілісекундах, витрачений на очікування обробки кожної source-map під час парсингу скрипта","type":"number"}},"type":"object"},"trace":{"default":true,"description":"Налаштовує, який діагностичний вивід буде створено.","oneOf":[{"description":"Trace може бути встановлено на 'true', щоб записувати діагностичні журнали на диск.","type":"boolean"},{"additionalProperties":false,"properties":{"logFile":{"description":"Налаштовує, де на диску записуються журнали.","type":["string","null"]},"stdio":{"description":"Чи повертати дані трасування з запущеного додатку або браузера.","type":"boolean"}},"type":"object"}]},"url":{"default":"http://localhost:8080","description":"Шукатиме вкладку з цим точним URL і приєднається до неї, якщо буде знайдена","tags":["setup"],"type":"string"},"urlFilter":{"default":"","description":"Шукатиме сторінку з цим URL і прикріпить до неї, якщо знайде. Можуть бути * підстановочні знаки.","type":"string"},"vueComponentPaths":{"default":["${workspaceFolder}/**/*.vue"],"description":"Список шаблонів глобусів файлів для знаходження `*.vue` компонентів. За замовчуванням, здійснює пошук по всьому робочому простору. Це потрібно вказати через додаткові запити, які потребують мапи джерел Vue в Vue CLI 4. Ви можете вимкнути це спеціальне оброблення, встановивши це в порожній масив.","type":"array"},"webRoot":{"default":"${workspaceFolder}","description":"Це вказує абсолютний шлях до кореня веб-сервера в робочому просторі. Використовується для вирішення шляхів, таких як `/app.js`, до файлів на диску. Скорочення для pathMapping для \"/\"","tags":["setup"],"type":"string"}}},"launch":{"properties":{"browserLaunchLocation":{"default":null,"description":"Примушує браузер запускатися в одному місці. У віддаленому робочому просторі (наприклад, через ssh або WSL) це можна використовувати для відкриття браузера на віддаленій машині, а не локально.","oneOf":[{"type":"null"},{"enum":["ui","workspace"],"type":"string"}]},"cascadeTerminateToConfigurations":{"default":[],"description":"Список сеансів налагодження, які, коли цей сеанс налагодження буде завершено, також будуть зупинені.","items":{"type":"string","uniqueItems":true},"type":"array"},"cleanUp":{"default":"wholeBrowser","description":"Яке очищення потрібно зробити після завершення сеансу налагодження. Закрити лише вкладку, що налагоджується, проти закриття всього браузера.","enum":["wholeBrowser","onlyTab"],"type":"string"},"customDescriptionGenerator":{"description":"Налаштуйте текстовий опис, який відображає відладчик для об'єктів (локальних змінних тощо...). Приклади:\n      1. this.toString() // викликає toString для виведення всіх об'єктів\n      2. this.customDescription ? this.customDescription() : defaultValue // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть defaultValue\n      3. function (def) { return this.customDescription ? this.customDescription() : def } // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть defaultValue\n      ","type":"string"},"customPropertiesGenerator":{"deprecated":true,"description":"Налаштуйте властивості, які відображаються для об'єкта в налагоджувачі (локальні змінні тощо...). Приклади:\n    1. { ...this, extraProperty: '12345' } // Додати extraProperty 12345 до всіх об'єктів\n    2. this.customProperties ? this.customProperties() : this // Використовуйте метод customProperties, якщо він доступний, якщо ні - використовуйте властивості в this (за замовчуванням)\n    3. function () { return this.customProperties ? this.customProperties() : this } // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть властивості за замовчуванням\n\n    Застаріло: Це тимчасова реалізація цієї функції, поки ми не матимемо часу реалізувати її в спосіб, описаний тут: https://github.com/microsoft/vscode/issues/102181","type":"string"},"cwd":{"default":null,"description":"Необов'язкова робоча директорія для виконуваного файлу під час виконання.","type":"string"},"disableNetworkCache":{"default":true,"description":"Контролює, чи пропускати мережевий кеш для кожного запиту","type":"boolean"},"enableContentValidation":{"default":true,"description":"Перемикає, чи перевіряємо ми, що вміст файлів на диску відповідає завантаженим у час виконання. Це корисно в різних сценаріях і є обов'язковим у деяких, але може викликати проблеми, якщо у вас є серверна трансформація скриптів, наприклад.","type":"boolean"},"enableDWARF":{"default":true,"markdownDescription":"Перемикає, чи буде відладчик намагатися зчитувати символи налагодження DWARF з WebAssembly, що може вимагати багато ресурсів. Для роботи потрібен розширення `ms-vscode.wasm-dwarf-debugging`.","type":"boolean"},"env":{"default":{},"description":"Необов'язковий словник пар ключ/значення для середовища браузера.","type":"object"},"file":{"default":"${workspaceFolder}/index.html","description":"Локальний html файл для відкриття в браузері","tags":["setup"],"type":"string"},"includeDefaultArgs":{"default":true,"description":"Чи будуть включені аргументи запуску браузера за замовчуванням (для відключення функцій, які можуть ускладнити налагодження) у запуск.","type":"boolean"},"includeLaunchArgs":{"default":true,"description":"Розширені: чи встановлені будь-які аргументи за замовчуванням для запуску/налагодження в браузері. Налагоджувач припустить, що браузер використовуватиме налагодження через канал, таке як те, що надається з `--remote-debugging-pipe`.","type":"boolean"},"inspectUri":{"default":null,"description":"Формат, який потрібно використовувати для переписування inspectUri: Це шаблонний рядок, який інтерполює ключі в `{curlyBraces}`. Доступні ключі:\n - `url.*` - це розпарсена адреса запущеного застосунку. Наприклад, `{url.port}`, `{url.hostname}`\n - `port` - це порт налагодження, на якому слухає Chrome.\n - `browserInspectUri` - це URI інспектора на запущеному браузері.\n - `browserInspectUriPath` - це частина шляху URI інспектора на запущеному браузері (наприклад: \"/devtools/browser/e9ec0098-306e-472a-8133-5e42488929c2\").\n - `wsProtocol` - це вказаний протокол вебсокетів. Це встановлюється на `wss`, якщо оригінальна URL-адреса є `https`, або `ws` в іншому випадку.","type":["string","null"]},"killBehavior":{"default":"forceful","enum":["forceful","polite","none"],"markdownDescription":"Налаштовує, як браузерні процеси зупиняються при завершенні сесії з `cleanUp: wholeBrowser`. Може бути:\n\n- примусовим (за замовчуванням): примусово знищує дерево процесів. Надсилає SIGKILL на posix або `taskkill.exe /F` на Windows.\n- ввічливим: коректно знищує дерево процесів. Можливо, що неправильно працюючі процеси продовжать виконання після завершення в такий спосіб. Надсилає SIGTERM на posix або `taskkill.exe` без прапора `/F` (примус) на Windows.\n- жодного: жодне завершення не відбудеться.","type":"string"},"outFiles":{"default":["${workspaceFolder}/**/*.(m|c|)js","!**/node_modules/**"],"description":"Якщо карти джерел увімкнені, ці шаблони glob вказують на згенеровані файли JavaScript. Якщо шаблон починається з `!`, файли виключаються. Якщо не вказано, згенерований код очікується в тому ж каталозі, що й його джерело.","items":{"type":"string"},"tags":["setup"],"type":["array"]},"outputCapture":{"default":"console","enum":["console","std"],"markdownDescription":"Звідки захоплювати вихідні повідомлення: за замовчуванням API налагодження, якщо встановлено `console`, або потоки stdout/stderr, якщо встановлено `std`."},"pathMapping":{"default":{},"description":"Відображення URL/шляхів на локальні папки, щоб вирішити скрипти в браузері на скрипти на диску","type":"object"},"pauseForSourceMap":{"default":false,"markdownDescription":"Чи чекати на завантаження карт джерел для кожного вхідного скрипта. Це має накладні витрати на продуктивність і може бути безпечно вимкнено при виконанні з диска, якщо `rootPath` не вимкнено.","type":"boolean"},"perScriptSourcemaps":{"default":"auto","description":"Чи завантажуються скрипти окремо з унікальними sourcemaps, що містять базову назву вихідного файлу. Це можна налаштувати для оптимізації обробки sourcemap при роботі з великою кількістю малих скриптів. Якщо встановлено \"auto\", ми виявимо відомі випадки, коли це доречно.","enum":["yes","no","auto"],"type":"string"},"port":{"default":0,"description":"Порт, на якому браузер буде слухати. За замовчуванням - \"0\", що призведе до налагодження браузера через канали, що зазвичай є більш безпечним і має бути обрано, якщо вам не потрібно підключатися до браузера з іншого інструменту.","type":"number"},"profileStartup":{"default":true,"description":"Якщо це правда, почнемо профілювання, як тільки процес запуститься","type":"boolean"},"resolveSourceMapLocations":{"default":null,"description":"Список патернів minimatch для місць (папок та URL), в яких карти джерел можуть бути використані для вирішення локальних файлів. Це можна використовувати, щоб уникнути неправильного розриву в зовнішньому коді з картами джерел. Патерни можуть бути префіксовані знаком \"!\", щоб виключити їх. Може бути встановлено на порожній масив або null, щоб уникнути обмежень.","items":{"type":"string"},"type":["array","null"]},"runtimeArgs":{"default":[],"description":"Необов'язкові аргументи, передані виконуваному файлу часу виконання.","items":{"type":"string"},"type":"array"},"runtimeExecutable":{"default":"stable","description":"Може бути 'canary', 'stable', 'custom' або шлях до виконуваного файлу браузера. Custom означає кастомний обгортку, кастомну збірку або змінну середовища CHROME_PATH.","type":["string","null"]},"server":{"oneOf":[{"additionalProperties":false,"default":{"program":"node my-server.js"},"description":"Налаштовує веб-сервер для запуску. Використовує таку ж конфігурацію, як і завдання запуску 'node'.","properties":{"args":{"default":[],"description":"Аргументи командного рядка, передані програмі.\n\nМожуть бути масивом рядків або єдиним рядком. Коли програма запускається в терміналі, встановлення цієї властивості в єдиний рядок призведе до того, що аргументи не будуть екрановані для оболонки.","items":{"type":"string"},"tags":["setup"],"type":["array","string"]},"attachSimplePort":{"default":9229,"description":"Якщо встановлено, приєднується до процесу через вказаний порт. Це зазвичай більше не є необхідним для програм Node.js і втрачає можливість налагодження дочірніх процесів, але може бути корисним у більш екзотичних сценаріях, таких як запуск з Deno та Docker. Якщо встановлено на 0, буде вибрано випадковий порт, і --inspect-brk буде автоматично додано до аргументів запуску.","oneOf":[{"type":"integer"},{"pattern":"^\\${.*}$","type":"string"}]},"autoAttachChildProcesses":{"default":true,"description":"Автоматично підключати налагоджувач до нових дочірніх процесів.","type":"boolean"},"cascadeTerminateToConfigurations":{"default":[],"description":"Список сеансів налагодження, які, коли цей сеанс налагодження буде завершено, також будуть зупинені.","items":{"type":"string","uniqueItems":true},"type":"array"},"console":{"default":"internalConsole","description":"Де запустити ціль налагодження.","enum":["internalConsole","integratedTerminal","externalTerminal"],"enumDescriptions":["Консоль налагодження VS Code (яка не підтримує читання введення з програми)","інтегрований термінал VS Code","Зовнішній термінал, який можна налаштувати через налаштування користувача"],"type":"string"},"customDescriptionGenerator":{"description":"Налаштуйте текстовий опис, який відображає відладчик для об'єктів (локальних змінних тощо...). Приклади:\n      1. this.toString() // викликає toString для виведення всіх об'єктів\n      2. this.customDescription ? this.customDescription() : defaultValue // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть defaultValue\n      3. function (def) { return this.customDescription ? this.customDescription() : def } // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть defaultValue\n      ","type":"string"},"customPropertiesGenerator":{"deprecated":true,"description":"Налаштуйте властивості, які відображаються для об'єкта в налагоджувачі (локальні змінні тощо...). Приклади:\n    1. { ...this, extraProperty: '12345' } // Додати extraProperty 12345 до всіх об'єктів\n    2. this.customProperties ? this.customProperties() : this // Використовуйте метод customProperties, якщо він доступний, якщо ні - використовуйте властивості в this (за замовчуванням)\n    3. function () { return this.customProperties ? this.customProperties() : this } // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть властивості за замовчуванням\n\n    Застаріло: Це тимчасова реалізація цієї функції, поки ми не матимемо часу реалізувати її в спосіб, описаний тут: https://github.com/microsoft/vscode/issues/102181","type":"string"},"cwd":{"default":"${workspaceFolder}","description":"Абсолютний шлях до робочого каталогу програми, що налагоджується. Якщо ви встановили localRoot, тоді cwd відповідатиме цьому значенню, інакше він повернеться до вашого workspaceFolder.","tags":["setup"],"type":"string"},"enableContentValidation":{"default":true,"description":"Перемикає, чи перевіряємо ми, що вміст файлів на диску відповідає завантаженим у час виконання. Це корисно в різних сценаріях і є обов'язковим у деяких, але може викликати проблеми, якщо у вас є серверна трансформація скриптів, наприклад.","type":"boolean"},"enableDWARF":{"default":true,"markdownDescription":"Перемикає, чи буде відладчик намагатися зчитувати символи налагодження DWARF з WebAssembly, що може вимагати багато ресурсів. Для роботи потрібен розширення `ms-vscode.wasm-dwarf-debugging`.","type":"boolean"},"env":{"additionalProperties":{"type":["string","null"]},"default":{},"markdownDescription":"Змінні середовища, передані програмі. Значення `null` видаляє змінну з середовища.","tags":["setup"],"type":"object"},"envFile":{"default":"${workspaceFolder}/.env","description":"Абсолютний шлях до файлу, що містить визначення змінних середовища.","type":"string"},"experimentalNetworking":{"default":"auto","description":"Увімкніть експериментальну перевірку в Node.js. Коли встановлено `auto`, це увімкнено для версій Node.js, які це підтримують. Його можна встановити на `on` або `off`, щоб увімкнути або вимкнути його явно.","enum":["auto","on","off"],"type":"string"},"killBehavior":{"default":"forceful","enum":["forceful","polite","none"],"markdownDescription":"Налаштовує, як процеси налагодження зупиняються при завершенні сеансу. Може бути:\n\n- примусовим (за замовчуванням): примусово знищує дерево процесів. Надсилає SIGKILL на posix або `taskkill.exe /F` на Windows.\n- ввічливим: м’яко знищує дерево процесів. Можливо, що некоректно працюючі процеси продовжать виконуватись після завершення таким чином. Надсилає SIGTERM на posix або `taskkill.exe` без прапора `/F` (примус) на Windows.\n- жодного: жодного завершення не відбудеться.","type":"string"},"localRoot":{"default":null,"description":"Шлях до локального каталогу, що містить програму.","type":["string","null"]},"nodeVersionHint":{"default":12,"description":"Дозволяє вам явно вказати версію Node, яка працює, що може бути використано для вимкнення або ввімкнення певних поведінок у випадках, коли автоматичне визначення версії не працює.","minimum":8,"type":"number"},"outFiles":{"default":["${workspaceFolder}/**/*.(m|c|)js","!**/node_modules/**"],"description":"Якщо карти джерел увімкнені, ці шаблони glob вказують на згенеровані файли JavaScript. Якщо шаблон починається з `!`, файли виключаються. Якщо не вказано, згенерований код очікується в тому ж каталозі, що й його джерело.","items":{"type":"string"},"tags":["setup"],"type":["array"]},"outputCapture":{"default":"console","enum":["console","std"],"markdownDescription":"Звідки захоплювати вихідні повідомлення: за замовчуванням API налагодження, якщо встановлено `console`, або потоки stdout/stderr, якщо встановлено `std`."},"pauseForSourceMap":{"default":false,"markdownDescription":"Чи чекати на завантаження карт джерел для кожного вхідного скрипта. Це має накладні витрати на продуктивність і може бути безпечно вимкнено при виконанні з диска, якщо `rootPath` не вимкнено.","type":"boolean"},"profileStartup":{"default":true,"description":"Якщо це правда, почне профілювання, як тільки процес запуститься","type":"boolean"},"program":{"default":"","description":"Абсолютний шлях до програми. Згенероване значення визначається шляхом аналізу package.json та відкритих файлів. Відредагуйте цей атрибут.","tags":["setup"],"type":"string"},"remoteRoot":{"default":null,"description":"Абсолютний шлях до віддаленого каталогу, що містить програму.","type":["string","null"]},"resolveSourceMapLocations":{"default":["${workspaceFolder}/**","!**/node_modules/**"],"description":"Список патернів minimatch для місць (папок та URL), в яких карти джерел можуть бути використані для вирішення локальних файлів. Це можна використовувати, щоб уникнути неправильного розриву в зовнішньому коді з картами джерел. Патерни можуть бути префіксовані знаком \"!\", щоб виключити їх. Може бути встановлено на порожній масив або null, щоб уникнути обмежень.","items":{"type":"string"},"type":["array","null"]},"restart":{"default":true,"description":"Спробуйте перепідключитися до програми, якщо ми втратимо з'єднання. Якщо встановлено `true`, ми будемо намагатися раз на секунду, вічно. Ви можете налаштувати інтервал і максимальну кількість спроб, вказавши `delay` та `maxAttempts` в об'єкті замість цього.","oneOf":[{"type":"boolean"},{"properties":{"delay":{"default":1000,"minimum":0,"type":"number"},"maxAttempts":{"default":10,"minimum":0,"type":"number"}},"type":"object"}]},"runtimeArgs":{"default":[],"description":"Необов'язкові аргументи, передані виконуваному файлу часу виконання.","items":{"type":"string"},"tags":["setup"],"type":"array"},"runtimeExecutable":{"default":"node","markdownDescription":"Час виконання для використання. Або абсолютний шлях, або ім'я часу виконання, доступного в PATH. Якщо пропущено, вважається, що використовується `node`.","type":["string","null"]},"runtimeSourcemapPausePatterns":{"default":[],"items":{"type":"string"},"markdownDescription":"Список шаблонів, за якими можна вручну вставити точки зупинки вхідної точки. Це може бути корисно, щоб надати відладчику можливість встановити точки зупинки при використанні sourcemaps, які не існують або не можуть бути виявлені до запуску, наприклад, [з фреймворком Serverless](https://github.com/microsoft/vscode-js-debug/issues/492).","type":"array"},"runtimeVersion":{"default":"default","markdownDescription":"Версія середовища виконання `node`, яку слід використовувати. Потрібен `nvm`.","type":"string"},"showAsyncStacks":{"default":true,"description":"Показати асинхронні виклики, які призвели до поточного стеку викликів.","oneOf":[{"type":"boolean"},{"properties":{"onAttach":{"default":32,"type":"number"}},"required":["onAttach"],"type":"object"},{"properties":{"onceBreakpointResolved":{"default":32,"type":"number"}},"required":["onceBreakpointResolved"],"type":"object"}]},"skipFiles":{"default":["${/**"],"description":"Масив імен файлів або папок, або шаблонів шляхів, які слід пропустити під час налагодження. Дозволені зіркові шаблони та заперечення, наприклад, `[\"**/node_modules/**\", \"!**/node_modules/my-module/**\"]`","type":"array"},"smartStep":{"default":true,"description":"Автоматично проходьте через згенерований код, який не може бути відображений назад до оригінального джерела.","type":"boolean"},"sourceMapPathOverrides":{"default":{"meteor://💻app/*":"${workspaceFolder}/*","webpack:///./~/*":"${workspaceFolder}/node_modules/*","webpack://?:*/*":"${workspaceFolder}/*"},"description":"Набір відображень для переписування місць розташування вихідних файлів з того, що вказує sourcemap, на їхні місця на диску.","type":"object"},"sourceMapRenames":{"default":true,"description":"Чи використовувати відображення \"names\" у sourcemaps. Це вимагає запиту на отримання вихідного контенту, що може бути повільним з певними налагоджувачами.","type":"boolean"},"sourceMaps":{"default":true,"description":"Використовуйте карти джерел JavaScript (якщо вони існують).","type":"boolean"},"stopOnEntry":{"default":true,"description":"Автоматично зупинити програму після запуску.","type":["boolean","string"]},"timeout":{"default":10000,"description":"Спробуйте знову протягом цього числа мілісекунд для підключення до Node.js. За замовчуванням 10000 мс.","type":"number"},"timeouts":{"additionalProperties":false,"default":{},"description":"Тайм-аути для кількох операцій налагодження.","markdownDescription":"Таймаути для кількох операцій налагоджувача.","properties":{"hoverEvaluation":{"default":500,"description":"Час до оцінки значення для символів, на які наведено курсор, скасовується. Якщо встановлено 0, оцінка при наведенні ніколи не закінчується.","type":"number"},"sourceMapCumulativePause":{"default":1000,"description":"Додатковий час у мілісекундах, дозволений за сесію для очікування обробки source-map, після того як мінімальний час (sourceMapMinPause) буде вичерпано","type":"number"},"sourceMapMinPause":{"default":1000,"description":"Мінімальний час у мілісекундах, витрачений на очікування обробки кожної source-map під час парсингу скрипта","type":"number"}},"type":"object"},"trace":{"default":true,"description":"Налаштовує, який діагностичний вивід буде створено.","oneOf":[{"description":"Trace може бути встановлено на 'true', щоб записувати діагностичні журнали на диск.","type":"boolean"},{"additionalProperties":false,"properties":{"logFile":{"description":"Налаштовує, де на диску записуються журнали.","type":["string","null"]},"stdio":{"description":"Чи повертати дані трасування з запущеного додатку або браузера.","type":"boolean"}},"type":"object"}]}},"type":"object"},{"additionalProperties":false,"default":{"program":"npm start"},"description":"Термінал налагодження JavaScript","properties":{"autoAttachChildProcesses":{"default":true,"description":"Автоматично підключати налагоджувач до нових дочірніх процесів.","type":"boolean"},"cascadeTerminateToConfigurations":{"default":[],"description":"Список сеансів налагодження, які, коли цей сеанс налагодження буде завершено, також будуть зупинені.","items":{"type":"string","uniqueItems":true},"type":"array"},"command":{"default":"npm start","description":"Команда для виконання в запущеному терміналі. Якщо не вказано, термінал відкриється без запуску програми.","tags":["setup"],"type":["string","null"]},"customDescriptionGenerator":{"description":"Налаштуйте текстовий опис, який відображає відладчик для об'єктів (локальних змінних тощо...). Приклади:\n      1. this.toString() // викликає toString для виведення всіх об'єктів\n      2. this.customDescription ? this.customDescription() : defaultValue // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть defaultValue\n      3. function (def) { return this.customDescription ? this.customDescription() : def } // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть defaultValue\n      ","type":"string"},"customPropertiesGenerator":{"deprecated":true,"description":"Налаштуйте властивості, які відображаються для об'єкта в налагоджувачі (локальні змінні тощо...). Приклади:\n    1. { ...this, extraProperty: '12345' } // Додати extraProperty 12345 до всіх об'єктів\n    2. this.customProperties ? this.customProperties() : this // Використовуйте метод customProperties, якщо він доступний, якщо ні - використовуйте властивості в this (за замовчуванням)\n    3. function () { return this.customProperties ? this.customProperties() : this } // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть властивості за замовчуванням\n\n    Застаріло: Це тимчасова реалізація цієї функції, поки ми не матимемо часу реалізувати її в спосіб, описаний тут: https://github.com/microsoft/vscode/issues/102181","type":"string"},"cwd":{"default":"${workspaceFolder}","description":"Абсолютний шлях до робочого каталогу програми, що налагоджується. Якщо ви встановили localRoot, тоді cwd відповідатиме цьому значенню, інакше він повернеться до вашого workspaceFolder.","docDefault":"localRoot || ${workspaceFolder}","tags":["setup"],"type":"string"},"enableContentValidation":{"default":true,"description":"Перемикає, чи перевіряємо ми, що вміст файлів на диску відповідає завантаженим у час виконання. Це корисно в різних сценаріях і є обов'язковим у деяких, але може викликати проблеми, якщо у вас є серверна трансформація скриптів, наприклад.","type":"boolean"},"enableDWARF":{"default":true,"markdownDescription":"Перемикає, чи буде відладчик намагатися зчитувати символи налагодження DWARF з WebAssembly, що може вимагати багато ресурсів. Для роботи потрібен розширення `ms-vscode.wasm-dwarf-debugging`.","type":"boolean"},"env":{"additionalProperties":{"type":["string","null"]},"default":{},"markdownDescription":"Змінні середовища, передані програмі. Значення `null` видаляє змінну з середовища.","tags":["setup"],"type":"object"},"envFile":{"default":"${workspaceFolder}/.env","description":"Абсолютний шлях до файлу, що містить визначення змінних середовища.","type":"string"},"localRoot":{"default":null,"description":"Шлях до локального каталогу, що містить програму.","type":["string","null"]},"nodeVersionHint":{"default":12,"description":"Дозволяє вам явно вказати версію Node, яка працює, що може бути використано для вимкнення або ввімкнення певних поведінок у випадках, коли автоматичне визначення версії не працює.","minimum":8,"type":"number"},"outFiles":{"default":["${workspaceFolder}/**/*.(m|c|)js","!**/node_modules/**"],"description":"Якщо карти джерел увімкнені, ці шаблони glob вказують на згенеровані файли JavaScript. Якщо шаблон починається з `!`, файли виключаються. Якщо не вказано, згенерований код очікується в тому ж каталозі, що й його джерело.","items":{"type":"string"},"tags":["setup"],"type":["array"]},"outputCapture":{"default":"console","enum":["console","std"],"markdownDescription":"Звідки захоплювати вихідні повідомлення: за замовчуванням API налагодження, якщо встановлено `console`, або потоки stdout/stderr, якщо встановлено `std`."},"pauseForSourceMap":{"default":false,"markdownDescription":"Чи чекати на завантаження карт джерел для кожного вхідного скрипта. Це має накладні витрати на продуктивність і може бути безпечно вимкнено при виконанні з диска, якщо `rootPath` не вимкнено.","type":"boolean"},"remoteRoot":{"default":null,"description":"Абсолютний шлях до віддаленого каталогу, що містить програму.","type":["string","null"]},"resolveSourceMapLocations":{"default":["${workspaceFolder}/**","!**/node_modules/**"],"description":"Список патернів minimatch для місць (папок та URL), в яких карти джерел можуть бути використані для вирішення локальних файлів. Це можна використовувати, щоб уникнути неправильного розриву в зовнішньому коді з картами джерел. Патерни можуть бути префіксовані знаком \"!\", щоб виключити їх. Може бути встановлено на порожній масив або null, щоб уникнути обмежень.","items":{"type":"string"},"type":["array","null"]},"runtimeSourcemapPausePatterns":{"default":[],"items":{"type":"string"},"markdownDescription":"Список шаблонів, за якими можна вручну вставити точки зупинки вхідної точки. Це може бути корисно, щоб надати відладчику можливість встановити точки зупинки при використанні sourcemaps, які не існують або не можуть бути виявлені до запуску, наприклад, [з фреймворком Serverless](https://github.com/microsoft/vscode-js-debug/issues/492).","type":"array"},"showAsyncStacks":{"default":true,"description":"Показати асинхронні виклики, які призвели до поточного стеку викликів.","oneOf":[{"type":"boolean"},{"properties":{"onAttach":{"default":32,"type":"number"}},"required":["onAttach"],"type":"object"},{"properties":{"onceBreakpointResolved":{"default":32,"type":"number"}},"required":["onceBreakpointResolved"],"type":"object"}]},"skipFiles":{"default":["${/**"],"description":"Масив імен файлів або папок, або шаблонів шляхів, які слід пропустити під час налагодження. Дозволені зіркові шаблони та заперечення, наприклад, `[\"**/node_modules/**\", \"!**/node_modules/my-module/**\"]`","type":"array"},"smartStep":{"default":true,"description":"Автоматично проходьте через згенерований код, який не може бути відображений назад до оригінального джерела.","type":"boolean"},"sourceMapPathOverrides":{"default":{"meteor://💻app/*":"${workspaceFolder}/*","webpack:///./~/*":"${workspaceFolder}/node_modules/*","webpack://?:*/*":"${workspaceFolder}/*"},"description":"Набір відображень для переписування місць розташування вихідних файлів з того, що вказує sourcemap, на їхні місця на диску.","type":"object"},"sourceMapRenames":{"default":true,"description":"Чи використовувати відображення \"names\" у sourcemaps. Це вимагає запиту на отримання вихідного контенту, що може бути повільним з певними налагоджувачами.","type":"boolean"},"sourceMaps":{"default":true,"description":"Використовуйте карти джерел JavaScript (якщо вони існують).","type":"boolean"},"timeout":{"default":10000,"description":"Спробуйте знову протягом цього числа мілісекунд для підключення до Node.js. За замовчуванням 10000 мс.","type":"number"},"timeouts":{"additionalProperties":false,"default":{},"description":"Тайм-аути для кількох операцій налагодження.","markdownDescription":"Таймаути для кількох операцій налагоджувача.","properties":{"hoverEvaluation":{"default":500,"description":"Час до оцінки значення для символів, на які наведено курсор, скасовується. Якщо встановлено 0, оцінка при наведенні ніколи не закінчується.","type":"number"},"sourceMapCumulativePause":{"default":1000,"description":"Додатковий час у мілісекундах, дозволений за сесію для очікування обробки source-map, після того як мінімальний час (sourceMapMinPause) буде вичерпано","type":"number"},"sourceMapMinPause":{"default":1000,"description":"Мінімальний час у мілісекундах, витрачений на очікування обробки кожної source-map під час парсингу скрипта","type":"number"}},"type":"object"},"trace":{"default":true,"description":"Налаштовує, який діагностичний вивід буде створено.","oneOf":[{"description":"Trace може бути встановлено на 'true', щоб записувати діагностичні журнали на диск.","type":"boolean"},{"additionalProperties":false,"properties":{"logFile":{"description":"Налаштовує, де на диску записуються журнали.","type":["string","null"]},"stdio":{"description":"Чи повертати дані трасування з запущеного додатку або браузера.","type":"boolean"}},"type":"object"}]}},"type":"object"}]},"showAsyncStacks":{"default":true,"description":"Показати асинхронні виклики, які призвели до поточного стеку викликів.","oneOf":[{"type":"boolean"},{"properties":{"onAttach":{"default":32,"type":"number"}},"required":["onAttach"],"type":"object"},{"properties":{"onceBreakpointResolved":{"default":32,"type":"number"}},"required":["onceBreakpointResolved"],"type":"object"}]},"skipFiles":{"default":["${/**"],"description":"Масив імен файлів або папок, або шаблонів шляхів, які слід пропустити під час налагодження. Дозволені зіркові шаблони та заперечення, наприклад, `[\"**/node_modules/**\", \"!**/node_modules/my-module/**\"]`","type":"array"},"smartStep":{"default":true,"description":"Автоматично проходьте через згенерований код, який не може бути відображений назад до оригінального джерела.","type":"boolean"},"sourceMapPathOverrides":{"default":{"meteor://💻app/*":"${workspaceFolder}/*","webpack:///./~/*":"${workspaceFolder}/node_modules/*","webpack://?:*/*":"${workspaceFolder}/*"},"description":"Набір відображень для переписування місць розташування вихідних файлів з того, що вказує sourcemap, на їхні місця на диску.","type":"object"},"sourceMapRenames":{"default":true,"description":"Чи використовувати відображення \"names\" у sourcemaps. Це вимагає запиту на отримання вихідного контенту, що може бути повільним з певними налагоджувачами.","type":"boolean"},"sourceMaps":{"default":true,"description":"Використовуйте карти джерел JavaScript (якщо вони існують).","type":"boolean"},"timeout":{"default":10000,"description":"Спробуйте знову протягом цього числа мілісекунд для підключення до Node.js. За замовчуванням 10000 мс.","type":"number"},"timeouts":{"additionalProperties":false,"default":{},"description":"Тайм-аути для кількох операцій налагодження.","markdownDescription":"Таймаути для кількох операцій налагоджувача.","properties":{"hoverEvaluation":{"default":500,"description":"Час до оцінки значення для символів, на які наведено курсор, скасовується. Якщо встановлено 0, оцінка при наведенні ніколи не закінчується.","type":"number"},"sourceMapCumulativePause":{"default":1000,"description":"Додатковий час у мілісекундах, дозволений за сесію для очікування обробки source-map, після того як мінімальний час (sourceMapMinPause) буде вичерпано","type":"number"},"sourceMapMinPause":{"default":1000,"description":"Мінімальний час у мілісекундах, витрачений на очікування обробки кожної source-map під час парсингу скрипта","type":"number"}},"type":"object"},"trace":{"default":true,"description":"Налаштовує, який діагностичний вивід буде створено.","oneOf":[{"description":"Trace може бути встановлено на 'true', щоб записувати діагностичні журнали на диск.","type":"boolean"},{"additionalProperties":false,"properties":{"logFile":{"description":"Налаштовує, де на диску записуються журнали.","type":["string","null"]},"stdio":{"description":"Чи повертати дані трасування з запущеного додатку або браузера.","type":"boolean"}},"type":"object"}]},"url":{"default":"http://localhost:8080","description":"Шукатиме вкладку з цим точним URL і приєднається до неї, якщо буде знайдена","tags":["setup"],"type":"string"},"urlFilter":{"default":"","description":"Шукатиме сторінку з цим URL і прикріпить до неї, якщо знайде. Можуть бути * підстановочні знаки.","type":"string"},"userDataDir":{"default":true,"description":"За замовчуванням браузер запускається з окремим профілем користувача в тимчасовій папці. Використовуйте цю опцію, щоб переоприділити це. Встановіть значення false, щоб запустити з вашим профілем користувача за замовчуванням. Новий браузер не може бути запущений, якщо екземпляр вже працює з `userDataDir`.","type":["string","boolean"]},"vueComponentPaths":{"default":["${workspaceFolder}/**/*.vue"],"description":"Список шаблонів глобусів файлів для знаходження `*.vue` компонентів. За замовчуванням, здійснює пошук по всьому робочому простору. Це потрібно вказати через додаткові запити, які потребують мапи джерел Vue в Vue CLI 4. Ви можете вимкнути це спеціальне оброблення, встановивши це в порожній масив.","type":"array"},"webRoot":{"default":"${workspaceFolder}","description":"Це вказує абсолютний шлях до кореня веб-сервера в робочому просторі. Використовується для вирішення шляхів, таких як `/app.js`, до файлів на диску. Скорочення для pathMapping для \"/\"","tags":["setup"],"type":"string"}}}},"configurationSnippets":[],"deprecated":"Please use type chrome instead","label":"Веб-додаток (Chrome)","languages":["javascript","typescript","javascriptreact","typescriptreact","html","css","coffeescript","handlebars","vue"],"strings":{"unverifiedBreakpoints":"Деякі з ваших точок зупинки не можуть бути встановлені. Якщо у вас виникає проблема, ви можете [усунути неполадки у вашій конфігурації запуску](command:extension.js-debug.createDiagnostics)."},"type":"pwa-chrome"},{"aiKey":"0c6ae279ed8443289764825290e4f9e2-1a736e7c-1324-4338-be46-fc2a58ae4d14-7255","configurationAttributes":{"attach":{"properties":{"address":{"default":"localhost","description":"IP-адреса або ім'я хоста, на якому слухає налагоджений браузер.","type":"string"},"browserAttachLocation":{"default":null,"description":"Примушує браузер підключатися в одному місці. У віддаленому робочому просторі (через ssh або WSL, наприклад) це можна використовувати для підключення до браузера на віддаленій машині, а не локально.","oneOf":[{"type":"null"},{"enum":["ui","workspace"],"type":"string"}]},"cascadeTerminateToConfigurations":{"default":[],"description":"Список сеансів налагодження, які, коли цей сеанс налагодження буде завершено, також будуть зупинені.","items":{"type":"string","uniqueItems":true},"type":"array"},"customDescriptionGenerator":{"description":"Налаштуйте текстовий опис, який відображає відладчик для об'єктів (локальних змінних тощо...). Приклади:\n      1. this.toString() // викликає toString для виведення всіх об'єктів\n      2. this.customDescription ? this.customDescription() : defaultValue // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть defaultValue\n      3. function (def) { return this.customDescription ? this.customDescription() : def } // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть defaultValue\n      ","type":"string"},"customPropertiesGenerator":{"deprecated":true,"description":"Налаштуйте властивості, які відображаються для об'єкта в налагоджувачі (локальні змінні тощо...). Приклади:\n    1. { ...this, extraProperty: '12345' } // Додати extraProperty 12345 до всіх об'єктів\n    2. this.customProperties ? this.customProperties() : this // Використовуйте метод customProperties, якщо він доступний, якщо ні - використовуйте властивості в this (за замовчуванням)\n    3. function () { return this.customProperties ? this.customProperties() : this } // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть властивості за замовчуванням\n\n    Застаріло: Це тимчасова реалізація цієї функції, поки ми не матимемо часу реалізувати її в спосіб, описаний тут: https://github.com/microsoft/vscode/issues/102181","type":"string"},"disableNetworkCache":{"default":true,"description":"Контролює, чи пропускати мережевий кеш для кожного запиту","type":"boolean"},"enableContentValidation":{"default":true,"description":"Перемикає, чи перевіряємо ми, що вміст файлів на диску відповідає завантаженим у час виконання. Це корисно в різних сценаріях і є обов'язковим у деяких, але може викликати проблеми, якщо у вас є серверна трансформація скриптів, наприклад.","type":"boolean"},"enableDWARF":{"default":true,"markdownDescription":"Перемикає, чи буде відладчик намагатися зчитувати символи налагодження DWARF з WebAssembly, що може вимагати багато ресурсів. Для роботи потрібен розширення `ms-vscode.wasm-dwarf-debugging`.","type":"boolean"},"inspectUri":{"default":null,"description":"Формат, який потрібно використовувати для переписування inspectUri: Це шаблонний рядок, який інтерполює ключі в `{curlyBraces}`. Доступні ключі:\n - `url.*` - це розпарсена адреса запущеного застосунку. Наприклад, `{url.port}`, `{url.hostname}`\n - `port` - це порт налагодження, на якому слухає Chrome.\n - `browserInspectUri` - це URI інспектора на запущеному браузері.\n - `browserInspectUriPath` - це частина шляху URI інспектора на запущеному браузері (наприклад: \"/devtools/browser/e9ec0098-306e-472a-8133-5e42488929c2\").\n - `wsProtocol` - це вказаний протокол вебсокетів. Це встановлюється на `wss`, якщо оригінальна URL-адреса є `https`, або `ws` в іншому випадку.","type":["string","null"]},"outFiles":{"default":["${workspaceFolder}/**/*.(m|c|)js","!**/node_modules/**"],"description":"Якщо карти джерел увімкнені, ці шаблони glob вказують на згенеровані файли JavaScript. Якщо шаблон починається з `!`, файли виключаються. Якщо не вказано, згенерований код очікується в тому ж каталозі, що й його джерело.","items":{"type":"string"},"tags":["setup"],"type":["array"]},"outputCapture":{"default":"console","enum":["console","std"],"markdownDescription":"Звідки захоплювати вихідні повідомлення: за замовчуванням API налагодження, якщо встановлено `console`, або потоки stdout/stderr, якщо встановлено `std`."},"pathMapping":{"default":{},"description":"Відображення URL/шляхів на локальні папки, щоб вирішити скрипти в браузері на скрипти на диску","type":"object"},"pauseForSourceMap":{"default":false,"markdownDescription":"Чи чекати на завантаження карт джерел для кожного вхідного скрипта. Це має накладні витрати на продуктивність і може бути безпечно вимкнено при виконанні з диска, якщо `rootPath` не вимкнено.","type":"boolean"},"perScriptSourcemaps":{"default":"auto","description":"Чи завантажуються скрипти окремо з унікальними sourcemaps, що містять базову назву вихідного файлу. Це можна налаштувати для оптимізації обробки sourcemap при роботі з великою кількістю малих скриптів. Якщо встановлено \"auto\", ми виявимо відомі випадки, коли це доречно.","enum":["yes","no","auto"],"type":"string"},"port":{"default":9229,"description":"Порт, який використовувати для віддаленого налагодження браузера, вказується як `--remote-debugging-port` під час запуску браузера.","oneOf":[{"type":"integer"},{"pattern":"^\\${.*}$","type":"string"}],"tags":["setup"]},"resolveSourceMapLocations":{"default":null,"description":"Список патернів minimatch для місць (папок та URL), в яких карти джерел можуть бути використані для вирішення локальних файлів. Це можна використовувати, щоб уникнути неправильного розриву в зовнішньому коді з картами джерел. Патерни можуть бути префіксовані знаком \"!\", щоб виключити їх. Може бути встановлено на порожній масив або null, щоб уникнути обмежень.","items":{"type":"string"},"type":["array","null"]},"restart":{"default":false,"markdownDescription":"Чи підключитися знову, якщо з'єднання браузера закрито","type":"boolean"},"server":{"oneOf":[{"additionalProperties":false,"default":{"program":"node my-server.js"},"description":"Налаштовує веб-сервер для запуску. Використовує таку ж конфігурацію, як і завдання запуску 'node'.","properties":{"args":{"default":[],"description":"Аргументи командного рядка, передані програмі.\n\nМожуть бути масивом рядків або єдиним рядком. Коли програма запускається в терміналі, встановлення цієї властивості в єдиний рядок призведе до того, що аргументи не будуть екрановані для оболонки.","items":{"type":"string"},"tags":["setup"],"type":["array","string"]},"attachSimplePort":{"default":9229,"description":"Якщо встановлено, приєднується до процесу через вказаний порт. Це зазвичай більше не є необхідним для програм Node.js і втрачає можливість налагодження дочірніх процесів, але може бути корисним у більш екзотичних сценаріях, таких як запуск з Deno та Docker. Якщо встановлено на 0, буде вибрано випадковий порт, і --inspect-brk буде автоматично додано до аргументів запуску.","oneOf":[{"type":"integer"},{"pattern":"^\\${.*}$","type":"string"}]},"autoAttachChildProcesses":{"default":true,"description":"Автоматично підключати налагоджувач до нових дочірніх процесів.","type":"boolean"},"cascadeTerminateToConfigurations":{"default":[],"description":"Список сеансів налагодження, які, коли цей сеанс налагодження буде завершено, також будуть зупинені.","items":{"type":"string","uniqueItems":true},"type":"array"},"console":{"default":"internalConsole","description":"Де запустити ціль налагодження.","enum":["internalConsole","integratedTerminal","externalTerminal"],"enumDescriptions":["Консоль налагодження VS Code (яка не підтримує читання введення з програми)","інтегрований термінал VS Code","Зовнішній термінал, який можна налаштувати через налаштування користувача"],"type":"string"},"customDescriptionGenerator":{"description":"Налаштуйте текстовий опис, який відображає відладчик для об'єктів (локальних змінних тощо...). Приклади:\n      1. this.toString() // викликає toString для виведення всіх об'єктів\n      2. this.customDescription ? this.customDescription() : defaultValue // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть defaultValue\n      3. function (def) { return this.customDescription ? this.customDescription() : def } // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть defaultValue\n      ","type":"string"},"customPropertiesGenerator":{"deprecated":true,"description":"Налаштуйте властивості, які відображаються для об'єкта в налагоджувачі (локальні змінні тощо...). Приклади:\n    1. { ...this, extraProperty: '12345' } // Додати extraProperty 12345 до всіх об'єктів\n    2. this.customProperties ? this.customProperties() : this // Використовуйте метод customProperties, якщо він доступний, якщо ні - використовуйте властивості в this (за замовчуванням)\n    3. function () { return this.customProperties ? this.customProperties() : this } // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть властивості за замовчуванням\n\n    Застаріло: Це тимчасова реалізація цієї функції, поки ми не матимемо часу реалізувати її в спосіб, описаний тут: https://github.com/microsoft/vscode/issues/102181","type":"string"},"cwd":{"default":"${workspaceFolder}","description":"Абсолютний шлях до робочого каталогу програми, що налагоджується. Якщо ви встановили localRoot, тоді cwd відповідатиме цьому значенню, інакше він повернеться до вашого workspaceFolder.","tags":["setup"],"type":"string"},"enableContentValidation":{"default":true,"description":"Перемикає, чи перевіряємо ми, що вміст файлів на диску відповідає завантаженим у час виконання. Це корисно в різних сценаріях і є обов'язковим у деяких, але може викликати проблеми, якщо у вас є серверна трансформація скриптів, наприклад.","type":"boolean"},"enableDWARF":{"default":true,"markdownDescription":"Перемикає, чи буде відладчик намагатися зчитувати символи налагодження DWARF з WebAssembly, що може вимагати багато ресурсів. Для роботи потрібен розширення `ms-vscode.wasm-dwarf-debugging`.","type":"boolean"},"env":{"additionalProperties":{"type":["string","null"]},"default":{},"markdownDescription":"Змінні середовища, передані програмі. Значення `null` видаляє змінну з середовища.","tags":["setup"],"type":"object"},"envFile":{"default":"${workspaceFolder}/.env","description":"Абсолютний шлях до файлу, що містить визначення змінних середовища.","type":"string"},"experimentalNetworking":{"default":"auto","description":"Увімкніть експериментальну перевірку в Node.js. Коли встановлено `auto`, це увімкнено для версій Node.js, які це підтримують. Його можна встановити на `on` або `off`, щоб увімкнути або вимкнути його явно.","enum":["auto","on","off"],"type":"string"},"killBehavior":{"default":"forceful","enum":["forceful","polite","none"],"markdownDescription":"Налаштовує, як процеси налагодження зупиняються при завершенні сеансу. Може бути:\n\n- примусовим (за замовчуванням): примусово знищує дерево процесів. Надсилає SIGKILL на posix або `taskkill.exe /F` на Windows.\n- ввічливим: м’яко знищує дерево процесів. Можливо, що некоректно працюючі процеси продовжать виконуватись після завершення таким чином. Надсилає SIGTERM на posix або `taskkill.exe` без прапора `/F` (примус) на Windows.\n- жодного: жодного завершення не відбудеться.","type":"string"},"localRoot":{"default":null,"description":"Шлях до локального каталогу, що містить програму.","type":["string","null"]},"nodeVersionHint":{"default":12,"description":"Дозволяє вам явно вказати версію Node, яка працює, що може бути використано для вимкнення або ввімкнення певних поведінок у випадках, коли автоматичне визначення версії не працює.","minimum":8,"type":"number"},"outFiles":{"default":["${workspaceFolder}/**/*.(m|c|)js","!**/node_modules/**"],"description":"Якщо карти джерел увімкнені, ці шаблони glob вказують на згенеровані файли JavaScript. Якщо шаблон починається з `!`, файли виключаються. Якщо не вказано, згенерований код очікується в тому ж каталозі, що й його джерело.","items":{"type":"string"},"tags":["setup"],"type":["array"]},"outputCapture":{"default":"console","enum":["console","std"],"markdownDescription":"Звідки захоплювати вихідні повідомлення: за замовчуванням API налагодження, якщо встановлено `console`, або потоки stdout/stderr, якщо встановлено `std`."},"pauseForSourceMap":{"default":false,"markdownDescription":"Чи чекати на завантаження карт джерел для кожного вхідного скрипта. Це має накладні витрати на продуктивність і може бути безпечно вимкнено при виконанні з диска, якщо `rootPath` не вимкнено.","type":"boolean"},"profileStartup":{"default":true,"description":"Якщо це правда, почне профілювання, як тільки процес запуститься","type":"boolean"},"program":{"default":"","description":"Абсолютний шлях до програми. Згенероване значення визначається шляхом аналізу package.json та відкритих файлів. Відредагуйте цей атрибут.","tags":["setup"],"type":"string"},"remoteRoot":{"default":null,"description":"Абсолютний шлях до віддаленого каталогу, що містить програму.","type":["string","null"]},"resolveSourceMapLocations":{"default":["${workspaceFolder}/**","!**/node_modules/**"],"description":"Список патернів minimatch для місць (папок та URL), в яких карти джерел можуть бути використані для вирішення локальних файлів. Це можна використовувати, щоб уникнути неправильного розриву в зовнішньому коді з картами джерел. Патерни можуть бути префіксовані знаком \"!\", щоб виключити їх. Може бути встановлено на порожній масив або null, щоб уникнути обмежень.","items":{"type":"string"},"type":["array","null"]},"restart":{"default":true,"description":"Спробуйте перепідключитися до програми, якщо ми втратимо з'єднання. Якщо встановлено `true`, ми будемо намагатися раз на секунду, вічно. Ви можете налаштувати інтервал і максимальну кількість спроб, вказавши `delay` та `maxAttempts` в об'єкті замість цього.","oneOf":[{"type":"boolean"},{"properties":{"delay":{"default":1000,"minimum":0,"type":"number"},"maxAttempts":{"default":10,"minimum":0,"type":"number"}},"type":"object"}]},"runtimeArgs":{"default":[],"description":"Необов'язкові аргументи, передані виконуваному файлу часу виконання.","items":{"type":"string"},"tags":["setup"],"type":"array"},"runtimeExecutable":{"default":"node","markdownDescription":"Час виконання для використання. Або абсолютний шлях, або ім'я часу виконання, доступного в PATH. Якщо пропущено, вважається, що використовується `node`.","type":["string","null"]},"runtimeSourcemapPausePatterns":{"default":[],"items":{"type":"string"},"markdownDescription":"Список шаблонів, за якими можна вручну вставити точки зупинки вхідної точки. Це може бути корисно, щоб надати відладчику можливість встановити точки зупинки при використанні sourcemaps, які не існують або не можуть бути виявлені до запуску, наприклад, [з фреймворком Serverless](https://github.com/microsoft/vscode-js-debug/issues/492).","type":"array"},"runtimeVersion":{"default":"default","markdownDescription":"Версія середовища виконання `node`, яку слід використовувати. Потрібен `nvm`.","type":"string"},"showAsyncStacks":{"default":true,"description":"Показати асинхронні виклики, які призвели до поточного стеку викликів.","oneOf":[{"type":"boolean"},{"properties":{"onAttach":{"default":32,"type":"number"}},"required":["onAttach"],"type":"object"},{"properties":{"onceBreakpointResolved":{"default":32,"type":"number"}},"required":["onceBreakpointResolved"],"type":"object"}]},"skipFiles":{"default":["${/**"],"description":"Масив імен файлів або папок, або шаблонів шляхів, які слід пропустити під час налагодження. Дозволені зіркові шаблони та заперечення, наприклад, `[\"**/node_modules/**\", \"!**/node_modules/my-module/**\"]`","type":"array"},"smartStep":{"default":true,"description":"Автоматично проходьте через згенерований код, який не може бути відображений назад до оригінального джерела.","type":"boolean"},"sourceMapPathOverrides":{"default":{"meteor://💻app/*":"${workspaceFolder}/*","webpack:///./~/*":"${workspaceFolder}/node_modules/*","webpack://?:*/*":"${workspaceFolder}/*"},"description":"Набір відображень для переписування місць розташування вихідних файлів з того, що вказує sourcemap, на їхні місця на диску.","type":"object"},"sourceMapRenames":{"default":true,"description":"Чи використовувати відображення \"names\" у sourcemaps. Це вимагає запиту на отримання вихідного контенту, що може бути повільним з певними налагоджувачами.","type":"boolean"},"sourceMaps":{"default":true,"description":"Використовуйте карти джерел JavaScript (якщо вони існують).","type":"boolean"},"stopOnEntry":{"default":true,"description":"Автоматично зупинити програму після запуску.","type":["boolean","string"]},"timeout":{"default":10000,"description":"Спробуйте знову протягом цього числа мілісекунд для підключення до Node.js. За замовчуванням 10000 мс.","type":"number"},"timeouts":{"additionalProperties":false,"default":{},"description":"Тайм-аути для кількох операцій налагодження.","markdownDescription":"Таймаути для кількох операцій налагоджувача.","properties":{"hoverEvaluation":{"default":500,"description":"Час до оцінки значення для символів, на які наведено курсор, скасовується. Якщо встановлено 0, оцінка при наведенні ніколи не закінчується.","type":"number"},"sourceMapCumulativePause":{"default":1000,"description":"Додатковий час у мілісекундах, дозволений за сесію для очікування обробки source-map, після того як мінімальний час (sourceMapMinPause) буде вичерпано","type":"number"},"sourceMapMinPause":{"default":1000,"description":"Мінімальний час у мілісекундах, витрачений на очікування обробки кожної source-map під час парсингу скрипта","type":"number"}},"type":"object"},"trace":{"default":true,"description":"Налаштовує, який діагностичний вивід буде створено.","oneOf":[{"description":"Trace може бути встановлено на 'true', щоб записувати діагностичні журнали на диск.","type":"boolean"},{"additionalProperties":false,"properties":{"logFile":{"description":"Налаштовує, де на диску записуються журнали.","type":["string","null"]},"stdio":{"description":"Чи повертати дані трасування з запущеного додатку або браузера.","type":"boolean"}},"type":"object"}]}},"type":"object"},{"additionalProperties":false,"default":{"program":"npm start"},"description":"Термінал налагодження JavaScript","properties":{"autoAttachChildProcesses":{"default":true,"description":"Автоматично підключати налагоджувач до нових дочірніх процесів.","type":"boolean"},"cascadeTerminateToConfigurations":{"default":[],"description":"Список сеансів налагодження, які, коли цей сеанс налагодження буде завершено, також будуть зупинені.","items":{"type":"string","uniqueItems":true},"type":"array"},"command":{"default":"npm start","description":"Команда для виконання в запущеному терміналі. Якщо не вказано, термінал відкриється без запуску програми.","tags":["setup"],"type":["string","null"]},"customDescriptionGenerator":{"description":"Налаштуйте текстовий опис, який відображає відладчик для об'єктів (локальних змінних тощо...). Приклади:\n      1. this.toString() // викликає toString для виведення всіх об'єктів\n      2. this.customDescription ? this.customDescription() : defaultValue // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть defaultValue\n      3. function (def) { return this.customDescription ? this.customDescription() : def } // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть defaultValue\n      ","type":"string"},"customPropertiesGenerator":{"deprecated":true,"description":"Налаштуйте властивості, які відображаються для об'єкта в налагоджувачі (локальні змінні тощо...). Приклади:\n    1. { ...this, extraProperty: '12345' } // Додати extraProperty 12345 до всіх об'єктів\n    2. this.customProperties ? this.customProperties() : this // Використовуйте метод customProperties, якщо він доступний, якщо ні - використовуйте властивості в this (за замовчуванням)\n    3. function () { return this.customProperties ? this.customProperties() : this } // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть властивості за замовчуванням\n\n    Застаріло: Це тимчасова реалізація цієї функції, поки ми не матимемо часу реалізувати її в спосіб, описаний тут: https://github.com/microsoft/vscode/issues/102181","type":"string"},"cwd":{"default":"${workspaceFolder}","description":"Абсолютний шлях до робочого каталогу програми, що налагоджується. Якщо ви встановили localRoot, тоді cwd відповідатиме цьому значенню, інакше він повернеться до вашого workspaceFolder.","docDefault":"localRoot || ${workspaceFolder}","tags":["setup"],"type":"string"},"enableContentValidation":{"default":true,"description":"Перемикає, чи перевіряємо ми, що вміст файлів на диску відповідає завантаженим у час виконання. Це корисно в різних сценаріях і є обов'язковим у деяких, але може викликати проблеми, якщо у вас є серверна трансформація скриптів, наприклад.","type":"boolean"},"enableDWARF":{"default":true,"markdownDescription":"Перемикає, чи буде відладчик намагатися зчитувати символи налагодження DWARF з WebAssembly, що може вимагати багато ресурсів. Для роботи потрібен розширення `ms-vscode.wasm-dwarf-debugging`.","type":"boolean"},"env":{"additionalProperties":{"type":["string","null"]},"default":{},"markdownDescription":"Змінні середовища, передані програмі. Значення `null` видаляє змінну з середовища.","tags":["setup"],"type":"object"},"envFile":{"default":"${workspaceFolder}/.env","description":"Абсолютний шлях до файлу, що містить визначення змінних середовища.","type":"string"},"localRoot":{"default":null,"description":"Шлях до локального каталогу, що містить програму.","type":["string","null"]},"nodeVersionHint":{"default":12,"description":"Дозволяє вам явно вказати версію Node, яка працює, що може бути використано для вимкнення або ввімкнення певних поведінок у випадках, коли автоматичне визначення версії не працює.","minimum":8,"type":"number"},"outFiles":{"default":["${workspaceFolder}/**/*.(m|c|)js","!**/node_modules/**"],"description":"Якщо карти джерел увімкнені, ці шаблони glob вказують на згенеровані файли JavaScript. Якщо шаблон починається з `!`, файли виключаються. Якщо не вказано, згенерований код очікується в тому ж каталозі, що й його джерело.","items":{"type":"string"},"tags":["setup"],"type":["array"]},"outputCapture":{"default":"console","enum":["console","std"],"markdownDescription":"Звідки захоплювати вихідні повідомлення: за замовчуванням API налагодження, якщо встановлено `console`, або потоки stdout/stderr, якщо встановлено `std`."},"pauseForSourceMap":{"default":false,"markdownDescription":"Чи чекати на завантаження карт джерел для кожного вхідного скрипта. Це має накладні витрати на продуктивність і може бути безпечно вимкнено при виконанні з диска, якщо `rootPath` не вимкнено.","type":"boolean"},"remoteRoot":{"default":null,"description":"Абсолютний шлях до віддаленого каталогу, що містить програму.","type":["string","null"]},"resolveSourceMapLocations":{"default":["${workspaceFolder}/**","!**/node_modules/**"],"description":"Список патернів minimatch для місць (папок та URL), в яких карти джерел можуть бути використані для вирішення локальних файлів. Це можна використовувати, щоб уникнути неправильного розриву в зовнішньому коді з картами джерел. Патерни можуть бути префіксовані знаком \"!\", щоб виключити їх. Може бути встановлено на порожній масив або null, щоб уникнути обмежень.","items":{"type":"string"},"type":["array","null"]},"runtimeSourcemapPausePatterns":{"default":[],"items":{"type":"string"},"markdownDescription":"Список шаблонів, за якими можна вручну вставити точки зупинки вхідної точки. Це може бути корисно, щоб надати відладчику можливість встановити точки зупинки при використанні sourcemaps, які не існують або не можуть бути виявлені до запуску, наприклад, [з фреймворком Serverless](https://github.com/microsoft/vscode-js-debug/issues/492).","type":"array"},"showAsyncStacks":{"default":true,"description":"Показати асинхронні виклики, які призвели до поточного стеку викликів.","oneOf":[{"type":"boolean"},{"properties":{"onAttach":{"default":32,"type":"number"}},"required":["onAttach"],"type":"object"},{"properties":{"onceBreakpointResolved":{"default":32,"type":"number"}},"required":["onceBreakpointResolved"],"type":"object"}]},"skipFiles":{"default":["${/**"],"description":"Масив імен файлів або папок, або шаблонів шляхів, які слід пропустити під час налагодження. Дозволені зіркові шаблони та заперечення, наприклад, `[\"**/node_modules/**\", \"!**/node_modules/my-module/**\"]`","type":"array"},"smartStep":{"default":true,"description":"Автоматично проходьте через згенерований код, який не може бути відображений назад до оригінального джерела.","type":"boolean"},"sourceMapPathOverrides":{"default":{"meteor://💻app/*":"${workspaceFolder}/*","webpack:///./~/*":"${workspaceFolder}/node_modules/*","webpack://?:*/*":"${workspaceFolder}/*"},"description":"Набір відображень для переписування місць розташування вихідних файлів з того, що вказує sourcemap, на їхні місця на диску.","type":"object"},"sourceMapRenames":{"default":true,"description":"Чи використовувати відображення \"names\" у sourcemaps. Це вимагає запиту на отримання вихідного контенту, що може бути повільним з певними налагоджувачами.","type":"boolean"},"sourceMaps":{"default":true,"description":"Використовуйте карти джерел JavaScript (якщо вони існують).","type":"boolean"},"timeout":{"default":10000,"description":"Спробуйте знову протягом цього числа мілісекунд для підключення до Node.js. За замовчуванням 10000 мс.","type":"number"},"timeouts":{"additionalProperties":false,"default":{},"description":"Тайм-аути для кількох операцій налагодження.","markdownDescription":"Таймаути для кількох операцій налагоджувача.","properties":{"hoverEvaluation":{"default":500,"description":"Час до оцінки значення для символів, на які наведено курсор, скасовується. Якщо встановлено 0, оцінка при наведенні ніколи не закінчується.","type":"number"},"sourceMapCumulativePause":{"default":1000,"description":"Додатковий час у мілісекундах, дозволений за сесію для очікування обробки source-map, після того як мінімальний час (sourceMapMinPause) буде вичерпано","type":"number"},"sourceMapMinPause":{"default":1000,"description":"Мінімальний час у мілісекундах, витрачений на очікування обробки кожної source-map під час парсингу скрипта","type":"number"}},"type":"object"},"trace":{"default":true,"description":"Налаштовує, який діагностичний вивід буде створено.","oneOf":[{"description":"Trace може бути встановлено на 'true', щоб записувати діагностичні журнали на диск.","type":"boolean"},{"additionalProperties":false,"properties":{"logFile":{"description":"Налаштовує, де на диску записуються журнали.","type":["string","null"]},"stdio":{"description":"Чи повертати дані трасування з запущеного додатку або браузера.","type":"boolean"}},"type":"object"}]}},"type":"object"}]},"showAsyncStacks":{"default":true,"description":"Показати асинхронні виклики, які призвели до поточного стеку викликів.","oneOf":[{"type":"boolean"},{"properties":{"onAttach":{"default":32,"type":"number"}},"required":["onAttach"],"type":"object"},{"properties":{"onceBreakpointResolved":{"default":32,"type":"number"}},"required":["onceBreakpointResolved"],"type":"object"}]},"skipFiles":{"default":["${/**"],"description":"Масив імен файлів або папок, або шаблонів шляхів, які слід пропустити під час налагодження. Дозволені зіркові шаблони та заперечення, наприклад, `[\"**/node_modules/**\", \"!**/node_modules/my-module/**\"]`","type":"array"},"smartStep":{"default":true,"description":"Автоматично проходьте через згенерований код, який не може бути відображений назад до оригінального джерела.","type":"boolean"},"sourceMapPathOverrides":{"default":{"meteor://💻app/*":"${workspaceFolder}/*","webpack:///./~/*":"${workspaceFolder}/node_modules/*","webpack://?:*/*":"${workspaceFolder}/*"},"description":"Набір відображень для переписування місць розташування вихідних файлів з того, що вказує sourcemap, на їхні місця на диску.","type":"object"},"sourceMapRenames":{"default":true,"description":"Чи використовувати відображення \"names\" у sourcemaps. Це вимагає запиту на отримання вихідного контенту, що може бути повільним з певними налагоджувачами.","type":"boolean"},"sourceMaps":{"default":true,"description":"Використовуйте карти джерел JavaScript (якщо вони існують).","type":"boolean"},"targetSelection":{"default":"automatic","enum":["pick","automatic"],"markdownDescription":"Чи прикріпити до всіх цілей, які відповідають фільтру URL (\"автоматично\"), чи запитати вибрати одну (\"вибрати\").","type":"string"},"timeout":{"default":10000,"description":"Спробуйте знову протягом цього числа мілісекунд для підключення до Node.js. За замовчуванням 10000 мс.","type":"number"},"timeouts":{"additionalProperties":false,"default":{},"description":"Тайм-аути для кількох операцій налагодження.","markdownDescription":"Таймаути для кількох операцій налагоджувача.","properties":{"hoverEvaluation":{"default":500,"description":"Час до оцінки значення для символів, на які наведено курсор, скасовується. Якщо встановлено 0, оцінка при наведенні ніколи не закінчується.","type":"number"},"sourceMapCumulativePause":{"default":1000,"description":"Додатковий час у мілісекундах, дозволений за сесію для очікування обробки source-map, після того як мінімальний час (sourceMapMinPause) буде вичерпано","type":"number"},"sourceMapMinPause":{"default":1000,"description":"Мінімальний час у мілісекундах, витрачений на очікування обробки кожної source-map під час парсингу скрипта","type":"number"}},"type":"object"},"trace":{"default":true,"description":"Налаштовує, який діагностичний вивід буде створено.","oneOf":[{"description":"Trace може бути встановлено на 'true', щоб записувати діагностичні журнали на диск.","type":"boolean"},{"additionalProperties":false,"properties":{"logFile":{"description":"Налаштовує, де на диску записуються журнали.","type":["string","null"]},"stdio":{"description":"Чи повертати дані трасування з запущеного додатку або браузера.","type":"boolean"}},"type":"object"}]},"url":{"default":"http://localhost:8080","description":"Шукатиме вкладку з цим точним URL і приєднається до неї, якщо буде знайдена","tags":["setup"],"type":"string"},"urlFilter":{"default":"","description":"Шукатиме сторінку з цим URL і прикріпить до неї, якщо знайде. Можуть бути * підстановочні знаки.","type":"string"},"vueComponentPaths":{"default":["${workspaceFolder}/**/*.vue"],"description":"Список шаблонів глобусів файлів для знаходження `*.vue` компонентів. За замовчуванням, здійснює пошук по всьому робочому простору. Це потрібно вказати через додаткові запити, які потребують мапи джерел Vue в Vue CLI 4. Ви можете вимкнути це спеціальне оброблення, встановивши це в порожній масив.","type":"array"},"webRoot":{"default":"${workspaceFolder}","description":"Це вказує абсолютний шлях до кореня веб-сервера в робочому просторі. Використовується для вирішення шляхів, таких як `/app.js`, до файлів на диску. Скорочення для pathMapping для \"/\"","tags":["setup"],"type":"string"}}},"launch":{"properties":{"browserLaunchLocation":{"default":null,"description":"Примушує браузер запускатися в одному місці. У віддаленому робочому просторі (наприклад, через ssh або WSL) це можна використовувати для відкриття браузера на віддаленій машині, а не локально.","oneOf":[{"type":"null"},{"enum":["ui","workspace"],"type":"string"}]},"cascadeTerminateToConfigurations":{"default":[],"description":"Список сеансів налагодження, які, коли цей сеанс налагодження буде завершено, також будуть зупинені.","items":{"type":"string","uniqueItems":true},"type":"array"},"cleanUp":{"default":"wholeBrowser","description":"Яке очищення потрібно зробити після завершення сеансу налагодження. Закрити лише вкладку, що налагоджується, проти закриття всього браузера.","enum":["wholeBrowser","onlyTab"],"type":"string"},"customDescriptionGenerator":{"description":"Налаштуйте текстовий опис, який відображає відладчик для об'єктів (локальних змінних тощо...). Приклади:\n      1. this.toString() // викликає toString для виведення всіх об'єктів\n      2. this.customDescription ? this.customDescription() : defaultValue // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть defaultValue\n      3. function (def) { return this.customDescription ? this.customDescription() : def } // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть defaultValue\n      ","type":"string"},"customPropertiesGenerator":{"deprecated":true,"description":"Налаштуйте властивості, які відображаються для об'єкта в налагоджувачі (локальні змінні тощо...). Приклади:\n    1. { ...this, extraProperty: '12345' } // Додати extraProperty 12345 до всіх об'єктів\n    2. this.customProperties ? this.customProperties() : this // Використовуйте метод customProperties, якщо він доступний, якщо ні - використовуйте властивості в this (за замовчуванням)\n    3. function () { return this.customProperties ? this.customProperties() : this } // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть властивості за замовчуванням\n\n    Застаріло: Це тимчасова реалізація цієї функції, поки ми не матимемо часу реалізувати її в спосіб, описаний тут: https://github.com/microsoft/vscode/issues/102181","type":"string"},"cwd":{"default":null,"description":"Необов'язкова робоча директорія для виконуваного файлу під час виконання.","type":"string"},"disableNetworkCache":{"default":true,"description":"Контролює, чи пропускати мережевий кеш для кожного запиту","type":"boolean"},"enableContentValidation":{"default":true,"description":"Перемикає, чи перевіряємо ми, що вміст файлів на диску відповідає завантаженим у час виконання. Це корисно в різних сценаріях і є обов'язковим у деяких, але може викликати проблеми, якщо у вас є серверна трансформація скриптів, наприклад.","type":"boolean"},"enableDWARF":{"default":true,"markdownDescription":"Перемикає, чи буде відладчик намагатися зчитувати символи налагодження DWARF з WebAssembly, що може вимагати багато ресурсів. Для роботи потрібен розширення `ms-vscode.wasm-dwarf-debugging`.","type":"boolean"},"env":{"default":{},"description":"Необов'язковий словник пар ключ/значення для середовища браузера.","type":"object"},"file":{"default":"${workspaceFolder}/index.html","description":"Локальний html файл для відкриття в браузері","tags":["setup"],"type":"string"},"includeDefaultArgs":{"default":true,"description":"Чи будуть включені аргументи запуску браузера за замовчуванням (для відключення функцій, які можуть ускладнити налагодження) у запуск.","type":"boolean"},"includeLaunchArgs":{"default":true,"description":"Розширені: чи встановлені будь-які аргументи за замовчуванням для запуску/налагодження в браузері. Налагоджувач припустить, що браузер використовуватиме налагодження через канал, таке як те, що надається з `--remote-debugging-pipe`.","type":"boolean"},"inspectUri":{"default":null,"description":"Формат, який потрібно використовувати для переписування inspectUri: Це шаблонний рядок, який інтерполює ключі в `{curlyBraces}`. Доступні ключі:\n - `url.*` - це розпарсена адреса запущеного застосунку. Наприклад, `{url.port}`, `{url.hostname}`\n - `port` - це порт налагодження, на якому слухає Chrome.\n - `browserInspectUri` - це URI інспектора на запущеному браузері.\n - `browserInspectUriPath` - це частина шляху URI інспектора на запущеному браузері (наприклад: \"/devtools/browser/e9ec0098-306e-472a-8133-5e42488929c2\").\n - `wsProtocol` - це вказаний протокол вебсокетів. Це встановлюється на `wss`, якщо оригінальна URL-адреса є `https`, або `ws` в іншому випадку.","type":["string","null"]},"killBehavior":{"default":"forceful","enum":["forceful","polite","none"],"markdownDescription":"Налаштовує, як браузерні процеси зупиняються при завершенні сесії з `cleanUp: wholeBrowser`. Може бути:\n\n- примусовим (за замовчуванням): примусово знищує дерево процесів. Надсилає SIGKILL на posix або `taskkill.exe /F` на Windows.\n- ввічливим: коректно знищує дерево процесів. Можливо, що неправильно працюючі процеси продовжать виконання після завершення в такий спосіб. Надсилає SIGTERM на posix або `taskkill.exe` без прапора `/F` (примус) на Windows.\n- жодного: жодне завершення не відбудеться.","type":"string"},"outFiles":{"default":["${workspaceFolder}/**/*.(m|c|)js","!**/node_modules/**"],"description":"Якщо карти джерел увімкнені, ці шаблони glob вказують на згенеровані файли JavaScript. Якщо шаблон починається з `!`, файли виключаються. Якщо не вказано, згенерований код очікується в тому ж каталозі, що й його джерело.","items":{"type":"string"},"tags":["setup"],"type":["array"]},"outputCapture":{"default":"console","enum":["console","std"],"markdownDescription":"Звідки захоплювати вихідні повідомлення: за замовчуванням API налагодження, якщо встановлено `console`, або потоки stdout/stderr, якщо встановлено `std`."},"pathMapping":{"default":{},"description":"Відображення URL/шляхів на локальні папки, щоб вирішити скрипти в браузері на скрипти на диску","type":"object"},"pauseForSourceMap":{"default":false,"markdownDescription":"Чи чекати на завантаження карт джерел для кожного вхідного скрипта. Це має накладні витрати на продуктивність і може бути безпечно вимкнено при виконанні з диска, якщо `rootPath` не вимкнено.","type":"boolean"},"perScriptSourcemaps":{"default":"auto","description":"Чи завантажуються скрипти окремо з унікальними sourcemaps, що містять базову назву вихідного файлу. Це можна налаштувати для оптимізації обробки sourcemap при роботі з великою кількістю малих скриптів. Якщо встановлено \"auto\", ми виявимо відомі випадки, коли це доречно.","enum":["yes","no","auto"],"type":"string"},"port":{"default":0,"description":"Порт, на якому браузер буде слухати. За замовчуванням - \"0\", що призведе до налагодження браузера через канали, що зазвичай є більш безпечним і має бути обрано, якщо вам не потрібно підключатися до браузера з іншого інструменту.","type":"number"},"profileStartup":{"default":true,"description":"Якщо це правда, почнемо профілювання, як тільки процес запуститься","type":"boolean"},"resolveSourceMapLocations":{"default":null,"description":"Список патернів minimatch для місць (папок та URL), в яких карти джерел можуть бути використані для вирішення локальних файлів. Це можна використовувати, щоб уникнути неправильного розриву в зовнішньому коді з картами джерел. Патерни можуть бути префіксовані знаком \"!\", щоб виключити їх. Може бути встановлено на порожній масив або null, щоб уникнути обмежень.","items":{"type":"string"},"type":["array","null"]},"runtimeArgs":{"default":[],"description":"Необов'язкові аргументи, передані виконуваному файлу часу виконання.","items":{"type":"string"},"type":"array"},"runtimeExecutable":{"default":"stable","description":"Може бути 'canary', 'stable', 'custom' або шлях до виконуваного файлу браузера. Custom означає кастомний обгортку, кастомну збірку або змінну середовища CHROME_PATH.","type":["string","null"]},"server":{"oneOf":[{"additionalProperties":false,"default":{"program":"node my-server.js"},"description":"Налаштовує веб-сервер для запуску. Використовує таку ж конфігурацію, як і завдання запуску 'node'.","properties":{"args":{"default":[],"description":"Аргументи командного рядка, передані програмі.\n\nМожуть бути масивом рядків або єдиним рядком. Коли програма запускається в терміналі, встановлення цієї властивості в єдиний рядок призведе до того, що аргументи не будуть екрановані для оболонки.","items":{"type":"string"},"tags":["setup"],"type":["array","string"]},"attachSimplePort":{"default":9229,"description":"Якщо встановлено, приєднується до процесу через вказаний порт. Це зазвичай більше не є необхідним для програм Node.js і втрачає можливість налагодження дочірніх процесів, але може бути корисним у більш екзотичних сценаріях, таких як запуск з Deno та Docker. Якщо встановлено на 0, буде вибрано випадковий порт, і --inspect-brk буде автоматично додано до аргументів запуску.","oneOf":[{"type":"integer"},{"pattern":"^\\${.*}$","type":"string"}]},"autoAttachChildProcesses":{"default":true,"description":"Автоматично підключати налагоджувач до нових дочірніх процесів.","type":"boolean"},"cascadeTerminateToConfigurations":{"default":[],"description":"Список сеансів налагодження, які, коли цей сеанс налагодження буде завершено, також будуть зупинені.","items":{"type":"string","uniqueItems":true},"type":"array"},"console":{"default":"internalConsole","description":"Де запустити ціль налагодження.","enum":["internalConsole","integratedTerminal","externalTerminal"],"enumDescriptions":["Консоль налагодження VS Code (яка не підтримує читання введення з програми)","інтегрований термінал VS Code","Зовнішній термінал, який можна налаштувати через налаштування користувача"],"type":"string"},"customDescriptionGenerator":{"description":"Налаштуйте текстовий опис, який відображає відладчик для об'єктів (локальних змінних тощо...). Приклади:\n      1. this.toString() // викликає toString для виведення всіх об'єктів\n      2. this.customDescription ? this.customDescription() : defaultValue // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть defaultValue\n      3. function (def) { return this.customDescription ? this.customDescription() : def } // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть defaultValue\n      ","type":"string"},"customPropertiesGenerator":{"deprecated":true,"description":"Налаштуйте властивості, які відображаються для об'єкта в налагоджувачі (локальні змінні тощо...). Приклади:\n    1. { ...this, extraProperty: '12345' } // Додати extraProperty 12345 до всіх об'єктів\n    2. this.customProperties ? this.customProperties() : this // Використовуйте метод customProperties, якщо він доступний, якщо ні - використовуйте властивості в this (за замовчуванням)\n    3. function () { return this.customProperties ? this.customProperties() : this } // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть властивості за замовчуванням\n\n    Застаріло: Це тимчасова реалізація цієї функції, поки ми не матимемо часу реалізувати її в спосіб, описаний тут: https://github.com/microsoft/vscode/issues/102181","type":"string"},"cwd":{"default":"${workspaceFolder}","description":"Абсолютний шлях до робочого каталогу програми, що налагоджується. Якщо ви встановили localRoot, тоді cwd відповідатиме цьому значенню, інакше він повернеться до вашого workspaceFolder.","tags":["setup"],"type":"string"},"enableContentValidation":{"default":true,"description":"Перемикає, чи перевіряємо ми, що вміст файлів на диску відповідає завантаженим у час виконання. Це корисно в різних сценаріях і є обов'язковим у деяких, але може викликати проблеми, якщо у вас є серверна трансформація скриптів, наприклад.","type":"boolean"},"enableDWARF":{"default":true,"markdownDescription":"Перемикає, чи буде відладчик намагатися зчитувати символи налагодження DWARF з WebAssembly, що може вимагати багато ресурсів. Для роботи потрібен розширення `ms-vscode.wasm-dwarf-debugging`.","type":"boolean"},"env":{"additionalProperties":{"type":["string","null"]},"default":{},"markdownDescription":"Змінні середовища, передані програмі. Значення `null` видаляє змінну з середовища.","tags":["setup"],"type":"object"},"envFile":{"default":"${workspaceFolder}/.env","description":"Абсолютний шлях до файлу, що містить визначення змінних середовища.","type":"string"},"experimentalNetworking":{"default":"auto","description":"Увімкніть експериментальну перевірку в Node.js. Коли встановлено `auto`, це увімкнено для версій Node.js, які це підтримують. Його можна встановити на `on` або `off`, щоб увімкнути або вимкнути його явно.","enum":["auto","on","off"],"type":"string"},"killBehavior":{"default":"forceful","enum":["forceful","polite","none"],"markdownDescription":"Налаштовує, як процеси налагодження зупиняються при завершенні сеансу. Може бути:\n\n- примусовим (за замовчуванням): примусово знищує дерево процесів. Надсилає SIGKILL на posix або `taskkill.exe /F` на Windows.\n- ввічливим: м’яко знищує дерево процесів. Можливо, що некоректно працюючі процеси продовжать виконуватись після завершення таким чином. Надсилає SIGTERM на posix або `taskkill.exe` без прапора `/F` (примус) на Windows.\n- жодного: жодного завершення не відбудеться.","type":"string"},"localRoot":{"default":null,"description":"Шлях до локального каталогу, що містить програму.","type":["string","null"]},"nodeVersionHint":{"default":12,"description":"Дозволяє вам явно вказати версію Node, яка працює, що може бути використано для вимкнення або ввімкнення певних поведінок у випадках, коли автоматичне визначення версії не працює.","minimum":8,"type":"number"},"outFiles":{"default":["${workspaceFolder}/**/*.(m|c|)js","!**/node_modules/**"],"description":"Якщо карти джерел увімкнені, ці шаблони glob вказують на згенеровані файли JavaScript. Якщо шаблон починається з `!`, файли виключаються. Якщо не вказано, згенерований код очікується в тому ж каталозі, що й його джерело.","items":{"type":"string"},"tags":["setup"],"type":["array"]},"outputCapture":{"default":"console","enum":["console","std"],"markdownDescription":"Звідки захоплювати вихідні повідомлення: за замовчуванням API налагодження, якщо встановлено `console`, або потоки stdout/stderr, якщо встановлено `std`."},"pauseForSourceMap":{"default":false,"markdownDescription":"Чи чекати на завантаження карт джерел для кожного вхідного скрипта. Це має накладні витрати на продуктивність і може бути безпечно вимкнено при виконанні з диска, якщо `rootPath` не вимкнено.","type":"boolean"},"profileStartup":{"default":true,"description":"Якщо це правда, почне профілювання, як тільки процес запуститься","type":"boolean"},"program":{"default":"","description":"Абсолютний шлях до програми. Згенероване значення визначається шляхом аналізу package.json та відкритих файлів. Відредагуйте цей атрибут.","tags":["setup"],"type":"string"},"remoteRoot":{"default":null,"description":"Абсолютний шлях до віддаленого каталогу, що містить програму.","type":["string","null"]},"resolveSourceMapLocations":{"default":["${workspaceFolder}/**","!**/node_modules/**"],"description":"Список патернів minimatch для місць (папок та URL), в яких карти джерел можуть бути використані для вирішення локальних файлів. Це можна використовувати, щоб уникнути неправильного розриву в зовнішньому коді з картами джерел. Патерни можуть бути префіксовані знаком \"!\", щоб виключити їх. Може бути встановлено на порожній масив або null, щоб уникнути обмежень.","items":{"type":"string"},"type":["array","null"]},"restart":{"default":true,"description":"Спробуйте перепідключитися до програми, якщо ми втратимо з'єднання. Якщо встановлено `true`, ми будемо намагатися раз на секунду, вічно. Ви можете налаштувати інтервал і максимальну кількість спроб, вказавши `delay` та `maxAttempts` в об'єкті замість цього.","oneOf":[{"type":"boolean"},{"properties":{"delay":{"default":1000,"minimum":0,"type":"number"},"maxAttempts":{"default":10,"minimum":0,"type":"number"}},"type":"object"}]},"runtimeArgs":{"default":[],"description":"Необов'язкові аргументи, передані виконуваному файлу часу виконання.","items":{"type":"string"},"tags":["setup"],"type":"array"},"runtimeExecutable":{"default":"node","markdownDescription":"Час виконання для використання. Або абсолютний шлях, або ім'я часу виконання, доступного в PATH. Якщо пропущено, вважається, що використовується `node`.","type":["string","null"]},"runtimeSourcemapPausePatterns":{"default":[],"items":{"type":"string"},"markdownDescription":"Список шаблонів, за якими можна вручну вставити точки зупинки вхідної точки. Це може бути корисно, щоб надати відладчику можливість встановити точки зупинки при використанні sourcemaps, які не існують або не можуть бути виявлені до запуску, наприклад, [з фреймворком Serverless](https://github.com/microsoft/vscode-js-debug/issues/492).","type":"array"},"runtimeVersion":{"default":"default","markdownDescription":"Версія середовища виконання `node`, яку слід використовувати. Потрібен `nvm`.","type":"string"},"showAsyncStacks":{"default":true,"description":"Показати асинхронні виклики, які призвели до поточного стеку викликів.","oneOf":[{"type":"boolean"},{"properties":{"onAttach":{"default":32,"type":"number"}},"required":["onAttach"],"type":"object"},{"properties":{"onceBreakpointResolved":{"default":32,"type":"number"}},"required":["onceBreakpointResolved"],"type":"object"}]},"skipFiles":{"default":["${/**"],"description":"Масив імен файлів або папок, або шаблонів шляхів, які слід пропустити під час налагодження. Дозволені зіркові шаблони та заперечення, наприклад, `[\"**/node_modules/**\", \"!**/node_modules/my-module/**\"]`","type":"array"},"smartStep":{"default":true,"description":"Автоматично проходьте через згенерований код, який не може бути відображений назад до оригінального джерела.","type":"boolean"},"sourceMapPathOverrides":{"default":{"meteor://💻app/*":"${workspaceFolder}/*","webpack:///./~/*":"${workspaceFolder}/node_modules/*","webpack://?:*/*":"${workspaceFolder}/*"},"description":"Набір відображень для переписування місць розташування вихідних файлів з того, що вказує sourcemap, на їхні місця на диску.","type":"object"},"sourceMapRenames":{"default":true,"description":"Чи використовувати відображення \"names\" у sourcemaps. Це вимагає запиту на отримання вихідного контенту, що може бути повільним з певними налагоджувачами.","type":"boolean"},"sourceMaps":{"default":true,"description":"Використовуйте карти джерел JavaScript (якщо вони існують).","type":"boolean"},"stopOnEntry":{"default":true,"description":"Автоматично зупинити програму після запуску.","type":["boolean","string"]},"timeout":{"default":10000,"description":"Спробуйте знову протягом цього числа мілісекунд для підключення до Node.js. За замовчуванням 10000 мс.","type":"number"},"timeouts":{"additionalProperties":false,"default":{},"description":"Тайм-аути для кількох операцій налагодження.","markdownDescription":"Таймаути для кількох операцій налагоджувача.","properties":{"hoverEvaluation":{"default":500,"description":"Час до оцінки значення для символів, на які наведено курсор, скасовується. Якщо встановлено 0, оцінка при наведенні ніколи не закінчується.","type":"number"},"sourceMapCumulativePause":{"default":1000,"description":"Додатковий час у мілісекундах, дозволений за сесію для очікування обробки source-map, після того як мінімальний час (sourceMapMinPause) буде вичерпано","type":"number"},"sourceMapMinPause":{"default":1000,"description":"Мінімальний час у мілісекундах, витрачений на очікування обробки кожної source-map під час парсингу скрипта","type":"number"}},"type":"object"},"trace":{"default":true,"description":"Налаштовує, який діагностичний вивід буде створено.","oneOf":[{"description":"Trace може бути встановлено на 'true', щоб записувати діагностичні журнали на диск.","type":"boolean"},{"additionalProperties":false,"properties":{"logFile":{"description":"Налаштовує, де на диску записуються журнали.","type":["string","null"]},"stdio":{"description":"Чи повертати дані трасування з запущеного додатку або браузера.","type":"boolean"}},"type":"object"}]}},"type":"object"},{"additionalProperties":false,"default":{"program":"npm start"},"description":"Термінал налагодження JavaScript","properties":{"autoAttachChildProcesses":{"default":true,"description":"Автоматично підключати налагоджувач до нових дочірніх процесів.","type":"boolean"},"cascadeTerminateToConfigurations":{"default":[],"description":"Список сеансів налагодження, які, коли цей сеанс налагодження буде завершено, також будуть зупинені.","items":{"type":"string","uniqueItems":true},"type":"array"},"command":{"default":"npm start","description":"Команда для виконання в запущеному терміналі. Якщо не вказано, термінал відкриється без запуску програми.","tags":["setup"],"type":["string","null"]},"customDescriptionGenerator":{"description":"Налаштуйте текстовий опис, який відображає відладчик для об'єктів (локальних змінних тощо...). Приклади:\n      1. this.toString() // викликає toString для виведення всіх об'єктів\n      2. this.customDescription ? this.customDescription() : defaultValue // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть defaultValue\n      3. function (def) { return this.customDescription ? this.customDescription() : def } // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть defaultValue\n      ","type":"string"},"customPropertiesGenerator":{"deprecated":true,"description":"Налаштуйте властивості, які відображаються для об'єкта в налагоджувачі (локальні змінні тощо...). Приклади:\n    1. { ...this, extraProperty: '12345' } // Додати extraProperty 12345 до всіх об'єктів\n    2. this.customProperties ? this.customProperties() : this // Використовуйте метод customProperties, якщо він доступний, якщо ні - використовуйте властивості в this (за замовчуванням)\n    3. function () { return this.customProperties ? this.customProperties() : this } // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть властивості за замовчуванням\n\n    Застаріло: Це тимчасова реалізація цієї функції, поки ми не матимемо часу реалізувати її в спосіб, описаний тут: https://github.com/microsoft/vscode/issues/102181","type":"string"},"cwd":{"default":"${workspaceFolder}","description":"Абсолютний шлях до робочого каталогу програми, що налагоджується. Якщо ви встановили localRoot, тоді cwd відповідатиме цьому значенню, інакше він повернеться до вашого workspaceFolder.","docDefault":"localRoot || ${workspaceFolder}","tags":["setup"],"type":"string"},"enableContentValidation":{"default":true,"description":"Перемикає, чи перевіряємо ми, що вміст файлів на диску відповідає завантаженим у час виконання. Це корисно в різних сценаріях і є обов'язковим у деяких, але може викликати проблеми, якщо у вас є серверна трансформація скриптів, наприклад.","type":"boolean"},"enableDWARF":{"default":true,"markdownDescription":"Перемикає, чи буде відладчик намагатися зчитувати символи налагодження DWARF з WebAssembly, що може вимагати багато ресурсів. Для роботи потрібен розширення `ms-vscode.wasm-dwarf-debugging`.","type":"boolean"},"env":{"additionalProperties":{"type":["string","null"]},"default":{},"markdownDescription":"Змінні середовища, передані програмі. Значення `null` видаляє змінну з середовища.","tags":["setup"],"type":"object"},"envFile":{"default":"${workspaceFolder}/.env","description":"Абсолютний шлях до файлу, що містить визначення змінних середовища.","type":"string"},"localRoot":{"default":null,"description":"Шлях до локального каталогу, що містить програму.","type":["string","null"]},"nodeVersionHint":{"default":12,"description":"Дозволяє вам явно вказати версію Node, яка працює, що може бути використано для вимкнення або ввімкнення певних поведінок у випадках, коли автоматичне визначення версії не працює.","minimum":8,"type":"number"},"outFiles":{"default":["${workspaceFolder}/**/*.(m|c|)js","!**/node_modules/**"],"description":"Якщо карти джерел увімкнені, ці шаблони glob вказують на згенеровані файли JavaScript. Якщо шаблон починається з `!`, файли виключаються. Якщо не вказано, згенерований код очікується в тому ж каталозі, що й його джерело.","items":{"type":"string"},"tags":["setup"],"type":["array"]},"outputCapture":{"default":"console","enum":["console","std"],"markdownDescription":"Звідки захоплювати вихідні повідомлення: за замовчуванням API налагодження, якщо встановлено `console`, або потоки stdout/stderr, якщо встановлено `std`."},"pauseForSourceMap":{"default":false,"markdownDescription":"Чи чекати на завантаження карт джерел для кожного вхідного скрипта. Це має накладні витрати на продуктивність і може бути безпечно вимкнено при виконанні з диска, якщо `rootPath` не вимкнено.","type":"boolean"},"remoteRoot":{"default":null,"description":"Абсолютний шлях до віддаленого каталогу, що містить програму.","type":["string","null"]},"resolveSourceMapLocations":{"default":["${workspaceFolder}/**","!**/node_modules/**"],"description":"Список патернів minimatch для місць (папок та URL), в яких карти джерел можуть бути використані для вирішення локальних файлів. Це можна використовувати, щоб уникнути неправильного розриву в зовнішньому коді з картами джерел. Патерни можуть бути префіксовані знаком \"!\", щоб виключити їх. Може бути встановлено на порожній масив або null, щоб уникнути обмежень.","items":{"type":"string"},"type":["array","null"]},"runtimeSourcemapPausePatterns":{"default":[],"items":{"type":"string"},"markdownDescription":"Список шаблонів, за якими можна вручну вставити точки зупинки вхідної точки. Це може бути корисно, щоб надати відладчику можливість встановити точки зупинки при використанні sourcemaps, які не існують або не можуть бути виявлені до запуску, наприклад, [з фреймворком Serverless](https://github.com/microsoft/vscode-js-debug/issues/492).","type":"array"},"showAsyncStacks":{"default":true,"description":"Показати асинхронні виклики, які призвели до поточного стеку викликів.","oneOf":[{"type":"boolean"},{"properties":{"onAttach":{"default":32,"type":"number"}},"required":["onAttach"],"type":"object"},{"properties":{"onceBreakpointResolved":{"default":32,"type":"number"}},"required":["onceBreakpointResolved"],"type":"object"}]},"skipFiles":{"default":["${/**"],"description":"Масив імен файлів або папок, або шаблонів шляхів, які слід пропустити під час налагодження. Дозволені зіркові шаблони та заперечення, наприклад, `[\"**/node_modules/**\", \"!**/node_modules/my-module/**\"]`","type":"array"},"smartStep":{"default":true,"description":"Автоматично проходьте через згенерований код, який не може бути відображений назад до оригінального джерела.","type":"boolean"},"sourceMapPathOverrides":{"default":{"meteor://💻app/*":"${workspaceFolder}/*","webpack:///./~/*":"${workspaceFolder}/node_modules/*","webpack://?:*/*":"${workspaceFolder}/*"},"description":"Набір відображень для переписування місць розташування вихідних файлів з того, що вказує sourcemap, на їхні місця на диску.","type":"object"},"sourceMapRenames":{"default":true,"description":"Чи використовувати відображення \"names\" у sourcemaps. Це вимагає запиту на отримання вихідного контенту, що може бути повільним з певними налагоджувачами.","type":"boolean"},"sourceMaps":{"default":true,"description":"Використовуйте карти джерел JavaScript (якщо вони існують).","type":"boolean"},"timeout":{"default":10000,"description":"Спробуйте знову протягом цього числа мілісекунд для підключення до Node.js. За замовчуванням 10000 мс.","type":"number"},"timeouts":{"additionalProperties":false,"default":{},"description":"Тайм-аути для кількох операцій налагодження.","markdownDescription":"Таймаути для кількох операцій налагоджувача.","properties":{"hoverEvaluation":{"default":500,"description":"Час до оцінки значення для символів, на які наведено курсор, скасовується. Якщо встановлено 0, оцінка при наведенні ніколи не закінчується.","type":"number"},"sourceMapCumulativePause":{"default":1000,"description":"Додатковий час у мілісекундах, дозволений за сесію для очікування обробки source-map, після того як мінімальний час (sourceMapMinPause) буде вичерпано","type":"number"},"sourceMapMinPause":{"default":1000,"description":"Мінімальний час у мілісекундах, витрачений на очікування обробки кожної source-map під час парсингу скрипта","type":"number"}},"type":"object"},"trace":{"default":true,"description":"Налаштовує, який діагностичний вивід буде створено.","oneOf":[{"description":"Trace може бути встановлено на 'true', щоб записувати діагностичні журнали на диск.","type":"boolean"},{"additionalProperties":false,"properties":{"logFile":{"description":"Налаштовує, де на диску записуються журнали.","type":["string","null"]},"stdio":{"description":"Чи повертати дані трасування з запущеного додатку або браузера.","type":"boolean"}},"type":"object"}]}},"type":"object"}]},"showAsyncStacks":{"default":true,"description":"Показати асинхронні виклики, які призвели до поточного стеку викликів.","oneOf":[{"type":"boolean"},{"properties":{"onAttach":{"default":32,"type":"number"}},"required":["onAttach"],"type":"object"},{"properties":{"onceBreakpointResolved":{"default":32,"type":"number"}},"required":["onceBreakpointResolved"],"type":"object"}]},"skipFiles":{"default":["${/**"],"description":"Масив імен файлів або папок, або шаблонів шляхів, які слід пропустити під час налагодження. Дозволені зіркові шаблони та заперечення, наприклад, `[\"**/node_modules/**\", \"!**/node_modules/my-module/**\"]`","type":"array"},"smartStep":{"default":true,"description":"Автоматично проходьте через згенерований код, який не може бути відображений назад до оригінального джерела.","type":"boolean"},"sourceMapPathOverrides":{"default":{"meteor://💻app/*":"${workspaceFolder}/*","webpack:///./~/*":"${workspaceFolder}/node_modules/*","webpack://?:*/*":"${workspaceFolder}/*"},"description":"Набір відображень для переписування місць розташування вихідних файлів з того, що вказує sourcemap, на їхні місця на диску.","type":"object"},"sourceMapRenames":{"default":true,"description":"Чи використовувати відображення \"names\" у sourcemaps. Це вимагає запиту на отримання вихідного контенту, що може бути повільним з певними налагоджувачами.","type":"boolean"},"sourceMaps":{"default":true,"description":"Використовуйте карти джерел JavaScript (якщо вони існують).","type":"boolean"},"timeout":{"default":10000,"description":"Спробуйте знову протягом цього числа мілісекунд для підключення до Node.js. За замовчуванням 10000 мс.","type":"number"},"timeouts":{"additionalProperties":false,"default":{},"description":"Тайм-аути для кількох операцій налагодження.","markdownDescription":"Таймаути для кількох операцій налагоджувача.","properties":{"hoverEvaluation":{"default":500,"description":"Час до оцінки значення для символів, на які наведено курсор, скасовується. Якщо встановлено 0, оцінка при наведенні ніколи не закінчується.","type":"number"},"sourceMapCumulativePause":{"default":1000,"description":"Додатковий час у мілісекундах, дозволений за сесію для очікування обробки source-map, після того як мінімальний час (sourceMapMinPause) буде вичерпано","type":"number"},"sourceMapMinPause":{"default":1000,"description":"Мінімальний час у мілісекундах, витрачений на очікування обробки кожної source-map під час парсингу скрипта","type":"number"}},"type":"object"},"trace":{"default":true,"description":"Налаштовує, який діагностичний вивід буде створено.","oneOf":[{"description":"Trace може бути встановлено на 'true', щоб записувати діагностичні журнали на диск.","type":"boolean"},{"additionalProperties":false,"properties":{"logFile":{"description":"Налаштовує, де на диску записуються журнали.","type":["string","null"]},"stdio":{"description":"Чи повертати дані трасування з запущеного додатку або браузера.","type":"boolean"}},"type":"object"}]},"url":{"default":"http://localhost:8080","description":"Шукатиме вкладку з цим точним URL і приєднається до неї, якщо буде знайдена","tags":["setup"],"type":"string"},"urlFilter":{"default":"","description":"Шукатиме сторінку з цим URL і прикріпить до неї, якщо знайде. Можуть бути * підстановочні знаки.","type":"string"},"userDataDir":{"default":true,"description":"За замовчуванням браузер запускається з окремим профілем користувача в тимчасовій папці. Використовуйте цю опцію, щоб переоприділити це. Встановіть значення false, щоб запустити з вашим профілем користувача за замовчуванням. Новий браузер не може бути запущений, якщо екземпляр вже працює з `userDataDir`.","type":["string","boolean"]},"vueComponentPaths":{"default":["${workspaceFolder}/**/*.vue"],"description":"Список шаблонів глобусів файлів для знаходження `*.vue` компонентів. За замовчуванням, здійснює пошук по всьому робочому простору. Це потрібно вказати через додаткові запити, які потребують мапи джерел Vue в Vue CLI 4. Ви можете вимкнути це спеціальне оброблення, встановивши це в порожній масив.","type":"array"},"webRoot":{"default":"${workspaceFolder}","description":"Це вказує абсолютний шлях до кореня веб-сервера в робочому просторі. Використовується для вирішення шляхів, таких як `/app.js`, до файлів на диску. Скорочення для pathMapping для \"/\"","tags":["setup"],"type":"string"}}}},"configurationSnippets":[{"body":{"name":"Launch Chrome","request":"launch","type":"chrome","url":"http://localhost:8080","webRoot":"^\"${2:\\${workspaceFolder\\}}\""},"description":"Запустіть Chrome для налагодження URL","label":"Chrome: Запустити"},{"body":{"name":"Attach to Chrome","port":9222,"request":"attach","type":"chrome","webRoot":"^\"${2:\\${workspaceFolder\\}}\""},"description":"Приєднатися до екземпляра Chrome, вже в режимі налагодження","label":"Chrome: Прикріпити"}],"label":"Веб-додаток (Chrome)","strings":{"unverifiedBreakpoints":"Деякі з ваших точок зупинки не можуть бути встановлені. Якщо у вас виникає проблема, ви можете [усунути неполадки у вашій конфігурації запуску](command:extension.js-debug.createDiagnostics)."},"type":"chrome"},{"aiKey":"0c6ae279ed8443289764825290e4f9e2-1a736e7c-1324-4338-be46-fc2a58ae4d14-7255","configurationAttributes":{"attach":{"properties":{"address":{"default":"localhost","description":"IP-адреса або ім'я хоста, на якому слухає налагоджений браузер.","type":"string"},"browserAttachLocation":{"default":null,"description":"Примушує браузер підключатися в одному місці. У віддаленому робочому просторі (через ssh або WSL, наприклад) це можна використовувати для підключення до браузера на віддаленій машині, а не локально.","oneOf":[{"type":"null"},{"enum":["ui","workspace"],"type":"string"}]},"cascadeTerminateToConfigurations":{"default":[],"description":"Список сеансів налагодження, які, коли цей сеанс налагодження буде завершено, також будуть зупинені.","items":{"type":"string","uniqueItems":true},"type":"array"},"customDescriptionGenerator":{"description":"Налаштуйте текстовий опис, який відображає відладчик для об'єктів (локальних змінних тощо...). Приклади:\n      1. this.toString() // викликає toString для виведення всіх об'єктів\n      2. this.customDescription ? this.customDescription() : defaultValue // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть defaultValue\n      3. function (def) { return this.customDescription ? this.customDescription() : def } // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть defaultValue\n      ","type":"string"},"customPropertiesGenerator":{"deprecated":true,"description":"Налаштуйте властивості, які відображаються для об'єкта в налагоджувачі (локальні змінні тощо...). Приклади:\n    1. { ...this, extraProperty: '12345' } // Додати extraProperty 12345 до всіх об'єктів\n    2. this.customProperties ? this.customProperties() : this // Використовуйте метод customProperties, якщо він доступний, якщо ні - використовуйте властивості в this (за замовчуванням)\n    3. function () { return this.customProperties ? this.customProperties() : this } // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть властивості за замовчуванням\n\n    Застаріло: Це тимчасова реалізація цієї функції, поки ми не матимемо часу реалізувати її в спосіб, описаний тут: https://github.com/microsoft/vscode/issues/102181","type":"string"},"disableNetworkCache":{"default":true,"description":"Контролює, чи пропускати мережевий кеш для кожного запиту","type":"boolean"},"enableContentValidation":{"default":true,"description":"Перемикає, чи перевіряємо ми, що вміст файлів на диску відповідає завантаженим у час виконання. Це корисно в різних сценаріях і є обов'язковим у деяких, але може викликати проблеми, якщо у вас є серверна трансформація скриптів, наприклад.","type":"boolean"},"enableDWARF":{"default":true,"markdownDescription":"Перемикає, чи буде відладчик намагатися зчитувати символи налагодження DWARF з WebAssembly, що може вимагати багато ресурсів. Для роботи потрібен розширення `ms-vscode.wasm-dwarf-debugging`.","type":"boolean"},"inspectUri":{"default":null,"description":"Формат, який потрібно використовувати для переписування inspectUri: Це шаблонний рядок, який інтерполює ключі в `{curlyBraces}`. Доступні ключі:\n - `url.*` - це розпарсена адреса запущеного застосунку. Наприклад, `{url.port}`, `{url.hostname}`\n - `port` - це порт налагодження, на якому слухає Chrome.\n - `browserInspectUri` - це URI інспектора на запущеному браузері.\n - `browserInspectUriPath` - це частина шляху URI інспектора на запущеному браузері (наприклад: \"/devtools/browser/e9ec0098-306e-472a-8133-5e42488929c2\").\n - `wsProtocol` - це вказаний протокол вебсокетів. Це встановлюється на `wss`, якщо оригінальна URL-адреса є `https`, або `ws` в іншому випадку.","type":["string","null"]},"outFiles":{"default":["${workspaceFolder}/**/*.(m|c|)js","!**/node_modules/**"],"description":"Якщо карти джерел увімкнені, ці шаблони glob вказують на згенеровані файли JavaScript. Якщо шаблон починається з `!`, файли виключаються. Якщо не вказано, згенерований код очікується в тому ж каталозі, що й його джерело.","items":{"type":"string"},"tags":["setup"],"type":["array"]},"outputCapture":{"default":"console","enum":["console","std"],"markdownDescription":"Звідки захоплювати вихідні повідомлення: за замовчуванням API налагодження, якщо встановлено `console`, або потоки stdout/stderr, якщо встановлено `std`."},"pathMapping":{"default":{},"description":"Відображення URL/шляхів на локальні папки, щоб вирішити скрипти в браузері на скрипти на диску","type":"object"},"pauseForSourceMap":{"default":false,"markdownDescription":"Чи чекати на завантаження карт джерел для кожного вхідного скрипта. Це має накладні витрати на продуктивність і може бути безпечно вимкнено при виконанні з диска, якщо `rootPath` не вимкнено.","type":"boolean"},"perScriptSourcemaps":{"default":"auto","description":"Чи завантажуються скрипти окремо з унікальними sourcemaps, що містять базову назву вихідного файлу. Це можна налаштувати для оптимізації обробки sourcemap при роботі з великою кількістю малих скриптів. Якщо встановлено \"auto\", ми виявимо відомі випадки, коли це доречно.","enum":["yes","no","auto"],"type":"string"},"port":{"default":9229,"description":"Порт, який використовувати для віддаленого налагодження браузера, вказується як `--remote-debugging-port` під час запуску браузера.","oneOf":[{"type":"integer"},{"pattern":"^\\${.*}$","type":"string"}],"tags":["setup"]},"resolveSourceMapLocations":{"default":null,"description":"Список патернів minimatch для місць (папок та URL), в яких карти джерел можуть бути використані для вирішення локальних файлів. Це можна використовувати, щоб уникнути неправильного розриву в зовнішньому коді з картами джерел. Патерни можуть бути префіксовані знаком \"!\", щоб виключити їх. Може бути встановлено на порожній масив або null, щоб уникнути обмежень.","items":{"type":"string"},"type":["array","null"]},"restart":{"default":false,"markdownDescription":"Чи підключитися знову, якщо з'єднання браузера закрито","type":"boolean"},"server":{"oneOf":[{"additionalProperties":false,"default":{"program":"node my-server.js"},"description":"Налаштовує веб-сервер для запуску. Використовує таку ж конфігурацію, як і завдання запуску 'node'.","properties":{"args":{"default":[],"description":"Аргументи командного рядка, передані програмі.\n\nМожуть бути масивом рядків або єдиним рядком. Коли програма запускається в терміналі, встановлення цієї властивості в єдиний рядок призведе до того, що аргументи не будуть екрановані для оболонки.","items":{"type":"string"},"tags":["setup"],"type":["array","string"]},"attachSimplePort":{"default":9229,"description":"Якщо встановлено, приєднується до процесу через вказаний порт. Це зазвичай більше не є необхідним для програм Node.js і втрачає можливість налагодження дочірніх процесів, але може бути корисним у більш екзотичних сценаріях, таких як запуск з Deno та Docker. Якщо встановлено на 0, буде вибрано випадковий порт, і --inspect-brk буде автоматично додано до аргументів запуску.","oneOf":[{"type":"integer"},{"pattern":"^\\${.*}$","type":"string"}]},"autoAttachChildProcesses":{"default":true,"description":"Автоматично підключати налагоджувач до нових дочірніх процесів.","type":"boolean"},"cascadeTerminateToConfigurations":{"default":[],"description":"Список сеансів налагодження, які, коли цей сеанс налагодження буде завершено, також будуть зупинені.","items":{"type":"string","uniqueItems":true},"type":"array"},"console":{"default":"internalConsole","description":"Де запустити ціль налагодження.","enum":["internalConsole","integratedTerminal","externalTerminal"],"enumDescriptions":["Консоль налагодження VS Code (яка не підтримує читання введення з програми)","інтегрований термінал VS Code","Зовнішній термінал, який можна налаштувати через налаштування користувача"],"type":"string"},"customDescriptionGenerator":{"description":"Налаштуйте текстовий опис, який відображає відладчик для об'єктів (локальних змінних тощо...). Приклади:\n      1. this.toString() // викликає toString для виведення всіх об'єктів\n      2. this.customDescription ? this.customDescription() : defaultValue // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть defaultValue\n      3. function (def) { return this.customDescription ? this.customDescription() : def } // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть defaultValue\n      ","type":"string"},"customPropertiesGenerator":{"deprecated":true,"description":"Налаштуйте властивості, які відображаються для об'єкта в налагоджувачі (локальні змінні тощо...). Приклади:\n    1. { ...this, extraProperty: '12345' } // Додати extraProperty 12345 до всіх об'єктів\n    2. this.customProperties ? this.customProperties() : this // Використовуйте метод customProperties, якщо він доступний, якщо ні - використовуйте властивості в this (за замовчуванням)\n    3. function () { return this.customProperties ? this.customProperties() : this } // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть властивості за замовчуванням\n\n    Застаріло: Це тимчасова реалізація цієї функції, поки ми не матимемо часу реалізувати її в спосіб, описаний тут: https://github.com/microsoft/vscode/issues/102181","type":"string"},"cwd":{"default":"${workspaceFolder}","description":"Абсолютний шлях до робочого каталогу програми, що налагоджується. Якщо ви встановили localRoot, тоді cwd відповідатиме цьому значенню, інакше він повернеться до вашого workspaceFolder.","tags":["setup"],"type":"string"},"enableContentValidation":{"default":true,"description":"Перемикає, чи перевіряємо ми, що вміст файлів на диску відповідає завантаженим у час виконання. Це корисно в різних сценаріях і є обов'язковим у деяких, але може викликати проблеми, якщо у вас є серверна трансформація скриптів, наприклад.","type":"boolean"},"enableDWARF":{"default":true,"markdownDescription":"Перемикає, чи буде відладчик намагатися зчитувати символи налагодження DWARF з WebAssembly, що може вимагати багато ресурсів. Для роботи потрібен розширення `ms-vscode.wasm-dwarf-debugging`.","type":"boolean"},"env":{"additionalProperties":{"type":["string","null"]},"default":{},"markdownDescription":"Змінні середовища, передані програмі. Значення `null` видаляє змінну з середовища.","tags":["setup"],"type":"object"},"envFile":{"default":"${workspaceFolder}/.env","description":"Абсолютний шлях до файлу, що містить визначення змінних середовища.","type":"string"},"experimentalNetworking":{"default":"auto","description":"Увімкніть експериментальну перевірку в Node.js. Коли встановлено `auto`, це увімкнено для версій Node.js, які це підтримують. Його можна встановити на `on` або `off`, щоб увімкнути або вимкнути його явно.","enum":["auto","on","off"],"type":"string"},"killBehavior":{"default":"forceful","enum":["forceful","polite","none"],"markdownDescription":"Налаштовує, як процеси налагодження зупиняються при завершенні сеансу. Може бути:\n\n- примусовим (за замовчуванням): примусово знищує дерево процесів. Надсилає SIGKILL на posix або `taskkill.exe /F` на Windows.\n- ввічливим: м’яко знищує дерево процесів. Можливо, що некоректно працюючі процеси продовжать виконуватись після завершення таким чином. Надсилає SIGTERM на posix або `taskkill.exe` без прапора `/F` (примус) на Windows.\n- жодного: жодного завершення не відбудеться.","type":"string"},"localRoot":{"default":null,"description":"Шлях до локального каталогу, що містить програму.","type":["string","null"]},"nodeVersionHint":{"default":12,"description":"Дозволяє вам явно вказати версію Node, яка працює, що може бути використано для вимкнення або ввімкнення певних поведінок у випадках, коли автоматичне визначення версії не працює.","minimum":8,"type":"number"},"outFiles":{"default":["${workspaceFolder}/**/*.(m|c|)js","!**/node_modules/**"],"description":"Якщо карти джерел увімкнені, ці шаблони glob вказують на згенеровані файли JavaScript. Якщо шаблон починається з `!`, файли виключаються. Якщо не вказано, згенерований код очікується в тому ж каталозі, що й його джерело.","items":{"type":"string"},"tags":["setup"],"type":["array"]},"outputCapture":{"default":"console","enum":["console","std"],"markdownDescription":"Звідки захоплювати вихідні повідомлення: за замовчуванням API налагодження, якщо встановлено `console`, або потоки stdout/stderr, якщо встановлено `std`."},"pauseForSourceMap":{"default":false,"markdownDescription":"Чи чекати на завантаження карт джерел для кожного вхідного скрипта. Це має накладні витрати на продуктивність і може бути безпечно вимкнено при виконанні з диска, якщо `rootPath` не вимкнено.","type":"boolean"},"profileStartup":{"default":true,"description":"Якщо це правда, почне профілювання, як тільки процес запуститься","type":"boolean"},"program":{"default":"","description":"Абсолютний шлях до програми. Згенероване значення визначається шляхом аналізу package.json та відкритих файлів. Відредагуйте цей атрибут.","tags":["setup"],"type":"string"},"remoteRoot":{"default":null,"description":"Абсолютний шлях до віддаленого каталогу, що містить програму.","type":["string","null"]},"resolveSourceMapLocations":{"default":["${workspaceFolder}/**","!**/node_modules/**"],"description":"Список патернів minimatch для місць (папок та URL), в яких карти джерел можуть бути використані для вирішення локальних файлів. Це можна використовувати, щоб уникнути неправильного розриву в зовнішньому коді з картами джерел. Патерни можуть бути префіксовані знаком \"!\", щоб виключити їх. Може бути встановлено на порожній масив або null, щоб уникнути обмежень.","items":{"type":"string"},"type":["array","null"]},"restart":{"default":true,"description":"Спробуйте перепідключитися до програми, якщо ми втратимо з'єднання. Якщо встановлено `true`, ми будемо намагатися раз на секунду, вічно. Ви можете налаштувати інтервал і максимальну кількість спроб, вказавши `delay` та `maxAttempts` в об'єкті замість цього.","oneOf":[{"type":"boolean"},{"properties":{"delay":{"default":1000,"minimum":0,"type":"number"},"maxAttempts":{"default":10,"minimum":0,"type":"number"}},"type":"object"}]},"runtimeArgs":{"default":[],"description":"Необов'язкові аргументи, передані виконуваному файлу часу виконання.","items":{"type":"string"},"tags":["setup"],"type":"array"},"runtimeExecutable":{"default":"node","markdownDescription":"Час виконання для використання. Або абсолютний шлях, або ім'я часу виконання, доступного в PATH. Якщо пропущено, вважається, що використовується `node`.","type":["string","null"]},"runtimeSourcemapPausePatterns":{"default":[],"items":{"type":"string"},"markdownDescription":"Список шаблонів, за якими можна вручну вставити точки зупинки вхідної точки. Це може бути корисно, щоб надати відладчику можливість встановити точки зупинки при використанні sourcemaps, які не існують або не можуть бути виявлені до запуску, наприклад, [з фреймворком Serverless](https://github.com/microsoft/vscode-js-debug/issues/492).","type":"array"},"runtimeVersion":{"default":"default","markdownDescription":"Версія середовища виконання `node`, яку слід використовувати. Потрібен `nvm`.","type":"string"},"showAsyncStacks":{"default":true,"description":"Показати асинхронні виклики, які призвели до поточного стеку викликів.","oneOf":[{"type":"boolean"},{"properties":{"onAttach":{"default":32,"type":"number"}},"required":["onAttach"],"type":"object"},{"properties":{"onceBreakpointResolved":{"default":32,"type":"number"}},"required":["onceBreakpointResolved"],"type":"object"}]},"skipFiles":{"default":["${/**"],"description":"Масив імен файлів або папок, або шаблонів шляхів, які слід пропустити під час налагодження. Дозволені зіркові шаблони та заперечення, наприклад, `[\"**/node_modules/**\", \"!**/node_modules/my-module/**\"]`","type":"array"},"smartStep":{"default":true,"description":"Автоматично проходьте через згенерований код, який не може бути відображений назад до оригінального джерела.","type":"boolean"},"sourceMapPathOverrides":{"default":{"meteor://💻app/*":"${workspaceFolder}/*","webpack:///./~/*":"${workspaceFolder}/node_modules/*","webpack://?:*/*":"${workspaceFolder}/*"},"description":"Набір відображень для переписування місць розташування вихідних файлів з того, що вказує sourcemap, на їхні місця на диску.","type":"object"},"sourceMapRenames":{"default":true,"description":"Чи використовувати відображення \"names\" у sourcemaps. Це вимагає запиту на отримання вихідного контенту, що може бути повільним з певними налагоджувачами.","type":"boolean"},"sourceMaps":{"default":true,"description":"Використовуйте карти джерел JavaScript (якщо вони існують).","type":"boolean"},"stopOnEntry":{"default":true,"description":"Автоматично зупинити програму після запуску.","type":["boolean","string"]},"timeout":{"default":10000,"description":"Спробуйте знову протягом цього числа мілісекунд для підключення до Node.js. За замовчуванням 10000 мс.","type":"number"},"timeouts":{"additionalProperties":false,"default":{},"description":"Тайм-аути для кількох операцій налагодження.","markdownDescription":"Таймаути для кількох операцій налагоджувача.","properties":{"hoverEvaluation":{"default":500,"description":"Час до оцінки значення для символів, на які наведено курсор, скасовується. Якщо встановлено 0, оцінка при наведенні ніколи не закінчується.","type":"number"},"sourceMapCumulativePause":{"default":1000,"description":"Додатковий час у мілісекундах, дозволений за сесію для очікування обробки source-map, після того як мінімальний час (sourceMapMinPause) буде вичерпано","type":"number"},"sourceMapMinPause":{"default":1000,"description":"Мінімальний час у мілісекундах, витрачений на очікування обробки кожної source-map під час парсингу скрипта","type":"number"}},"type":"object"},"trace":{"default":true,"description":"Налаштовує, який діагностичний вивід буде створено.","oneOf":[{"description":"Trace може бути встановлено на 'true', щоб записувати діагностичні журнали на диск.","type":"boolean"},{"additionalProperties":false,"properties":{"logFile":{"description":"Налаштовує, де на диску записуються журнали.","type":["string","null"]},"stdio":{"description":"Чи повертати дані трасування з запущеного додатку або браузера.","type":"boolean"}},"type":"object"}]}},"type":"object"},{"additionalProperties":false,"default":{"program":"npm start"},"description":"Термінал налагодження JavaScript","properties":{"autoAttachChildProcesses":{"default":true,"description":"Автоматично підключати налагоджувач до нових дочірніх процесів.","type":"boolean"},"cascadeTerminateToConfigurations":{"default":[],"description":"Список сеансів налагодження, які, коли цей сеанс налагодження буде завершено, також будуть зупинені.","items":{"type":"string","uniqueItems":true},"type":"array"},"command":{"default":"npm start","description":"Команда для виконання в запущеному терміналі. Якщо не вказано, термінал відкриється без запуску програми.","tags":["setup"],"type":["string","null"]},"customDescriptionGenerator":{"description":"Налаштуйте текстовий опис, який відображає відладчик для об'єктів (локальних змінних тощо...). Приклади:\n      1. this.toString() // викликає toString для виведення всіх об'єктів\n      2. this.customDescription ? this.customDescription() : defaultValue // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть defaultValue\n      3. function (def) { return this.customDescription ? this.customDescription() : def } // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть defaultValue\n      ","type":"string"},"customPropertiesGenerator":{"deprecated":true,"description":"Налаштуйте властивості, які відображаються для об'єкта в налагоджувачі (локальні змінні тощо...). Приклади:\n    1. { ...this, extraProperty: '12345' } // Додати extraProperty 12345 до всіх об'єктів\n    2. this.customProperties ? this.customProperties() : this // Використовуйте метод customProperties, якщо він доступний, якщо ні - використовуйте властивості в this (за замовчуванням)\n    3. function () { return this.customProperties ? this.customProperties() : this } // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть властивості за замовчуванням\n\n    Застаріло: Це тимчасова реалізація цієї функції, поки ми не матимемо часу реалізувати її в спосіб, описаний тут: https://github.com/microsoft/vscode/issues/102181","type":"string"},"cwd":{"default":"${workspaceFolder}","description":"Абсолютний шлях до робочого каталогу програми, що налагоджується. Якщо ви встановили localRoot, тоді cwd відповідатиме цьому значенню, інакше він повернеться до вашого workspaceFolder.","docDefault":"localRoot || ${workspaceFolder}","tags":["setup"],"type":"string"},"enableContentValidation":{"default":true,"description":"Перемикає, чи перевіряємо ми, що вміст файлів на диску відповідає завантаженим у час виконання. Це корисно в різних сценаріях і є обов'язковим у деяких, але може викликати проблеми, якщо у вас є серверна трансформація скриптів, наприклад.","type":"boolean"},"enableDWARF":{"default":true,"markdownDescription":"Перемикає, чи буде відладчик намагатися зчитувати символи налагодження DWARF з WebAssembly, що може вимагати багато ресурсів. Для роботи потрібен розширення `ms-vscode.wasm-dwarf-debugging`.","type":"boolean"},"env":{"additionalProperties":{"type":["string","null"]},"default":{},"markdownDescription":"Змінні середовища, передані програмі. Значення `null` видаляє змінну з середовища.","tags":["setup"],"type":"object"},"envFile":{"default":"${workspaceFolder}/.env","description":"Абсолютний шлях до файлу, що містить визначення змінних середовища.","type":"string"},"localRoot":{"default":null,"description":"Шлях до локального каталогу, що містить програму.","type":["string","null"]},"nodeVersionHint":{"default":12,"description":"Дозволяє вам явно вказати версію Node, яка працює, що може бути використано для вимкнення або ввімкнення певних поведінок у випадках, коли автоматичне визначення версії не працює.","minimum":8,"type":"number"},"outFiles":{"default":["${workspaceFolder}/**/*.(m|c|)js","!**/node_modules/**"],"description":"Якщо карти джерел увімкнені, ці шаблони glob вказують на згенеровані файли JavaScript. Якщо шаблон починається з `!`, файли виключаються. Якщо не вказано, згенерований код очікується в тому ж каталозі, що й його джерело.","items":{"type":"string"},"tags":["setup"],"type":["array"]},"outputCapture":{"default":"console","enum":["console","std"],"markdownDescription":"Звідки захоплювати вихідні повідомлення: за замовчуванням API налагодження, якщо встановлено `console`, або потоки stdout/stderr, якщо встановлено `std`."},"pauseForSourceMap":{"default":false,"markdownDescription":"Чи чекати на завантаження карт джерел для кожного вхідного скрипта. Це має накладні витрати на продуктивність і може бути безпечно вимкнено при виконанні з диска, якщо `rootPath` не вимкнено.","type":"boolean"},"remoteRoot":{"default":null,"description":"Абсолютний шлях до віддаленого каталогу, що містить програму.","type":["string","null"]},"resolveSourceMapLocations":{"default":["${workspaceFolder}/**","!**/node_modules/**"],"description":"Список патернів minimatch для місць (папок та URL), в яких карти джерел можуть бути використані для вирішення локальних файлів. Це можна використовувати, щоб уникнути неправильного розриву в зовнішньому коді з картами джерел. Патерни можуть бути префіксовані знаком \"!\", щоб виключити їх. Може бути встановлено на порожній масив або null, щоб уникнути обмежень.","items":{"type":"string"},"type":["array","null"]},"runtimeSourcemapPausePatterns":{"default":[],"items":{"type":"string"},"markdownDescription":"Список шаблонів, за якими можна вручну вставити точки зупинки вхідної точки. Це може бути корисно, щоб надати відладчику можливість встановити точки зупинки при використанні sourcemaps, які не існують або не можуть бути виявлені до запуску, наприклад, [з фреймворком Serverless](https://github.com/microsoft/vscode-js-debug/issues/492).","type":"array"},"showAsyncStacks":{"default":true,"description":"Показати асинхронні виклики, які призвели до поточного стеку викликів.","oneOf":[{"type":"boolean"},{"properties":{"onAttach":{"default":32,"type":"number"}},"required":["onAttach"],"type":"object"},{"properties":{"onceBreakpointResolved":{"default":32,"type":"number"}},"required":["onceBreakpointResolved"],"type":"object"}]},"skipFiles":{"default":["${/**"],"description":"Масив імен файлів або папок, або шаблонів шляхів, які слід пропустити під час налагодження. Дозволені зіркові шаблони та заперечення, наприклад, `[\"**/node_modules/**\", \"!**/node_modules/my-module/**\"]`","type":"array"},"smartStep":{"default":true,"description":"Автоматично проходьте через згенерований код, який не може бути відображений назад до оригінального джерела.","type":"boolean"},"sourceMapPathOverrides":{"default":{"meteor://💻app/*":"${workspaceFolder}/*","webpack:///./~/*":"${workspaceFolder}/node_modules/*","webpack://?:*/*":"${workspaceFolder}/*"},"description":"Набір відображень для переписування місць розташування вихідних файлів з того, що вказує sourcemap, на їхні місця на диску.","type":"object"},"sourceMapRenames":{"default":true,"description":"Чи використовувати відображення \"names\" у sourcemaps. Це вимагає запиту на отримання вихідного контенту, що може бути повільним з певними налагоджувачами.","type":"boolean"},"sourceMaps":{"default":true,"description":"Використовуйте карти джерел JavaScript (якщо вони існують).","type":"boolean"},"timeout":{"default":10000,"description":"Спробуйте знову протягом цього числа мілісекунд для підключення до Node.js. За замовчуванням 10000 мс.","type":"number"},"timeouts":{"additionalProperties":false,"default":{},"description":"Тайм-аути для кількох операцій налагодження.","markdownDescription":"Таймаути для кількох операцій налагоджувача.","properties":{"hoverEvaluation":{"default":500,"description":"Час до оцінки значення для символів, на які наведено курсор, скасовується. Якщо встановлено 0, оцінка при наведенні ніколи не закінчується.","type":"number"},"sourceMapCumulativePause":{"default":1000,"description":"Додатковий час у мілісекундах, дозволений за сесію для очікування обробки source-map, після того як мінімальний час (sourceMapMinPause) буде вичерпано","type":"number"},"sourceMapMinPause":{"default":1000,"description":"Мінімальний час у мілісекундах, витрачений на очікування обробки кожної source-map під час парсингу скрипта","type":"number"}},"type":"object"},"trace":{"default":true,"description":"Налаштовує, який діагностичний вивід буде створено.","oneOf":[{"description":"Trace може бути встановлено на 'true', щоб записувати діагностичні журнали на диск.","type":"boolean"},{"additionalProperties":false,"properties":{"logFile":{"description":"Налаштовує, де на диску записуються журнали.","type":["string","null"]},"stdio":{"description":"Чи повертати дані трасування з запущеного додатку або браузера.","type":"boolean"}},"type":"object"}]}},"type":"object"}]},"showAsyncStacks":{"default":true,"description":"Показати асинхронні виклики, які призвели до поточного стеку викликів.","oneOf":[{"type":"boolean"},{"properties":{"onAttach":{"default":32,"type":"number"}},"required":["onAttach"],"type":"object"},{"properties":{"onceBreakpointResolved":{"default":32,"type":"number"}},"required":["onceBreakpointResolved"],"type":"object"}]},"skipFiles":{"default":["${/**"],"description":"Масив імен файлів або папок, або шаблонів шляхів, які слід пропустити під час налагодження. Дозволені зіркові шаблони та заперечення, наприклад, `[\"**/node_modules/**\", \"!**/node_modules/my-module/**\"]`","type":"array"},"smartStep":{"default":true,"description":"Автоматично проходьте через згенерований код, який не може бути відображений назад до оригінального джерела.","type":"boolean"},"sourceMapPathOverrides":{"default":{"meteor://💻app/*":"${workspaceFolder}/*","webpack:///./~/*":"${workspaceFolder}/node_modules/*","webpack://?:*/*":"${workspaceFolder}/*"},"description":"Набір відображень для переписування місць розташування вихідних файлів з того, що вказує sourcemap, на їхні місця на диску.","type":"object"},"sourceMapRenames":{"default":true,"description":"Чи використовувати відображення \"names\" у sourcemaps. Це вимагає запиту на отримання вихідного контенту, що може бути повільним з певними налагоджувачами.","type":"boolean"},"sourceMaps":{"default":true,"description":"Використовуйте карти джерел JavaScript (якщо вони існують).","type":"boolean"},"targetSelection":{"default":"automatic","enum":["pick","automatic"],"markdownDescription":"Чи прикріпити до всіх цілей, які відповідають фільтру URL (\"автоматично\"), чи запитати вибрати одну (\"вибрати\").","type":"string"},"timeout":{"default":10000,"description":"Спробуйте знову протягом цього числа мілісекунд для підключення до Node.js. За замовчуванням 10000 мс.","type":"number"},"timeouts":{"additionalProperties":false,"default":{},"description":"Тайм-аути для кількох операцій налагодження.","markdownDescription":"Таймаути для кількох операцій налагоджувача.","properties":{"hoverEvaluation":{"default":500,"description":"Час до оцінки значення для символів, на які наведено курсор, скасовується. Якщо встановлено 0, оцінка при наведенні ніколи не закінчується.","type":"number"},"sourceMapCumulativePause":{"default":1000,"description":"Додатковий час у мілісекундах, дозволений за сесію для очікування обробки source-map, після того як мінімальний час (sourceMapMinPause) буде вичерпано","type":"number"},"sourceMapMinPause":{"default":1000,"description":"Мінімальний час у мілісекундах, витрачений на очікування обробки кожної source-map під час парсингу скрипта","type":"number"}},"type":"object"},"trace":{"default":true,"description":"Налаштовує, який діагностичний вивід буде створено.","oneOf":[{"description":"Trace може бути встановлено на 'true', щоб записувати діагностичні журнали на диск.","type":"boolean"},{"additionalProperties":false,"properties":{"logFile":{"description":"Налаштовує, де на диску записуються журнали.","type":["string","null"]},"stdio":{"description":"Чи повертати дані трасування з запущеного додатку або браузера.","type":"boolean"}},"type":"object"}]},"url":{"default":"http://localhost:8080","description":"Шукатиме вкладку з цим точним URL і приєднається до неї, якщо буде знайдена","tags":["setup"],"type":"string"},"urlFilter":{"default":"","description":"Шукатиме сторінку з цим URL і прикріпить до неї, якщо знайде. Можуть бути * підстановочні знаки.","type":"string"},"useWebView":{"default":{"pipeName":"MyPipeName"},"description":"Об'єкт, що містить `pipeName` налагоджувальної труби для Webview2, розміщеного в UWP. Це \"MyTestSharedMemory\" під час створення труби \"\\\\.\\pipe\\LOCAL\\MyTestSharedMemory\".","properties":{"pipeName":{"type":"string"}},"type":"object"},"vueComponentPaths":{"default":["${workspaceFolder}/**/*.vue"],"description":"Список шаблонів глобусів файлів для знаходження `*.vue` компонентів. За замовчуванням, здійснює пошук по всьому робочому простору. Це потрібно вказати через додаткові запити, які потребують мапи джерел Vue в Vue CLI 4. Ви можете вимкнути це спеціальне оброблення, встановивши це в порожній масив.","type":"array"},"webRoot":{"default":"${workspaceFolder}","description":"Це вказує абсолютний шлях до кореня веб-сервера в робочому просторі. Використовується для вирішення шляхів, таких як `/app.js`, до файлів на диску. Скорочення для pathMapping для \"/\"","tags":["setup"],"type":"string"}}},"launch":{"properties":{"address":{"default":"localhost","description":"При налагодженні веб-переглядів IP-адреса або ім'я хоста, на якому слухає веб-перегляд. Буде автоматично виявлено, якщо не встановлено.","type":"string"},"browserLaunchLocation":{"default":null,"description":"Примушує браузер запускатися в одному місці. У віддаленому робочому просторі (наприклад, через ssh або WSL) це можна використовувати для відкриття браузера на віддаленій машині, а не локально.","oneOf":[{"type":"null"},{"enum":["ui","workspace"],"type":"string"}]},"cascadeTerminateToConfigurations":{"default":[],"description":"Список сеансів налагодження, які, коли цей сеанс налагодження буде завершено, також будуть зупинені.","items":{"type":"string","uniqueItems":true},"type":"array"},"cleanUp":{"default":"wholeBrowser","description":"Яке очищення потрібно зробити після завершення сеансу налагодження. Закрити лише вкладку, що налагоджується, проти закриття всього браузера.","enum":["wholeBrowser","onlyTab"],"type":"string"},"customDescriptionGenerator":{"description":"Налаштуйте текстовий опис, який відображає відладчик для об'єктів (локальних змінних тощо...). Приклади:\n      1. this.toString() // викликає toString для виведення всіх об'єктів\n      2. this.customDescription ? this.customDescription() : defaultValue // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть defaultValue\n      3. function (def) { return this.customDescription ? this.customDescription() : def } // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть defaultValue\n      ","type":"string"},"customPropertiesGenerator":{"deprecated":true,"description":"Налаштуйте властивості, які відображаються для об'єкта в налагоджувачі (локальні змінні тощо...). Приклади:\n    1. { ...this, extraProperty: '12345' } // Додати extraProperty 12345 до всіх об'єктів\n    2. this.customProperties ? this.customProperties() : this // Використовуйте метод customProperties, якщо він доступний, якщо ні - використовуйте властивості в this (за замовчуванням)\n    3. function () { return this.customProperties ? this.customProperties() : this } // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть властивості за замовчуванням\n\n    Застаріло: Це тимчасова реалізація цієї функції, поки ми не матимемо часу реалізувати її в спосіб, описаний тут: https://github.com/microsoft/vscode/issues/102181","type":"string"},"cwd":{"default":null,"description":"Необов'язкова робоча директорія для виконуваного файлу під час виконання.","type":"string"},"disableNetworkCache":{"default":true,"description":"Контролює, чи пропускати мережевий кеш для кожного запиту","type":"boolean"},"enableContentValidation":{"default":true,"description":"Перемикає, чи перевіряємо ми, що вміст файлів на диску відповідає завантаженим у час виконання. Це корисно в різних сценаріях і є обов'язковим у деяких, але може викликати проблеми, якщо у вас є серверна трансформація скриптів, наприклад.","type":"boolean"},"enableDWARF":{"default":true,"markdownDescription":"Перемикає, чи буде відладчик намагатися зчитувати символи налагодження DWARF з WebAssembly, що може вимагати багато ресурсів. Для роботи потрібен розширення `ms-vscode.wasm-dwarf-debugging`.","type":"boolean"},"env":{"default":{},"description":"Необов'язковий словник пар ключ/значення для середовища браузера.","type":"object"},"file":{"default":"${workspaceFolder}/index.html","description":"Локальний html файл для відкриття в браузері","tags":["setup"],"type":"string"},"includeDefaultArgs":{"default":true,"description":"Чи будуть включені аргументи запуску браузера за замовчуванням (для відключення функцій, які можуть ускладнити налагодження) у запуск.","type":"boolean"},"includeLaunchArgs":{"default":true,"description":"Розширені: чи встановлені будь-які аргументи за замовчуванням для запуску/налагодження в браузері. Налагоджувач припустить, що браузер використовуватиме налагодження через канал, таке як те, що надається з `--remote-debugging-pipe`.","type":"boolean"},"inspectUri":{"default":null,"description":"Формат, який потрібно використовувати для переписування inspectUri: Це шаблонний рядок, який інтерполює ключі в `{curlyBraces}`. Доступні ключі:\n - `url.*` - це розпарсена адреса запущеного застосунку. Наприклад, `{url.port}`, `{url.hostname}`\n - `port` - це порт налагодження, на якому слухає Chrome.\n - `browserInspectUri` - це URI інспектора на запущеному браузері.\n - `browserInspectUriPath` - це частина шляху URI інспектора на запущеному браузері (наприклад: \"/devtools/browser/e9ec0098-306e-472a-8133-5e42488929c2\").\n - `wsProtocol` - це вказаний протокол вебсокетів. Це встановлюється на `wss`, якщо оригінальна URL-адреса є `https`, або `ws` в іншому випадку.","type":["string","null"]},"killBehavior":{"default":"forceful","enum":["forceful","polite","none"],"markdownDescription":"Налаштовує, як браузерні процеси зупиняються при завершенні сесії з `cleanUp: wholeBrowser`. Може бути:\n\n- примусовим (за замовчуванням): примусово знищує дерево процесів. Надсилає SIGKILL на posix або `taskkill.exe /F` на Windows.\n- ввічливим: коректно знищує дерево процесів. Можливо, що неправильно працюючі процеси продовжать виконання після завершення в такий спосіб. Надсилає SIGTERM на posix або `taskkill.exe` без прапора `/F` (примус) на Windows.\n- жодного: жодне завершення не відбудеться.","type":"string"},"outFiles":{"default":["${workspaceFolder}/**/*.(m|c|)js","!**/node_modules/**"],"description":"Якщо карти джерел увімкнені, ці шаблони glob вказують на згенеровані файли JavaScript. Якщо шаблон починається з `!`, файли виключаються. Якщо не вказано, згенерований код очікується в тому ж каталозі, що й його джерело.","items":{"type":"string"},"tags":["setup"],"type":["array"]},"outputCapture":{"default":"console","enum":["console","std"],"markdownDescription":"Звідки захоплювати вихідні повідомлення: за замовчуванням API налагодження, якщо встановлено `console`, або потоки stdout/stderr, якщо встановлено `std`."},"pathMapping":{"default":{},"description":"Відображення URL/шляхів на локальні папки, щоб вирішити скрипти в браузері на скрипти на диску","type":"object"},"pauseForSourceMap":{"default":false,"markdownDescription":"Чи чекати на завантаження карт джерел для кожного вхідного скрипта. Це має накладні витрати на продуктивність і може бути безпечно вимкнено при виконанні з диска, якщо `rootPath` не вимкнено.","type":"boolean"},"perScriptSourcemaps":{"default":"auto","description":"Чи завантажуються скрипти окремо з унікальними sourcemaps, що містять базову назву вихідного файлу. Це можна налаштувати для оптимізації обробки sourcemap при роботі з великою кількістю малих скриптів. Якщо встановлено \"auto\", ми виявимо відомі випадки, коли це доречно.","enum":["yes","no","auto"],"type":"string"},"port":{"default":9229,"description":"Під час налагодження веб-переглядів порт, на якому слухає налагоджувач веб-переглядів. Буде автоматично виявлений, якщо не встановлено.","type":"number"},"profileStartup":{"default":true,"description":"Якщо це правда, почнемо профілювання, як тільки процес запуститься","type":"boolean"},"resolveSourceMapLocations":{"default":null,"description":"Список патернів minimatch для місць (папок та URL), в яких карти джерел можуть бути використані для вирішення локальних файлів. Це можна використовувати, щоб уникнути неправильного розриву в зовнішньому коді з картами джерел. Патерни можуть бути префіксовані знаком \"!\", щоб виключити їх. Може бути встановлено на порожній масив або null, щоб уникнути обмежень.","items":{"type":"string"},"type":["array","null"]},"runtimeArgs":{"default":[],"description":"Необов'язкові аргументи, передані виконуваному файлу часу виконання.","items":{"type":"string"},"type":"array"},"runtimeExecutable":{"default":"stable","description":"Може бути 'canary', 'stable', 'dev', 'custom' або шлях до виконуваного файлу браузера. Custom означає кастомний обгортку, кастомну збірку або змінну середовища EDGE_PATH.","type":["string","null"]},"server":{"oneOf":[{"additionalProperties":false,"default":{"program":"node my-server.js"},"description":"Налаштовує веб-сервер для запуску. Використовує таку ж конфігурацію, як і завдання запуску 'node'.","properties":{"args":{"default":[],"description":"Аргументи командного рядка, передані програмі.\n\nМожуть бути масивом рядків або єдиним рядком. Коли програма запускається в терміналі, встановлення цієї властивості в єдиний рядок призведе до того, що аргументи не будуть екрановані для оболонки.","items":{"type":"string"},"tags":["setup"],"type":["array","string"]},"attachSimplePort":{"default":9229,"description":"Якщо встановлено, приєднується до процесу через вказаний порт. Це зазвичай більше не є необхідним для програм Node.js і втрачає можливість налагодження дочірніх процесів, але може бути корисним у більш екзотичних сценаріях, таких як запуск з Deno та Docker. Якщо встановлено на 0, буде вибрано випадковий порт, і --inspect-brk буде автоматично додано до аргументів запуску.","oneOf":[{"type":"integer"},{"pattern":"^\\${.*}$","type":"string"}]},"autoAttachChildProcesses":{"default":true,"description":"Автоматично підключати налагоджувач до нових дочірніх процесів.","type":"boolean"},"cascadeTerminateToConfigurations":{"default":[],"description":"Список сеансів налагодження, які, коли цей сеанс налагодження буде завершено, також будуть зупинені.","items":{"type":"string","uniqueItems":true},"type":"array"},"console":{"default":"internalConsole","description":"Де запустити ціль налагодження.","enum":["internalConsole","integratedTerminal","externalTerminal"],"enumDescriptions":["Консоль налагодження VS Code (яка не підтримує читання введення з програми)","інтегрований термінал VS Code","Зовнішній термінал, який можна налаштувати через налаштування користувача"],"type":"string"},"customDescriptionGenerator":{"description":"Налаштуйте текстовий опис, який відображає відладчик для об'єктів (локальних змінних тощо...). Приклади:\n      1. this.toString() // викликає toString для виведення всіх об'єктів\n      2. this.customDescription ? this.customDescription() : defaultValue // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть defaultValue\n      3. function (def) { return this.customDescription ? this.customDescription() : def } // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть defaultValue\n      ","type":"string"},"customPropertiesGenerator":{"deprecated":true,"description":"Налаштуйте властивості, які відображаються для об'єкта в налагоджувачі (локальні змінні тощо...). Приклади:\n    1. { ...this, extraProperty: '12345' } // Додати extraProperty 12345 до всіх об'єктів\n    2. this.customProperties ? this.customProperties() : this // Використовуйте метод customProperties, якщо він доступний, якщо ні - використовуйте властивості в this (за замовчуванням)\n    3. function () { return this.customProperties ? this.customProperties() : this } // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть властивості за замовчуванням\n\n    Застаріло: Це тимчасова реалізація цієї функції, поки ми не матимемо часу реалізувати її в спосіб, описаний тут: https://github.com/microsoft/vscode/issues/102181","type":"string"},"cwd":{"default":"${workspaceFolder}","description":"Абсолютний шлях до робочого каталогу програми, що налагоджується. Якщо ви встановили localRoot, тоді cwd відповідатиме цьому значенню, інакше він повернеться до вашого workspaceFolder.","tags":["setup"],"type":"string"},"enableContentValidation":{"default":true,"description":"Перемикає, чи перевіряємо ми, що вміст файлів на диску відповідає завантаженим у час виконання. Це корисно в різних сценаріях і є обов'язковим у деяких, але може викликати проблеми, якщо у вас є серверна трансформація скриптів, наприклад.","type":"boolean"},"enableDWARF":{"default":true,"markdownDescription":"Перемикає, чи буде відладчик намагатися зчитувати символи налагодження DWARF з WebAssembly, що може вимагати багато ресурсів. Для роботи потрібен розширення `ms-vscode.wasm-dwarf-debugging`.","type":"boolean"},"env":{"additionalProperties":{"type":["string","null"]},"default":{},"markdownDescription":"Змінні середовища, передані програмі. Значення `null` видаляє змінну з середовища.","tags":["setup"],"type":"object"},"envFile":{"default":"${workspaceFolder}/.env","description":"Абсолютний шлях до файлу, що містить визначення змінних середовища.","type":"string"},"experimentalNetworking":{"default":"auto","description":"Увімкніть експериментальну перевірку в Node.js. Коли встановлено `auto`, це увімкнено для версій Node.js, які це підтримують. Його можна встановити на `on` або `off`, щоб увімкнути або вимкнути його явно.","enum":["auto","on","off"],"type":"string"},"killBehavior":{"default":"forceful","enum":["forceful","polite","none"],"markdownDescription":"Налаштовує, як процеси налагодження зупиняються при завершенні сеансу. Може бути:\n\n- примусовим (за замовчуванням): примусово знищує дерево процесів. Надсилає SIGKILL на posix або `taskkill.exe /F` на Windows.\n- ввічливим: м’яко знищує дерево процесів. Можливо, що некоректно працюючі процеси продовжать виконуватись після завершення таким чином. Надсилає SIGTERM на posix або `taskkill.exe` без прапора `/F` (примус) на Windows.\n- жодного: жодного завершення не відбудеться.","type":"string"},"localRoot":{"default":null,"description":"Шлях до локального каталогу, що містить програму.","type":["string","null"]},"nodeVersionHint":{"default":12,"description":"Дозволяє вам явно вказати версію Node, яка працює, що може бути використано для вимкнення або ввімкнення певних поведінок у випадках, коли автоматичне визначення версії не працює.","minimum":8,"type":"number"},"outFiles":{"default":["${workspaceFolder}/**/*.(m|c|)js","!**/node_modules/**"],"description":"Якщо карти джерел увімкнені, ці шаблони glob вказують на згенеровані файли JavaScript. Якщо шаблон починається з `!`, файли виключаються. Якщо не вказано, згенерований код очікується в тому ж каталозі, що й його джерело.","items":{"type":"string"},"tags":["setup"],"type":["array"]},"outputCapture":{"default":"console","enum":["console","std"],"markdownDescription":"Звідки захоплювати вихідні повідомлення: за замовчуванням API налагодження, якщо встановлено `console`, або потоки stdout/stderr, якщо встановлено `std`."},"pauseForSourceMap":{"default":false,"markdownDescription":"Чи чекати на завантаження карт джерел для кожного вхідного скрипта. Це має накладні витрати на продуктивність і може бути безпечно вимкнено при виконанні з диска, якщо `rootPath` не вимкнено.","type":"boolean"},"profileStartup":{"default":true,"description":"Якщо це правда, почне профілювання, як тільки процес запуститься","type":"boolean"},"program":{"default":"","description":"Абсолютний шлях до програми. Згенероване значення визначається шляхом аналізу package.json та відкритих файлів. Відредагуйте цей атрибут.","tags":["setup"],"type":"string"},"remoteRoot":{"default":null,"description":"Абсолютний шлях до віддаленого каталогу, що містить програму.","type":["string","null"]},"resolveSourceMapLocations":{"default":["${workspaceFolder}/**","!**/node_modules/**"],"description":"Список патернів minimatch для місць (папок та URL), в яких карти джерел можуть бути використані для вирішення локальних файлів. Це можна використовувати, щоб уникнути неправильного розриву в зовнішньому коді з картами джерел. Патерни можуть бути префіксовані знаком \"!\", щоб виключити їх. Може бути встановлено на порожній масив або null, щоб уникнути обмежень.","items":{"type":"string"},"type":["array","null"]},"restart":{"default":true,"description":"Спробуйте перепідключитися до програми, якщо ми втратимо з'єднання. Якщо встановлено `true`, ми будемо намагатися раз на секунду, вічно. Ви можете налаштувати інтервал і максимальну кількість спроб, вказавши `delay` та `maxAttempts` в об'єкті замість цього.","oneOf":[{"type":"boolean"},{"properties":{"delay":{"default":1000,"minimum":0,"type":"number"},"maxAttempts":{"default":10,"minimum":0,"type":"number"}},"type":"object"}]},"runtimeArgs":{"default":[],"description":"Необов'язкові аргументи, передані виконуваному файлу часу виконання.","items":{"type":"string"},"tags":["setup"],"type":"array"},"runtimeExecutable":{"default":"node","markdownDescription":"Час виконання для використання. Або абсолютний шлях, або ім'я часу виконання, доступного в PATH. Якщо пропущено, вважається, що використовується `node`.","type":["string","null"]},"runtimeSourcemapPausePatterns":{"default":[],"items":{"type":"string"},"markdownDescription":"Список шаблонів, за якими можна вручну вставити точки зупинки вхідної точки. Це може бути корисно, щоб надати відладчику можливість встановити точки зупинки при використанні sourcemaps, які не існують або не можуть бути виявлені до запуску, наприклад, [з фреймворком Serverless](https://github.com/microsoft/vscode-js-debug/issues/492).","type":"array"},"runtimeVersion":{"default":"default","markdownDescription":"Версія середовища виконання `node`, яку слід використовувати. Потрібен `nvm`.","type":"string"},"showAsyncStacks":{"default":true,"description":"Показати асинхронні виклики, які призвели до поточного стеку викликів.","oneOf":[{"type":"boolean"},{"properties":{"onAttach":{"default":32,"type":"number"}},"required":["onAttach"],"type":"object"},{"properties":{"onceBreakpointResolved":{"default":32,"type":"number"}},"required":["onceBreakpointResolved"],"type":"object"}]},"skipFiles":{"default":["${/**"],"description":"Масив імен файлів або папок, або шаблонів шляхів, які слід пропустити під час налагодження. Дозволені зіркові шаблони та заперечення, наприклад, `[\"**/node_modules/**\", \"!**/node_modules/my-module/**\"]`","type":"array"},"smartStep":{"default":true,"description":"Автоматично проходьте через згенерований код, який не може бути відображений назад до оригінального джерела.","type":"boolean"},"sourceMapPathOverrides":{"default":{"meteor://💻app/*":"${workspaceFolder}/*","webpack:///./~/*":"${workspaceFolder}/node_modules/*","webpack://?:*/*":"${workspaceFolder}/*"},"description":"Набір відображень для переписування місць розташування вихідних файлів з того, що вказує sourcemap, на їхні місця на диску.","type":"object"},"sourceMapRenames":{"default":true,"description":"Чи використовувати відображення \"names\" у sourcemaps. Це вимагає запиту на отримання вихідного контенту, що може бути повільним з певними налагоджувачами.","type":"boolean"},"sourceMaps":{"default":true,"description":"Використовуйте карти джерел JavaScript (якщо вони існують).","type":"boolean"},"stopOnEntry":{"default":true,"description":"Автоматично зупинити програму після запуску.","type":["boolean","string"]},"timeout":{"default":10000,"description":"Спробуйте знову протягом цього числа мілісекунд для підключення до Node.js. За замовчуванням 10000 мс.","type":"number"},"timeouts":{"additionalProperties":false,"default":{},"description":"Тайм-аути для кількох операцій налагодження.","markdownDescription":"Таймаути для кількох операцій налагоджувача.","properties":{"hoverEvaluation":{"default":500,"description":"Час до оцінки значення для символів, на які наведено курсор, скасовується. Якщо встановлено 0, оцінка при наведенні ніколи не закінчується.","type":"number"},"sourceMapCumulativePause":{"default":1000,"description":"Додатковий час у мілісекундах, дозволений за сесію для очікування обробки source-map, після того як мінімальний час (sourceMapMinPause) буде вичерпано","type":"number"},"sourceMapMinPause":{"default":1000,"description":"Мінімальний час у мілісекундах, витрачений на очікування обробки кожної source-map під час парсингу скрипта","type":"number"}},"type":"object"},"trace":{"default":true,"description":"Налаштовує, який діагностичний вивід буде створено.","oneOf":[{"description":"Trace може бути встановлено на 'true', щоб записувати діагностичні журнали на диск.","type":"boolean"},{"additionalProperties":false,"properties":{"logFile":{"description":"Налаштовує, де на диску записуються журнали.","type":["string","null"]},"stdio":{"description":"Чи повертати дані трасування з запущеного додатку або браузера.","type":"boolean"}},"type":"object"}]}},"type":"object"},{"additionalProperties":false,"default":{"program":"npm start"},"description":"Термінал налагодження JavaScript","properties":{"autoAttachChildProcesses":{"default":true,"description":"Автоматично підключати налагоджувач до нових дочірніх процесів.","type":"boolean"},"cascadeTerminateToConfigurations":{"default":[],"description":"Список сеансів налагодження, які, коли цей сеанс налагодження буде завершено, також будуть зупинені.","items":{"type":"string","uniqueItems":true},"type":"array"},"command":{"default":"npm start","description":"Команда для виконання в запущеному терміналі. Якщо не вказано, термінал відкриється без запуску програми.","tags":["setup"],"type":["string","null"]},"customDescriptionGenerator":{"description":"Налаштуйте текстовий опис, який відображає відладчик для об'єктів (локальних змінних тощо...). Приклади:\n      1. this.toString() // викликає toString для виведення всіх об'єктів\n      2. this.customDescription ? this.customDescription() : defaultValue // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть defaultValue\n      3. function (def) { return this.customDescription ? this.customDescription() : def } // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть defaultValue\n      ","type":"string"},"customPropertiesGenerator":{"deprecated":true,"description":"Налаштуйте властивості, які відображаються для об'єкта в налагоджувачі (локальні змінні тощо...). Приклади:\n    1. { ...this, extraProperty: '12345' } // Додати extraProperty 12345 до всіх об'єктів\n    2. this.customProperties ? this.customProperties() : this // Використовуйте метод customProperties, якщо він доступний, якщо ні - використовуйте властивості в this (за замовчуванням)\n    3. function () { return this.customProperties ? this.customProperties() : this } // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть властивості за замовчуванням\n\n    Застаріло: Це тимчасова реалізація цієї функції, поки ми не матимемо часу реалізувати її в спосіб, описаний тут: https://github.com/microsoft/vscode/issues/102181","type":"string"},"cwd":{"default":"${workspaceFolder}","description":"Абсолютний шлях до робочого каталогу програми, що налагоджується. Якщо ви встановили localRoot, тоді cwd відповідатиме цьому значенню, інакше він повернеться до вашого workspaceFolder.","docDefault":"localRoot || ${workspaceFolder}","tags":["setup"],"type":"string"},"enableContentValidation":{"default":true,"description":"Перемикає, чи перевіряємо ми, що вміст файлів на диску відповідає завантаженим у час виконання. Це корисно в різних сценаріях і є обов'язковим у деяких, але може викликати проблеми, якщо у вас є серверна трансформація скриптів, наприклад.","type":"boolean"},"enableDWARF":{"default":true,"markdownDescription":"Перемикає, чи буде відладчик намагатися зчитувати символи налагодження DWARF з WebAssembly, що може вимагати багато ресурсів. Для роботи потрібен розширення `ms-vscode.wasm-dwarf-debugging`.","type":"boolean"},"env":{"additionalProperties":{"type":["string","null"]},"default":{},"markdownDescription":"Змінні середовища, передані програмі. Значення `null` видаляє змінну з середовища.","tags":["setup"],"type":"object"},"envFile":{"default":"${workspaceFolder}/.env","description":"Абсолютний шлях до файлу, що містить визначення змінних середовища.","type":"string"},"localRoot":{"default":null,"description":"Шлях до локального каталогу, що містить програму.","type":["string","null"]},"nodeVersionHint":{"default":12,"description":"Дозволяє вам явно вказати версію Node, яка працює, що може бути використано для вимкнення або ввімкнення певних поведінок у випадках, коли автоматичне визначення версії не працює.","minimum":8,"type":"number"},"outFiles":{"default":["${workspaceFolder}/**/*.(m|c|)js","!**/node_modules/**"],"description":"Якщо карти джерел увімкнені, ці шаблони glob вказують на згенеровані файли JavaScript. Якщо шаблон починається з `!`, файли виключаються. Якщо не вказано, згенерований код очікується в тому ж каталозі, що й його джерело.","items":{"type":"string"},"tags":["setup"],"type":["array"]},"outputCapture":{"default":"console","enum":["console","std"],"markdownDescription":"Звідки захоплювати вихідні повідомлення: за замовчуванням API налагодження, якщо встановлено `console`, або потоки stdout/stderr, якщо встановлено `std`."},"pauseForSourceMap":{"default":false,"markdownDescription":"Чи чекати на завантаження карт джерел для кожного вхідного скрипта. Це має накладні витрати на продуктивність і може бути безпечно вимкнено при виконанні з диска, якщо `rootPath` не вимкнено.","type":"boolean"},"remoteRoot":{"default":null,"description":"Абсолютний шлях до віддаленого каталогу, що містить програму.","type":["string","null"]},"resolveSourceMapLocations":{"default":["${workspaceFolder}/**","!**/node_modules/**"],"description":"Список патернів minimatch для місць (папок та URL), в яких карти джерел можуть бути використані для вирішення локальних файлів. Це можна використовувати, щоб уникнути неправильного розриву в зовнішньому коді з картами джерел. Патерни можуть бути префіксовані знаком \"!\", щоб виключити їх. Може бути встановлено на порожній масив або null, щоб уникнути обмежень.","items":{"type":"string"},"type":["array","null"]},"runtimeSourcemapPausePatterns":{"default":[],"items":{"type":"string"},"markdownDescription":"Список шаблонів, за якими можна вручну вставити точки зупинки вхідної точки. Це може бути корисно, щоб надати відладчику можливість встановити точки зупинки при використанні sourcemaps, які не існують або не можуть бути виявлені до запуску, наприклад, [з фреймворком Serverless](https://github.com/microsoft/vscode-js-debug/issues/492).","type":"array"},"showAsyncStacks":{"default":true,"description":"Показати асинхронні виклики, які призвели до поточного стеку викликів.","oneOf":[{"type":"boolean"},{"properties":{"onAttach":{"default":32,"type":"number"}},"required":["onAttach"],"type":"object"},{"properties":{"onceBreakpointResolved":{"default":32,"type":"number"}},"required":["onceBreakpointResolved"],"type":"object"}]},"skipFiles":{"default":["${/**"],"description":"Масив імен файлів або папок, або шаблонів шляхів, які слід пропустити під час налагодження. Дозволені зіркові шаблони та заперечення, наприклад, `[\"**/node_modules/**\", \"!**/node_modules/my-module/**\"]`","type":"array"},"smartStep":{"default":true,"description":"Автоматично проходьте через згенерований код, який не може бути відображений назад до оригінального джерела.","type":"boolean"},"sourceMapPathOverrides":{"default":{"meteor://💻app/*":"${workspaceFolder}/*","webpack:///./~/*":"${workspaceFolder}/node_modules/*","webpack://?:*/*":"${workspaceFolder}/*"},"description":"Набір відображень для переписування місць розташування вихідних файлів з того, що вказує sourcemap, на їхні місця на диску.","type":"object"},"sourceMapRenames":{"default":true,"description":"Чи використовувати відображення \"names\" у sourcemaps. Це вимагає запиту на отримання вихідного контенту, що може бути повільним з певними налагоджувачами.","type":"boolean"},"sourceMaps":{"default":true,"description":"Використовуйте карти джерел JavaScript (якщо вони існують).","type":"boolean"},"timeout":{"default":10000,"description":"Спробуйте знову протягом цього числа мілісекунд для підключення до Node.js. За замовчуванням 10000 мс.","type":"number"},"timeouts":{"additionalProperties":false,"default":{},"description":"Тайм-аути для кількох операцій налагодження.","markdownDescription":"Таймаути для кількох операцій налагоджувача.","properties":{"hoverEvaluation":{"default":500,"description":"Час до оцінки значення для символів, на які наведено курсор, скасовується. Якщо встановлено 0, оцінка при наведенні ніколи не закінчується.","type":"number"},"sourceMapCumulativePause":{"default":1000,"description":"Додатковий час у мілісекундах, дозволений за сесію для очікування обробки source-map, після того як мінімальний час (sourceMapMinPause) буде вичерпано","type":"number"},"sourceMapMinPause":{"default":1000,"description":"Мінімальний час у мілісекундах, витрачений на очікування обробки кожної source-map під час парсингу скрипта","type":"number"}},"type":"object"},"trace":{"default":true,"description":"Налаштовує, який діагностичний вивід буде створено.","oneOf":[{"description":"Trace може бути встановлено на 'true', щоб записувати діагностичні журнали на диск.","type":"boolean"},{"additionalProperties":false,"properties":{"logFile":{"description":"Налаштовує, де на диску записуються журнали.","type":["string","null"]},"stdio":{"description":"Чи повертати дані трасування з запущеного додатку або браузера.","type":"boolean"}},"type":"object"}]}},"type":"object"}]},"showAsyncStacks":{"default":true,"description":"Показати асинхронні виклики, які призвели до поточного стеку викликів.","oneOf":[{"type":"boolean"},{"properties":{"onAttach":{"default":32,"type":"number"}},"required":["onAttach"],"type":"object"},{"properties":{"onceBreakpointResolved":{"default":32,"type":"number"}},"required":["onceBreakpointResolved"],"type":"object"}]},"skipFiles":{"default":["${/**"],"description":"Масив імен файлів або папок, або шаблонів шляхів, які слід пропустити під час налагодження. Дозволені зіркові шаблони та заперечення, наприклад, `[\"**/node_modules/**\", \"!**/node_modules/my-module/**\"]`","type":"array"},"smartStep":{"default":true,"description":"Автоматично проходьте через згенерований код, який не може бути відображений назад до оригінального джерела.","type":"boolean"},"sourceMapPathOverrides":{"default":{"meteor://💻app/*":"${workspaceFolder}/*","webpack:///./~/*":"${workspaceFolder}/node_modules/*","webpack://?:*/*":"${workspaceFolder}/*"},"description":"Набір відображень для переписування місць розташування вихідних файлів з того, що вказує sourcemap, на їхні місця на диску.","type":"object"},"sourceMapRenames":{"default":true,"description":"Чи використовувати відображення \"names\" у sourcemaps. Це вимагає запиту на отримання вихідного контенту, що може бути повільним з певними налагоджувачами.","type":"boolean"},"sourceMaps":{"default":true,"description":"Використовуйте карти джерел JavaScript (якщо вони існують).","type":"boolean"},"timeout":{"default":10000,"description":"Спробуйте знову протягом цього числа мілісекунд для підключення до Node.js. За замовчуванням 10000 мс.","type":"number"},"timeouts":{"additionalProperties":false,"default":{},"description":"Тайм-аути для кількох операцій налагодження.","markdownDescription":"Таймаути для кількох операцій налагоджувача.","properties":{"hoverEvaluation":{"default":500,"description":"Час до оцінки значення для символів, на які наведено курсор, скасовується. Якщо встановлено 0, оцінка при наведенні ніколи не закінчується.","type":"number"},"sourceMapCumulativePause":{"default":1000,"description":"Додатковий час у мілісекундах, дозволений за сесію для очікування обробки source-map, після того як мінімальний час (sourceMapMinPause) буде вичерпано","type":"number"},"sourceMapMinPause":{"default":1000,"description":"Мінімальний час у мілісекундах, витрачений на очікування обробки кожної source-map під час парсингу скрипта","type":"number"}},"type":"object"},"trace":{"default":true,"description":"Налаштовує, який діагностичний вивід буде створено.","oneOf":[{"description":"Trace може бути встановлено на 'true', щоб записувати діагностичні журнали на диск.","type":"boolean"},{"additionalProperties":false,"properties":{"logFile":{"description":"Налаштовує, де на диску записуються журнали.","type":["string","null"]},"stdio":{"description":"Чи повертати дані трасування з запущеного додатку або браузера.","type":"boolean"}},"type":"object"}]},"url":{"default":"http://localhost:8080","description":"Шукатиме вкладку з цим точним URL і приєднається до неї, якщо буде знайдена","tags":["setup"],"type":"string"},"urlFilter":{"default":"","description":"Шукатиме сторінку з цим URL і прикріпить до неї, якщо знайде. Можуть бути * підстановочні знаки.","type":"string"},"useWebView":{"default":false,"description":"Коли 'true', налагоджувач буде розглядати виконуваний файл під час виконання як хост-додаток, що містить WebView, що дозволяє вам налагоджувати вміст скрипта WebView.","type":"boolean"},"userDataDir":{"default":true,"description":"За замовчуванням браузер запускається з окремим профілем користувача в тимчасовій папці. Використовуйте цю опцію, щоб переоприділити це. Встановіть значення false, щоб запустити з вашим профілем користувача за замовчуванням. Новий браузер не може бути запущений, якщо екземпляр вже працює з `userDataDir`.","type":["string","boolean"]},"vueComponentPaths":{"default":["${workspaceFolder}/**/*.vue"],"description":"Список шаблонів глобусів файлів для знаходження `*.vue` компонентів. За замовчуванням, здійснює пошук по всьому робочому простору. Це потрібно вказати через додаткові запити, які потребують мапи джерел Vue в Vue CLI 4. Ви можете вимкнути це спеціальне оброблення, встановивши це в порожній масив.","type":"array"},"webRoot":{"default":"${workspaceFolder}","description":"Це вказує абсолютний шлях до кореня веб-сервера в робочому просторі. Використовується для вирішення шляхів, таких як `/app.js`, до файлів на диску. Скорочення для pathMapping для \"/\"","tags":["setup"],"type":"string"}}}},"configurationSnippets":[],"deprecated":"Please use type msedge instead","label":"Веб-додаток (Edge)","languages":["javascript","typescript","javascriptreact","typescriptreact","html","css","coffeescript","handlebars","vue"],"strings":{"unverifiedBreakpoints":"Деякі з ваших точок зупинки не можуть бути встановлені. Якщо у вас виникає проблема, ви можете [усунути неполадки у вашій конфігурації запуску](command:extension.js-debug.createDiagnostics)."},"type":"pwa-msedge"},{"aiKey":"0c6ae279ed8443289764825290e4f9e2-1a736e7c-1324-4338-be46-fc2a58ae4d14-7255","configurationAttributes":{"attach":{"properties":{"address":{"default":"localhost","description":"IP-адреса або ім'я хоста, на якому слухає налагоджений браузер.","type":"string"},"browserAttachLocation":{"default":null,"description":"Примушує браузер підключатися в одному місці. У віддаленому робочому просторі (через ssh або WSL, наприклад) це можна використовувати для підключення до браузера на віддаленій машині, а не локально.","oneOf":[{"type":"null"},{"enum":["ui","workspace"],"type":"string"}]},"cascadeTerminateToConfigurations":{"default":[],"description":"Список сеансів налагодження, які, коли цей сеанс налагодження буде завершено, також будуть зупинені.","items":{"type":"string","uniqueItems":true},"type":"array"},"customDescriptionGenerator":{"description":"Налаштуйте текстовий опис, який відображає відладчик для об'єктів (локальних змінних тощо...). Приклади:\n      1. this.toString() // викликає toString для виведення всіх об'єктів\n      2. this.customDescription ? this.customDescription() : defaultValue // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть defaultValue\n      3. function (def) { return this.customDescription ? this.customDescription() : def } // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть defaultValue\n      ","type":"string"},"customPropertiesGenerator":{"deprecated":true,"description":"Налаштуйте властивості, які відображаються для об'єкта в налагоджувачі (локальні змінні тощо...). Приклади:\n    1. { ...this, extraProperty: '12345' } // Додати extraProperty 12345 до всіх об'єктів\n    2. this.customProperties ? this.customProperties() : this // Використовуйте метод customProperties, якщо він доступний, якщо ні - використовуйте властивості в this (за замовчуванням)\n    3. function () { return this.customProperties ? this.customProperties() : this } // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть властивості за замовчуванням\n\n    Застаріло: Це тимчасова реалізація цієї функції, поки ми не матимемо часу реалізувати її в спосіб, описаний тут: https://github.com/microsoft/vscode/issues/102181","type":"string"},"disableNetworkCache":{"default":true,"description":"Контролює, чи пропускати мережевий кеш для кожного запиту","type":"boolean"},"enableContentValidation":{"default":true,"description":"Перемикає, чи перевіряємо ми, що вміст файлів на диску відповідає завантаженим у час виконання. Це корисно в різних сценаріях і є обов'язковим у деяких, але може викликати проблеми, якщо у вас є серверна трансформація скриптів, наприклад.","type":"boolean"},"enableDWARF":{"default":true,"markdownDescription":"Перемикає, чи буде відладчик намагатися зчитувати символи налагодження DWARF з WebAssembly, що може вимагати багато ресурсів. Для роботи потрібен розширення `ms-vscode.wasm-dwarf-debugging`.","type":"boolean"},"inspectUri":{"default":null,"description":"Формат, який потрібно використовувати для переписування inspectUri: Це шаблонний рядок, який інтерполює ключі в `{curlyBraces}`. Доступні ключі:\n - `url.*` - це розпарсена адреса запущеного застосунку. Наприклад, `{url.port}`, `{url.hostname}`\n - `port` - це порт налагодження, на якому слухає Chrome.\n - `browserInspectUri` - це URI інспектора на запущеному браузері.\n - `browserInspectUriPath` - це частина шляху URI інспектора на запущеному браузері (наприклад: \"/devtools/browser/e9ec0098-306e-472a-8133-5e42488929c2\").\n - `wsProtocol` - це вказаний протокол вебсокетів. Це встановлюється на `wss`, якщо оригінальна URL-адреса є `https`, або `ws` в іншому випадку.","type":["string","null"]},"outFiles":{"default":["${workspaceFolder}/**/*.(m|c|)js","!**/node_modules/**"],"description":"Якщо карти джерел увімкнені, ці шаблони glob вказують на згенеровані файли JavaScript. Якщо шаблон починається з `!`, файли виключаються. Якщо не вказано, згенерований код очікується в тому ж каталозі, що й його джерело.","items":{"type":"string"},"tags":["setup"],"type":["array"]},"outputCapture":{"default":"console","enum":["console","std"],"markdownDescription":"Звідки захоплювати вихідні повідомлення: за замовчуванням API налагодження, якщо встановлено `console`, або потоки stdout/stderr, якщо встановлено `std`."},"pathMapping":{"default":{},"description":"Відображення URL/шляхів на локальні папки, щоб вирішити скрипти в браузері на скрипти на диску","type":"object"},"pauseForSourceMap":{"default":false,"markdownDescription":"Чи чекати на завантаження карт джерел для кожного вхідного скрипта. Це має накладні витрати на продуктивність і може бути безпечно вимкнено при виконанні з диска, якщо `rootPath` не вимкнено.","type":"boolean"},"perScriptSourcemaps":{"default":"auto","description":"Чи завантажуються скрипти окремо з унікальними sourcemaps, що містять базову назву вихідного файлу. Це можна налаштувати для оптимізації обробки sourcemap при роботі з великою кількістю малих скриптів. Якщо встановлено \"auto\", ми виявимо відомі випадки, коли це доречно.","enum":["yes","no","auto"],"type":"string"},"port":{"default":9229,"description":"Порт, який використовувати для віддаленого налагодження браузера, вказується як `--remote-debugging-port` під час запуску браузера.","oneOf":[{"type":"integer"},{"pattern":"^\\${.*}$","type":"string"}],"tags":["setup"]},"resolveSourceMapLocations":{"default":null,"description":"Список патернів minimatch для місць (папок та URL), в яких карти джерел можуть бути використані для вирішення локальних файлів. Це можна використовувати, щоб уникнути неправильного розриву в зовнішньому коді з картами джерел. Патерни можуть бути префіксовані знаком \"!\", щоб виключити їх. Може бути встановлено на порожній масив або null, щоб уникнути обмежень.","items":{"type":"string"},"type":["array","null"]},"restart":{"default":false,"markdownDescription":"Чи підключитися знову, якщо з'єднання браузера закрито","type":"boolean"},"server":{"oneOf":[{"additionalProperties":false,"default":{"program":"node my-server.js"},"description":"Налаштовує веб-сервер для запуску. Використовує таку ж конфігурацію, як і завдання запуску 'node'.","properties":{"args":{"default":[],"description":"Аргументи командного рядка, передані програмі.\n\nМожуть бути масивом рядків або єдиним рядком. Коли програма запускається в терміналі, встановлення цієї властивості в єдиний рядок призведе до того, що аргументи не будуть екрановані для оболонки.","items":{"type":"string"},"tags":["setup"],"type":["array","string"]},"attachSimplePort":{"default":9229,"description":"Якщо встановлено, приєднується до процесу через вказаний порт. Це зазвичай більше не є необхідним для програм Node.js і втрачає можливість налагодження дочірніх процесів, але може бути корисним у більш екзотичних сценаріях, таких як запуск з Deno та Docker. Якщо встановлено на 0, буде вибрано випадковий порт, і --inspect-brk буде автоматично додано до аргументів запуску.","oneOf":[{"type":"integer"},{"pattern":"^\\${.*}$","type":"string"}]},"autoAttachChildProcesses":{"default":true,"description":"Автоматично підключати налагоджувач до нових дочірніх процесів.","type":"boolean"},"cascadeTerminateToConfigurations":{"default":[],"description":"Список сеансів налагодження, які, коли цей сеанс налагодження буде завершено, також будуть зупинені.","items":{"type":"string","uniqueItems":true},"type":"array"},"console":{"default":"internalConsole","description":"Де запустити ціль налагодження.","enum":["internalConsole","integratedTerminal","externalTerminal"],"enumDescriptions":["Консоль налагодження VS Code (яка не підтримує читання введення з програми)","інтегрований термінал VS Code","Зовнішній термінал, який можна налаштувати через налаштування користувача"],"type":"string"},"customDescriptionGenerator":{"description":"Налаштуйте текстовий опис, який відображає відладчик для об'єктів (локальних змінних тощо...). Приклади:\n      1. this.toString() // викликає toString для виведення всіх об'єктів\n      2. this.customDescription ? this.customDescription() : defaultValue // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть defaultValue\n      3. function (def) { return this.customDescription ? this.customDescription() : def } // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть defaultValue\n      ","type":"string"},"customPropertiesGenerator":{"deprecated":true,"description":"Налаштуйте властивості, які відображаються для об'єкта в налагоджувачі (локальні змінні тощо...). Приклади:\n    1. { ...this, extraProperty: '12345' } // Додати extraProperty 12345 до всіх об'єктів\n    2. this.customProperties ? this.customProperties() : this // Використовуйте метод customProperties, якщо він доступний, якщо ні - використовуйте властивості в this (за замовчуванням)\n    3. function () { return this.customProperties ? this.customProperties() : this } // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть властивості за замовчуванням\n\n    Застаріло: Це тимчасова реалізація цієї функції, поки ми не матимемо часу реалізувати її в спосіб, описаний тут: https://github.com/microsoft/vscode/issues/102181","type":"string"},"cwd":{"default":"${workspaceFolder}","description":"Абсолютний шлях до робочого каталогу програми, що налагоджується. Якщо ви встановили localRoot, тоді cwd відповідатиме цьому значенню, інакше він повернеться до вашого workspaceFolder.","tags":["setup"],"type":"string"},"enableContentValidation":{"default":true,"description":"Перемикає, чи перевіряємо ми, що вміст файлів на диску відповідає завантаженим у час виконання. Це корисно в різних сценаріях і є обов'язковим у деяких, але може викликати проблеми, якщо у вас є серверна трансформація скриптів, наприклад.","type":"boolean"},"enableDWARF":{"default":true,"markdownDescription":"Перемикає, чи буде відладчик намагатися зчитувати символи налагодження DWARF з WebAssembly, що може вимагати багато ресурсів. Для роботи потрібен розширення `ms-vscode.wasm-dwarf-debugging`.","type":"boolean"},"env":{"additionalProperties":{"type":["string","null"]},"default":{},"markdownDescription":"Змінні середовища, передані програмі. Значення `null` видаляє змінну з середовища.","tags":["setup"],"type":"object"},"envFile":{"default":"${workspaceFolder}/.env","description":"Абсолютний шлях до файлу, що містить визначення змінних середовища.","type":"string"},"experimentalNetworking":{"default":"auto","description":"Увімкніть експериментальну перевірку в Node.js. Коли встановлено `auto`, це увімкнено для версій Node.js, які це підтримують. Його можна встановити на `on` або `off`, щоб увімкнути або вимкнути його явно.","enum":["auto","on","off"],"type":"string"},"killBehavior":{"default":"forceful","enum":["forceful","polite","none"],"markdownDescription":"Налаштовує, як процеси налагодження зупиняються при завершенні сеансу. Може бути:\n\n- примусовим (за замовчуванням): примусово знищує дерево процесів. Надсилає SIGKILL на posix або `taskkill.exe /F` на Windows.\n- ввічливим: м’яко знищує дерево процесів. Можливо, що некоректно працюючі процеси продовжать виконуватись після завершення таким чином. Надсилає SIGTERM на posix або `taskkill.exe` без прапора `/F` (примус) на Windows.\n- жодного: жодного завершення не відбудеться.","type":"string"},"localRoot":{"default":null,"description":"Шлях до локального каталогу, що містить програму.","type":["string","null"]},"nodeVersionHint":{"default":12,"description":"Дозволяє вам явно вказати версію Node, яка працює, що може бути використано для вимкнення або ввімкнення певних поведінок у випадках, коли автоматичне визначення версії не працює.","minimum":8,"type":"number"},"outFiles":{"default":["${workspaceFolder}/**/*.(m|c|)js","!**/node_modules/**"],"description":"Якщо карти джерел увімкнені, ці шаблони glob вказують на згенеровані файли JavaScript. Якщо шаблон починається з `!`, файли виключаються. Якщо не вказано, згенерований код очікується в тому ж каталозі, що й його джерело.","items":{"type":"string"},"tags":["setup"],"type":["array"]},"outputCapture":{"default":"console","enum":["console","std"],"markdownDescription":"Звідки захоплювати вихідні повідомлення: за замовчуванням API налагодження, якщо встановлено `console`, або потоки stdout/stderr, якщо встановлено `std`."},"pauseForSourceMap":{"default":false,"markdownDescription":"Чи чекати на завантаження карт джерел для кожного вхідного скрипта. Це має накладні витрати на продуктивність і може бути безпечно вимкнено при виконанні з диска, якщо `rootPath` не вимкнено.","type":"boolean"},"profileStartup":{"default":true,"description":"Якщо це правда, почне профілювання, як тільки процес запуститься","type":"boolean"},"program":{"default":"","description":"Абсолютний шлях до програми. Згенероване значення визначається шляхом аналізу package.json та відкритих файлів. Відредагуйте цей атрибут.","tags":["setup"],"type":"string"},"remoteRoot":{"default":null,"description":"Абсолютний шлях до віддаленого каталогу, що містить програму.","type":["string","null"]},"resolveSourceMapLocations":{"default":["${workspaceFolder}/**","!**/node_modules/**"],"description":"Список патернів minimatch для місць (папок та URL), в яких карти джерел можуть бути використані для вирішення локальних файлів. Це можна використовувати, щоб уникнути неправильного розриву в зовнішньому коді з картами джерел. Патерни можуть бути префіксовані знаком \"!\", щоб виключити їх. Може бути встановлено на порожній масив або null, щоб уникнути обмежень.","items":{"type":"string"},"type":["array","null"]},"restart":{"default":true,"description":"Спробуйте перепідключитися до програми, якщо ми втратимо з'єднання. Якщо встановлено `true`, ми будемо намагатися раз на секунду, вічно. Ви можете налаштувати інтервал і максимальну кількість спроб, вказавши `delay` та `maxAttempts` в об'єкті замість цього.","oneOf":[{"type":"boolean"},{"properties":{"delay":{"default":1000,"minimum":0,"type":"number"},"maxAttempts":{"default":10,"minimum":0,"type":"number"}},"type":"object"}]},"runtimeArgs":{"default":[],"description":"Необов'язкові аргументи, передані виконуваному файлу часу виконання.","items":{"type":"string"},"tags":["setup"],"type":"array"},"runtimeExecutable":{"default":"node","markdownDescription":"Час виконання для використання. Або абсолютний шлях, або ім'я часу виконання, доступного в PATH. Якщо пропущено, вважається, що використовується `node`.","type":["string","null"]},"runtimeSourcemapPausePatterns":{"default":[],"items":{"type":"string"},"markdownDescription":"Список шаблонів, за якими можна вручну вставити точки зупинки вхідної точки. Це може бути корисно, щоб надати відладчику можливість встановити точки зупинки при використанні sourcemaps, які не існують або не можуть бути виявлені до запуску, наприклад, [з фреймворком Serverless](https://github.com/microsoft/vscode-js-debug/issues/492).","type":"array"},"runtimeVersion":{"default":"default","markdownDescription":"Версія середовища виконання `node`, яку слід використовувати. Потрібен `nvm`.","type":"string"},"showAsyncStacks":{"default":true,"description":"Показати асинхронні виклики, які призвели до поточного стеку викликів.","oneOf":[{"type":"boolean"},{"properties":{"onAttach":{"default":32,"type":"number"}},"required":["onAttach"],"type":"object"},{"properties":{"onceBreakpointResolved":{"default":32,"type":"number"}},"required":["onceBreakpointResolved"],"type":"object"}]},"skipFiles":{"default":["${/**"],"description":"Масив імен файлів або папок, або шаблонів шляхів, які слід пропустити під час налагодження. Дозволені зіркові шаблони та заперечення, наприклад, `[\"**/node_modules/**\", \"!**/node_modules/my-module/**\"]`","type":"array"},"smartStep":{"default":true,"description":"Автоматично проходьте через згенерований код, який не може бути відображений назад до оригінального джерела.","type":"boolean"},"sourceMapPathOverrides":{"default":{"meteor://💻app/*":"${workspaceFolder}/*","webpack:///./~/*":"${workspaceFolder}/node_modules/*","webpack://?:*/*":"${workspaceFolder}/*"},"description":"Набір відображень для переписування місць розташування вихідних файлів з того, що вказує sourcemap, на їхні місця на диску.","type":"object"},"sourceMapRenames":{"default":true,"description":"Чи використовувати відображення \"names\" у sourcemaps. Це вимагає запиту на отримання вихідного контенту, що може бути повільним з певними налагоджувачами.","type":"boolean"},"sourceMaps":{"default":true,"description":"Використовуйте карти джерел JavaScript (якщо вони існують).","type":"boolean"},"stopOnEntry":{"default":true,"description":"Автоматично зупинити програму після запуску.","type":["boolean","string"]},"timeout":{"default":10000,"description":"Спробуйте знову протягом цього числа мілісекунд для підключення до Node.js. За замовчуванням 10000 мс.","type":"number"},"timeouts":{"additionalProperties":false,"default":{},"description":"Тайм-аути для кількох операцій налагодження.","markdownDescription":"Таймаути для кількох операцій налагоджувача.","properties":{"hoverEvaluation":{"default":500,"description":"Час до оцінки значення для символів, на які наведено курсор, скасовується. Якщо встановлено 0, оцінка при наведенні ніколи не закінчується.","type":"number"},"sourceMapCumulativePause":{"default":1000,"description":"Додатковий час у мілісекундах, дозволений за сесію для очікування обробки source-map, після того як мінімальний час (sourceMapMinPause) буде вичерпано","type":"number"},"sourceMapMinPause":{"default":1000,"description":"Мінімальний час у мілісекундах, витрачений на очікування обробки кожної source-map під час парсингу скрипта","type":"number"}},"type":"object"},"trace":{"default":true,"description":"Налаштовує, який діагностичний вивід буде створено.","oneOf":[{"description":"Trace може бути встановлено на 'true', щоб записувати діагностичні журнали на диск.","type":"boolean"},{"additionalProperties":false,"properties":{"logFile":{"description":"Налаштовує, де на диску записуються журнали.","type":["string","null"]},"stdio":{"description":"Чи повертати дані трасування з запущеного додатку або браузера.","type":"boolean"}},"type":"object"}]}},"type":"object"},{"additionalProperties":false,"default":{"program":"npm start"},"description":"Термінал налагодження JavaScript","properties":{"autoAttachChildProcesses":{"default":true,"description":"Автоматично підключати налагоджувач до нових дочірніх процесів.","type":"boolean"},"cascadeTerminateToConfigurations":{"default":[],"description":"Список сеансів налагодження, які, коли цей сеанс налагодження буде завершено, також будуть зупинені.","items":{"type":"string","uniqueItems":true},"type":"array"},"command":{"default":"npm start","description":"Команда для виконання в запущеному терміналі. Якщо не вказано, термінал відкриється без запуску програми.","tags":["setup"],"type":["string","null"]},"customDescriptionGenerator":{"description":"Налаштуйте текстовий опис, який відображає відладчик для об'єктів (локальних змінних тощо...). Приклади:\n      1. this.toString() // викликає toString для виведення всіх об'єктів\n      2. this.customDescription ? this.customDescription() : defaultValue // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть defaultValue\n      3. function (def) { return this.customDescription ? this.customDescription() : def } // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть defaultValue\n      ","type":"string"},"customPropertiesGenerator":{"deprecated":true,"description":"Налаштуйте властивості, які відображаються для об'єкта в налагоджувачі (локальні змінні тощо...). Приклади:\n    1. { ...this, extraProperty: '12345' } // Додати extraProperty 12345 до всіх об'єктів\n    2. this.customProperties ? this.customProperties() : this // Використовуйте метод customProperties, якщо він доступний, якщо ні - використовуйте властивості в this (за замовчуванням)\n    3. function () { return this.customProperties ? this.customProperties() : this } // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть властивості за замовчуванням\n\n    Застаріло: Це тимчасова реалізація цієї функції, поки ми не матимемо часу реалізувати її в спосіб, описаний тут: https://github.com/microsoft/vscode/issues/102181","type":"string"},"cwd":{"default":"${workspaceFolder}","description":"Абсолютний шлях до робочого каталогу програми, що налагоджується. Якщо ви встановили localRoot, тоді cwd відповідатиме цьому значенню, інакше він повернеться до вашого workspaceFolder.","docDefault":"localRoot || ${workspaceFolder}","tags":["setup"],"type":"string"},"enableContentValidation":{"default":true,"description":"Перемикає, чи перевіряємо ми, що вміст файлів на диску відповідає завантаженим у час виконання. Це корисно в різних сценаріях і є обов'язковим у деяких, але може викликати проблеми, якщо у вас є серверна трансформація скриптів, наприклад.","type":"boolean"},"enableDWARF":{"default":true,"markdownDescription":"Перемикає, чи буде відладчик намагатися зчитувати символи налагодження DWARF з WebAssembly, що може вимагати багато ресурсів. Для роботи потрібен розширення `ms-vscode.wasm-dwarf-debugging`.","type":"boolean"},"env":{"additionalProperties":{"type":["string","null"]},"default":{},"markdownDescription":"Змінні середовища, передані програмі. Значення `null` видаляє змінну з середовища.","tags":["setup"],"type":"object"},"envFile":{"default":"${workspaceFolder}/.env","description":"Абсолютний шлях до файлу, що містить визначення змінних середовища.","type":"string"},"localRoot":{"default":null,"description":"Шлях до локального каталогу, що містить програму.","type":["string","null"]},"nodeVersionHint":{"default":12,"description":"Дозволяє вам явно вказати версію Node, яка працює, що може бути використано для вимкнення або ввімкнення певних поведінок у випадках, коли автоматичне визначення версії не працює.","minimum":8,"type":"number"},"outFiles":{"default":["${workspaceFolder}/**/*.(m|c|)js","!**/node_modules/**"],"description":"Якщо карти джерел увімкнені, ці шаблони glob вказують на згенеровані файли JavaScript. Якщо шаблон починається з `!`, файли виключаються. Якщо не вказано, згенерований код очікується в тому ж каталозі, що й його джерело.","items":{"type":"string"},"tags":["setup"],"type":["array"]},"outputCapture":{"default":"console","enum":["console","std"],"markdownDescription":"Звідки захоплювати вихідні повідомлення: за замовчуванням API налагодження, якщо встановлено `console`, або потоки stdout/stderr, якщо встановлено `std`."},"pauseForSourceMap":{"default":false,"markdownDescription":"Чи чекати на завантаження карт джерел для кожного вхідного скрипта. Це має накладні витрати на продуктивність і може бути безпечно вимкнено при виконанні з диска, якщо `rootPath` не вимкнено.","type":"boolean"},"remoteRoot":{"default":null,"description":"Абсолютний шлях до віддаленого каталогу, що містить програму.","type":["string","null"]},"resolveSourceMapLocations":{"default":["${workspaceFolder}/**","!**/node_modules/**"],"description":"Список патернів minimatch для місць (папок та URL), в яких карти джерел можуть бути використані для вирішення локальних файлів. Це можна використовувати, щоб уникнути неправильного розриву в зовнішньому коді з картами джерел. Патерни можуть бути префіксовані знаком \"!\", щоб виключити їх. Може бути встановлено на порожній масив або null, щоб уникнути обмежень.","items":{"type":"string"},"type":["array","null"]},"runtimeSourcemapPausePatterns":{"default":[],"items":{"type":"string"},"markdownDescription":"Список шаблонів, за якими можна вручну вставити точки зупинки вхідної точки. Це може бути корисно, щоб надати відладчику можливість встановити точки зупинки при використанні sourcemaps, які не існують або не можуть бути виявлені до запуску, наприклад, [з фреймворком Serverless](https://github.com/microsoft/vscode-js-debug/issues/492).","type":"array"},"showAsyncStacks":{"default":true,"description":"Показати асинхронні виклики, які призвели до поточного стеку викликів.","oneOf":[{"type":"boolean"},{"properties":{"onAttach":{"default":32,"type":"number"}},"required":["onAttach"],"type":"object"},{"properties":{"onceBreakpointResolved":{"default":32,"type":"number"}},"required":["onceBreakpointResolved"],"type":"object"}]},"skipFiles":{"default":["${/**"],"description":"Масив імен файлів або папок, або шаблонів шляхів, які слід пропустити під час налагодження. Дозволені зіркові шаблони та заперечення, наприклад, `[\"**/node_modules/**\", \"!**/node_modules/my-module/**\"]`","type":"array"},"smartStep":{"default":true,"description":"Автоматично проходьте через згенерований код, який не може бути відображений назад до оригінального джерела.","type":"boolean"},"sourceMapPathOverrides":{"default":{"meteor://💻app/*":"${workspaceFolder}/*","webpack:///./~/*":"${workspaceFolder}/node_modules/*","webpack://?:*/*":"${workspaceFolder}/*"},"description":"Набір відображень для переписування місць розташування вихідних файлів з того, що вказує sourcemap, на їхні місця на диску.","type":"object"},"sourceMapRenames":{"default":true,"description":"Чи використовувати відображення \"names\" у sourcemaps. Це вимагає запиту на отримання вихідного контенту, що може бути повільним з певними налагоджувачами.","type":"boolean"},"sourceMaps":{"default":true,"description":"Використовуйте карти джерел JavaScript (якщо вони існують).","type":"boolean"},"timeout":{"default":10000,"description":"Спробуйте знову протягом цього числа мілісекунд для підключення до Node.js. За замовчуванням 10000 мс.","type":"number"},"timeouts":{"additionalProperties":false,"default":{},"description":"Тайм-аути для кількох операцій налагодження.","markdownDescription":"Таймаути для кількох операцій налагоджувача.","properties":{"hoverEvaluation":{"default":500,"description":"Час до оцінки значення для символів, на які наведено курсор, скасовується. Якщо встановлено 0, оцінка при наведенні ніколи не закінчується.","type":"number"},"sourceMapCumulativePause":{"default":1000,"description":"Додатковий час у мілісекундах, дозволений за сесію для очікування обробки source-map, після того як мінімальний час (sourceMapMinPause) буде вичерпано","type":"number"},"sourceMapMinPause":{"default":1000,"description":"Мінімальний час у мілісекундах, витрачений на очікування обробки кожної source-map під час парсингу скрипта","type":"number"}},"type":"object"},"trace":{"default":true,"description":"Налаштовує, який діагностичний вивід буде створено.","oneOf":[{"description":"Trace може бути встановлено на 'true', щоб записувати діагностичні журнали на диск.","type":"boolean"},{"additionalProperties":false,"properties":{"logFile":{"description":"Налаштовує, де на диску записуються журнали.","type":["string","null"]},"stdio":{"description":"Чи повертати дані трасування з запущеного додатку або браузера.","type":"boolean"}},"type":"object"}]}},"type":"object"}]},"showAsyncStacks":{"default":true,"description":"Показати асинхронні виклики, які призвели до поточного стеку викликів.","oneOf":[{"type":"boolean"},{"properties":{"onAttach":{"default":32,"type":"number"}},"required":["onAttach"],"type":"object"},{"properties":{"onceBreakpointResolved":{"default":32,"type":"number"}},"required":["onceBreakpointResolved"],"type":"object"}]},"skipFiles":{"default":["${/**"],"description":"Масив імен файлів або папок, або шаблонів шляхів, які слід пропустити під час налагодження. Дозволені зіркові шаблони та заперечення, наприклад, `[\"**/node_modules/**\", \"!**/node_modules/my-module/**\"]`","type":"array"},"smartStep":{"default":true,"description":"Автоматично проходьте через згенерований код, який не може бути відображений назад до оригінального джерела.","type":"boolean"},"sourceMapPathOverrides":{"default":{"meteor://💻app/*":"${workspaceFolder}/*","webpack:///./~/*":"${workspaceFolder}/node_modules/*","webpack://?:*/*":"${workspaceFolder}/*"},"description":"Набір відображень для переписування місць розташування вихідних файлів з того, що вказує sourcemap, на їхні місця на диску.","type":"object"},"sourceMapRenames":{"default":true,"description":"Чи використовувати відображення \"names\" у sourcemaps. Це вимагає запиту на отримання вихідного контенту, що може бути повільним з певними налагоджувачами.","type":"boolean"},"sourceMaps":{"default":true,"description":"Використовуйте карти джерел JavaScript (якщо вони існують).","type":"boolean"},"targetSelection":{"default":"automatic","enum":["pick","automatic"],"markdownDescription":"Чи прикріпити до всіх цілей, які відповідають фільтру URL (\"автоматично\"), чи запитати вибрати одну (\"вибрати\").","type":"string"},"timeout":{"default":10000,"description":"Спробуйте знову протягом цього числа мілісекунд для підключення до Node.js. За замовчуванням 10000 мс.","type":"number"},"timeouts":{"additionalProperties":false,"default":{},"description":"Тайм-аути для кількох операцій налагодження.","markdownDescription":"Таймаути для кількох операцій налагоджувача.","properties":{"hoverEvaluation":{"default":500,"description":"Час до оцінки значення для символів, на які наведено курсор, скасовується. Якщо встановлено 0, оцінка при наведенні ніколи не закінчується.","type":"number"},"sourceMapCumulativePause":{"default":1000,"description":"Додатковий час у мілісекундах, дозволений за сесію для очікування обробки source-map, після того як мінімальний час (sourceMapMinPause) буде вичерпано","type":"number"},"sourceMapMinPause":{"default":1000,"description":"Мінімальний час у мілісекундах, витрачений на очікування обробки кожної source-map під час парсингу скрипта","type":"number"}},"type":"object"},"trace":{"default":true,"description":"Налаштовує, який діагностичний вивід буде створено.","oneOf":[{"description":"Trace може бути встановлено на 'true', щоб записувати діагностичні журнали на диск.","type":"boolean"},{"additionalProperties":false,"properties":{"logFile":{"description":"Налаштовує, де на диску записуються журнали.","type":["string","null"]},"stdio":{"description":"Чи повертати дані трасування з запущеного додатку або браузера.","type":"boolean"}},"type":"object"}]},"url":{"default":"http://localhost:8080","description":"Шукатиме вкладку з цим точним URL і приєднається до неї, якщо буде знайдена","tags":["setup"],"type":"string"},"urlFilter":{"default":"","description":"Шукатиме сторінку з цим URL і прикріпить до неї, якщо знайде. Можуть бути * підстановочні знаки.","type":"string"},"useWebView":{"default":{"pipeName":"MyPipeName"},"description":"Об'єкт, що містить `pipeName` налагоджувальної труби для Webview2, розміщеного в UWP. Це \"MyTestSharedMemory\" під час створення труби \"\\\\.\\pipe\\LOCAL\\MyTestSharedMemory\".","properties":{"pipeName":{"type":"string"}},"type":"object"},"vueComponentPaths":{"default":["${workspaceFolder}/**/*.vue"],"description":"Список шаблонів глобусів файлів для знаходження `*.vue` компонентів. За замовчуванням, здійснює пошук по всьому робочому простору. Це потрібно вказати через додаткові запити, які потребують мапи джерел Vue в Vue CLI 4. Ви можете вимкнути це спеціальне оброблення, встановивши це в порожній масив.","type":"array"},"webRoot":{"default":"${workspaceFolder}","description":"Це вказує абсолютний шлях до кореня веб-сервера в робочому просторі. Використовується для вирішення шляхів, таких як `/app.js`, до файлів на диску. Скорочення для pathMapping для \"/\"","tags":["setup"],"type":"string"}}},"launch":{"properties":{"address":{"default":"localhost","description":"При налагодженні веб-переглядів IP-адреса або ім'я хоста, на якому слухає веб-перегляд. Буде автоматично виявлено, якщо не встановлено.","type":"string"},"browserLaunchLocation":{"default":null,"description":"Примушує браузер запускатися в одному місці. У віддаленому робочому просторі (наприклад, через ssh або WSL) це можна використовувати для відкриття браузера на віддаленій машині, а не локально.","oneOf":[{"type":"null"},{"enum":["ui","workspace"],"type":"string"}]},"cascadeTerminateToConfigurations":{"default":[],"description":"Список сеансів налагодження, які, коли цей сеанс налагодження буде завершено, також будуть зупинені.","items":{"type":"string","uniqueItems":true},"type":"array"},"cleanUp":{"default":"wholeBrowser","description":"Яке очищення потрібно зробити після завершення сеансу налагодження. Закрити лише вкладку, що налагоджується, проти закриття всього браузера.","enum":["wholeBrowser","onlyTab"],"type":"string"},"customDescriptionGenerator":{"description":"Налаштуйте текстовий опис, який відображає відладчик для об'єктів (локальних змінних тощо...). Приклади:\n      1. this.toString() // викликає toString для виведення всіх об'єктів\n      2. this.customDescription ? this.customDescription() : defaultValue // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть defaultValue\n      3. function (def) { return this.customDescription ? this.customDescription() : def } // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть defaultValue\n      ","type":"string"},"customPropertiesGenerator":{"deprecated":true,"description":"Налаштуйте властивості, які відображаються для об'єкта в налагоджувачі (локальні змінні тощо...). Приклади:\n    1. { ...this, extraProperty: '12345' } // Додати extraProperty 12345 до всіх об'єктів\n    2. this.customProperties ? this.customProperties() : this // Використовуйте метод customProperties, якщо він доступний, якщо ні - використовуйте властивості в this (за замовчуванням)\n    3. function () { return this.customProperties ? this.customProperties() : this } // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть властивості за замовчуванням\n\n    Застаріло: Це тимчасова реалізація цієї функції, поки ми не матимемо часу реалізувати її в спосіб, описаний тут: https://github.com/microsoft/vscode/issues/102181","type":"string"},"cwd":{"default":null,"description":"Необов'язкова робоча директорія для виконуваного файлу під час виконання.","type":"string"},"disableNetworkCache":{"default":true,"description":"Контролює, чи пропускати мережевий кеш для кожного запиту","type":"boolean"},"enableContentValidation":{"default":true,"description":"Перемикає, чи перевіряємо ми, що вміст файлів на диску відповідає завантаженим у час виконання. Це корисно в різних сценаріях і є обов'язковим у деяких, але може викликати проблеми, якщо у вас є серверна трансформація скриптів, наприклад.","type":"boolean"},"enableDWARF":{"default":true,"markdownDescription":"Перемикає, чи буде відладчик намагатися зчитувати символи налагодження DWARF з WebAssembly, що може вимагати багато ресурсів. Для роботи потрібен розширення `ms-vscode.wasm-dwarf-debugging`.","type":"boolean"},"env":{"default":{},"description":"Необов'язковий словник пар ключ/значення для середовища браузера.","type":"object"},"file":{"default":"${workspaceFolder}/index.html","description":"Локальний html файл для відкриття в браузері","tags":["setup"],"type":"string"},"includeDefaultArgs":{"default":true,"description":"Чи будуть включені аргументи запуску браузера за замовчуванням (для відключення функцій, які можуть ускладнити налагодження) у запуск.","type":"boolean"},"includeLaunchArgs":{"default":true,"description":"Розширені: чи встановлені будь-які аргументи за замовчуванням для запуску/налагодження в браузері. Налагоджувач припустить, що браузер використовуватиме налагодження через канал, таке як те, що надається з `--remote-debugging-pipe`.","type":"boolean"},"inspectUri":{"default":null,"description":"Формат, який потрібно використовувати для переписування inspectUri: Це шаблонний рядок, який інтерполює ключі в `{curlyBraces}`. Доступні ключі:\n - `url.*` - це розпарсена адреса запущеного застосунку. Наприклад, `{url.port}`, `{url.hostname}`\n - `port` - це порт налагодження, на якому слухає Chrome.\n - `browserInspectUri` - це URI інспектора на запущеному браузері.\n - `browserInspectUriPath` - це частина шляху URI інспектора на запущеному браузері (наприклад: \"/devtools/browser/e9ec0098-306e-472a-8133-5e42488929c2\").\n - `wsProtocol` - це вказаний протокол вебсокетів. Це встановлюється на `wss`, якщо оригінальна URL-адреса є `https`, або `ws` в іншому випадку.","type":["string","null"]},"killBehavior":{"default":"forceful","enum":["forceful","polite","none"],"markdownDescription":"Налаштовує, як браузерні процеси зупиняються при завершенні сесії з `cleanUp: wholeBrowser`. Може бути:\n\n- примусовим (за замовчуванням): примусово знищує дерево процесів. Надсилає SIGKILL на posix або `taskkill.exe /F` на Windows.\n- ввічливим: коректно знищує дерево процесів. Можливо, що неправильно працюючі процеси продовжать виконання після завершення в такий спосіб. Надсилає SIGTERM на posix або `taskkill.exe` без прапора `/F` (примус) на Windows.\n- жодного: жодне завершення не відбудеться.","type":"string"},"outFiles":{"default":["${workspaceFolder}/**/*.(m|c|)js","!**/node_modules/**"],"description":"Якщо карти джерел увімкнені, ці шаблони glob вказують на згенеровані файли JavaScript. Якщо шаблон починається з `!`, файли виключаються. Якщо не вказано, згенерований код очікується в тому ж каталозі, що й його джерело.","items":{"type":"string"},"tags":["setup"],"type":["array"]},"outputCapture":{"default":"console","enum":["console","std"],"markdownDescription":"Звідки захоплювати вихідні повідомлення: за замовчуванням API налагодження, якщо встановлено `console`, або потоки stdout/stderr, якщо встановлено `std`."},"pathMapping":{"default":{},"description":"Відображення URL/шляхів на локальні папки, щоб вирішити скрипти в браузері на скрипти на диску","type":"object"},"pauseForSourceMap":{"default":false,"markdownDescription":"Чи чекати на завантаження карт джерел для кожного вхідного скрипта. Це має накладні витрати на продуктивність і може бути безпечно вимкнено при виконанні з диска, якщо `rootPath` не вимкнено.","type":"boolean"},"perScriptSourcemaps":{"default":"auto","description":"Чи завантажуються скрипти окремо з унікальними sourcemaps, що містять базову назву вихідного файлу. Це можна налаштувати для оптимізації обробки sourcemap при роботі з великою кількістю малих скриптів. Якщо встановлено \"auto\", ми виявимо відомі випадки, коли це доречно.","enum":["yes","no","auto"],"type":"string"},"port":{"default":9229,"description":"Під час налагодження веб-переглядів порт, на якому слухає налагоджувач веб-переглядів. Буде автоматично виявлений, якщо не встановлено.","type":"number"},"profileStartup":{"default":true,"description":"Якщо це правда, почнемо профілювання, як тільки процес запуститься","type":"boolean"},"resolveSourceMapLocations":{"default":null,"description":"Список патернів minimatch для місць (папок та URL), в яких карти джерел можуть бути використані для вирішення локальних файлів. Це можна використовувати, щоб уникнути неправильного розриву в зовнішньому коді з картами джерел. Патерни можуть бути префіксовані знаком \"!\", щоб виключити їх. Може бути встановлено на порожній масив або null, щоб уникнути обмежень.","items":{"type":"string"},"type":["array","null"]},"runtimeArgs":{"default":[],"description":"Необов'язкові аргументи, передані виконуваному файлу часу виконання.","items":{"type":"string"},"type":"array"},"runtimeExecutable":{"default":"stable","description":"Може бути 'canary', 'stable', 'dev', 'custom' або шлях до виконуваного файлу браузера. Custom означає кастомний обгортку, кастомну збірку або змінну середовища EDGE_PATH.","type":["string","null"]},"server":{"oneOf":[{"additionalProperties":false,"default":{"program":"node my-server.js"},"description":"Налаштовує веб-сервер для запуску. Використовує таку ж конфігурацію, як і завдання запуску 'node'.","properties":{"args":{"default":[],"description":"Аргументи командного рядка, передані програмі.\n\nМожуть бути масивом рядків або єдиним рядком. Коли програма запускається в терміналі, встановлення цієї властивості в єдиний рядок призведе до того, що аргументи не будуть екрановані для оболонки.","items":{"type":"string"},"tags":["setup"],"type":["array","string"]},"attachSimplePort":{"default":9229,"description":"Якщо встановлено, приєднується до процесу через вказаний порт. Це зазвичай більше не є необхідним для програм Node.js і втрачає можливість налагодження дочірніх процесів, але може бути корисним у більш екзотичних сценаріях, таких як запуск з Deno та Docker. Якщо встановлено на 0, буде вибрано випадковий порт, і --inspect-brk буде автоматично додано до аргументів запуску.","oneOf":[{"type":"integer"},{"pattern":"^\\${.*}$","type":"string"}]},"autoAttachChildProcesses":{"default":true,"description":"Автоматично підключати налагоджувач до нових дочірніх процесів.","type":"boolean"},"cascadeTerminateToConfigurations":{"default":[],"description":"Список сеансів налагодження, які, коли цей сеанс налагодження буде завершено, також будуть зупинені.","items":{"type":"string","uniqueItems":true},"type":"array"},"console":{"default":"internalConsole","description":"Де запустити ціль налагодження.","enum":["internalConsole","integratedTerminal","externalTerminal"],"enumDescriptions":["Консоль налагодження VS Code (яка не підтримує читання введення з програми)","інтегрований термінал VS Code","Зовнішній термінал, який можна налаштувати через налаштування користувача"],"type":"string"},"customDescriptionGenerator":{"description":"Налаштуйте текстовий опис, який відображає відладчик для об'єктів (локальних змінних тощо...). Приклади:\n      1. this.toString() // викликає toString для виведення всіх об'єктів\n      2. this.customDescription ? this.customDescription() : defaultValue // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть defaultValue\n      3. function (def) { return this.customDescription ? this.customDescription() : def } // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть defaultValue\n      ","type":"string"},"customPropertiesGenerator":{"deprecated":true,"description":"Налаштуйте властивості, які відображаються для об'єкта в налагоджувачі (локальні змінні тощо...). Приклади:\n    1. { ...this, extraProperty: '12345' } // Додати extraProperty 12345 до всіх об'єктів\n    2. this.customProperties ? this.customProperties() : this // Використовуйте метод customProperties, якщо він доступний, якщо ні - використовуйте властивості в this (за замовчуванням)\n    3. function () { return this.customProperties ? this.customProperties() : this } // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть властивості за замовчуванням\n\n    Застаріло: Це тимчасова реалізація цієї функції, поки ми не матимемо часу реалізувати її в спосіб, описаний тут: https://github.com/microsoft/vscode/issues/102181","type":"string"},"cwd":{"default":"${workspaceFolder}","description":"Абсолютний шлях до робочого каталогу програми, що налагоджується. Якщо ви встановили localRoot, тоді cwd відповідатиме цьому значенню, інакше він повернеться до вашого workspaceFolder.","tags":["setup"],"type":"string"},"enableContentValidation":{"default":true,"description":"Перемикає, чи перевіряємо ми, що вміст файлів на диску відповідає завантаженим у час виконання. Це корисно в різних сценаріях і є обов'язковим у деяких, але може викликати проблеми, якщо у вас є серверна трансформація скриптів, наприклад.","type":"boolean"},"enableDWARF":{"default":true,"markdownDescription":"Перемикає, чи буде відладчик намагатися зчитувати символи налагодження DWARF з WebAssembly, що може вимагати багато ресурсів. Для роботи потрібен розширення `ms-vscode.wasm-dwarf-debugging`.","type":"boolean"},"env":{"additionalProperties":{"type":["string","null"]},"default":{},"markdownDescription":"Змінні середовища, передані програмі. Значення `null` видаляє змінну з середовища.","tags":["setup"],"type":"object"},"envFile":{"default":"${workspaceFolder}/.env","description":"Абсолютний шлях до файлу, що містить визначення змінних середовища.","type":"string"},"experimentalNetworking":{"default":"auto","description":"Увімкніть експериментальну перевірку в Node.js. Коли встановлено `auto`, це увімкнено для версій Node.js, які це підтримують. Його можна встановити на `on` або `off`, щоб увімкнути або вимкнути його явно.","enum":["auto","on","off"],"type":"string"},"killBehavior":{"default":"forceful","enum":["forceful","polite","none"],"markdownDescription":"Налаштовує, як процеси налагодження зупиняються при завершенні сеансу. Може бути:\n\n- примусовим (за замовчуванням): примусово знищує дерево процесів. Надсилає SIGKILL на posix або `taskkill.exe /F` на Windows.\n- ввічливим: м’яко знищує дерево процесів. Можливо, що некоректно працюючі процеси продовжать виконуватись після завершення таким чином. Надсилає SIGTERM на posix або `taskkill.exe` без прапора `/F` (примус) на Windows.\n- жодного: жодного завершення не відбудеться.","type":"string"},"localRoot":{"default":null,"description":"Шлях до локального каталогу, що містить програму.","type":["string","null"]},"nodeVersionHint":{"default":12,"description":"Дозволяє вам явно вказати версію Node, яка працює, що може бути використано для вимкнення або ввімкнення певних поведінок у випадках, коли автоматичне визначення версії не працює.","minimum":8,"type":"number"},"outFiles":{"default":["${workspaceFolder}/**/*.(m|c|)js","!**/node_modules/**"],"description":"Якщо карти джерел увімкнені, ці шаблони glob вказують на згенеровані файли JavaScript. Якщо шаблон починається з `!`, файли виключаються. Якщо не вказано, згенерований код очікується в тому ж каталозі, що й його джерело.","items":{"type":"string"},"tags":["setup"],"type":["array"]},"outputCapture":{"default":"console","enum":["console","std"],"markdownDescription":"Звідки захоплювати вихідні повідомлення: за замовчуванням API налагодження, якщо встановлено `console`, або потоки stdout/stderr, якщо встановлено `std`."},"pauseForSourceMap":{"default":false,"markdownDescription":"Чи чекати на завантаження карт джерел для кожного вхідного скрипта. Це має накладні витрати на продуктивність і може бути безпечно вимкнено при виконанні з диска, якщо `rootPath` не вимкнено.","type":"boolean"},"profileStartup":{"default":true,"description":"Якщо це правда, почне профілювання, як тільки процес запуститься","type":"boolean"},"program":{"default":"","description":"Абсолютний шлях до програми. Згенероване значення визначається шляхом аналізу package.json та відкритих файлів. Відредагуйте цей атрибут.","tags":["setup"],"type":"string"},"remoteRoot":{"default":null,"description":"Абсолютний шлях до віддаленого каталогу, що містить програму.","type":["string","null"]},"resolveSourceMapLocations":{"default":["${workspaceFolder}/**","!**/node_modules/**"],"description":"Список патернів minimatch для місць (папок та URL), в яких карти джерел можуть бути використані для вирішення локальних файлів. Це можна використовувати, щоб уникнути неправильного розриву в зовнішньому коді з картами джерел. Патерни можуть бути префіксовані знаком \"!\", щоб виключити їх. Може бути встановлено на порожній масив або null, щоб уникнути обмежень.","items":{"type":"string"},"type":["array","null"]},"restart":{"default":true,"description":"Спробуйте перепідключитися до програми, якщо ми втратимо з'єднання. Якщо встановлено `true`, ми будемо намагатися раз на секунду, вічно. Ви можете налаштувати інтервал і максимальну кількість спроб, вказавши `delay` та `maxAttempts` в об'єкті замість цього.","oneOf":[{"type":"boolean"},{"properties":{"delay":{"default":1000,"minimum":0,"type":"number"},"maxAttempts":{"default":10,"minimum":0,"type":"number"}},"type":"object"}]},"runtimeArgs":{"default":[],"description":"Необов'язкові аргументи, передані виконуваному файлу часу виконання.","items":{"type":"string"},"tags":["setup"],"type":"array"},"runtimeExecutable":{"default":"node","markdownDescription":"Час виконання для використання. Або абсолютний шлях, або ім'я часу виконання, доступного в PATH. Якщо пропущено, вважається, що використовується `node`.","type":["string","null"]},"runtimeSourcemapPausePatterns":{"default":[],"items":{"type":"string"},"markdownDescription":"Список шаблонів, за якими можна вручну вставити точки зупинки вхідної точки. Це може бути корисно, щоб надати відладчику можливість встановити точки зупинки при використанні sourcemaps, які не існують або не можуть бути виявлені до запуску, наприклад, [з фреймворком Serverless](https://github.com/microsoft/vscode-js-debug/issues/492).","type":"array"},"runtimeVersion":{"default":"default","markdownDescription":"Версія середовища виконання `node`, яку слід використовувати. Потрібен `nvm`.","type":"string"},"showAsyncStacks":{"default":true,"description":"Показати асинхронні виклики, які призвели до поточного стеку викликів.","oneOf":[{"type":"boolean"},{"properties":{"onAttach":{"default":32,"type":"number"}},"required":["onAttach"],"type":"object"},{"properties":{"onceBreakpointResolved":{"default":32,"type":"number"}},"required":["onceBreakpointResolved"],"type":"object"}]},"skipFiles":{"default":["${/**"],"description":"Масив імен файлів або папок, або шаблонів шляхів, які слід пропустити під час налагодження. Дозволені зіркові шаблони та заперечення, наприклад, `[\"**/node_modules/**\", \"!**/node_modules/my-module/**\"]`","type":"array"},"smartStep":{"default":true,"description":"Автоматично проходьте через згенерований код, який не може бути відображений назад до оригінального джерела.","type":"boolean"},"sourceMapPathOverrides":{"default":{"meteor://💻app/*":"${workspaceFolder}/*","webpack:///./~/*":"${workspaceFolder}/node_modules/*","webpack://?:*/*":"${workspaceFolder}/*"},"description":"Набір відображень для переписування місць розташування вихідних файлів з того, що вказує sourcemap, на їхні місця на диску.","type":"object"},"sourceMapRenames":{"default":true,"description":"Чи використовувати відображення \"names\" у sourcemaps. Це вимагає запиту на отримання вихідного контенту, що може бути повільним з певними налагоджувачами.","type":"boolean"},"sourceMaps":{"default":true,"description":"Використовуйте карти джерел JavaScript (якщо вони існують).","type":"boolean"},"stopOnEntry":{"default":true,"description":"Автоматично зупинити програму після запуску.","type":["boolean","string"]},"timeout":{"default":10000,"description":"Спробуйте знову протягом цього числа мілісекунд для підключення до Node.js. За замовчуванням 10000 мс.","type":"number"},"timeouts":{"additionalProperties":false,"default":{},"description":"Тайм-аути для кількох операцій налагодження.","markdownDescription":"Таймаути для кількох операцій налагоджувача.","properties":{"hoverEvaluation":{"default":500,"description":"Час до оцінки значення для символів, на які наведено курсор, скасовується. Якщо встановлено 0, оцінка при наведенні ніколи не закінчується.","type":"number"},"sourceMapCumulativePause":{"default":1000,"description":"Додатковий час у мілісекундах, дозволений за сесію для очікування обробки source-map, після того як мінімальний час (sourceMapMinPause) буде вичерпано","type":"number"},"sourceMapMinPause":{"default":1000,"description":"Мінімальний час у мілісекундах, витрачений на очікування обробки кожної source-map під час парсингу скрипта","type":"number"}},"type":"object"},"trace":{"default":true,"description":"Налаштовує, який діагностичний вивід буде створено.","oneOf":[{"description":"Trace може бути встановлено на 'true', щоб записувати діагностичні журнали на диск.","type":"boolean"},{"additionalProperties":false,"properties":{"logFile":{"description":"Налаштовує, де на диску записуються журнали.","type":["string","null"]},"stdio":{"description":"Чи повертати дані трасування з запущеного додатку або браузера.","type":"boolean"}},"type":"object"}]}},"type":"object"},{"additionalProperties":false,"default":{"program":"npm start"},"description":"Термінал налагодження JavaScript","properties":{"autoAttachChildProcesses":{"default":true,"description":"Автоматично підключати налагоджувач до нових дочірніх процесів.","type":"boolean"},"cascadeTerminateToConfigurations":{"default":[],"description":"Список сеансів налагодження, які, коли цей сеанс налагодження буде завершено, також будуть зупинені.","items":{"type":"string","uniqueItems":true},"type":"array"},"command":{"default":"npm start","description":"Команда для виконання в запущеному терміналі. Якщо не вказано, термінал відкриється без запуску програми.","tags":["setup"],"type":["string","null"]},"customDescriptionGenerator":{"description":"Налаштуйте текстовий опис, який відображає відладчик для об'єктів (локальних змінних тощо...). Приклади:\n      1. this.toString() // викликає toString для виведення всіх об'єктів\n      2. this.customDescription ? this.customDescription() : defaultValue // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть defaultValue\n      3. function (def) { return this.customDescription ? this.customDescription() : def } // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть defaultValue\n      ","type":"string"},"customPropertiesGenerator":{"deprecated":true,"description":"Налаштуйте властивості, які відображаються для об'єкта в налагоджувачі (локальні змінні тощо...). Приклади:\n    1. { ...this, extraProperty: '12345' } // Додати extraProperty 12345 до всіх об'єктів\n    2. this.customProperties ? this.customProperties() : this // Використовуйте метод customProperties, якщо він доступний, якщо ні - використовуйте властивості в this (за замовчуванням)\n    3. function () { return this.customProperties ? this.customProperties() : this } // Використовуйте метод customDescription, якщо він доступний, якщо ні - поверніть властивості за замовчуванням\n\n    Застаріло: Це тимчасова реалізація цієї функції, поки ми не матимемо часу реалізувати її в спосіб, описаний тут: https://github.com/microsoft/vscode/issues/102181","type":"string"},"cwd":{"default":"${workspaceFolder}","description":"Абсолютний шлях до робочого каталогу програми, що налагоджується. Якщо ви встановили localRoot, тоді cwd відповідатиме цьому значенню, інакше він повернеться до вашого workspaceFolder.","docDefault":"localRoot || ${workspaceFolder}","tags":["setup"],"type":"string"},"enableContentValidation":{"default":true,"description":"Перемикає, чи перевіряємо ми, що вміст файлів на диску відповідає завантаженим у час виконання. Це корисно в різних сценаріях і є обов'язковим у деяких, але може викликати проблеми, якщо у вас є серверна трансформація скриптів, наприклад.","type":"boolean"},"enableDWARF":{"default":true,"markdownDescription":"Перемикає, чи буде відладчик намагатися зчитувати символи налагодження DWARF з WebAssembly, що може вимагати багато ресурсів. Для роботи потрібен розширення `ms-vscode.wasm-dwarf-debugging`.","type":"boolean"},"env":{"additionalProperties":{"type":["string","null"]},"default":{},"markdownDescription":"Змінні середовища, передані програмі. Значення `null` видаляє змінну з середовища.","tags":["setup"],"type":"object"},"envFile":{"default":"${workspaceFolder}/.env","description":"Абсолютний шлях до файлу, що містить визначення змінних середовища.","type":"string"},"localRoot":{"default":null,"description":"Шлях до локального каталогу, що містить програму.","type":["string","null"]},"nodeVersionHint":{"default":12,"description":"Дозволяє вам явно вказати версію Node, яка працює, що може бути використано для вимкнення або ввімкнення певних поведінок у випадках, коли автоматичне визначення версії не працює.","minimum":8,"type":"number"},"outFiles":{"default":["${workspaceFolder}/**/*.(m|c|)js","!**/node_modules/**"],"description":"Якщо карти джерел увімкнені, ці шаблони glob вказують на згенеровані файли JavaScript. Якщо шаблон починається з `!`, файли виключаються. Якщо не вказано, згенерований код очікується в тому ж каталозі, що й його джерело.","items":{"type":"string"},"tags":["setup"],"type":["array"]},"outputCapture":{"default":"console","enum":["console","std"],"markdownDescription":"Звідки захоплювати вихідні повідомлення: за замовчуванням API налагодження, якщо встановлено `console`, або потоки stdout/stderr, якщо встановлено `std`."},"pauseForSourceMap":{"default":false,"markdownDescription":"Чи чекати на завантаження карт джерел для кожного вхідного скрипта. Це має накладні витрати на продуктивність і може бути безпечно вимкнено при виконанні з диска, якщо `rootPath` не вимкнено.","type":"boolean"},"remoteRoot":{"default":null,"description":"Абсолютний шлях до віддаленого каталогу, що містить програму.","type":["string","null"]},"resolveSourceMapLocations":{"default":["${workspaceFolder}/**","!**/node_modules/**"],"description":"Список патернів minimatch для місць (папок та URL), в яких карти джерел можуть бути використані для вирішення локальних файлів. Це можна використовувати, щоб уникнути неправильного розриву в зовнішньому коді з картами джерел. Патерни можуть бути префіксовані знаком \"!\", щоб виключити їх. Може бути встановлено на порожній масив або null, щоб уникнути обмежень.","items":{"type":"string"},"type":["array","null"]},"runtimeSourcemapPausePatterns":{"default":[],"items":{"type":"string"},"markdownDescription":"Список шаблонів, за якими можна вручну вставити точки зупинки вхідної точки. Це може бути корисно, щоб надати відладчику можливість встановити точки зупинки при використанні sourcemaps, які не існують або не можуть бути виявлені до запуску, наприклад, [з фреймворком Serverless](https://github.com/microsoft/vscode-js-debug/issues/492).","type":"array"},"showAsyncStacks":{"default":true,"description":"Показати асинхронні виклики, які призвели до поточного стеку викликів.","oneOf":[{"type":"boolean"},{"properties":{"onAttach":{"default":32,"type":"number"}},"required":["onAttach"],"type":"object"},{"properties":{"onceBreakpointResolved":{"default":32,"type":"number"}},"required":["onceBreakpointResolved"],"type":"object"}]},"skipFiles":{"default":["${/**"],"description":"Масив імен файлів або папок, або шаблонів шляхів, які слід пропустити під час налагодження. Дозволені зіркові шаблони та заперечення, наприклад, `[\"**/node_modules/**\", \"!**/node_modules/my-module/**\"]`","type":"array"},"smartStep":{"default":true,"description":"Автоматично проходьте через згенерований код, який не може бути відображений назад до оригінального джерела.","type":"boolean"},"sourceMapPathOverrides":{"default":{"meteor://💻app/*":"${workspaceFolder}/*","webpack:///./~/*":"${workspaceFolder}/node_modules/*","webpack://?:*/*":"${workspaceFolder}/*"},"description":"Набір відображень для переписування місць розташування вихідних файлів з того, що вказує sourcemap, на їхні місця на диску.","type":"object"},"sourceMapRenames":{"default":true,"description":"Чи використовувати