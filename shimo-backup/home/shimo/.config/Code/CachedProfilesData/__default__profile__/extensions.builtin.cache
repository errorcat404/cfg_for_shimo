"text/x-kotlin","text/x-less","text/x-lexon","text/x-lua","text/x-m3","text/x-markdown","text/x-mips","text/x-msdax","text/x-mysql","text/x-objective-c/objective","text/x-pascal","text/x-pascaligo","text/x-perl","text/x-pgsql","text/x-php","text/x-postiats","text/x-powerquery","text/x-powershell","text/x-pug","text/x-python","text/x-r","text/x-razor","text/x-redis","text/x-redshift","text/x-restructuredtext","text/x-ruby","text/x-rust","text/x-sb","text/x-scala","text/x-scheme","text/x-scss","text/x-shell","text/x-solidity","text/x-sophia","text/x-sql","text/x-st","text/x-swift","text/x-systemverilog","text/x-tcl","text/x-twig","text/x-typescript","text/x-vb","text/x-xml","text/x-yaml","application/json"]}],"commands":[{"command":"_markdown.copyImage","title":{"value":"Копіювати зображення","original":"Copy Image"},"category":"Markdown"},{"command":"_markdown.openImage","title":{"value":"Відкрити зображення","original":"Open Image"},"category":"Markdown"},{"command":"markdown.showPreview","title":{"value":"Відкрити попередній перегляд","original":"Open Preview"},"category":"Markdown","icon":{"light":"./media/preview-light.svg","dark":"./media/preview-dark.svg"}},{"command":"markdown.showPreviewToSide","title":{"value":"Відкрити попередній перегляд збоку","original":"Open Preview to the Side"},"category":"Markdown","icon":"$(open-preview)"},{"command":"markdown.showLockedPreviewToSide","title":{"value":"Відкрити заблокований попередній перегляд збоку","original":"Open Locked Preview to the Side"},"category":"Markdown","icon":"$(open-preview)"},{"command":"markdown.showSource","title":{"value":"Показати джерело","original":"Show Source"},"category":"Markdown","icon":"$(go-to-file)"},{"command":"markdown.showPreviewSecuritySelector","title":{"value":"Змінити налаштування безпеки попереднього перегляду","original":"Change Preview Security Settings"},"category":"Markdown"},{"command":"markdown.preview.refresh","title":{"value":"Оновити попередній перегляд","original":"Refresh Preview"},"category":"Markdown"},{"command":"markdown.preview.toggleLock","title":{"value":"Перемикання блокування попереднього перегляду","original":"Toggle Preview Locking"},"category":"Markdown"},{"command":"markdown.findAllFileReferences","title":{"value":"Знайти посилання на файли","original":"Find File References"},"category":"Markdown"},{"command":"markdown.editor.insertLinkFromWorkspace","title":{"value":"Вставити посилання на файл у робочій області","original":"Insert Link to File in Workspace"},"category":"Markdown","enablement":"editorLangId =~ /^(markdown|prompt|instructions|chatagent|skill)$/ && !activeEditorIsReadonly"},{"command":"markdown.editor.insertImageFromWorkspace","title":{"value":"Вставити зображення з робочої області","original":"Insert Image from Workspace"},"category":"Markdown","enablement":"editorLangId =~ /^(markdown|prompt|instructions|chatagent|skill)$/ && !activeEditorIsReadonly"}],"menus":{"webview/context":[{"command":"_markdown.copyImage","when":"webviewId == 'markdown.preview' && (webviewSection == 'image' || webviewSection == 'localImage')"},{"command":"_markdown.openImage","when":"webviewId == 'markdown.preview' && webviewSection == 'localImage'"}],"editor/title":[{"command":"markdown.showPreviewToSide","when":"editorLangId =~ /^(markdown|prompt|instructions|chatagent|skill)$/ && !notebookEditorFocused && !hasCustomMarkdownPreview","alt":"markdown.showPreview","group":"navigation"},{"command":"markdown.showSource","when":"activeWebviewPanelId == 'markdown.preview' || activeCustomEditorId == 'vscode.markdown.preview.editor'","group":"navigation"},{"command":"markdown.preview.refresh","when":"activeWebviewPanelId == 'markdown.preview' || activeCustomEditorId == 'vscode.markdown.preview.editor'","group":"1_markdown"},{"command":"markdown.preview.toggleLock","when":"activeWebviewPanelId == 'markdown.preview' || activeCustomEditorId == 'vscode.markdown.preview.editor'","group":"1_markdown"},{"command":"markdown.showPreviewSecuritySelector","when":"activeWebviewPanelId == 'markdown.preview' || activeCustomEditorId == 'vscode.markdown.preview.editor'","group":"1_markdown"}],"modalEditor/editorTitle":[{"command":"markdown.showPreviewToSide","when":"editorLangId =~ /^(markdown|prompt|instructions|chatagent|skill)$/ && !notebookEditorFocused && !hasCustomMarkdownPreview","alt":"markdown.showPreview","group":"navigation"}],"explorer/context":[{"command":"markdown.showPreview","when":"resourceLangId =~ /^(markdown|prompt|instructions|chatagent|skill)$/ && !hasCustomMarkdownPreview","group":"navigation"},{"command":"markdown.findAllFileReferences","when":"resourceLangId =~ /^(markdown|prompt|instructions|chatagent|skill)$/","group":"4_search"}],"editor/title/context":[{"command":"markdown.showPreview","when":"resourceLangId =~ /^(markdown|prompt|instructions|chatagent|skill)$/ && !hasCustomMarkdownPreview","group":"1_open"},{"command":"markdown.findAllFileReferences","when":"resourceLangId =~ /^(markdown|prompt|instructions|chatagent|skill)$/"}],"commandPalette":[{"command":"_markdown.openImage","when":"false"},{"command":"_markdown.copyImage","when":"false"},{"command":"markdown.showPreview","when":"editorLangId =~ /^(markdown|prompt|instructions|chatagent|skill)$/ && !notebookEditorFocused","group":"navigation"},{"command":"markdown.showPreviewToSide","when":"editorLangId =~ /^(markdown|prompt|instructions|chatagent|skill)$/ && !notebookEditorFocused","group":"navigation"},{"command":"markdown.showLockedPreviewToSide","when":"editorLangId =~ /^(markdown|prompt|instructions|chatagent|skill)$/ && !notebookEditorFocused","group":"navigation"},{"command":"markdown.showSource","when":"activeWebviewPanelId == 'markdown.preview' || activeCustomEditorId == 'vscode.markdown.preview.editor'","group":"navigation"},{"command":"markdown.showPreviewSecuritySelector","when":"editorLangId =~ /^(markdown|prompt|instructions|chatagent|skill)$/ && !notebookEditorFocused"},{"command":"markdown.showPreviewSecuritySelector","when":"activeWebviewPanelId == 'markdown.preview' || activeCustomEditorId == 'vscode.markdown.preview.editor'"},{"command":"markdown.preview.toggleLock","when":"activeWebviewPanelId == 'markdown.preview' || activeCustomEditorId == 'vscode.markdown.preview.editor'"},{"command":"markdown.preview.refresh","when":"editorLangId =~ /^(markdown|prompt|instructions|chatagent|skill)$/ && !notebookEditorFocused"},{"command":"markdown.preview.refresh","when":"activeWebviewPanelId == 'markdown.preview' || activeCustomEditorId == 'vscode.markdown.preview.editor'"},{"command":"markdown.findAllFileReferences","when":"editorLangId =~ /^(markdown|prompt|instructions|chatagent|skill)$/"}]},"keybindings":[{"command":"markdown.showPreview","key":"shift+ctrl+v","mac":"shift+cmd+v","when":"editorLangId =~ /^(markdown|prompt|instructions|chatagent|skill)$/ && !notebookEditorFocused"},{"command":"markdown.showPreviewToSide","key":"ctrl+k v","mac":"cmd+k v","when":"editorLangId =~ /^(markdown|prompt|instructions|chatagent|skill)$/ && !notebookEditorFocused"}],"configuration":{"type":"object","title":"Markdown","order":20,"properties":{"markdown.styles":{"type":"array","items":{"type":"string"},"default":[],"description":"Список URL-адрес або локальних шляхів до CSS стилів, які використовуються з попереднім переглядом Markdown. Відносні шляхи інтерпретуються відносно папки, відкритої в Провіднику. Якщо немає відкритої папки, вони інтерпретуються відносно місця розташування файлу Markdown. Усі '\\' потрібно писати як '\\\\'.","scope":"resource"},"markdown.preview.breaks":{"type":"boolean","default":false,"markdownDescription":"Встановлює, як перенос рядків відображається в попередньому перегляді Markdown. Встановлення значення `true` створює `<br>` для нових рядків всередині абзаців.","scope":"resource"},"markdown.preview.linkify":{"type":"boolean","default":true,"description":"Перетворіть текст, схожий на URL, на посилання у попередньому перегляді Markdown.","scope":"resource"},"markdown.preview.typographer":{"type":"boolean","default":false,"description":"Увімкніть деяке нейтральне до мови заміщення та покращення цитат у попередньому перегляді Markdown.","scope":"resource"},"markdown.preview.fontFamily":{"type":"string","default":"-apple-system, BlinkMacSystemFont, 'Segoe WPC', 'Segoe UI', system-ui, 'Ubuntu', 'Droid Sans', sans-serif","description":"Керує сім'єю шрифтів, що використовується в попередньому перегляді Markdown.","scope":"resource"},"markdown.preview.fontSize":{"type":"number","default":14,"description":"Контролює розмір шрифту в пікселях, що використовується в попередньому перегляді Markdown.","scope":"resource"},"markdown.preview.lineHeight":{"type":"number","default":1.6,"description":"Контролює висоту рядка, що використовується в попередньому перегляді Markdown. Це число є відносним до розміру шрифту.","scope":"resource"},"markdown.preview.scrollPreviewWithEditor":{"type":"boolean","default":true,"description":"Коли редактор Markdown прокручується, оновіть перегляд попереднього вигляду.","scope":"resource"},"markdown.preview.markEditorSelection":{"type":"boolean","default":true,"description":"Позначте вибір поточного редактора в попередньому перегляді Markdown.","scope":"resource"},"markdown.preview.scrollEditorWithPreview":{"type":"boolean","default":true,"description":"Коли попередній перегляд Markdown прокручується, оновіть вигляд редактора.","scope":"resource"},"markdown.preview.doubleClickToSwitchToEditor":{"type":"boolean","default":true,"description":"Двічі клацніть у попередньому перегляді Markdown, щоб перейти до редактора.","scope":"resource"},"markdown.preview.openMarkdownLinks":{"type":"string","default":"inPreview","description":"Контролює, як посилання на інші файли Markdown у попередньому перегляді Markdown повинні відкриватися.","scope":"resource","enum":["inPreview","inEditor"],"enumDescriptions":["Спробуйте відкрити посилання в попередньому перегляді Markdown.","Спробуйте відкрити посилання в редакторі."]},"markdown.links.openLocation":{"type":"string","default":"currentGroup","description":"Контролює, де повинні відкриватися посилання в файлах Markdown.","scope":"resource","enum":["currentGroup","beside"],"enumDescriptions":["Відкривати посилання в активній групі редакторів.","Відкрийте посилання поруч з активним редактором."]},"markdown.suggest.paths.enabled":{"type":"boolean","default":true,"description":"Увімкніть пропозиції шляхів під час написання посилань у файлах Markdown.","scope":"resource"},"markdown.suggest.paths.includeWorkspaceHeaderCompletions":{"type":"string","default":"onDoubleHash","scope":"resource","markdownDescription":"Увімкніть пропозиції для заголовків в інших Markdown файлах у поточному робочому просторі. Прийняття однієї з цих пропозицій вставляє повний шлях до заголовка в цьому файлі, наприклад: `[link text](/path/to/file.md#header)`.","enum":["never","onDoubleHash","onSingleOrDoubleHash"],"markdownEnumDescriptions":["Вимкнути підказки заголовка робочого простору.","Увімкніть пропозиції заголовка робочого простору після введення `##` у шляху, наприклад: `[link text](##`.","Увімкніть пропозиції заголовків робочого простору після введення `##` або `#` у шляху, наприклад: `[link text](#` або `[link text](##`."]},"markdown.trace.server":{"type":"string","scope":"window","enum":["off","messages","verbose"],"default":"off","description":"Відстежує комунікацію між VS Code та сервером мови Markdown."},"markdown.server.log":{"type":"string","scope":"window","enum":["off","debug","trace"],"default":"off","description":"Контролює рівень журналювання серверу мови Markdown."},"markdown.editor.drop.enabled":{"type":"string","scope":"resource","markdownDescription":"Увімкніть перетягування файлів у редактор Markdown, утримуючи Shift. Потрібно увімкнути `#editor.dropIntoEditor.enabled#`.","default":"smart","enum":["always","smart","never"],"markdownEnumDescriptions":["Завжди вставляйте посилання Markdown.","Розумно створюйте посилання Markdown за замовчуванням, коли не вставляєте в блок коду або інший спеціальний елемент. Використовуйте віджет для перемикання між вставкою як простий текст або як посилання Markdown.","Ніколи не створюйте посилання Markdown."]},"markdown.editor.drop.copyIntoWorkspace":{"type":"string","markdownDescription":"Контролює, чи файли поза робочою областю, які перетягуються в редактор Markdown, повинні бути скопійовані в робочу область.\n\nВикористовуйте `#markdown.copyFiles.destination#`, щоб налаштувати, де повинні бути створені скопійовані файли.","default":"mediaFiles","enum":["mediaFiles","never"],"markdownEnumDescriptions":["Спробуйте скопіювати зовнішні файли зображень і відео в робочу область.","Не копіюйте зовнішні файли в робочий простір."]},"markdown.editor.filePaste.enabled":{"type":"string","scope":"resource","markdownDescription":"Увімкніть вставку файлів у редактор Markdown для створення посилань Markdown. Потрібно увімкнути `#editor.pasteAs.enabled#`.","default":"smart","enum":["always","smart","never"],"markdownEnumDescriptions":["Завжди вставляйте посилання Markdown.","Розумно створюйте посилання Markdown за замовчуванням, коли не вставляєте в кодовий блок або інший спеціальний елемент. Використовуйте віджет вставки, щоб перемикатися між вставкою як простий текст або як посилання Markdown.","Ніколи не створюйте посилання Markdown."]},"markdown.editor.filePaste.copyIntoWorkspace":{"type":"string","markdownDescription":"Контролює, чи файли поза робочою областю, які вставляються в редактор Markdown, повинні бути скопійовані в робочу область.\n\nВикористовуйте `#markdown.copyFiles.destination#`, щоб налаштувати, де повинні бути створені скопійовані файли.","default":"mediaFiles","enum":["mediaFiles","never"],"markdownEnumDescriptions":["Спробуйте скопіювати зовнішні файли зображень і відео в робочу область.","Не копіюйте зовнішні файли в робочий простір."]},"markdown.editor.filePaste.videoSnippet":{"type":"string","markdownDescription":"Фрагмент, що використовується при додаванні відео до Markdown. Цей фрагмент може використовувати такі змінні:\n- `${src}` — Вирішений шлях до відеофайлу.\n- `${title}` — Назва, що використовується для відео. Для цієї змінної автоматично буде створено плейсхолдер фрагмента.","default":"<video controls src=\"${src}\" title=\"${title}\"></video>"},"markdown.editor.filePaste.audioSnippet":{"type":"string","markdownDescription":"Фрагмент, що використовується при додаванні аудіо до Markdown. Цей фрагмент може використовувати такі змінні:\n- `${src}` — Вирішений шлях до аудіофайлу.\n- `${title}` — Заголовок, що використовується для аудіо. Для цієї змінної автоматично буде створено плейсхолдер фрагмента.","default":"<audio controls src=\"${src}\" title=\"${title}\"></audio>"},"markdown.editor.pasteUrlAsFormattedLink.enabled":{"type":"string","scope":"resource","markdownDescription":"Контролює, чи створюються посилання Markdown, коли URL-адреси вставляються в редактор Markdown. Потребує увімкнення `#editor.pasteAs.enabled#`.","default":"smartWithSelection","enum":["always","smart","smartWithSelection","never"],"markdownEnumDescriptions":["Завжди вставляйте посилання Markdown.","Розумно створюйте посилання Markdown за замовчуванням, коли не вставляєте в блок коду або інший спеціальний елемент. Використовуйте віджет вставки, щоб перемикатися між вставкою як простого тексту або як посилань Markdown.","Розумно створюйте посилання Markdown за замовчуванням, коли ви виділили текст і не вставляєте його в кодовий блок або інший спеціальний елемент. Використовуйте віджет вставки, щоб перемикатися між вставкою як простого тексту або як посилань Markdown.","Ніколи не створюйте посилання Markdown."]},"markdown.validate.enabled":{"type":"boolean","scope":"resource","description":"Увімкніть усю звітність про помилки у файлах Markdown.","default":false},"markdown.validate.referenceLinks.enabled":{"type":"string","scope":"resource","markdownDescription":"Перевірте посилання на довідки у файлах Markdown, наприклад: `[link][ref]`. Потрібно увімкнути `#markdown.validate.enabled#`.","default":"warning","enum":["ignore","warning","error"]},"markdown.validate.fragmentLinks.enabled":{"type":"string","scope":"resource","markdownDescription":"Перевірте фрагменти посилань на заголовки в поточному Markdown файлі, наприклад: `[link](#header)`. Потрібно увімкнути `#markdown.validate.enabled#`.","default":"warning","enum":["ignore","warning","error"]},"markdown.validate.fileLinks.enabled":{"type":"string","scope":"resource","markdownDescription":"Перевірте посилання на інші файли в Markdown-файлах, наприклад `[link](/path/to/file.md)`. Це перевіряє, що цільові файли існують. Потрібно увімкнути `#markdown.validate.enabled#`.","default":"warning","enum":["ignore","warning","error"]},"markdown.validate.fileLinks.markdownFragmentLinks":{"type":"string","scope":"resource","markdownDescription":"Перевірте фрагментну частину посилань на заголовки в інших файлах у Markdown файлах, наприклад: `[link](/path/to/file.md#header)`. За замовчуванням успадковує значення налаштування з `#markdown.validate.fragmentLinks.enabled#`.","default":"inherit","enum":["inherit","ignore","warning","error"]},"markdown.validate.ignoredLinks":{"type":"array","scope":"resource","markdownDescription":"Налаштуйте посилання, які не повинні перевірятися. Наприклад, додавання `/about` не перевірить посилання `[about](/about)`, тоді як шаблон `/assets/**/*.svg` дозволить вам пропустити перевірку для будь-якого посилання на файли `.svg` у каталозі `assets`.","items":{"type":"string"}},"markdown.validate.unusedLinkDefinitions.enabled":{"type":"string","scope":"resource","markdownDescription":"Перевірте визначення посилань, які не використовуються в поточному файлі.","default":"hint","enum":["ignore","hint","warning","error"]},"markdown.validate.duplicateLinkDefinitions.enabled":{"type":"string","scope":"resource","markdownDescription":"Перевірте наявність дублікатів визначень у поточному файлі.","default":"warning","enum":["ignore","warning","error"]},"markdown.updateLinksOnFileMove.enabled":{"type":"string","enum":["prompt","always","never"],"markdownEnumDescriptions":["Запит на кожен переміщення файлу.","Завжди автоматично оновлювати посилання.","Ніколи не намагайтеся оновити посилання і не запитуйте."],"default":"never","markdownDescription":"Спробуйте оновити посилання в Markdown файлах, коли файл перейменовано/переміщено в робочій області. Використовуйте `#markdown.updateLinksOnFileMove.include#`, щоб налаштувати, які файли викликають оновлення посилань.","scope":"window"},"markdown.updateLinksOnFileMove.include":{"type":"array","markdownDescription":"Глобальні шаблони, які вказують файли, що викликають автоматичні оновлення посилань. Дивіться `#markdown.updateLinksOnFileMove.enabled#` для отримання деталей про цю функцію.","scope":"window","items":{"type":"string","description":"Шаблон glob для порівняння з шляхами до файлів. Встановіть в true, щоб увімкнути шаблон."},"default":["**/*.{md,mkd,mdwn,mdown,markdown,markdn,mdtxt,mdtext,workbook}","**/*.{jpg,jpe,jpeg,png,bmp,gif,ico,webp,avif,tiff,svg,mp4}"]},"markdown.updateLinksOnFileMove.enableForDirectories":{"type":"boolean","default":true,"description":"Увімкнути оновлення посилань, коли каталог переміщується або перейменовується в робочій області.","scope":"window"},"markdown.occurrencesHighlight.enabled":{"type":"boolean","default":false,"description":"Увімкнути підсвічування посилань у поточному документі.","scope":"resource"},"markdown.copyFiles.destination":{"type":"object","markdownDescription":"Налаштовує шлях та ім'я файлу для файлів, створених шляхом копіювання/вставки або перетягування. Це карта глобусів, які відповідають шляху до документа Markdown, до шляху призначення, де має бути створено новий файл.\n\nШлях призначення може використовувати такі змінні:\n\n- `${documentDirName}` — Абсолютний шлях до батьківської директорії документа Markdown, наприклад, `/Users/me/myProject/docs`.\n- `${documentRelativeDirName}` — Відносний шлях до батьківської директорії документа Markdown, наприклад, `docs`. Це те саме, що і `${documentDirName}`, якщо файл не є частиною робочого простору.\n- `${documentFileName}` — Повне ім'я файлу документа Markdown, наприклад, `README.md`.\n- `${documentBaseName}` — Базове ім'я документа Markdown, наприклад, `README`.\n- `${documentExtName}` — Розширення документа Markdown, наприклад, `md`.\n- `${documentFilePath}` — Абсолютний шлях до документа Markdown, наприклад, `/Users/me/myProject/docs/README.md`.\n- `${documentRelativeFilePath}` — Відносний шлях до документа Markdown, наприклад, `docs/README.md`. Це те саме, що і `${documentFilePath}`, якщо файл не є частиною робочого простору.\n- `${documentWorkspaceFolder}` — Папка робочого простору для документа Markdown, наприклад, `/Users/me/myProject`. Це те саме, що і `${documentDirName}`, якщо файл не є частиною робочого простору.\n- `${fileName}` — Ім'я файлу перетягнутого файлу, наприклад, `image.png`.\n- `${fileExtName}` — Розширення перетягнутого файлу, наприклад, `png`.\n- `${unixTime}` — Поточна Unix мітка часу в мілісекундах.\n- `${isoTime}` — Поточний час у форматі ISO 8601, наприклад, '2025-06-06T08:40:32.123Z'.","additionalProperties":{"type":"string"}},"markdown.copyFiles.overwriteBehavior":{"type":"string","markdownDescription":"Контролює, чи файли, створені шляхом перетягування або вставки, повинні перезаписувати існуючі файли.","default":"nameIncrementally","enum":["nameIncrementally","overwrite"],"markdownEnumDescriptions":["Якщо файл з такою ж назвою вже існує, додайте число до назви файлу, наприклад: `image.png` стає `image-1.png`.","Якщо файл з такою ж назвою вже існує, перезаписати його."]},"markdown.preferredMdPathExtensionStyle":{"type":"string","default":"auto","markdownDescription":"Контролює, чи додаються розширення файлів (наприклад, `.md`) для посилань на Markdown-файли. Цей параметр використовується, коли шляхи до файлів додаються за допомогою інструментів, таких як автозавершення шляхів або перейменування файлів.","enum":["auto","includeExtension","removeExtension"],"markdownEnumDescriptions":["Для існуючих шляхів намагайтеся зберігати стиль розширення файлів. Для нових шляхів додайте розширення файлів.","Надавайте перевагу включенню розширення файлу. Наприклад, автозавершення шляху до файлу з назвою `file.md` вставить `file.md`.","Виберіть видалення розширення файлу. Наприклад, завершення шляху до файлу з назвою `file.md` вставить `file` без `.md`."]},"markdown.editor.updateLinksOnPaste.enabled":{"type":"boolean","markdownDescription":"Увімкніть/вимкніть опцію вставки, яка оновлює посилання та посилання в тексті, що копіюється та вставляється між редакторами Markdown.\n\nЩоб скористатися цією функцією, після вставки тексту, що містить оновлювальні посилання, просто натисніть на віджет вставки та виберіть `Вставити та оновити вставлені посилання`.","scope":"resource","default":true}}},"configurationDefaults":{"[markdown]":{"editor.wordWrap":"on","editor.quickSuggestions":{"comments":"off","strings":"off","other":"off"}}},"jsonValidation":[{"fileMatch":"package.json","url":"./schemas/package.schema.json"}],"markdown.previewStyles":["./media/markdown.css","./media/highlight.css"],"markdown.previewScripts":["./media/index.js"],"customEditors":[{"viewType":"vscode.markdown.preview.editor","displayName":"Markdown Preview","priority":"option","selector":[{"filenamePattern":"*.md"}]}]},"repository":{"type":"git","url":"https://github.com/microsoft/vscode.git"}},"location":{"$mid":1,"path":"/usr/share/code/resources/app/extensions/markdown-language-features","scheme":"file"},"isBuiltin":true,"targetPlatform":"undefined","isValid":true,"validations":[],"preRelease":false,"forceAutoUpdate":false},{"type":0,"identifier":{"id":"vscode.markdown-math"},"manifest":{"name":"markdown-math","displayName":"Markdown Math","description":"Додає підтримку математики до Markdown у нотатках.","version":"10.0.0","icon":"icon.png","publisher":"vscode","license":"MIT","aiKey":"0c6ae279ed8443289764825290e4f9e2-1a736e7c-1324-4338-be46-fc2a58ae4d14-7255","engines":{"vscode":"^1.54.0"},"categories":["Other","Programming Languages"],"capabilities":{"virtualWorkspaces":true,"untrustedWorkspaces":{"supported":true}},"main":"./dist/extension","browser":"./dist/browser/extension","activationEvents":[],"contributes":{"languages":[{"id":"markdown-math","aliases":[]}],"grammars":[{"language":"markdown-math","scopeName":"text.html.markdown.math","path":"./syntaxes/md-math.tmLanguage.json"},{"scopeName":"markdown.math.block","path":"./syntaxes/md-math-block.tmLanguage.json","injectTo":["text.html.markdown"],"embeddedLanguages":{"meta.embedded.math.markdown":"latex"}},{"scopeName":"markdown.math.inline","path":"./syntaxes/md-math-inline.tmLanguage.json","injectTo":["text.html.markdown"],"embeddedLanguages":{"meta.embedded.math.markdown":"latex","punctuation.definition.math.end.markdown":"latex"}},{"scopeName":"markdown.math.codeblock","path":"./syntaxes/md-math-fence.tmLanguage.json","injectTo":["text.html.markdown"],"embeddedLanguages":{"meta.embedded.math.markdown":"latex"}}],"notebookRenderer":[{"id":"vscode.markdown-it-katex-extension","displayName":"Markdown it KaTeX renderer","entrypoint":{"extends":"vscode.markdown-it-renderer","path":"./notebook-out/katex.js"}}],"markdown.markdownItPlugins":true,"markdown.previewStyles":["./notebook-out/katex.min.css","./preview-styles/index.css"],"configuration":[{"title":"Markdown Math","properties":{"markdown.math.enabled":{"type":"boolean","default":true,"description":"Увімкнути/вимкнути відображення математики у вбудованому попередньому перегляді Markdown."},"markdown.math.macros":{"type":"object","additionalProperties":{"type":"string"},"default":{},"description":"Збірка користувацьких макросів. Кожен макрос є парою ключ-значення, де ключ - це нова назва команди, а значення - розширення макросу.","scope":"resource"}}}]},"repository":{"type":"git","url":"https://github.com/microsoft/vscode.git"}},"location":{"$mid":1