hView","group":"5_preview@1"}],"git.repositories.stash":[{"command":"git.stash","group":"1_stash@1"},{"command":"git.stashStaged","when":"gitVersion2.35","group":"2_stash@1"},{"command":"git.stashIncludeUntracked","group":"2_stash@2"}],"git.tags":[{"command":"git.createTag","group":"1_tags@1"},{"command":"git.deleteTag","group":"1_tags@2"},{"command":"git.deleteRemoteTag","group":"1_tags@3"},{"command":"git.pushTags","group":"2_tags@1"}],"git.worktrees":[{"when":"scmProviderContext == worktree","command":"git.openWorktree","group":"openWorktrees@1"},{"when":"scmProviderContext == worktree","command":"git.openWorktreeInNewWindow","group":"openWorktrees@2"},{"when":"scmProviderContext == repository","command":"git.createWorktree","group":"worktrees@1"},{"when":"scmProviderContext == worktree","command":"git.deleteWorktree2","group":"worktrees@2"}]},"submenus":[{"id":"git.commit","label":"Зобов'язатися"},{"id":"git.changes","label":"Зміни"},{"id":"git.pullpush","label":"Тягнути, Штовхати"},{"id":"git.branch","label":"Гілка"},{"id":"git.remotes","label":"Віддалений"},{"id":"git.stash","label":"Сховати зміни"},{"id":"git.tags","label":"Теги"},{"id":"git.worktrees","label":"Робочі дерева"},{"id":"git.repositories.stash","label":"Сховати зміни","icon":"$(plus)"}],"configuration":{"title":"Git","properties":{"git.enabled":{"type":"boolean","scope":"resource","description":"Чи ввімкнено Git.","default":true},"git.path":{"type":["string","null","array"],"markdownDescription":"Шлях і ім'я файлу виконуваного файлу git, наприклад, `C:\\Program Files\\Git\\bin\\git.exe` (Windows). Це також може бути масив значень рядків, що містять кілька шляхів для пошуку.","default":null,"scope":"machine"},"git.autoRepositoryDetection":{"type":["boolean","string"],"enum":[true,false,"subFolders","openEditors"],"enumDescriptions":["Сканувати як підпапки поточної відкритої папки, так і батьківські папки відкритих файлів.","Вимкнути автоматичне сканування репозиторіїв.","Сканувати підпапки відкритого в даний момент папки.","Сканувати батьківські папки відкритих файлів."],"description":"Налаштовує, коли репозиторії повинні бути автоматично виявлені.","default":true},"git.autorefresh":{"type":"boolean","description":"Чи увімкнено автоматичне оновлення.","default":true},"git.autofetch":{"type":["boolean","string"],"enum":[true,false,"all"],"scope":"resource","markdownDescription":"Коли встановлено на true, коміти автоматично будуть завантажені з віддаленого репозиторію за замовчуванням поточного Git-репозиторію. Встановлення на `all` завантажить з усіх віддалених репозиторіїв.","default":false,"tags":["usesOnlineServices"]},"git.autofetchPeriod":{"type":"number","scope":"resource","markdownDescription":"Тривалість у секундах між кожним автоматичним git fetch, коли увімкнено `#git.autofetch#`.","default":180},"git.defaultBranchName":{"type":"string","markdownDescription":"Назва гілки за замовчуванням (наприклад: main, trunk, development) під час ініціалізації нового Git-репозиторію. Якщо залишити порожнім, буде використано назву гілки за замовчуванням, налаштовану в Git. **Примітка:** Потрібна версія Git `2.28.0` або новіша.","default":"main","scope":"resource"},"git.branchPrefix":{"type":"string","description":"Префікс, що використовується при створенні нової гілки.","default":"","scope":"resource"},"git.branchProtection":{"type":"array","markdownDescription":"Список захищених гілок. За замовчуванням перед комітом змін у захищену гілку відображається запит. Запит можна контролювати за допомогою налаштування `#git.branchProtectionPrompt#`.","items":{"type":"string"},"default":[],"scope":"resource"},"git.branchProtectionPrompt":{"type":"string","description":"Контролює, чи відображається запит перед тим, як зміни будуть зафіксовані в захищеній гілці.","enum":["alwaysCommit","alwaysCommitToNewBranch","alwaysPrompt"],"enumDescriptions":["Завжди фіксуйте зміни в захищеній гілці.","Завжди фіксуйте зміни в новій гілці.","Завжди запитувати перед внесенням змін до захищеної гілки."],"default":"alwaysPrompt","scope":"resource"},"git.branchValidationRegex":{"type":"string","description":"Регулярний вираз для валідації нових імен гілок.","default":""},"git.branchWhitespaceChar":{"type":"string","description":"Символ для заміни пробілів у нових назвах гілок та для розділення сегментів випадково згенерованої назви гілки.","default":"-"},"git.branchRandomName.enable":{"type":"boolean","description":"Контролює, чи генерується випадкове ім'я при створенні нової гілки.","default":false,"scope":"resource"},"git.branchRandomName.dictionary":{"type":"array","markdownDescription":"Список словників, що використовуються для випадково згенерованого імені гілки. Кожне значення представляє словник, що використовується для генерації сегмента імені гілки. Підтримувані словники: `adjectives`, `animals`, `colors` та `numbers`.","items":{"type":"string","enum":["adjectives","animals","colors","numbers"],"enumDescriptions":["Випадковий прикметник","Випадкове ім'я тварини","Випадкова назва кольору","Випадкове число між 100 і 999"]},"minItems":1,"maxItems":5,"default":["adjectives","animals"],"scope":"resource"},"git.confirmSync":{"type":"boolean","description":"Підтвердіть перед синхронізацією репозиторіїв Git.","default":true},"git.confirmCommittedDelete":{"type":"boolean","description":"Confirm before deleting committed files with Git.","default":true},"git.countBadge":{"type":"string","enum":["all","tracked","off"],"enumDescriptions":["Підрахуйте всі зміни.","Рахувати лише відстежені зміни.","Вимкнути лічильник."],"description":"Контролює значок лічильника Git.","default":"all","scope":"resource"},"git.checkoutType":{"type":"array","items":{"type":"string","enum":["local","tags","remote"],"enumDescriptions":["Місцеві відділення","Теги","Віддалені гілки"]},"uniqueItems":true,"markdownDescription":"Контролює, які типи Git refs відображаються під час виконання `Checkout to...`.","default":["local","remote","tags"]},"git.ignoreLegacyWarning":{"type":"boolean","description":"Ignoruє попередження про застарілий Git.","default":false},"git.ignoreMissingGitWarning":{"type":"boolean","description":"Ignoruє попередження, коли Git відсутній.","default":false},"git.ignoreWindowsGit27Warning":{"type":"boolean","description":"Ігнорує попередження, коли Git 2.25 - 2.26 встановлено на Windows.","default":false},"git.ignoreLimitWarning":{"type":"boolean","description":"Ignoruje попередження, коли в репозиторії занадто багато змін.","default":false},"git.ignoreRebaseWarning":{"type":"boolean","description":"Ignoruє попередження, коли виглядає так, ніби гілка могла бути перебазована під час витягування.","default":false},"git.defaultCloneDirectory":{"type":["string","null"],"default":null,"scope":"machine","description":"За замовчуванням місце для клонування репозиторію Git."},"git.useEditorAsCommitInput":{"type":"boolean","description":"Контролює, чи буде використовуватися повноцінний текстовий редактор для написання повідомлень про коміти, коли жодне повідомлення не надано в полі введення коміту.","default":true},"git.verboseCommit":{"type":"boolean","scope":"resource","markdownDescription":"Увімкніть детальний вивід, коли `#git.useEditorAsCommitInput#` увімкнено.","default":false},"git.enableSmartCommit":{"type":"boolean","scope":"resource","description":"Зафіксуйте всі зміни, коли немає підготовлених змін.","default":false},"git.smartCommitChanges":{"type":"string","enum":["all","tracked"],"enumDescriptions":["Автоматично підготувати всі зміни.","Автоматично підготувати лише відстежені зміни."],"scope":"resource","description":"Контролюйте, які зміни автоматично підготовлені Smart Commit.","default":"all"},"git.suggestSmartCommit":{"type":"boolean","scope":"resource","description":"Пропонує увімкнути розумний коміт (комітити всі зміни, коли немає підготовлених змін).","default":true},"git.enableCommitSigning":{"type":"boolean","scope":"resource","description":"Дозволяє підписування комітів за допомогою GPG, X.509 або SSH.","default":false},"git.confirmEmptyCommits":{"type":"boolean","scope":"resource","description":"Завжди підтверджуйте створення порожніх комітів для команди 'Git: Commit Empty'.","default":true},"git.decorations.enabled":{"type":"boolean","default":true,"description":"Контролює, чи Git додає кольори та значки до перегляду Провідника та Відкритих редакторів."},"git.enableStatusBarSync":{"type":"boolean","default":true,"description":"Контролює, чи з'являється команда Git Sync у рядку стану.","scope":"resource"},"git.followTagsWhenSync":{"type":"boolean","scope":"resource","default":false,"description":"Відправте всі анотовані теги під час виконання команди синхронізації."},"git.replaceTagsWhenPull":{"type":"boolean","scope":"resource","default":false,"description":"Автоматично замінюйте локальні теги на віддалені теги у разі конфлікту під час виконання команди pull."},"git.promptToSaveFilesBeforeStash":{"type":"string","enum":["always","staged","never"],"enumDescriptions":["Перевірте наявність незбережених файлів.","Перевіряти лише незбережені стадійовані файли.","Вимкнути цю перевірку."],"scope":"resource","default":"always","description":"Контролює, чи повинен Git перевіряти наявність незбережених файлів перед збереженням змін."},"git.promptToSaveFilesBeforeCommit":{"type":"string","enum":["always","staged","never"],"enumDescriptions":["Перевірте наявність незбережених файлів.","Перевірити лише незбережені підготовлені файли.","Вимкнути цю перевірку."],"scope":"resource","default":"always","description":"Контролює, чи повинен Git перевіряти наявність незбережених файлів перед комітом."},"git.postCommitCommand":{"type":"string","enum":["none","push","sync"],"enumDescriptions":["Не виконуйте жодної команди після коміту.","Запустіть 'git push' після успішного коміту.","Запустіть 'git pull' та 'git push' після успішного коміту."],"markdownDescription":"Виконайте команду git після успішного коміту.","scope":"resource","default":"none"},"git.rememberPostCommitCommand":{"type":"boolean","description":"Запам'ятайте останню команду git, яка виконувалася після коміту.","scope":"resource","default":false},"git.openAfterClone":{"type":"string","enum":["always","alwaysNewWindow","whenNoFolderOpen","prompt"],"enumDescriptions":["Завжди відкривати в поточному вікні.","Завжди відкривати в новому вікні.","Відкривати лише в поточному вікні, коли жодна папка не відкрита.","Завжди запитуйте про дію."],"default":"prompt","description":"Контролює, чи відкривати репозиторій автоматично після клонування."},"git.showInlineOpenFileAction":{"type":"boolean","default":true,"description":"Контролює, чи показувати вбудовану дію Відкрити файл у вигляді змін Git."},"git.showPushSuccessNotification":{"type":"boolean","description":"Контролює, чи показувати сповіщення, коли пуш успішний.","default":false},"git.inputValidation":{"type":"boolean","default":false,"description":"Контролює, чи показувати діагностику валідації введення повідомлення коміту."},"git.inputValidationLength":{"type":"number","default":72,"description":"Контролює поріг довжини повідомлення коміту для відображення попередження."},"git.inputValidationSubjectLength":{"type":["number","null"],"default":50,"markdownDescription":"Контролює поріг довжини заголовка повідомлення коміту для відображення попередження. Скиньте його, щоб успадкувати значення `#git.inputValidationLength#`."},"git.detectSubmodules":{"type":"boolean","scope":"resource","default":true,"description":"Контролює, чи автоматично виявляти підмодулі Git."},"git.detectSubmodulesLimit":{"type":"number","scope":"resource","default":10,"description":"Контролює межу виявлених підмодулів Git."},"git.detectWorktrees":{"type":"boolean","scope":"resource","default":false,"description":"Контролює, чи автоматично виявляти Git worktrees."},"git.detectWorktreesLimit":{"type":"number","scope":"resource","default":50,"description":"Контролює межу виявлених Git worktrees."},"git.worktreeIncludeFiles":{"type":"array","items":{"type":"string"},"default":[],"markdownDescription":"Configure [glob patterns](https://aka.ms/vscode-glob-patterns) for files and folders that are included when creating a new worktree. Only files and folders that match the patterns and are listed in `.gitignore` will be copied to the newly created worktree.","scope":"resource","tags":["experimental"]},"git.alwaysShowStagedChangesResourceGroup":{"type":"boolean","scope":"resource","default":false,"description":"Завжди показувати групу ресурсів Змін, що стають."},"git.alwaysSignOff":{"type":"boolean","scope":"resource","default":false,"description":"Контролює прапорець затвердження для всіх комітів."},"git.addAICoAuthor":{"type":"string","enum":["off","chatAndAgent","all"],"enumDescriptions":["Never add the AI co-author trailer.","Add the AI co-author trailer when code from chat or agent edits is included.","Add the AI co-author trailer when any AI-generated code is included, such as inline completions, chat, or agent edits."],"scope":"resource","default":"off","description":"Controls whether a 'Co-authored-by' trailer is automatically added to the commit message when AI-generated code is included in the commit."},"git.ignoreSubmodules":{"type":"boolean","scope":"resource","default":false,"description":"Ігнорувати зміни в підмодулях у дереві файлів."},"git.ignoredRepositories":{"type":"array","items":{"type":"string"},"default":[],"scope":"window","description":"Список репозиторіїв Git, які потрібно ігнорувати."},"git.scanRepositories":{"type":"array","items":{"type":"string"},"default":[],"scope":"resource","description":"Список шляхів для пошуку Git-репозиторіїв."},"git.showProgress":{"type":"boolean","description":"Контролює, чи повинні дії Git показувати прогрес.","default":true,"scope":"resource"},"git.rebaseWhenSync":{"type":"boolean","scope":"resource","default":false,"description":"Змусьте Git використовувати rebase під час виконання команди sync."},"git.pullBeforeCheckout":{"type":"boolean","scope":"resource","default":false,"description":"Контролює, чи гілка, яка не має вихідних комітів, буде швидко переміщена вперед перед її перевіркою."},"git.fetchOnPull":{"type":"boolean","scope":"resource","default":false,"description":"Коли увімкнено, отримуйте всі гілки під час витягування. В іншому випадку отримуйте лише поточну."},"git.pruneOnFetch":{"type":"boolean","scope":"resource","default":false,"description":"Обрізати під час отримання."},"git.pullTags":{"type":"boolean","scope":"resource","default":true,"description":"Отримати всі теги під час витягування."},"git.autoStash":{"type":"boolean","scope":"resource","default":false,"description":"Сховати всі зміни перед отриманням і відновити їх після успішного отримання."},"git.allowForcePush":{"type":"boolean","default":false,"description":"Контролює, чи увімкнено примусове злиття (з або без оренди)."},"git.useForcePushWithLease":{"type":"boolean","default":true,"description":"Контролює, чи використовує примусове відправлення безпечніший варіант force-with-lease."},"git.useForcePushIfIncludes":{"type":"boolean","default":true,"markdownDescription":"Контролює, чи використовує примусове злиття безпечніший варіант force-if-includes. Примітка: ця настройка вимагає, щоб настройка `#git.useForcePushWithLease#` була увімкнена, а версія Git була `2.30.0` або пізніше."},"git.confirmForcePush":{"type":"boolean","default":true,"description":"Контролює, чи запитувати підтвердження перед примусовим пушем."},"git.allowNoVerifyCommit":{"type":"boolean","default":false,"description":"Контролює, чи дозволені коміти без виконання хуків pre-commit та commit-msg."},"git.confirmNoVerifyCommit":{"type":"boolean","default":true,"description":"Контролює, чи запитувати підтвердження перед виконанням без перевірки."},"git.closeDiffOnOperation":{"type":"boolean","scope":"resource","default":false,"description":"Контролює, чи має диф-редактор автоматично закриватися, коли зміни зберігаються, комітяться, скасовуються, ставляться в чергу або не ставляться в чергу."},"git.openDiffOnClick":{"type":"boolean","scope":"resource","default":true,"description":"Контролює, чи має бути відкрито редактор змін при натисканні на зміни. В іншому випадку буде відкрито звичайний редактор."},"git.supportCancellation":{"type":"boolean","scope":"resource","default":false,"description":"Контролює, чи з'являється сповіщення під час виконання дії синхронізації, що дозволяє користувачу скасувати операцію."},"git.branchSortOrder":{"type":"string","enum":["committerdate","alphabetically"],"default":"committerdate","description":"Контролює порядок сортування для філій."},"git.untrackedChanges":{"type":"string","enum":["mixed","separate","hidden"],"enumDescriptions":["Усі зміни, відстежені та не відстежені, з'являються разом і поводяться однаково.","Невідстежувані зміни з'являються окремо в перегляді Контролю джерел. Вони також виключені з кількох дій.","Невідслідковані зміни приховані та виключені з кількох дій."],"default":"mixed","description":"Контролює, як поводяться непідраховані зміни.","scope":"resource"},"git.requireGitUserConfig":{"type":"boolean","description":"Контролює, чи потрібно вимагати явну конфігурацію користувача Git, чи дозволити Git здогадуватися, якщо вона відсутня.","default":true,"scope":"resource"},"git.showCommitInput":{"type":"boolean","scope":"resource","default":true,"description":"Контролює, чи показувати введення коміту в панелі контролю версій Git."},"git.terminalAuthentication":{"type":"boolean","default":true,"description":"Контролює, чи дозволити VS Code бути обробником аутентифікації для процесів Git, що запускаються в інтегрованому терміналі. Примітка: Термінали потрібно перезапустити, щоб застосувати зміни в цьому налаштуванні."},"git.terminalGitEditor":{"type":"boolean","default":false,"description":"Контролює, чи дозволити VS Code бути редактором Git для процесів Git, що запускаються в інтегрованому терміналі. Примітка: Термінали потрібно перезапустити, щоб застосувати зміни в цьому налаштуванні."},"git.useCommitInputAsStashMessage":{"type":"boolean","scope":"resource","default":false,"description":"Контролює, чи використовувати повідомлення з поля вводу коміту як повідомлення за замовчуванням для сховища."},"git.useIntegratedAskPass":{"type":"boolean","default":true,"description":"Контролює, чи слід переписувати GIT_ASKPASS для використання інтегрованої версії."},"git.githubAuthentication":{"markdownDeprecationMessage":"This setting is now deprecated, please use `#github.gitAuthentication#` instead."},"git.timeline.date":{"type":"string","enum":["committed","authored"],"enumDescriptions":["Використовуйте дату зобов'язання","Використовуйте дату авторства"],"default":"committed","description":"Контролює, яку дату використовувати для елементів у вигляді Хронології.","scope":"window"},"git.timeline.showAuthor":{"type":"boolean","default":true,"description":"Контролює, чи показувати автора коміту в режимі перегляду Хронології.","scope":"window"},"git.timeline.showUncommitted":{"type":"boolean","default":false,"description":"Контролює, чи показувати незакріплені зміни у вигляді Хронології.","scope":"window"},"git.showActionButton":{"type":"object","additionalProperties":false,"description":"Контролює, чи відображається кнопка дії у вигляді джерела.","properties":{"commit":{"type":"boolean","description":"Показати кнопку дії для збереження змін, коли локальна гілка має змінені файли, готові до збереження."},"publish":{"type":"boolean","description":"Показати кнопку дії для публікації локальної гілки, коли вона не має відстежуваної віддаленої гілки."},"sync":{"type":"boolean","description":"Показати кнопку дії для синхронізації змін, коли локальна гілка або випереджає, або відстає від віддаленої гілки."}},"default":{"commit":true,"publish":true,"sync":true},"scope":"resource"},"git.statusLimit":{"type":"number","scope":"resource","default":10000,"description":"Контролює, як обмежити кількість змін, які можуть бути розібрані з команди Git status. Може бути встановлено на 0 для відсутності обмеження."},"git.repositoryScanIgnoredFolders":{"type":"array","items":{"type":"string"},"default":["node_modules"],"scope":"resource","markdownDescription":"Список папок, які ігноруються під час сканування на наявність Git-репозиторіїв, коли `#git.autoRepositoryDetection#` встановлено на `true` або `subFolders`."},"git.repositoryScanMaxDepth":{"type":"number","scope":"resource","default":1,"markdownDescription":"Контролює глибину, що використовується під час сканування папок робочого простору на наявність Git-репозиторіїв, коли `#git.autoRepositoryDetection#` встановлено на `true` або `subFolders`. Може бути встановлено на `-1` для безмежного сканування."},"git.commandsToLog":{"type":"array","items":{"type":"string"},"default":[],"markdownDescription":"Список команд git (наприклад: commit, push), для яких буде записано їхній `stdout` у [git output](command:git.showOutput). Якщо команда git має налаштований клієнтський хуком, `stdout` клієнтського хуку також буде записано у [git output](command:git.showOutput)."},"git.mergeEditor":{"type":"boolean","default":false,"markdownDescription":"Відкрийте редактор злиття для файлів, які наразі знаходяться в конфлікті.","scope":"window"},"git.optimisticUpdate":{"type":"boolean","default":true,"markdownDescription":"Контролює, чи оптимістично оновлювати стан перегляду джерела контролю після виконання команд git.","scope":"resource","tags":["experimental"]},"git.openRepositoryInParentFolders":{"type":"string","enum":["always","never","prompt"],"enumDescriptions":["Завжди відкривайте репозиторій у батьківських папках робочих просторів або відкритих файлів.","Ніколи не відкривайте репозиторій у батьківських папках робочих просторів або відкритих файлах.","Запит перед відкриттям репозиторію батьківських папок робочих просторів або відкритих файлів."],"default":"prompt","markdownDescription":"Контролюйте, чи слід відкривати репозиторій у батьківських папках робочих просторів або відкритих файлах.","scope":"resource"},"git.similarityThreshold":{"type":"number","default":50,"minimum":0,"maximum":100,"markdownDescription":"Контролює поріг індексу схожості (кількість додатків/видалень у порівнянні з розміром файлу) для того, щоб зміни в парі доданих/видалених файлів вважалися перейменуванням. **Примітка:** Потребує версії Git `2.18.0` або новішої.","scope":"resource"},"git.blame.editorDecoration.enabled":{"type":"boolean","default":false,"markdownDescription":"Контролює, чи показувати інформацію про провину в редакторі, використовуючи декорації редактора."},"git.blame.editorDecoration.template":{"type":"string","default":"${subject}, ${authorName} (${authorDateAgo})","markdownDescription":"Шаблон для оформлення редактора інформації про провину. Підтримувані змінні:\n\n* `hash`: Хеш коміту\n\n* `hashShort`: Перші N символів хешу коміту відповідно до `#git.commitShortHashLength#`\n\n* `subject`: Перше речення повідомлення коміту\n\n* `authorName`: Ім'я автора\n\n* `authorEmail`: Електронна пошта автора\n\n* `authorDate`: Дата автора\n\n* `authorDateAgo`: Різниця в часі між теперішнім моментом і датою автора"},"git.blame.editorDecoration.disableHover":{"type":"boolean","default":false,"markdownDescription":"Controls whether to disable the blame information editor decoration hover."},"git.blame.statusBarItem.enabled":{"type":"boolean","default":true,"markdownDescription":"Контролює, чи відображати інформацію про провину в рядку стану."},"git.blame.statusBarItem.template":{"type":"string","default":"${authorName} (${authorDateAgo})","markdownDescription":"Шаблон для елемента статусного рядка інформації про провину. Підтримувані змінні:\n\n* `hash`: Хеш коміту\n\n* `hashShort`: Перші N символів хешу коміту відповідно до `#git.commitShortHashLength#`\n\n* `subject`: Перше речення повідомлення коміту\n\n* `authorName`: Ім'я автора\n\n* `authorEmail`: Електронна пошта автора\n\n* `authorDate`: Дата автора\n\n* `authorDateAgo`: Різниця в часі між теперішнім моментом і датою автора"},"git.blame.ignoreWhitespace":{"type":"boolean","default":false,"markdownDescription":"Controls whether to ignore whitespace changes when computing blame information."},"git.commitShortHashLength":{"type":"number","default":7,"minimum":7,"maximum":40,"markdownDescription":"Контролює довжину короткого хешу коміту.","scope":"resource"},"git.diagnosticsCommitHook.enabled":{"type":"boolean","default":false,"markdownDescription":"Контролює, чи перевіряти наявність невирішених діагностик перед комітом.","scope":"resource"},"git.diagnosticsCommitHook.sources":{"type":"object","additionalProperties":{"type":"string","enum":["error","warning","information","hint","none"]},"default":{"*":"error"},"markdownDescription":"Контролює список джерел (**Item**) та мінімальну серйозність (**Value**), які слід враховувати перед комітом. **Примітка:** Щоб ігнорувати діагностику з певного джерела, додайте джерело до списку та встановіть мінімальну серйозність на `none`.","scope":"resource"},"git.discardUntrackedChangesToTrash":{"type":"boolean","default":true,"markdownDescription":"Контролює, чи скидання ненаглядованих змін переміщує файл(и) до Кошика (Windows), Смітника (macOS, Linux) замість їх постійного видалення. **Примітка:** Ця настройка не має жодного ефекту при підключенні до віддаленого або при запуску в Linux як пакет snap."},"git.showReferenceDetails":{"type":"boolean","default":true,"markdownDescription":"Контролює, чи показувати деталі останнього коміту для Git refs у вибірниках чекауту, гілок та тегів."}}},"colors":[{"id":"gitDecoration.addedResourceForeground","description":"Колір для додаткових ресурсів.","defaults":{"light":"#587c0c","dark":"#81b88b","highContrast":"#a1e3ad","highContrastLight":"#374e06"}},{"id":"gitDecoration.modifiedResourceForeground","description":"Колір для модифікованих ресурсів.","defaults":{"light":"#895503","dark":"#E2C08D","highContrast":"#E2C08D","highContrastLight":"#895503"}},{"id":"gitDecoration.deletedResourceForeground","description":"Колір для видалених ресурсів.","defaults":{"light":"#ad0707","dark":"#c74e39","highContrast":"#c74e39","highContrastLight":"#ad0707"}},{"id":"gitDecoration.renamedResourceForeground","description":"Колір для перейменованих або скопійованих ресурсів.","defaults":{"light":"#007100","dark":"#73C991","highContrast":"#73C991","highContrastLight":"#007100"}},{"id":"gitDecoration.untrackedResourceForeground","description":"Колір для не відстежуваних ресурсів.","defaults":{"light":"#007100","dark":"#73C991","highContrast":"#73C991","highContrastLight":"#007100"}},{"id":"gitDecoration.ignoredResourceForeground","description":"Колір для ігнорованих ресурсів.","defaults":{"light":"#8E8E90","dark":"#8C8C8C","highContrast":"#A7A8A9","highContrastLight":"#8e8e90"}},{"id":"gitDecoration.stageModifiedResourceForeground","description":"Колір для модифікованих ресурсів, які були підготовлені.","defaults":{"light":"#895503","dark":"#E2C08D","highContrast":"#E2C08D","highContrastLight":"#895503"}},{"id":"gitDecoration.stageDeletedResourceForeground","description":"Колір для видалених ресурсів, які були підготовлені.","defaults":{"light":"#ad0707","dark":"#c74e39","highContrast":"#c74e39","highContrastLight":"#ad0707"}},{"id":"gitDecoration.conflictingResourceForeground","description":"Колір для ресурсів з конфліктами.","defaults":{"light":"#ad0707","dark":"#e4676b","highContrast":"#c74e39","highContrastLight":"#ad0707"}},{"id":"gitDecoration.submoduleResourceForeground","description":"Колір для ресурсів підмодуля.","defaults":{"light":"#1258a7","dark":"#8db9e2","highContrast":"#8db9e2","highContrastLight":"#1258a7"}},{"id":"git.blame.editorDecorationForeground","description":"Колір для оформлення редактора провини.","defaults":{"dark":"editorInlayHint.foreground","light":"editorInlayHint.foreground","highContrast":"editorInlayHint.foreground","highContrastLight":"editorInlayHint.foreground"}}],"configurationDefaults":{"[git-commit]":{"editor.rulers":[50,72],"editor.wordWrap":"off","workbench.editor.restoreViewState":false},"[git-rebase]":{"workbench.editor.restoreViewState":false}},"viewsWelcome":[{"view":"scm","contents":"Якщо ви хочете використовувати функції Git, будь ласка, увімкніть Git у ваших [налаштуваннях](command:workbench.action.openSettings?%5B%22git.enabled%22%5D).\nЩоб дізнатися більше про те, як використовувати Git та контроль версій у VS Code, [прочитайте нашу документацію](https://aka.ms/vscode-scm).","when":"!config.git.enabled"},{"view":"scm","contents":"Встановіть Git, популярну систему контролю версій, щоб відстежувати зміни в коді та співпрацювати з іншими. Дізнайтеся більше в наших [посібниках з Git](https://aka.ms/vscode-scm).","when":"config.git.enabled && git.missing && remoteName != ''"},{"view":"scm","contents":"[Завантажити Git для macOS](https://git-scm.com/download/mac)\nПісля встановлення, будь ласка, [перезавантажте](command:workbench.action.reloadWindow) (або [усуньте неполадки](command:git.showOutput)). Додаткові провайдери контролю версій можуть бути встановлені [з Маркетплейсу](command:workbench.extensions.search?%22%40category%3A%5C%22scm%20providers%5C%22%22).","when":"config.git.enabled && git.missing && remoteName == '' && isMac"},{"view":"scm","contents":"[Завантажити Git для Windows](https://git-scm.com/download/win)\nПісля встановлення, будь ласка, [перезавантажте](command:workbench.action.reloadWindow) (або [усуньте неполадки](command:git.showOutput)). Додаткові постачальники контролю версій можуть бути встановлені [з Маркетплейсу](command:workbench.extensions.search?%22%40category%3A%5C%22scm%20providers%5C%22%22).","when":"config.git.enabled && git.missing && remoteName == '' && isWindows"},{"view":"scm","contents":"Контроль версій залежить від наявності Git.\n[Завантажити Git для Linux](https://git-scm.com/download/linux)\nПісля встановлення, будь ласка, [перезавантажте](command:workbench.action.reloadWindow) (або [усуньте неполадки](command:git.showOutput)). Додаткові постачальники контролю версій можуть бути встановлені [з Маркетплейсу](command:workbench.extensions.search?%22%40category%3A%5C%22scm%20providers%5C%22%22).","when":"config.git.enabled && git.missing && remoteName == '' && isLinux"},{"view":"scm","contents":"Щоб використовувати функції Git, ви можете відкрити папку, що містить репозиторій Git, або клонувати з URL-адреси.  \n[Відкрити папку](command:vscode.openFolder)  \n[Клонувати репозиторій](command:git.cloneRecursive)  \nЩоб дізнатися більше про те, як використовувати Git та контроль версій у VS Code, [прочитайте нашу документацію](https://aka.ms/vscode-scm).","when":"config.git.enabled && !git.missing && workbenchState == empty && git.parentRepositoryCount == 0 && git.unsafeRepositoryCount == 0 && git.closedRepositoryCount == 0","enablement":"git.state == initialized","group":"2_open@1"},{"view":"scm","contents":"Поточне робоче середовище не містить жодних папок з репозиторіями Git.\n[Додати папку до робочого середовища](command:workbench.action.addRootFolder)\nЩоб дізнатися більше про використання Git та контролю версій у VS Code [прочитайте нашу документацію](https://aka.ms/vscode-scm).","when":"config.git.enabled && !git.missing && workbenchState == workspace && workspaceFolderCount == 0 && git.parentRepositoryCount == 0 && git.unsafeRepositoryCount == 0 && git.closedRepositoryCount == 0","enablement":"git.state == initialized","group":"2_open@1"},{"view":"scm","contents":"Сканування папки на наявність репозиторіїв Git...","when":"config.git.enabled && !git.missing && workbenchState == folder && workspaceFolderCount != 0 && git.state != initialized"},{"view":"scm","contents":"Сканування робочого простору на наявність репозиторіїв Git...","when":"config.git.enabled && !git.missing && workbenchState == workspace && workspaceFolderCount != 0 && git.state != initialized"},{"view":"scm","contents":"Тека, яка зараз відкрита, не має репозиторію Git. Ви можете ініціалізувати репозиторій, що дозволить використовувати функції контролю версій, які підтримуються Git.  \n[Ініціалізувати репозиторій](command:git.init?%5Btrue%5D)  \nЩоб дізнатися більше про те, як використовувати Git та контроль версій у VS Code, [прочитайте нашу документацію](https://aka.ms/vscode-scm).","when":"config.git.enabled && !git.missing && git.state == initialized && workbenchState == folder && scm.providerCount == 0 && git.parentRepositoryCount == 0 && git.unsafeRepositoryCount == 0 && git.closedRepositoryCount == 0 && remoteName != 'codespaces'","group":"5_scm@1"},{"view":"scm","contents":"Поточне робоче середовище не містить жодних папок з репозиторіями Git. Ви можете ініціалізувати репозиторій у папці, що дозволить активувати функції контролю версій, які підтримуються Git.\n[Ініціалізувати репозиторій](command:git.init)\nЩоб дізнатися більше про те, як використовувати Git та контроль версій у VS Code, [прочитайте нашу документацію](https://aka.ms/vscode-scm).","when":"config.git.enabled && !git.missing && git.state == initialized && workbenchState == workspace && workspaceFolderCount != 0 && scm.providerCount == 0 && git.parentRepositoryCount == 0 && git.unsafeRepositoryCount == 0 && git.closedRepositoryCount == 0 && remoteName != 'codespaces'","group":"5_scm@1"},{"view":"scm","contents":"У батьківських папках робочого простору або відкритих файлів знайдено репозиторій Git.\n[Відкрити репозиторій](command:git.openRepositoriesInParentFolders)\nВикористовуйте налаштування [git.openRepositoryInParentFolders](command:workbench.action.openSettings?%5B%22git.openRepositoryInParentFolders%22%5D), щоб контролювати, чи відкриваються репозиторії Git у батьківських папках робочих просторів або відкритих файлів. Щоб дізнатися більше, [прочитайте нашу документацію](https://aka.ms/vscode-git-repository-in-parent-folders).","when":"config.git.enabled && !git.missing && git.state == initialized && git.parentRepositoryCount == 1"},{"view":"scm","contents":"У батьківських папках робочої області або відкритих файлів були знайдені репозиторії Git.\n[Відкрити репозиторій](command:git.openRepositoriesInParentFolders)\nВикористовуйте налаштування [git.openRepositoryInParentFolders](command:workbench.action.openSettings?%5B%22git.openRepositoryInParentFolders%22%5D), щоб контролювати, чи відкриваються репозиторії Git у батьківських папках робочої області або відкритих файлів. Щоб дізнатися більше, [прочитайте нашу документацію](https://aka.ms/vscode-git-repository-in-parent-folders).","when":"config.git.enabled && !git.missing && git.state == initialized && git.parentRepositoryCount > 1"},{"view":"scm","contents":"Виявлений репозиторій Git потенційно небезпечний, оскільки папка належить не поточному користувачу.\n[Управління небезпечними репозиторіями](command:git.manageUnsafeRepositories)\nЩоб дізнатися більше про небезпечні репозиторії, [прочитайте нашу документацію](https://aka.ms/vscode-git-unsafe-repository).","when":"config.git.enabled && !git.missing && git.state == initialized && git.unsafeRepositoryCount == 1"},{"view":"scm","contents":"Виявлені Git-репозиторії можуть бути небезпечними, оскільки папки належать не поточному користувачу.  \n[Управління небезпечними репозиторіями](command:git.manageUnsafeRepositories)  \nЩоб дізнатися більше про небезпечні репозиторії, [прочитайте нашу документацію](https://aka.ms/vscode-git-unsafe-repository).","when":"config.git.enabled && !git.missing && git.state == initialized && git.unsafeRepositoryCount > 1"},{"view":"scm","contents":"Було знайдено репозиторій Git, який раніше був закритий.  \n[Відкрити закритий репозиторій](command:git.reopenClosedRepositories)  \nЩоб дізнатися більше про те, як використовувати Git та контроль версій у VS Code, [прочитайте нашу документацію](https://aka.ms/vscode-scm).","when":"config.git.enabled && !git.missing && git.state == initialized && git.closedRepositoryCount == 1"},{"view":"scm","contents":"Було знайдено Git-репозиторії, які раніше були закриті.\n[Відкрити закриті репозиторії](command:git.reopenClosedRepositories)\nЩоб дізнатися більше про використання Git та контролю версій у VS Code, [прочитайте нашу документацію](https://aka.ms/vscode-scm).","when":"config.git.enabled && !git.missing && git.state == initialized && git.closedRepositoryCount > 1"},{"view":"explorer","contents":"Ви можете клонувати репозиторій локально.  \n[Клонувати репозиторій](command:git.clone 'Клонувати репозиторій після активації розширення Git')","when":"config.git.enabled && git.state == initialized && scm.providerCount == 0","group":"5_scm@1"},{"view":"explorer","contents":"Щоб дізнатися більше про те, як використовувати Git та контроль версій у VS Code [прочитайте нашу документацію](https://aka.ms/vscode-scm).","when":"config.git.enabled && git.state == initialized && scm.providerCount == 0","group":"5_scm@10"}]},"repository":{"type":"git","url":"https://github.com/microsoft/vscode.git"}},"location":{"$mid":1,"path":"/usr/share/code/resources/app/extensions/git","scheme":"file"},"isBuiltin":true,"targetPlatform":"undefined","isValid":true,"validations":[],"preRelease":false,"forceAutoUpdate":false},{"type":0,"identifier":{"id":"vscode.git-base"},"manifest":{"name":"git-base","displayName":"Git Base","description":"Git статичні внески та вибірки.","version":"10.0.0","publisher":"vscode","license":"MIT","engines":{"vscode":"0.10.x"},"categories":["Other"],"activationEvents":["*"],"main":"./dist/extension.js","browser":"./dist/browser/extension.js","icon":"resources/icons/git.png","capabilities":{"virtualWorkspaces":true,"untrustedWorkspaces":{"supported":true}},"contributes":{"commands":[{"command":"git-base.api.getRemoteSources","title":{"value":"Отримати віддалені джерела","original":"Get Remote Sources"},"category":"Git Base API"}],"menus":{"commandPalette":[{"command":"git-base.api.getRemoteSources","when":"false"}]},"languages":[{"id":"git-commit","aliases":["Git Commit Message","git-commit"],"filenames":["COMMIT_EDITMSG","MERGE_MSG"],"configuration":"./languages/git-commit.language-configuration.json"},{"id":"git-rebase","aliases":["G